          {
            "name": "structured_logging_hook",
            "kind": "function",
            "display": "def structured_logging_hook(\n    *,\n    logger: logging.Logger | None = None,\n    levels: LogLevels | None = None,\n    redaction: RedactionPolicy | None = None,\n) -> ExecHook",
            "doc": {
              "summary": "Create an observe hook that logs execution events with structured data.",
              "sections": [
                {
                  "title": "Parameters",
                  "fields": [
                    {
                      "name": "logger",
                      "type": "",
                      "description": "Logger instance for event emission. Defaults to <code>logging.getLogger(&quot;cuprum.exec&quot;)</code>."
                    },
                    {
                      "name": "levels",
                      "type": "",
                      "description": "Log level configuration for different event phases. Defaults to <code>LogLevels()</code> with standard levels."
                    },
                    {
                      "name": "redaction",
                      "type": "",
                      "description": "Optional projection policy applied before rendering messages and extras. Defaults to <code>None</code>; execution inputs and raw events remain unchanged."
                    }
