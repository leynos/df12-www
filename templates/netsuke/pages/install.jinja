{% extends "doc_page.jinja" %}
{% set active_nav = 'install' %}
{% block page_title %}Install Netsuke - Build System{% endblock %}
{% block extra_head %}
    <style>
        .tab-btn.active {
            background-color: #E8D5B5;
            color: #2E2A25;
            border-color: #D1C7B8;
        }

        .code-block-wrapper {
            position: relative;
        }
        .code-block-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.2);
            border-radius: 0.5rem;
        }
    </style>
{% endblock %}
{% block content %}
{% raw %}
<main id="main-content" class="flex-grow pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">

        <!-- Hero Section -->
        <header id="install-hero" class="mb-16 text-center max-w-3xl mx-auto">
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-boxwood text-charcoal-mid text-xs font-semibold uppercase tracking-wider border border-stone mb-6">
                <span  class="iconify mr-2 text-indigo" data-icon="carbon:download" aria-hidden="true"></span> Get Started &middot; v{% endraw %}{{ netsuke_version }}{% raw %}
            </div>
            <h1 class="font-serif text-5xl lg:text-6xl font-bold text-charcoal mb-6">Install Netsuke</h1>
            <p class="text-xl text-charcoal-mid font-light leading-relaxed mb-8">
                Install the CLI, make sure <code>ninja</code> is available, and start with a small <code>Netsukefile</code>. Netsuke works best when the first build is boring.
            </p>
            <div class="flex justify-center space-x-6 text-sm text-charcoal-mid">
                <span class="flex items-center"><span  class="iconify mr-2 text-lg" data-icon="carbon:apple" aria-hidden="true"></span> macOS</span>
                <span class="flex items-center"><span  class="iconify mr-2 text-lg" data-icon="carbon:linux" aria-hidden="true"></span> Linux</span>
                <span class="flex items-center"><span  class="iconify mr-2 text-lg" data-icon="carbon:window-base" aria-hidden="true"></span> Windows</span>
            </div>
        </header>

        <!-- Main Installation Widget -->
        <section id="install-widget" class="max-w-4xl mx-auto mb-20">
            <div class="hm-card overflow-hidden">
                <!-- OS Tabs -->
                <div class="flex border-b border-stone bg-boxwood-pale/50 overflow-x-auto" role="tablist" aria-label="Installation methods">
                    <button type="button" id="install-tab-cargo" class="tab-btn active px-6 py-4 text-sm font-bold text-charcoal border-r border-stone hover:bg-boxwood-pale transition-colors flex items-center whitespace-nowrap" data-install-tab="cargo" role="tab" aria-selected="true" aria-controls="install-panel-cargo" tabindex="0">
                        <span  class="iconify mr-2" data-icon="carbon:development" aria-hidden="true"></span> Cargo
                    </button>
                    <button type="button" id="install-tab-linux" class="tab-btn px-6 py-4 text-sm font-medium text-charcoal-mid border-r border-stone hover:bg-boxwood-pale transition-colors flex items-center whitespace-nowrap" data-install-tab="linux" role="tab" aria-selected="false" aria-controls="install-panel-linux" tabindex="-1">
                        <span  class="iconify mr-2" data-icon="carbon:linux" aria-hidden="true"></span> Linux
                    </button>
                    <button type="button" id="install-tab-macos" class="tab-btn px-6 py-4 text-sm font-medium text-charcoal-mid border-r border-stone hover:bg-boxwood-pale transition-colors flex items-center whitespace-nowrap" data-install-tab="macos" role="tab" aria-selected="false" aria-controls="install-panel-macos" tabindex="-1">
                        <span  class="iconify mr-2" data-icon="carbon:apple" aria-hidden="true"></span> macOS
                    </button>
                    <button type="button" id="install-tab-windows" class="tab-btn px-6 py-4 text-sm font-medium text-charcoal-mid hover:bg-boxwood-pale transition-colors flex items-center whitespace-nowrap" data-install-tab="windows" role="tab" aria-selected="false" aria-controls="install-panel-windows" tabindex="-1">
                        <span  class="iconify mr-2" data-icon="carbon:windows" aria-hidden="true"></span> Windows
                    </button>
                </div>

                <!-- Cargo panel -->
                <div class="p-8 lg:p-10" id="install-panel-cargo" data-install-panel="cargo" role="tabpanel" aria-labelledby="install-tab-cargo">
                    <div class="mb-8">
                        <h3 class="font-serif text-2xl font-bold text-charcoal mb-2">Install with Cargo</h3>
                        <p class="text-charcoal-mid text-sm">Netsuke <span class="font-semibold">v{% endraw %}{{ netsuke_version }}{% raw %}</span> is published on crates.io as the <code>netsuke-build</code> crate; the installed binary is named <code>netsuke</code>. Where <a href="https://github.com/cargo-bins/cargo-binstall" class="text-indigo hover:underline"><code>cargo binstall</code></a> is available, prefer it: it fetches a prebuilt release binary and avoids the nightly toolchain requirement below. <code>ninja</code> must be installed separately.</p>
                    </div>
                    <div class="bg-charcoal rounded-lg p-6 code-block-wrapper">
                        {% endraw %}{% highlight 'netsuke-console' %}{% raw %}
$ cargo binstall netsuke-build
                        {% endraw %}{% endhighlight %}{% raw %}
                    </div>
                    <div class="mt-6 mb-2">
                        <h4 class="font-bold text-sm text-charcoal mb-2">Build from crates.io instead</h4>
                        <p class="text-charcoal-mid text-xs mb-3">Netsuke builds with the Polonius borrow checker, so a registry build runs outside a repository checkout and must supply the dated Rust nightly toolchain and <code>RUSTFLAGS</code> explicitly:</p>
                    </div>
                    <div class="bg-charcoal rounded-lg p-6 code-block-wrapper">
                        {% endraw %}{% highlight 'netsuke-console' %}{% raw %}
$ rustup toolchain install nightly-2026-06-25
$ RUSTFLAGS=-Zpolonius=next cargo +nightly-2026-06-25 install netsuke-build
                        {% endraw %}{% endhighlight %}{% raw %}
                    </div>
                    <div class="mt-8 grid md:grid-cols-2 gap-6">
                        <div class="bg-boxwood-pale p-4 rounded-lg border border-stone">
                            <h4 class="font-bold text-sm text-charcoal mb-2 flex items-center">
                                <span  class="iconify mr-2 text-amber" data-icon="carbon:chemistry" aria-hidden="true"></span> Build from a source checkout
                            </h4>
                            <div class="bg-white p-3 rounded border border-stone font-mono text-xs text-charcoal-mid">
                                git clone https://github.com/leynos/netsuke.git<br>
                                cd netsuke &amp;&amp; cargo install --path .
                            </div>
                            <p class="mt-2 text-xs text-charcoal-mid">The checkout supplies the pinned nightly toolchain and the Polonius flag automatically, so neither is passed here.</p>
                        </div>
                        <div class="bg-boxwood-pale p-4 rounded-lg border border-stone">
                            <h4 class="font-bold text-sm text-charcoal mb-2 flex items-center">
                                <span  class="iconify mr-2 text-indigo" data-icon="carbon:cube" aria-hidden="true"></span> Verify
                            </h4>
                            <div class="bg-white p-3 rounded border border-stone font-mono text-xs text-charcoal-mid">
                                netsuke --version
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Linux panel -->
                <div class="p-8 lg:p-10 hidden" id="install-panel-linux" data-install-panel="linux" role="tabpanel" aria-labelledby="install-tab-linux">
                    <div class="mb-8">
                        <h3 class="font-serif text-2xl font-bold text-charcoal mb-2">Linux packages</h3>
                        <p class="text-charcoal-mid text-sm">The <a href="https://github.com/leynos/netsuke/releases/tag/v{% endraw %}{{ netsuke_version }}{% raw %}" class="text-indigo hover:underline">v{% endraw %}{{ netsuke_version }}{% raw %} release</a> ships Debian (<code>.deb</code>) and RPM (<code>.rpm</code>) packages for x86-64 (<code>amd64</code>) and Arm64 (<code>arm64</code>). They install the binary under <code>/usr/bin</code>, add the <code>netsuke.1</code> manual page, and declare <code>ninja-build</code> as a dependency, so Ninja is pulled in automatically.</p>
                    </div>
                    <div class="bg-charcoal rounded-lg p-6 code-block-wrapper font-mono text-sm text-stone-light">
{% endraw %}{% highlight 'netsuke-console' %}{% raw %}
# Debian or Ubuntu
$ sudo apt install ./PACKAGE.deb

# Fedora, Rocky Linux, or another RPM-based distribution
$ sudo dnf install ./PACKAGE.rpm
{% endraw %}{% endhighlight %}{% raw %}
                    </div>
                    <p class="mt-6 text-xs text-charcoal-mid">Replace <code>PACKAGE</code> with the downloaded filename for your architecture. Standalone binaries with SHA-256 checksum sidecars are also published; the installer packages themselves do not have checksum sidecars in v{% endraw %}{{ netsuke_version }}{% raw %}.</p>
                </div>

                <!-- macOS panel -->
                <div class="p-8 lg:p-10 hidden" id="install-panel-macos" data-install-panel="macos" role="tabpanel" aria-labelledby="install-tab-macos">
                    <div class="mb-8">
                        <h3 class="font-serif text-2xl font-bold text-charcoal mb-2">macOS installer package</h3>
                        <p class="text-charcoal-mid text-sm">The <a href="https://github.com/leynos/netsuke/releases/tag/v{% endraw %}{{ netsuke_version }}{% raw %}" class="text-indigo hover:underline">v{% endraw %}{{ netsuke_version }}{% raw %} release</a> ships installer packages (<code>.pkg</code>) for Intel x86-64 and Apple silicon Arm64. They install the binary under <code>/usr/local/bin</code> along with the manual page and licence. Ninja must be installed separately.</p>
                    </div>
                    <div class="bg-charcoal rounded-lg p-6 code-block-wrapper font-mono text-sm text-stone-light">
{% endraw %}{% highlight 'netsuke-console' %}{% raw %}
# Install the downloaded package
$ sudo installer -pkg ./PACKAGE.pkg -target /

# Ninja is a separate install
$ brew install ninja
{% endraw %}{% endhighlight %}{% raw %}
                    </div>
                    <p class="mt-6 text-xs text-charcoal-mid">Replace <code>PACKAGE</code> with the downloaded filename for your architecture (for example <code>netsuke-{% endraw %}{{ netsuke_version }}{% raw %}-macos-arm64.pkg</code>).</p>
                </div>

                <!-- Windows panel -->
                <div class="p-8 lg:p-10 hidden" id="install-panel-windows" data-install-panel="windows" role="tabpanel" aria-labelledby="install-tab-windows">
                    <div class="mb-8">
                        <h3 class="font-serif text-2xl font-bold text-charcoal mb-2">Windows installer</h3>
                        <p class="text-charcoal-mid text-sm">The <a href="https://github.com/leynos/netsuke/releases/tag/v{% endraw %}{{ netsuke_version }}{% raw %}" class="text-indigo hover:underline">v{% endraw %}{{ netsuke_version }}{% raw %} release</a> ships Windows Installer (<code>.msi</code>) packages for x64 and Arm64. The MSI installs to <code>C:\Program Files\netsuke</code> and does <strong>not</strong> update <code>PATH</code>. Ninja must be installed separately. PowerShell help files are published beside each MSI as sidecar artefacts.</p>
                    </div>
                    <div class="bg-charcoal rounded-lg p-6 code-block-wrapper font-mono text-sm text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'powershell' %}{% raw %}
# Install the downloaded package
msiexec.exe /i PACKAGE.msi

# Add the install directory to the current user's PATH
$dir = Join-Path $env:ProgramFiles 'netsuke'
[Environment]::SetEnvironmentVariable('Path',
  "$([Environment]::GetEnvironmentVariable('Path', 'User'));$dir", 'User')
$env:Path = "$env:Path;$dir"

netsuke --version
{% endraw %}{% endhighlight %}{% raw %}
                    </div>
                    <p class="mt-6 text-xs text-charcoal-mid">See the <a href="https://github.com/leynos/netsuke/blob/main/docs/users-guide.md#complete-windows-setup" class="text-indigo hover:underline">complete Windows setup</a> for the idempotent PATH script and the PowerShell help module install.</p>
                </div>

                <div class="px-8 lg:px-10 pb-8 pt-2 border-t border-stone-light flex items-start gap-3">
                    <span  class="iconify text-indigo mt-3" data-icon="carbon:information-filled" aria-hidden="true"></span>
                    <p class="text-xs text-charcoal-mid pt-2.5">
                        <strong>Note:</strong> Netsuke delegates execution to <code>ninja</code>; make sure it is on your <code>PATH</code>. You may need to restart your terminal after installation for the <code>netsuke</code> command to be recognized.
                    </p>
                </div>
            </div>
        </section>

        <!-- Steps Section -->
        <section id="verification-steps" class="max-w-5xl mx-auto mb-24">
            <div class="grid lg:grid-cols-12 gap-12">
                <!-- Content -->
                <div class="lg:col-span-8 space-y-12">

                    <!-- Step 1 -->
                    <div class="relative pl-10 border-l-2 border-stone-light">
                        <div class="absolute -left-[21px] top-0 w-10 h-10 rounded-full bg-white border-2 border-stone text-charcoal font-bold flex items-center justify-center font-serif text-lg shadow-sm">1</div>
                        <h3 class="text-xl font-bold text-charcoal mb-4">Verify Installation</h3>
                        <p class="text-charcoal-mid mb-4">Run the version command to ensure Netsuke is correctly installed and accessible in your path.</p>
                        <div class="bg-charcoal rounded-lg p-4 font-mono text-sm text-stone-light shadow-inner border border-charcoal-mid">
                            {% endraw %}{% highlight 'netsuke-console' %}{% raw %}
$ netsuke --version
netsuke {% endraw %}{{ netsuke_version }}{% raw %}
                            {% endraw %}{% endhighlight %}{% raw %}
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative pl-10 border-l-2 border-stone-light">
                        <div class="absolute -left-[21px] top-0 w-10 h-10 rounded-full bg-white border-2 border-stone text-charcoal font-bold flex items-center justify-center font-serif text-lg shadow-sm">2</div>
                        <h3 class="text-xl font-bold text-charcoal mb-4">Create a Manifest</h3>
                        <p class="text-charcoal-mid mb-4">Create a <code>Netsukefile</code> in the project root. Start with one rule, one target, and one default.</p>
                        <div class="bg-charcoal rounded-lg p-4 font-mono text-sm text-stone-light shadow-inner border border-charcoal-mid">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
netsuke_version: "1.0.0"
targets:
  - name: "hello.txt"
    command: "printf 'hello\n' > {{ outs }}"
    sources: []
defaults: ["hello.txt"]
{% endraw %}{% endhighlight %}{% raw %}
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative pl-10 border-l-2 border-stone-light">
                        <div class="absolute -left-[21px] top-0 w-10 h-10 rounded-full bg-white border-2 border-stone text-charcoal font-bold flex items-center justify-center font-serif text-lg shadow-sm">3</div>
                        <h3 class="text-xl font-bold text-charcoal mb-4">Run Your First Build</h3>
                        <p class="text-charcoal-mid mb-4">Execute the default target defined in your manifest. Netsuke validates the manifest, expands templates, writes a Ninja plan, and hands execution over.</p>
                        <div class="bg-charcoal rounded-lg p-4 font-mono text-sm text-stone-light shadow-inner border border-charcoal-mid">
                            {% endraw %}{% highlight 'netsuke-console' %}{% raw %}
$ netsuke build
[1/1] printf 'hello\n' > hello.txt
                            {% endraw %}{% endhighlight %}{% raw %}
                        </div>

                        <div class="mt-6 flex gap-4">
                            <a href="/netsuke/docs/getting-started/" class="hm-button hm-button--primary inline-flex items-center px-5 py-2.5">
                                Read Getting Started Guide <span  class="iconify ml-2" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Troubleshooting Sidebar -->
                <div class="lg:col-span-4 space-y-8">
                    <div class="bg-boxwood-pale p-6 rounded-xl border border-stone">
                        <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                            <span  class="iconify text-amber mr-2 text-sm" data-icon="carbon:tool-box" aria-hidden="true"></span> Troubleshooting
                        </h3>
                        <div class="space-y-4">
                            <div class="p-3 bg-white rounded border border-stone">
                                <h4 class="font-bold text-sm text-charcoal mb-1">Command not found?</h4>
                                <p class="text-xs text-charcoal-mid">Ensure <code>~/.cargo/bin</code> or <code>/usr/local/bin</code> is in your PATH environment variable.</p>
                            </div>
                            <div class="p-3 bg-white rounded border border-stone">
                                <h4 class="font-bold text-sm text-charcoal mb-1">`ninja` missing?</h4>
                                <p class="text-xs text-charcoal-mid">Install Ninja separately and make sure it is on your <code>PATH</code>. Netsuke delegates execution to it.</p>
                            </div>
                            <div class="p-3 bg-white rounded border border-stone">
                                <h4 class="font-bold text-sm text-charcoal mb-1">Manifest errors?</h4>
                                <p class="text-xs text-charcoal-mid">Start by checking YAML structure first. Netsuke validates YAML before any Jinja rendering happens.</p>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-stone-light text-center">
                            <a href="https://github.com/leynos/netsuke/issues" class="text-xs font-bold text-indigo hover:text-vermillion transition-colors">Visit GitHub Issues &rarr;</a>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                         <h3 class="font-serif text-lg font-bold text-charcoal mb-4">
                            Manual Download
                        </h3>
                        <p class="text-xs text-charcoal-mid mb-4">The v{% endraw %}{{ netsuke_version }}{% raw %} release ships installers: Debian and RPM packages for Linux (x86-64 and Arm64), a macOS installer package, and a Windows MSI. Ninja must be installed separately on macOS and Windows.</p>

                        <div class="mt-4 text-center">
                             <a href="https://github.com/leynos/netsuke/releases" class="hm-button hm-button--ghost inline-flex items-center px-5 py-2.5 text-sm">
                                <span  class="iconify mr-2" data-icon="carbon:download" aria-hidden="true"></span> View all releases
                             </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Community / Open Source -->
        <section class="py-16 bg-white border-y border-stone-light mb-12">
             <div class="site-container">
                 <div class="max-w-2xl">
                     <h2 class="font-serif text-3xl font-bold text-charcoal mb-4">Open source</h2>
                     <p class="text-charcoal-mid mb-6">
                         Netsuke is free and open source. The source, issues, and contribution guide are all on GitHub.
                     </p>
                     <a href="https://github.com/leynos/netsuke" class="hm-button hm-button--ghost inline-flex items-center px-5 py-2.5 text-sm">
                         <span class="iconify mr-2" data-icon="carbon:logo-github" aria-hidden="true"></span> View on GitHub
                     </a>
                 </div>
             </div>
        </section>

        <!-- FAQ Section -->
        <section id="faq" class="max-w-3xl mx-auto">
            <h2 class="font-serif text-3xl font-bold text-charcoal mb-8 text-center">Common Questions</h2>

            <div class="space-y-6">
                <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                    <h3 class="font-bold text-charcoal text-lg mb-2">Can I install a specific version?</h3>
                    <p class="text-charcoal-mid leading-relaxed">
                        Yes. Use Cargo with a semantic version number: <code>cargo install netsuke-build --version &lt;VERSION&gt;</code>. The version must be a number without a leading <code>v</code> (for example <code>{% endraw %}{{ netsuke_version }}{% raw %}</code>, not <code>v{% endraw %}{{ netsuke_version }}{% raw %}</code>). Pre-release versions such as <code>{% endraw %}{{ netsuke_version }}{% raw %}</code> must be requested explicitly; Cargo does not select them by default. Check <a href="https://crates.io/crates/netsuke-build" class="text-indigo hover:underline">crates.io</a> for available versions.
                    </p>
                </div>

                <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                    <h3 class="font-bold text-charcoal text-lg mb-2">How do I update Netsuke?</h3>
                    <p class="text-charcoal-mid leading-relaxed">
                        Re-run <code>cargo binstall netsuke-build</code> to fetch the latest prebuilt release, or run <code>cargo install netsuke-build --force</code> with the nightly toolchain and <code>RUSTFLAGS</code> shown above to rebuild from crates.io. Either way the existing <code>netsuke</code> binary is replaced.
                    </p>
                </div>

                <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                    <h3 class="font-bold text-charcoal text-lg mb-2">Does it work with CI/CD?</h3>
                    <p class="text-charcoal-mid leading-relaxed">
                        Yes. Install Netsuke on your continuous integration (CI) agent via <code>cargo binstall netsuke-build</code> (pin the version in automated workflows) and run <code>netsuke build</code> as a build step. When standard error (stderr) is not a teletype/terminal (TTY), progress falls back to plain text automatically, and <code>--json</code> emits a machine-readable result document. Dedicated CI integrations are planned but not yet available.
                    </p>
                </div>
            </div>
        </section>

    </main>
{% endraw %}
{% endblock %}
{% block extra_body %}
    <script>
        // Installation tab switcher
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = Array.from(document.querySelectorAll('[data-install-tab]'));
            const panels = document.querySelectorAll('[data-install-panel]');

            function selectTab(tab) {
                const key = tab.getAttribute('data-install-tab');

                tabs.forEach((other) => {
                    const active = other === tab;
                    other.classList.toggle('active', active);
                    other.classList.toggle('font-bold', active);
                    other.classList.toggle('text-charcoal', active);
                    other.classList.toggle('font-medium', !active);
                    other.classList.toggle('text-charcoal-mid', !active);
                    other.setAttribute('aria-selected', String(active));
                    other.setAttribute('tabindex', active ? '0' : '-1');
                });

                panels.forEach((panel) => {
                    panel.classList.toggle('hidden', panel.getAttribute('data-install-panel') !== key);
                });
            }

            tabs.forEach((tab, index) => {
                tab.addEventListener('click', () => selectTab(tab));
                tab.addEventListener('keydown', (event) => {
                    let targetIndex = null;
                    if (event.key === 'ArrowRight') {
                        targetIndex = (index + 1) % tabs.length;
                    } else if (event.key === 'ArrowLeft') {
                        targetIndex = (index - 1 + tabs.length) % tabs.length;
                    } else if (event.key === 'Home') {
                        targetIndex = 0;
                    } else if (event.key === 'End') {
                        targetIndex = tabs.length - 1;
                    }
                    if (targetIndex === null) {
                        return;
                    }
                    event.preventDefault();
                    const target = tabs[targetIndex];
                    selectTab(target);
                    target.focus();
                });
            });
        });
    </script>
{% endblock %}
