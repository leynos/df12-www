{% extends "doc_page.jinja" %}
{% import "components.jinja" as ui %}
{% import "docs_nav.jinja" as docsnav %}
{% set active_nav = 'docs' %}
{% block page_title %}Getting Started - Netsuke Build System{% endblock %}
{% block extra_head %}
    <style>
    </style>
{% endblock %}
{% block content %}
{% set install_command = 'cargo binstall netsuke-build@' ~ netsuke_version %}
{% raw %}
    <!-- Main Content Area with Sidebar -->
    <div class="site-container pt-16 flex-grow flex">

        <!-- Sidebar Navigation (Desktop) -->
        <aside id="sidebar" class="hidden lg:block w-64 flex-shrink-0 h-[calc(100vh-4rem)] sticky top-16 overflow-y-auto border-r border-stone-light pr-6 py-8">
            <!-- Search -->
            <div
                class="mb-8 relative"
                data-doc-search-root
                data-doc-search-index="/netsuke/assets/search/docs-search.json"
            >
                <span class="iconify absolute left-3 top-2.5 text-stone text-sm" data-icon="carbon:search" aria-hidden="true"></span>
                <input
                    type="text"
                    placeholder="Search docs..."
                    class="search-input w-full pl-9 pr-4 py-2 bg-white border border-stone rounded-md text-sm text-charcoal placeholder-stone focus:border-indigo transition-colors shadow-sm"
                    data-doc-search-input
                    aria-label="Search the documentation"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                >
                <div class="absolute right-3 top-2.5 text-xs text-stone font-mono">⌘K</div>
                <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-doc-search-panel>
                    <div class="overflow-hidden rounded-xl border border-stone bg-white shadow-paper-lg">
                        <ul class="max-h-96 overflow-y-auto divide-y divide-stone-light" data-doc-search-results role="listbox"></ul>
                        <p class="border-t border-stone-light bg-boxwood-pale px-4 py-3 text-xs text-charcoal-light" data-doc-search-meta>
                            Type at least 2 characters to search the docs.
                        </p>
                    </div>
                </div>
            </div>

            <nav class="space-y-8">
                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Introduction</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Documentation Hub</a></li>
                        <li><a href="/netsuke/docs/getting-started/" class="sidebar-link active block px-2 py-1.5 text-sm font-medium rounded-r-md transition-colors">Getting Started</a></li>
                        <li><a href="/netsuke/docs/getting-started/#installation" class="sidebar-link sidebar-link--sub block px-2 py-1.5 hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Installation</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Core Concepts</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/manifest-reference/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Manifest Reference</a></li>
                        <li><a href="/netsuke/docs/rules-and-targets/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Rules &amp; Targets</a></li>
                        <li><a href="/netsuke/docs/templating/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Templating</a></li>
                        <li><a href="/netsuke/docs/standard-library/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Standard Library</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Reference</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/cli/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">CLI Commands</a></li>
                        <li><a href="/netsuke/docs/configuration/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Configuration</a></li>
                        <li><a href="/netsuke/docs/security/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Security Model</a></li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main id="main-content" class="hm-docs-content flex-1 min-w-0 py-12 px-4 sm:px-6 lg:px-12">
{% endraw %}{{ docsnav.mobile_docs_bar('getting-started') }}{% raw %}

            <!-- Breadcrumbs -->
            <nav class="flex items-center text-sm text-charcoal-light mb-8 font-mono">
                <a href="/netsuke/docs/" class="hover:text-vermillion transition-colors">Docs</a>
                <span class="mx-2 text-stone">/</span>
                <span class="text-charcoal font-medium">Getting Started</span>
            </nav>

            <!-- Page Header -->
            <div class="mb-12 border-b border-stone-light pb-8">
                <div class="flex items-center mb-4">
                    {% endraw %}{{ ui.kicker('Tutorial') }}{% raw %}
                </div>
                <h1 class="font-serif text-4xl lg:text-5xl font-bold text-charcoal mb-6">Getting Started with Netsuke</h1>
                <p class="text-xl text-charcoal-mid font-light leading-relaxed max-w-3xl">
                    This guide will walk you through installing Netsuke, creating your first build manifest, and running your first successful build.
                </p>
            </div>

            <!-- Prerequisites Section -->
            <section id="prerequisites" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-4 group cursor-pointer">
                    <span class="text-stone-light mr-2 font-light">01.</span> Prerequisites
                    <span class="iconify text-sm text-stone opacity-0 group-hover:opacity-100 ml-2 transition-opacity" data-icon="carbon:link" aria-hidden="true"></span>
                </h2>
                <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                    <p class="text-charcoal-mid mb-4">Before we begin, ensure you have the following installed on your system:</p>
                    <ul class="space-y-3">
                        <li class="flex items-start">
                            <span class="iconify text-matcha mt-1 mr-3" data-icon="carbon:checkmark" aria-hidden="true"></span>
                            <span class="text-charcoal">macOS, Linux, or Windows (PowerShell natively, or WSL2)</span>
                        </li>
                        <li class="flex items-start">
                            <span class="iconify text-matcha mt-1 mr-3" data-icon="carbon:checkmark" aria-hidden="true"></span>
                            <span class="text-charcoal">Rust toolchain (optional, for building from source)</span>
                        </li>
                        <li class="flex items-start">
                            <span class="iconify text-matcha mt-1 mr-3" data-icon="carbon:checkmark" aria-hidden="true"></span>
                            <span class="text-charcoal">Basic familiarity with terminal commands</span>
                        </li>
                    </ul>
                    <div class="mt-6 pt-6 border-t border-stone-light">
                        <div class="flex items-start p-4 bg-indigo/5 rounded-lg border border-indigo/10">
                            <span class="iconify text-indigo mt-0.5 mr-3" data-icon="carbon:information-filled" aria-hidden="true"></span>
                            <div class="text-sm text-indigo">
                                <span class="font-bold">Note:</span> Netsuke relies on <code class="bg-white px-1 py-0.5 rounded text-xs font-mono border border-indigo/20">ninja</code> for the execution phase. Make sure it is installed and available on your <code>PATH</code>.
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Installation Section -->
            <section id="installation" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-4 group cursor-pointer">
                    <span class="text-stone-light mr-2 font-light">02.</span> Install Netsuke
                    <span class="iconify text-sm text-stone opacity-0 group-hover:opacity-100 ml-2 transition-opacity" data-icon="carbon:link" aria-hidden="true"></span>
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    Install Netsuke in the way that fits the machine. The reviewed docs only require the CLI binary and a working Ninja installation.
                </p>

                <div class="relative group mb-6">
                    <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity">
                        {% endraw %}<button class="bg-charcoal-light/20 hover:bg-charcoal-light/40 text-stone-light p-1.5 rounded transition-colors" type="button" title="Copy to clipboard" aria-label="Copy install command" data-copy-text="{{ install_command }}">{% raw %}
                            <span class="iconify" data-icon="carbon:copy" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="bg-charcoal rounded-lg p-5 font-mono text-sm overflow-x-auto border border-charcoal-mid shadow-lg">
                        {% endraw %}{% highlight 'netsuke-console' %}$ {{ install_command }}{% endhighlight %}{% raw %}
                    </div>
                </div>

                <p class="text-sm text-charcoal-mid">
                    The crate is published as <code class="bg-stone-light/30 px-1 rounded font-mono text-charcoal">netsuke-build</code> (current version {% endraw %}{{ netsuke_version }}{% raw %}); the installed binary is named <code class="bg-stone-light/30 px-1 rounded font-mono text-charcoal">netsuke</code>.
                </p>
                <p class="mt-3 text-sm text-charcoal-mid max-w-3xl">
                    <code>cargo binstall</code> fetches a prebuilt release binary. Building from crates.io or from a source checkout instead requires the pinned nightly toolchain — see the <a href="/netsuke/install/" class="text-vermillion hover:underline">install page</a> for the full instructions and platform installers.
                </p>
            </section>

            <!-- First Project Section -->
            <section id="first-project" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-4 group cursor-pointer">
                    <span class="text-stone-light mr-2 font-light">03.</span> Create a Manifest
                    <span class="iconify text-sm text-stone opacity-0 group-hover:opacity-100 ml-2 transition-opacity" data-icon="carbon:link" aria-hidden="true"></span>
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    Netsuke uses a file named <code class="text-vermillion bg-vermillion/5 px-1 rounded font-mono text-sm">Netsukefile</code> to define build targets. Let's create a minimal project structure.
                </p>

                <div class="grid lg:grid-cols-2 gap-8 mb-8">
                    <!-- Step 1: File Structure -->
                    <div>
                        <h3 class="font-bold text-charcoal mb-3 text-sm uppercase tracking-wide">1. Create Project Directory</h3>
                        <p class="text-xs font-mono uppercase tracking-wide text-charcoal-light mb-2">macOS, Linux, or WSL2</p>
                        <div class="bg-charcoal rounded-lg p-5 font-mono text-sm border border-charcoal-mid shadow-lg mb-4">
                            {% endraw %}{% highlight 'netsuke-console' %}{% raw %}
$ mkdir my-first-build && cd my-first-build
$ touch Netsukefile
                            {% endraw %}{% endhighlight %}{% raw %}
                        </div>
                        <p class="text-xs font-mono uppercase tracking-wide text-charcoal-light mb-2">Windows PowerShell</p>
                        <div class="bg-charcoal rounded-lg p-5 font-mono text-sm border border-charcoal-mid shadow-lg mb-4">
                            {% endraw %}{% highlight 'powershell' %}{% raw %}
mkdir my-first-build; cd my-first-build
New-Item Netsukefile -ItemType File
                            {% endraw %}{% endhighlight %}{% raw %}
                        </div>
                        <p class="text-sm text-charcoal-mid">
                            This creates a clean workspace. The <code class="font-mono text-xs">Netsukefile</code> is where the build graph is declared. Windows PowerShell 5.1 has no <code class="font-mono text-xs">&amp;&amp;</code> operator, so the two commands are separated by a semicolon.
                        </p>
                        <div class="mt-4 flex items-start p-4 bg-amber/5 rounded-lg border border-amber/30">
                            <span class="iconify text-amber mt-0.5 mr-3 shrink-0" data-icon="carbon:logo-windows" aria-hidden="true"></span>
                            <p class="text-xs text-charcoal-mid">
                                On Windows, recipes run in Windows PowerShell by default, so the <code>printf</code> and <code>tr</code> commands in the manifest opposite need either WSL2 or the explicit Bash route: install Git for Windows, prepend its <code>bin</code> directory to <code>PATH</code>, and set <code>NETSUKE_WINDOWS_SHELL=bash</code> before running <code>netsuke build</code>. See the <a href="/netsuke/docs/security/#recipe-shells" class="text-indigo underline decoration-indigo/40 hover:decoration-indigo">recipe shell contract</a>.
                            </p>
                        </div>
                    </div>

                    <!-- Step 2: Content -->
                    <div>
                        <h3 class="font-bold text-charcoal mb-3 text-sm uppercase tracking-wide">2. Define a Simple Rule</h3>
                        <div class="hm-faux-window bg-charcoal rounded-lg border border-charcoal-mid shadow-lg overflow-hidden">
                            <div class="hm-faux-window__titlebar flex items-center justify-between px-4 py-3 bg-charcoal-mid/20 border-b border-white/10">
                                <div class="flex space-x-2">
                                    <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                                    <div class="w-3 h-3 rounded-full bg-amber"></div>
                                    <div class="w-3 h-3 rounded-full bg-matcha"></div>
                                </div>
                                <span class="text-xs font-mono text-stone-light">Netsukefile</span>
                                <div class="w-12"></div>
                            </div>
                            <div class="hm-faux-window__body p-5 font-mono text-sm text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
netsuke_version: "1.0.0"

targets:
  - name: "hello.txt"
    command: "printf 'Hello, Netsuke!\n' > {{ outs }}"

  - name: "shout.txt"
    command: "tr 'a-z' 'A-Z' < {{ ins }} > {{ outs }}"
    sources: "hello.txt"

defaults: ["shout.txt"]
{% endraw %}{% endhighlight %}{% raw %}
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Build Execution Section -->
            <section id="build" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-4 group cursor-pointer">
                    <span class="text-stone-light mr-2 font-light">04.</span> Run the Build
                    <span class="iconify text-sm text-stone opacity-0 group-hover:opacity-100 ml-2 transition-opacity" data-icon="carbon:link" aria-hidden="true"></span>
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    Now invoke the CLI to build your target. Netsuke parses YAML first, resolves any templating, generates a Ninja plan, and then executes the required commands.
                </p>

                <div class="hm-faux-window bg-charcoal rounded-xl border border-charcoal-mid shadow-lg overflow-hidden mb-8">
                    <div class="hm-faux-window__titlebar bg-charcoal-mid/30 px-4 py-3 flex items-center justify-between border-b border-white/10">
                        <div class="flex space-x-2">
                            <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                            <div class="w-3 h-3 rounded-full bg-amber"></div>
                            <div class="w-3 h-3 rounded-full bg-matcha"></div>
                        </div>
                        <div class="text-xs font-mono text-charcoal-light">Terminal</div>
                        <div class="w-12"></div>
                    </div>
                    <div class="hm-faux-window__body p-6 font-mono text-sm overflow-x-auto">
{% endraw %}{% highlight 'netsuke-console' %}{% raw %}
$ netsuke build shout.txt
[1/2] printf 'Hello, Netsuke!\n' > hello.txt
[2/2] tr 'a-z' 'A-Z' < hello.txt > shout.txt
$ cat shout.txt
HELLO, NETSUKE!
{% endraw %}{% endhighlight %}{% raw %}
                    </div>
                </div>

                <div class="flex p-4 bg-boxwood-pale border border-stone rounded-lg">
                    <div class="flex-shrink-0">
                        <span class="iconify text-amber mt-0.5" data-icon="carbon:idea" aria-hidden="true"></span>
                    </div>
                    <div class="ml-3 text-sm text-charcoal-mid">
                        <p class="font-bold text-charcoal mb-1">What just happened?</p>
                        <p>
                            You asked to build <code class="bg-white px-1 rounded border border-stone/50">shout.txt</code>. Netsuke saw that <code class="bg-white px-1 rounded border border-stone/50">shout.txt</code> depends on <code class="bg-white px-1 rounded border border-stone/50">hello.txt</code>. It built <code class="bg-white px-1 rounded border border-stone/50">hello.txt</code> first, verified the output, and then fed that output into the <code class="bg-white px-1 rounded border border-stone/50">shout.txt</code> rule.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Next Steps -->
            <section id="next-steps" class="mb-20">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6">Next Steps</h2>
                <div class="grid md:grid-cols-3 gap-6">
                    <a href="/netsuke/docs/manifest-reference/" class="block p-6 bg-white rounded-xl border border-stone shadow-sm hover:shadow-paper hover:border-indigo transition-all group">
                        <div class="w-10 h-10 rounded-lg bg-indigo/10 text-indigo flex items-center justify-center text-lg mb-4 group-hover:scale-110 transition-transform">
                            <span class="iconify" data-icon="carbon:book" aria-hidden="true"></span>
                        </div>
                        <h3 class="font-bold text-charcoal mb-2">Manifest Reference</h3>
                        <p class="text-sm text-charcoal-mid mb-4">Dive deeper into the syntax and available functions in Netsukefiles.</p>
                        <span class="text-indigo text-sm font-medium">Read docs &rarr;</span>
                    </a>

                    <a href="/netsuke/docs/rules-and-targets/" class="block p-6 bg-white rounded-xl border border-stone shadow-sm hover:shadow-paper hover:border-vermillion transition-all group">
                        <div class="w-10 h-10 rounded-lg bg-vermillion/10 text-vermillion flex items-center justify-center text-lg mb-4 group-hover:scale-110 transition-transform">
                            <span class="iconify" data-icon="carbon:center-circle" aria-hidden="true"></span>
                        </div>
                        <h3 class="font-bold text-charcoal mb-2">Rules &amp; Targets</h3>
                        <p class="text-sm text-charcoal-mid mb-4">Learn how to define custom rules and manage visibility across packages.</p>
                        <span class="text-vermillion text-sm font-medium">Explore rules &rarr;</span>
                    </a>

                    <a href="/netsuke/examples/" class="block p-6 bg-white rounded-xl border border-stone shadow-sm hover:shadow-paper hover:border-matcha transition-all group">
                        <div class="w-10 h-10 rounded-lg bg-matcha/10 text-matcha flex items-center justify-center text-lg mb-4 group-hover:scale-110 transition-transform">
                            <span class="iconify" data-icon="carbon:code" aria-hidden="true"></span>
                        </div>
                        <h3 class="font-bold text-charcoal mb-2">Examples Hub</h3>
                        <p class="text-sm text-charcoal-mid mb-4">See real-world examples including C++ projects, website builds, and more.</p>
                        <span class="text-matcha text-sm font-medium">View examples &rarr;</span>
                    </a>
                </div>
            </section>

            <!-- Help Footer -->
{% endraw %}{{ docsnav.docs_footer('getting-started') }}{% raw %}

        </main>
    </div>
    <script defer src="/netsuke/assets/vendor/minisearch.js"></script>
    <script defer src="/netsuke/assets/js/doc-search.js"></script>
{% endraw %}
{% endblock %}
