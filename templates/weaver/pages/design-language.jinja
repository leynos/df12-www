{% from '_icons.jinja' import icon %}
{#
  The Weaver design-system reference.

  This page keeps its own shell rather than extending doc_page.jinja, and
  that is deliberate: its sidebar is a table of contents for the document
  itself, not the site navigation, so sharing the layout would mean
  overriding the one part of it that matters. It shares the vocabulary
  instead - the same nav-link macro, so the current item picks up the same
  treatment as everywhere else - and it carries the same mobile-drawer
  hooks.
#}
{% import '_chrome.jinja' as chrome %}<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weaver Design Language</title>
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/weaver/assets/fonts/playfair-display-latin-wght-normal.woff2">
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href="/weaver/assets/fonts/ibm-plex-sans-latin-wght-normal.woff2">

    <link rel="stylesheet" href="/weaver/assets/styles/weaver.css">
</head>

  <body class="bg-base-100 relative overflow-x-hidden">
    <!-- Texture Overlay for Washi Paper feel -->
    <div class="texture-overlay fixed w-full h-full"></div>
    <div class="flex flex-col lg:flex-row min-h-screen relative z-20">
      <!-- Sidebar Navigation -->
      <aside id="sidebar"
        class="w-full lg:w-64 bg-base-100 border-r-2 border-base-content/20 shrink-0 lg:fixed h-auto lg:h-full z-30">
        <div class="p-8 border-b-2 border-base-content/20" data-mobile-nav-header>
          <h1
            class="font-serif text-3xl font-bold tracking-tight text-base-content">
            WEAVER</h1>
          <p class="font-mono text-xs mt-2 text-base-content/88">DESIGN SYSTEM
          </p>
        </div>
        <nav class="p-6 space-y-2">
          {%- set here = '#overview' -%}
          {{ chrome.nav_link('#overview', '01', 'Overview', here) }}
          {{ chrome.nav_link('#foundations', '02', 'Foundations', here) }}
          {{ chrome.nav_link('#typography', '03', 'Typography', here) }}
          {{ chrome.nav_link('#motifs', '04', 'Motifs & Symbols', here) }}
          {{ chrome.nav_link('#illustrations', '05', 'Illustrations', here) }}
          {{ chrome.nav_link('#components', '06', 'Components', here) }}
        </nav>
      </aside><!-- Main Content Area -->
      <main class="flex-1 lg:ml-64 grid-bg min-h-screen">
        <!-- Hero Section -->
        <section id="overview"
          class="relative p-8 lg:p-16 border-b border-base-content/20">
          <div class="masthead-frame mx-auto">
            <div
              class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12">
              <div id="icyur">
                <div
                  class="masthead-eyebrow mb-6">
                  <span
                    class="font-mono text-xs tracking-widest uppercase text-base-content">Design
                    Philosophy</span></div>
                <h2
                  class="font-serif text-5xl lg:text-7xl text-base-content mb-6 leading-tight">
                </h2>
                <h1 id="ihkga" draggable="false"
                  class="font-serif text-6xl md:text-7xl lg:text-8xl font-bold leading-none text-base-content gjs-selected">
                  Techno<br id="imh53" draggable="true"><span id="ipbse"
                    draggable="true"
                    class="italic text-accent-ink font-light">Artisanal</span><br
                    id="ivx1g" draggable="true">Fusion</h1>
                <p
                  class="max-w-xl text-lg text-base-content/80 leading-relaxed font-light">
                  Weaver bridges the gap between artificial intelligence and
                  human craftsmanship. Our visual language combines the
                  precision of engineering blueprints with the organic fluidity
                  of Edo-era woodblock prints.
                </p>
              </div><!-- Hero Illustration Placeholder -->
              <div
                class="mt-8 md:mt-0 relative w-full md:w-1/3 h-64 border-2 border-base-content p-2 bg-white/40">
                <div
                  class="w-full h-full relative overflow-hidden bg-base-100">
                  <img
                    src="/weaver/assets/design-language/hero-illustration.png"
                    alt="Japanese woodblock style illustration of a mechanical loom weaving blue digital threads into a red fabric pattern, technical drawing style, blueprint lines, indigo and vermilion colors, minimalist"
                    class="w-full h-full object-cover opacity-90 mix-blend-multiply">
                  <!-- Decorative technical marks -->
                  <div
                    class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-base-content">
                  </div>
                  <div
                    class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-base-content">
                  </div>
                  <div
                    class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-base-content">
                  </div>
                  <div
                    class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-base-content">
                  </div><!-- Hanko Stamp -->
                  <div
                    class="absolute bottom-4 right-4 w-12 h-12 border-2 border-accent rounded-xs flex items-center justify-center stamp-rotate opacity-90">
                    <span
                      class="text-accent-ink font-serif font-bold text-xs writing-vertical-rl">WEAVER</span>
                  </div>
                </div><!-- Measurement lines -->
                <div
                  class="absolute -right-6 top-0 h-full w-4 border-l border-base-content/40 flex flex-col justify-between py-2">
                  <span class="block w-2 h-px bg-primary"></span><span
                    class="block w-2 h-px bg-primary"></span></div>
                <div
                  class="absolute -bottom-6 left-0 w-full h-4 border-t border-base-content/40 flex justify-between px-2">
                  <span class="block h-2 w-px bg-primary"></span><span
                    class="block h-2 w-px bg-primary"></span></div>
              </div>
            </div><!-- Key Principles Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
              <div class="border-t-2 border-base-content pt-4"><span
                  class="font-mono text-xs text-accent-ink mb-2 block">01</span>
                <h3 class="font-serif text-xl mb-3 text-base-content">Crafted
                  Intelligence</h3>
                <p class="text-sm text-base-content/88 leading-relaxed">AI is
                  not magic; it is a tool of intricate craft. We visualize code
                  as thread — tangible, woven, and structural.</p>
              </div>
              <div class="border-t-2 border-base-content pt-4"><span
                  class="font-mono text-xs text-accent-ink mb-2 block">02</span>
                <h3 class="font-serif text-xl mb-3 text-base-content">Blueprint
                  Precision</h3>
                <p class="text-sm text-base-content/88 leading-relaxed">Every
                  element aligns to a grid. Use measurement marks, leader lines,
                  and annotations to convey technical accuracy.</p>
              </div>
              <div class="border-t-2 border-base-content pt-4"><span
                  class="font-mono text-xs text-accent-ink mb-2 block">03</span>
                <h3 class="font-serif text-xl mb-3 text-base-content">Organic
                  Flow</h3>
                <p class="text-sm text-base-content/88 leading-relaxed">Balance
                  rigidity with fluid lines inspired by water and fabric. Use
                  Seigaiha waves to represent data streams.</p>
              </div>
            </div>
          </div>
        </section><!-- Colour Palette Section -->
        <section id="foundations"
          class="p-8 lg:p-16 border-b border-base-content/20 bg-white/30">
          <div class="max-w-5xl mx-auto">
            <div class="flex items-center mb-10"><span
                class="h-px w-12 bg-primary mr-4"></span>
              <h2 class="font-serif text-3xl text-base-content">Colour Palette
              </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <!-- Primary Indigo -->
              <div class="group">
                <div
                  class="h-40 bg-primary w-full rounded-xs shadow-xs relative overflow-hidden group-hover:shadow-md transition-all">
                </div>
                <div
                  class="mt-3 flex justify-between items-start font-mono text-xs">
                  <div><strong
                      class="block text-base-content text-sm font-sans mb-1">Foundational
                      Indigo</strong><span
                      class="block text-base-content/82">Primary / Text /
                      Stroke</span></div>
                  <div class="text-right"><span
                      class="block text-base-content">#193C6E</span><span
                      class="block text-base-content/82">PMS 281 C</span></div>
                </div>
              </div><!-- Sumi Ink -->
              <div class="group">
                <div
                  class="h-40 bg-ink-deep w-full rounded-xs shadow-xs relative overflow-hidden group-hover:shadow-md transition-all">
                </div>
                <div
                  class="mt-3 flex justify-between items-start font-mono text-xs">
                  <div><strong
                      class="block text-base-content text-sm font-sans mb-1">Sumi
                      Ink</strong><span
                      class="block text-base-content/82">Primary Text /
                      Linework</span></div>
                  <div class="text-right"><span
                      class="block text-base-content">#0F172A</span><span
                      class="block text-base-content/82">Deep Contrast</span>
                  </div>
                </div>
              </div><!-- Vermilion -->
              <div class="group">
                <div
                  class="h-40 bg-accent w-full rounded-xs shadow-xs relative overflow-hidden group-hover:shadow-md transition-all">
                </div>
                <div
                  class="mt-3 flex justify-between items-start font-mono text-xs">
                  <div><strong
                      class="block text-base-content text-sm font-sans mb-1">Active
                      Vermilion</strong><span
                      class="block text-base-content/82">Action / Highlight /
                      Seals</span></div>
                  <div class="text-right"><span
                      class="block text-base-content">#E8502B</span><span
                      class="block text-base-content/82">PMS 172 C</span></div>
                </div>
              </div><!-- Washi Cream -->
              <div class="group">
                <div
                  class="h-40 bg-base-100 border border-base-content/20 w-full rounded-xs shadow-xs relative overflow-hidden group-hover:shadow-md transition-all">
                  <div
                    class="absolute inset-0 opacity-30 bg-[url('/weaver/assets/textures/cream-paper.png')]">
                  </div>
                </div>
                <div
                  class="mt-3 flex justify-between items-start font-mono text-xs">
                  <div><strong
                      class="block text-base-content text-sm font-sans mb-1">Aged
                      Washi</strong><span
                      class="block text-base-content/82">Background /
                      Surface</span></div>
                  <div class="text-right"><span
                      class="block text-base-content">#F3EFD9</span><span
                      class="block text-base-content/82">Warm Cream</span>
                  </div>
                </div>
              </div>
            </div>
            <div
              class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-6">
              <!-- Secondary Blue -->
              <div class="group">
                <div
                  class="h-40 bg-ink-muted w-full rounded-xs shadow-xs relative overflow-hidden group-hover:shadow-md transition-all">
                </div>
                <div
                  class="mt-3 flex justify-between items-start font-mono text-xs">
                  <div><strong
                      class="block text-base-content text-sm font-sans mb-1">Faded
                      Indigo</strong><span
                      class="block text-base-content/82">Secondary /
                      Illustration</span></div>
                  <div class="text-right"><span
                      class="block text-base-content">#4A6FA5</span><span
                      class="block text-base-content/82">PMS 646 C</span></div>
                </div>
              </div>
            </div><!-- Usage Ratio Bar -->
            <div class="mt-12">
              <p
                class="font-mono text-xs text-base-content/82 mb-2 uppercase tracking-wide">
                Usage Ratio</p>
              <div
                class="h-4 w-full flex rounded-xs overflow-hidden border border-base-content/20">
                <div class="w-[55%] bg-base-100"></div>
                <div class="w-[25%] bg-primary"></div>
                <div class="w-[10%] bg-ink-deep"></div>
                <div class="w-[10%] bg-accent"></div>
              </div>
            </div>
          </div>
        </section><!-- Typography Section -->
        <section id="typography"
          class="p-8 lg:p-16 border-b border-base-content/20">
          <div class="max-w-5xl mx-auto">
            <div class="flex items-center mb-10"><span
                class="h-px w-12 bg-primary mr-4"></span>
              <h2 class="font-serif text-3xl text-base-content">Typography</h2>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
              <!-- Headings -->
              <div
                class="relative p-8 border border-base-content/30 bg-white/40">
                <div
                  class="absolute top-0 left-0 bg-primary text-base-100 px-2 py-1 font-mono text-xs">
                  SERIF</div>
                <h3 class="font-serif text-6xl text-base-content mb-4">Aa</h3>
                <p class="font-serif text-4xl text-base-content mb-2">Playfair
                  Display</p>
                <p class="text-base-content/88 mb-8 font-serif italic">For hero
                  headers and brand emphasis.</p>
                <div
                  class="space-y-4 border-t border-dashed border-base-content/30 pt-6">
                  <div><span
                      class="font-mono text-xs text-base-content/78 block mb-1">H1
                      / Bold / 64px</span>
                    <p class="font-serif text-4xl font-bold text-base-content">
                      The Art of Code</p>
                  </div>
                  <div><span
                      class="font-mono text-xs text-base-content/78 block mb-1">H2
                      / Semibold / 48px</span>
                    <p
                      class="font-serif text-3xl font-semibold text-base-content">
                      Patterns &amp; Logic</p>
                  </div>
                </div>
              </div><!-- Body & UI -->
              <div
                class="relative p-8 border border-base-content/30 bg-white/40">
                <div
                  class="absolute top-0 left-0 bg-primary text-base-100 px-2 py-1 font-mono text-xs">
                  SANS &amp; MONO</div>
                <h3 class="font-sans text-6xl text-base-content mb-4">Aa</h3>
                <p class="font-sans text-4xl text-base-content mb-2">IBM Plex
                  Sans</p>
                <p class="text-base-content/88 mb-8">For interface,
                  documentation, and body text.</p>
                <div
                  class="space-y-4 border-t border-dashed border-base-content/30 pt-6">
                  <div><span
                      class="font-mono text-xs text-base-content/78 block mb-1">Body
                      / Regular / 16px</span>
                    <p class="font-sans text-base text-base-content">The quick
                      brown fox jumps over the lazy dog. Efficiency is the soul
                      of this machine.</p>
                  </div>
                  <div><span
                      class="font-mono text-xs text-base-content/78 block mb-1">Code
                      / Mono / 14px</span>
                    <p
                      class="font-mono text-sm text-base-content bg-primary/5 p-2 rounded-sm">
                      function weave(thread) { return pattern; }</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section><!-- Motifs Section -->
        <section id="motifs"
          class="p-8 lg:p-16 border-b border-base-content/20 bg-white/30">
          <div class="max-w-5xl mx-auto">
            <div class="flex items-center mb-10"><span
                class="h-px w-12 bg-primary mr-4"></span>
              <h2 class="font-serif text-3xl text-base-content">Motifs &amp;
                Symbolism</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              <!-- Motif 1 -->
              <div
                class="bg-base-100 border border-base-content p-6 relative group hover:-translate-y-1 transition-transform duration-300">
                <div
                  class="h-40 w-full mb-6 flex items-center justify-center overflow-hidden border border-base-content/10 bg-white">
                  <img
                    src="/weaver/assets/design-language/component-illustration.png"
                    alt="Seigaiha wave pattern illustration, indigo blue lines on cream background, traditional Japanese style, minimalist vector"
                    class="w-full h-full object-cover opacity-80"></div>
                <h3 class="font-serif text-xl text-base-content mb-2">Seigaiha
                  Waves</h3>
                <p class="text-sm text-base-content/88 mb-4">Represents
                  continuous data streams, flow, and resilience. Use for
                  backgrounds or connecting elements.</p>
                <div class="absolute bottom-4 right-4 text-accent-ink">{{ icon('water') }}</div>
              </div><!-- Motif 2 -->
              <div
                class="bg-base-100 border border-base-content p-6 relative group hover:-translate-y-1 transition-transform duration-300">
                <div
                  class="h-40 w-full mb-6 flex items-center justify-center overflow-hidden border border-base-content/10 bg-white">
                  <img
                    src="/weaver/assets/design-language/motif-illustration.png"
                    alt="Red thread knot illustration, mizuhiki style, simple line art, cream background, vector graphic"
                    class="w-full h-full object-cover opacity-80"></div>
                <h3 class="font-serif text-xl text-base-content mb-2">Musubi
                  (Knots)</h3>
                <p class="text-sm text-base-content/88 mb-4">Symbolizes
                  connection, logic gates, and secure functions. Use for points
                  of interaction or conclusion.</p>
                <div class="absolute bottom-4 right-4 text-accent-ink">{{ icon('link') }}</div>
              </div><!-- Motif 3 -->
              <div
                class="bg-base-100 border border-base-content p-6 relative group hover:-translate-y-1 transition-transform duration-300">
                <div
                  class="h-40 w-full mb-6 flex items-center justify-center overflow-hidden border border-base-content/10 bg-white">
                  <img
                    src="/weaver/assets/design-language/pattern-illustration.png"
                    alt="Japanese hanko stamp seal, red ink on cream paper, square shape with kanji characters inside, textured edges"
                    class="w-full h-full object-cover opacity-80"></div>
                <h3 class="font-serif text-xl text-base-content mb-2">Hanko
                  Seals</h3>
                <p class="text-sm text-base-content/88 mb-4">Marks of approval,
                  authorship, and completion. Always placed bottom-right. Use
                  sparingly.</p>
                <div class="absolute bottom-4 right-4 text-accent-ink">{{ icon('stamp') }}</div>
              </div>
            </div>
          </div>
        </section><!-- Illustrations & Grid System -->
        <section id="illustrations" class="p-8 lg:p-16">
          <div class="max-w-5xl mx-auto">
            <div class="flex items-center mb-10"><span
                class="h-px w-12 bg-primary mr-4"></span>
              <h2 class="font-serif text-3xl text-base-content">Grid &amp;
                Annotations</h2>
            </div>
            <div
              class="bg-white border-2 border-base-content p-1 relative shadow-lg">
              <!-- Blueprint container -->
              <div
                class="bg-base-100 border border-base-content p-8 relative overflow-hidden min-h-[500px]">
                <!-- Grid Background -->
                <div id="i1qtsc" class="absolute inset-0 z-0"></div>
                <!-- Main Illustration Content -->
                <div
                  class="relative z-10 flex flex-col items-center justify-center h-full">
                  <div class="w-full max-w-2xl relative">
                    <!-- Diagram -->
                    <div
                      class="bg-white/80 border border-base-content p-6 shadow-xs backdrop-blur-sm relative mb-8">
                      <div
                        class="flex justify-between items-center border-b border-base-content/20 pb-2 mb-4">
                        <span
                          class="font-mono text-xs text-base-content font-bold">FN:
                          PROCESS_DATA</span>
                        <div class="flex gap-1">
                          <div
                            class="w-2 h-2 rounded-full border border-base-content">
                          </div>
                          <div class="w-2 h-2 rounded-full bg-primary">
                          </div>
                        </div>
                      </div>
                      <div
                        class="font-mono text-sm text-base-content space-y-2">
                        <div class="flex"><span
                            class="w-8 text-base-content/75 select-none">01</span><span
                            class="text-accent-ink">fn</span> <span
                            class="text-base-content">&nbsp;analyze_pattern</span>(input:
                          <span class="text-code-name">Stream</span>) {
                        </div>
                        <div class="flex"><span
                            class="w-8 text-base-content/75 select-none">02</span><span
                            class="text-base-content/82">&nbsp; // Detect
                            structure</span></div>
                        <div class="flex"><span
                            class="w-8 text-base-content/75 select-none">03</span><span
                            class="text-accent-ink">&nbsp;
                            let</span>&nbsp;structure = weave::parse(input);
                        </div>
                        <div class="flex"><span
                            class="w-8 text-base-content/75 select-none">04</span><span
                            class="text-accent-ink">&nbsp;
                            return</span>&nbsp;structure.optimize();
                        </div>
                        <div class="flex"><span
                            class="w-8 text-base-content/75 select-none">05</span>
                          }
                        </div>
                      </div><!-- Annotation Lines -->
                      <div class="absolute -right-24 top-12 flex items-center">
                        <div class="w-20 h-px bg-primary"></div>
                        <div class="w-2 h-2 bg-primary rounded-full">
                        </div><span
                          class="ml-2 font-mono text-xs text-base-content bg-base-100 px-1 border border-base-content">Function
                          Signature</span>
                      </div>
                      <div
                        class="absolute -left-24 bottom-8 flex items-center flex-row-reverse">
                        <div class="w-20 h-px bg-primary"></div>
                        <div class="w-2 h-2 bg-primary rounded-full">
                        </div><span
                          class="mr-2 font-mono text-xs text-base-content bg-base-100 px-1 border border-base-content">Logic
                          Block</span>
                      </div>
                    </div><!-- Connecting Threads -->
                    <div
