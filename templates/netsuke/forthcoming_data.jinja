{#
  The href of a preview, or of one of its sections.

  An unknown preview or an unlisted section calls an undefined function,
  which fails the build rather than publishing a link to nowhere.
#}
{% macro href(key, section=none) -%}
{%- set found = namespace(entry=none) -%}
{%- for p in previews if p.key == key %}{% set found.entry = p %}{% endfor -%}
{%- if found.entry is none %}{{ raise_unknown_preview(key) }}{% endif -%}
{%- if section and section not in (found.entry.sections | map(attribute='id') | list) %}{{ raise_unknown_preview_section(key ~ '#' ~ section) }}{% endif -%}
/netsuke/forthcoming/{{ key }}/{% if section %}#{{ section }}{% endif %}
{%- endmacro %}

{#- The chip text naming how near a preview is. -#}
{% macro target_label(entry) -%}
{%- if entry.target %}Preview targeted at {{ entry.target }}{% else %}Proposed &middot; no release named{% endif -%}
{%- endmacro %}

{#- The status chip: a primary dot for a named release, a muted one otherwise. -#}
{% macro chip(entry) -%}
<span class="hm-chip"><span class="w-2 h-2 rounded-full {{ 'bg-primary' if entry.target else 'bg-base-300' }} mr-1.5"></span> {{ target_label(entry) }}</span>
{%- endmacro %}

{#
  The preview sidebar: every preview, with the current one's sections
  nested beneath it, then the current page's sources.
#}
{% macro sidebar(key) -%}
{%- set links = [{'href': '/netsuke/forthcoming/', 'label': 'All previews'}] -%}
{%- set ns = namespace(sources=[]) -%}
{%- for p in previews -%}
    {%- set _ = links.append({'href': '/netsuke/forthcoming/' ~ p.key ~ '/', 'label': p.short, 'active': p.key == key}) -%}
    {%- if p.key == key -%}
        {%- set ns.sources = p.sources -%}
        {%- for s in p.sections %}{% set _ = links.append({'href': '#' ~ s.id, 'label': s.label, 'sub': true}) %}{% endfor -%}
    {%- endif -%}
{%- endfor -%}
{%- if not ns.sources %}{{ raise_unknown_preview(key) }}{% endif -%}
{{ docsnav.sidebar(sections=[
    {'title': 'Forthcoming', 'links': links},
    {'title': 'Sources', 'links': ns.sources},
], search=false, nav_label='Preview pages') }}
{%- endmacro %}

{#
  The page header: breadcrumb, kicker, release chip, title, and the lede
  passed as the call body.
#}
{% macro header(key) -%}
{%- set found = namespace(entry=none) -%}
{%- for p in previews if p.key == key %}{% set found.entry = p %}{% endfor -%}
{%- if found.entry is none %}{{ raise_unknown_preview(key) }}{% endif -%}
            {{ chrome.breadcrumb([{'href': '/netsuke/forthcoming/', 'label': 'Forthcoming'}, {'label': found.entry.short}]) }}

            <!-- Page Header -->
            <div class="mb-12 border-b border-stone-light pb-8">
                <div class="flex items-center flex-wrap gap-3 mb-4">
                    {{ ui.kicker('Forthcoming capability', dot='bg-primary') }}
                    {{ chip(found.entry) }}
                    <span class="hm-chip"><span class="w-2 h-2 rounded-full bg-warning mr-1.5"></span> {{ found.entry.stage }}</span>
                </div>
                <h1 class="font-serif text-4xl lg:text-5xl font-bold text-base-content mb-6">{{ found.entry.title }}</h1>
                <p class="text-xl text-charcoal-mid font-light leading-relaxed max-w-3xl">
                    {{ caller() }}
                </p>
            </div>
{%- endmacro %}

{#- Previous and next previews in list order; the ends lead back to the hub. -#}
{% macro footer(key) -%}
{%- set ns = namespace(prev=none, next=none) -%}
{%- for p in previews -%}
    {%- if p.key == key -%}
        {%- if not loop.first %}{% set ns.prev = previews[loop.index0 - 1] %}{% endif -%}
        {%- if not loop.last %}{% set ns.next = previews[loop.index0 + 1] %}{% endif -%}
    {%- endif -%}
{%- endfor -%}
{{ docsnav.footer_nav(
    {'kicker': 'Previous preview', 'label': ns.prev.short, 'href': '/netsuke/forthcoming/' ~ ns.prev.key ~ '/'} if ns.prev
        else {'kicker': 'Back', 'label': 'Forthcoming capabilities', 'href': '/netsuke/forthcoming/'},
    {'kicker': 'Next preview', 'label': ns.next.short, 'href': '/netsuke/forthcoming/' ~ ns.next.key ~ '/'} if ns.next
        else {'kicker': 'Back', 'label': 'Forthcoming capabilities', 'href': '/netsuke/forthcoming/'}
) }}
{%- endmacro %}

{#- The hub's card grid. -#}
{% macro cards() -%}
            <div class="grid md:grid-cols-2 gap-8">
                {%- for p in previews %}
                <a href="/netsuke/forthcoming/{{ p.key }}/" class="hm-card hm-card--interactive p-8 block h-full group">
                    <div class="flex items-center justify-between gap-4 mb-6">
                        <div class="w-12 h-12 shrink-0 rounded-lg {{ p.tile }} text-white flex items-center justify-center text-xl">
                            <span class="iconify" data-icon="{{ p.icon }}" aria-hidden="true"></span>
                        </div>
                        {{ chip(p) }}
                    </div>
                    <h2 class="font-serif text-2xl font-bold text-base-content mb-3 group-hover:text-primary transition-colors">{{ p.title }}</h2>
                    <p class="text-charcoal-mid text-sm leading-relaxed mb-6">{{ p.summary | safe }}</p>
                    <span class="inline-flex items-center text-sm font-bold text-primary">Read the preview <span class="iconify ml-2" data-icon="carbon:arrow-right" aria-hidden="true"></span></span>
                </a>
                {%- endfor %}
            </div>
{%- endmacro %}

{#-
  A compact index of every preview, for the docs and guides hubs: one row
  per preview with its icon, title, and release chip.
-#}
{% macro index_list() -%}
                <ul class="grid md:grid-cols-2 gap-3">
                    {%- for p in previews %}
                    <li class="min-w-0">
                        <a href="/netsuke/forthcoming/{{ p.key }}/" class="group flex items-center gap-3 p-4 h-full bg-white rounded-xl border border-base-300 shadow-xs hover:shadow-paper hover:border-primary transition-all">
                            <span class="w-9 h-9 shrink-0 rounded-lg bg-primary/10 text-primary flex items-center justify-center" aria-hidden="true"><span class="iconify" data-icon="{{ p.icon }}"></span></span>
                            <span class="min-w-0 flex-1">
                                <span class="block font-bold text-base-content text-sm group-hover:text-primary transition-colors">{{ p.title }}</span>
                                <span class="block text-xs text-charcoal-mid mt-0.5">{{ target_label(p) }}</span>
                            </span>
                        </a>
                    </li>
                    {%- endfor %}
                </ul>
{%- endmacro %}
