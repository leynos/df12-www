{% extends "doc_page.jinja" %}
{% import "examples_data.jinja" as exdata %}
{% set active_nav = 'examples' %}
{% block page_title %}Examples Hub - Netsuke Build System{% endblock %}
{% block content %}
{% raw %}
    <!-- Main Content Area -->
    <main id="main-content" class="flex-grow pt-24 pb-20 site-container w-full">

        <!-- Header Section -->
        <header class="text-center max-w-3xl mx-auto mb-16">
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-boxwood text-charcoal-mid text-xs font-semibold uppercase tracking-wider border border-stone mb-6">
                Community &amp; Official
            </div>
            <h1 class="font-serif text-5xl lg:text-6xl font-bold text-charcoal mb-6">Examples Hub</h1>
            <p class="text-xl text-charcoal-mid font-light leading-relaxed">
                Explore small, concrete Netsuke manifests. Each example shows one part of the language clearly enough to steal without regret.
            </p>
        </header>

        <!-- Featured Example (Hero Card) -->
        <section id="featured-example" class="mb-20">
            <div class="hm-card hm-card--interactive overflow-hidden grid lg:grid-cols-2 group">
                <div class="p-8 lg:p-12 flex flex-col justify-center hm-card--accent">
                    <div class="flex items-center space-x-3 mb-6">
                        <span class="hm-chip">
                            C / C++
                        </span>
                        <span class="hm-chip">
                            Beginner
                        </span>
                    </div>
                    <h2 class="font-serif text-3xl font-bold text-charcoal mb-4">Basic C Application</h2>
                    <p class="text-charcoal-mid mb-8 leading-relaxed">
                        A small C build expressed in plain YAML. Reuse one compile rule, link two object files, and let Netsuke translate the graph for Ninja.
                    </p>
                    <div class="flex flex-wrap gap-4 mt-auto">
                        <a href="/netsuke/examples/basic-c-application/" class="hm-button hm-button--primary inline-flex items-center px-6 py-3">
                            View Example <span  class="iconify ml-2" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </a>
                        <a href="https://github.com/leynos/netsuke/blob/main/examples/basic_c.yml" class="hm-button hm-button--ghost inline-flex items-center px-6 py-3">
                            <span  class="iconify mr-2" data-icon="carbon:logo-github" aria-hidden="true"></span> Open in GitHub
                        </a>
                    </div>
                </div>
                <div class="bg-charcoal p-6 lg:p-8 flex items-center overflow-hidden relative">
                    <!-- Decorative blurred circles -->
                    <div class="absolute top-0 right-0 -mr-10 -mt-10 w-40 h-40 bg-vermillion/20 rounded-full blur-3xl"></div>
                    <div class="absolute bottom-0 left-0 -ml-10 -mb-10 w-40 h-40 bg-indigo/20 rounded-full blur-3xl"></div>

                    <div class="w-full relative z-10">
                        <div class="flex justify-between items-center mb-2 text-xs font-mono text-stone-light/60 px-2">
                            <span>Netsukefile</span>
                            <span>basic-c/</span>
                        </div>
                        <div class="code-preview p-4 text-sm border border-white/10 shadow-2xl rounded-lg">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
netsuke_version: "1.0.0"

rules:
  - name: "compile"
    command: "gcc -c {{ ins }} -o {{ outs }}"

targets:
  - name: "main.o"
    rule: "compile"
    sources: "src/main.c"

  - name: "app"
    command: "gcc {{ ins }} -o {{ outs }}"
    sources: ["main.o", "utils.o"]
{% endraw %}{% endhighlight %}{% raw %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Filter Bar -->
        <section id="filters" class="hm-filter-shell mb-10 sticky top-20 z-40 py-4 -mx-4 px-4 sm:mx-0 sm:px-0">
            <div class="hm-filter-shell__row flex flex-col sm:flex-row justify-between items-center gap-4 max-w-7xl mx-auto">
                <div class="flex items-center space-x-2 overflow-x-auto w-full sm:w-auto pb-2 sm:pb-0 no-scrollbar">
{% endraw %}
{{ exdata.filter_buttons() }}
{% raw %}
                </div>

                <div
                    class="relative w-full sm:w-64"
                    data-doc-search-root
                    data-doc-search-index="/netsuke/assets/search/examples-search.json"
                >
                    <label for="example-search" class="visually-hidden">Search examples</label>
                    <span  class="iconify absolute left-3 top-2.5 text-stone text-sm" data-icon="carbon:search" aria-hidden="true"></span>
                    <input
                        id="example-search"
                        type="text"
                        placeholder="Search examples..."
                        class="search-input w-full pl-9 pr-4 py-1.5 bg-white border border-stone rounded-md text-sm text-charcoal placeholder-stone focus:border-indigo focus:ring-1 focus:ring-indigo transition-colors"
                        data-doc-search-input
                        aria-label="Search the examples"
                        role="combobox"
                        aria-autocomplete="list"
                        aria-controls="example-search-results"
                        aria-expanded="false"
                    >
                    <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-doc-search-panel>
                        <div class="overflow-hidden rounded-xl border border-stone bg-white shadow-paper-lg">
                            <ul id="example-search-results" class="max-h-96 overflow-y-auto divide-y divide-stone-light" data-doc-search-results role="listbox"></ul>
                            <p class="border-t border-stone-light bg-boxwood-pale px-4 py-3 text-xs text-charcoal-light" data-doc-search-meta>
                                Type at least 2 characters to search the examples.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Examples Grid -->
        <section id="examples-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
{% endraw %}
{% for ex in exdata.examples %}
{{ exdata.card(ex) }}
{% endfor %}
{% raw %}
        </section>

        <!-- Contributing Callout -->
        <section class="bg-indigo rounded-2xl p-8 lg:p-12 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-72 h-72 bg-black/20 rounded-full blur-3xl"></div>

            <div class="relative z-10 grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2 class="font-serif text-3xl font-bold mb-4">Have an example to share?</h2>
                    <p class="text-indigo-100 mb-8 max-w-md text-lg">
                        The best way to learn Netsuke is by seeing it in action. If you've built something interesting, contribute it to our examples repository.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="mailto:netsuke@df12.studio" class="inline-flex items-center px-6 py-3 bg-white text-indigo rounded-md font-bold shadow-sm hover:bg-stone-light transition-colors">
                            Submit Example
                        </a>
                        <a href="/netsuke/guides/writing-examples/" class="inline-flex items-center px-6 py-3 bg-indigo-light border border-white/20 text-white rounded-md font-bold hover:bg-indigo-light/80 transition-colors">
                            Read Contribution Guide
                        </a>
                    </div>
                </div>
                <div class="hidden lg:block">
                    <div class="bg-charcoal rounded-lg p-6 font-mono text-sm text-stone border border-white/10 shadow-2xl">
                        <div class="flex items-center space-x-2 mb-4 border-b border-white/10 pb-4">
                            <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                            <div class="w-3 h-3 rounded-full bg-amber"></div>
                            <div class="w-3 h-3 rounded-full bg-matcha"></div>
                            <span class="text-xs text-stone-light/50 ml-2">bash</span>
                        </div>
                        <div class="space-y-2">
                            <div><span class="text-matcha">&#10145;</span> <span class="text-indigo-light">~</span> git clone https://github.com/leynos/netsuke.git</div>
                            <div><span class="text-matcha">&#10145;</span> <span class="text-indigo-light">~</span> cd netsuke/examples</div>
                            <div><span class="text-matcha">&#10145;</span> <span class="text-indigo-light">~/netsuke/examples</span> mkdir my-project</div>
                            <div class="text-stone-light/60 italic">Add a `Netsukefile`, keep the graph small, then submit the example.</div>
                            <div><span class="text-matcha">&#10145;</span> <span class="text-indigo-light">~/netsuke/examples</span> <span class="animate-pulse">_</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </main>
    <script defer src="/netsuke/assets/vendor/minisearch.js"></script>
    <script defer src="/netsuke/assets/js/doc-search.js"></script>
    <script defer src="/netsuke/assets/js/examples-hub.js"></script>
{% endraw %}
{% endblock %}
