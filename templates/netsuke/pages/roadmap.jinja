] %}

{% macro track_card(track) -%}
{%- set p = namespace(entry=none) -%}
{%- for e in fc.previews if e.key == track.preview %}{% set p.entry = e %}{% endfor -%}
                        <div class="bg-white rounded-xl border border-base-300 shadow-xs overflow-hidden">
                            <div class="p-6 border-b border-stone-light flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
                                <div class="min-w-0">
                                    <h4 class="font-serif text-xl font-bold text-base-content mb-1">{{ track.title | safe }}</h4>
                                    <p class="text-sm text-charcoal-mid">{{ track.blurb | safe }}</p>
                                </div>
                                {%- if p.entry %}
                                <span class="shrink-0">{{ fc.chip(p.entry) }}</span>
                                {%- else %}
                                <span class="hm-chip shrink-0"><span class="w-2 h-2 rounded-full {{ track.dot }} mr-1.5"></span> {{ track.chip }}</span>
                                {%- endif %}
                            </div>
                            <ul class="p-6 grid md:grid-cols-2 gap-x-8 gap-y-2 text-sm text-charcoal-mid list-none">
                                {%- for item in track['items'] %}
                                {%- set key = item.preview | default(track.preview) %}
                                <li class="flex items-start min-w-0">
                                    {%- if item.done %}
                                    <span class="iconify shrink-0 text-success mt-1 mr-2 text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span><span class="visually-hidden">Done: </span>
                                    {%- else %}
                                    <span class="iconify shrink-0 text-base-300 mt-1 mr-2 text-xs" data-icon="carbon:circle-dash" aria-hidden="true"></span><span class="visually-hidden">To do: </span>
                                    {%- endif %}
                                    <span class="min-w-0">
                                        {%- if item.section %}<a href="{{ fc.href(key, item.section) }}" class="hm-link">{{ item.text | safe }}</a>{% else %}{{ item.text | safe }}{% endif %}
                                        {%- if item.task %} <a href="{{ item.task[1] }}" class="text-xs font-mono text-charcoal-light hover:text-accent whitespace-nowrap" aria-label="Upstream roadmap step {{ item.task[0] }}">[{{ item.task[0] }}]</a>{% endif -%}
                                    </span>
                                </li>
                                {%- endfor %}
                            </ul>
                            <div class="px-6 pb-5 flex flex-wrap gap-x-6 gap-y-2 text-xs">
                                {%- if p.entry %}
                                <a href="{{ fc.href(p.entry.key) }}" class="font-bold text-primary inline-flex items-center">Read the {{ p.entry.short }} preview <span class="iconify ml-1" data-icon="carbon:arrow-right" aria-hidden="true"></span></a>
                                {%- endif %}
                                <a href="{{ track.source }}" class="text-charcoal-mid hover:text-accent inline-flex items-center">Upstream plan <span class="iconify ml-1" data-icon="carbon:launch" aria-hidden="true"></span></a>
                            </div>
                        </div>
{%- endmacro %}

{% block content %}

    <!-- Main Content Area -->
    <main id="main-content" class="grow pt-24 pb-20 site-container w-full">

        <!-- Header Section -->
        {% call chrome.page_header('Current version v' ~ netsuke_version, 'Roadmap', hero=true, dot='bg-warning') %}
            v{{ netsuke_version }} is a useful preview for early adopters, not a declaration that Netsuke is finished.
            This page tracks what shipped, what is honestly still rough, and the order of the work ahead.
        {% endcall %}

        <div class="grid lg:grid-cols-12 gap-12">

            <!-- Left Column: Roadmap Content -->
            <div class="lg:col-span-8 space-y-16 min-w-0">

                <!-- Shipped -->
                <section id="shipped">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-success/10 text-success flex items-center justify-center mr-4">
                            <span class="iconify" data-icon="carbon:checkmark-outline" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-base-content">Shipped in v{{ netsuke_version }}</h2>
                    </div>
                    <p class="text-charcoal-mid mb-6 max-w-3xl">
                        The core build-system compiler is implemented and packaged for Linux, macOS, and Windows.
                        The public beta releases so far cover the following; items marked <span class="hm-chip hm-chip--inline hm-chip--success">beta4</span> are new in this release.
                    </p>
                    <div class="grid md:grid-cols-2 gap-4">
                        {%- for group in shipped %}
                        <div class="bg-white p-5 rounded-xl border border-base-300 shadow-xs min-w-0">
                            <h3 class="font-bold text-base-content text-sm mb-2">{{ group.title | safe }}</h3>
                            <ul class="space-y-1.5 text-sm text-charcoal-mid">
                                {%- for item in group['items'] %}
                                <li class="flex items-start"><span class="iconify shrink-0 text-success mt-1 mr-2 text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span> <span>{{ item.text | safe }}{% if item.new %} <span class="hm-chip hm-chip--inline hm-chip--success">beta4</span>{% endif %}</span></li>
                                {%- endfor %}
                            </ul>
                        </div>
                        {%- endfor %}
                    </div>
                </section>

                <!-- Upgrading -->
                <section id="upgrading">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-accent/10 text-accent flex items-center justify-center mr-4">
                            <span class="iconify" data-icon="carbon:migrate" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-base-content">Upgrading from beta3</h2>
                    </div>
                    <p class="text-charcoal-mid mb-6 max-w-3xl">
                        Four changes in v{{ netsuke_version }} can alter what an existing manifest does. Each one closes a way for a
                        checkout or a project file to widen what a build may reach; the
                        <a href="https://github.com/leynos/netsuke/blob/main/docs/v0-1-0-migration-guide.md" class="hm-link">migration guide</a>
                        has the detail.
                    </p>
                    <div class="bg-white rounded-xl border border-base-300 shadow-xs hm-rows">
                        <div class="p-5 flex items-start">
                            <span class="iconify text-accent mt-1 mr-3 shrink-0" data-icon="carbon:search" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid"><code>which</code> and <code>command_available</code> no longer search the workspace when <code>PATH</code> has no match. A manifest that deliberately runs an executable from its own checkout must now say so with <code>cwd_mode="workspace-recursive"</code>; see the <a href="/netsuke/docs/standard-library/" class="hm-link">standard library</a>.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-accent mt-1 mr-3 shrink-0" data-icon="carbon:network-3" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">A project&rsquo;s <code>.netsuke.toml</code> can narrow the network policy but no longer widen it: its allowed schemes and hosts are ignored unless the operator trusts project fetch policy. See the <a href="/netsuke/docs/security/" class="hm-link">security model</a>.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-accent mt-1 mr-3 shrink-0" data-icon="carbon:document" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid"><code>contents</code>, <code>linecount</code>, <code>hash</code>, and <code>digest</code> read at most 8 MiB by default, refuse a symlink unless the call passes <code>follow_symlinks=true</code>, and refuse anything that is not a regular file.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-accent mt-1 mr-3 shrink-0" data-icon="carbon:script" aria-hidden="true"></span>
{% raw %}                            <p class="text-sm text-charcoal-mid">In <code>script:</code> recipes, <code>$in</code> and <code>$out</code> are now ordinary shell variables. Use <code>{{ ins }}</code> and <code>{{ outs }}</code> for a target&rsquo;s paths.</p>
{% endraw %}                        </div>
                    </div>
                    <p class="text-xs text-charcoal-mid mt-4 max-w-3xl">Building from a source checkout on Linux now also needs the <code>mold</code> linker; <a href="/netsuke/install/" class="hm-link">Install</a> has the details. Registry installs and packages are unaffected.</p>
                </section>

                <!-- Known limitations -->
                <section id="limitations">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-warning/10 text-warning flex items-center justify-center mr-4">
                            <span class="iconify" data-icon="carbon:warning-alt" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-base-content">Known limitations</h2>
                    </div>
                    <p class="text-charcoal-mid mb-6 max-w-3xl">
                        The compiler pipeline and ordinary local-build workflow are substantial; the command-line interface,
                        configuration vocabulary, and advanced recipe model remain pre-stable. Pin the Netsuke version in
                        automation and expect some command names, flags, diagnostic schemas, and manifest details to change before 1.0.
                        The following limitations apply to v{{ netsuke_version }}.
                    </p>
                    <div class="bg-white rounded-xl border border-base-300 shadow-xs hm-rows">
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:terminal" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">Recipes remain shell strings: Unix scripts use <code>/bin/sh -e</code>, Windows legacy recipes use Windows PowerShell by default, and the Windows Bash compatibility route is an explicit opt-in. Values templated into a recipe are not quoted for you. Argv-safe commands and recipe environment mappings are designed but not implemented; see the <a href="{{ fc.href('structured-commands') }}" class="hm-link">structured commands preview</a>.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:bare-metal-server" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">A manifest cannot yet ask which operating system or architecture it is on without reading environment variables; a stable host descriptor is <a href="{{ fc.href('system-facts') }}" class="hm-link">sketched for v0.1.1</a>.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:flow-connection" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">Compiler-generated dependency imports, such as GCC depfiles, are planned but not yet part of the manifest model.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:document-multiple-01" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">A build is one Netsukefile: there are no includes or bundles yet, and reuse means Jinja macros within the file. <a href="{{ fc.href('modules') }}" class="hm-link">Reusable modules</a> are designed.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:json" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid"><code>--json</code> emits exactly one versioned result or diagnostic document per command, but the schema may still change before 1.0.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:accessibility" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">Accessibility still needs assistive-technology verification, and terminal rendering needs regression coverage.</p>
                        </div>
                        <div class="p-5 flex items-start">
                            <span class="iconify text-warning mt-1 mr-3 shrink-0" data-icon="carbon:color-palette" aria-hidden="true"></span>
                            <p class="text-sm text-charcoal-mid">Colour rendering is not implemented: <code>--color</code> affects mode selection but does not add coloured terminal text.</p>
                        </div>
                    </div>
                    <div class="mt-4 bg-accent/5 border border-accent/20 rounded-lg p-4 flex items-start">
                        <span class="iconify text-accent mt-0.5 mr-3 shrink-0" data-icon="carbon:security" aria-hidden="true"></span>
                        <p class="text-xs text-charcoal-mid">
                            A <code>Netsukefile</code> can execute commands and use impure template helpers. Treat it with the same care
                            as a <code>Makefile</code>: review untrusted manifests before running them. Netsuke quotes supported path
                            substitutions, but it is not a sandbox.
                        </p>
                    </div>
                </section>

                <!-- The road ahead -->
                <section id="road-ahead">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center mr-4">
                            <span class="iconify" data-icon="carbon:road" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-base-content">The road ahead</h2>
                    </div>
                    <p class="text-charcoal-mid mb-8 max-w-3xl">
                        Work after the first release is organized around a few near-term priorities and a set of larger capability tracks,
                        each validating one hypothesis. The upstream plans &mdash; the
                        <a href="https://github.com/leynos/netsuke/blob/main/docs/roadmap.md" class="hm-link">detailed roadmap</a>, the
                        <a href="https://github.com/leynos/netsuke/blob/main/docs/roadmap-composition.md" class="hm-link">composition roadmap</a>, and the
                        <a href="https://github.com/leynos/netsuke/blob/main/docs/roadmap-progressive-enhancement.md" class="hm-link">progressive-enhancement roadmap</a>
                        &mdash; track the task-level sequence; the bracketed numbers below link to the step that owns each item. Every
                        capability track has a <a href="/netsuke/forthcoming/" class="hm-link">preview page</a>, and every item on it
                        links to the section that explains it.
                    </p>

                    {%- for group_key, group_title, group_blurb in groups %}
                    <div class="mb-12">
                        <h3 class="font-serif text-lg font-bold text-base-content mb-1">{{ group_title }}</h3>
                        <p class="text-sm text-charcoal-mid mb-6">{{ group_blurb | safe }}</p>
                        <div class="space-y-6">
                            {%- for track in tracks if track.group == group_key %}
                            {{ track_card(track) }}
                            {%- endfor %}
                        </div>
                    </div>
                    {%- endfor %}
                </section>
            </div>

            <!-- Right Column: Sidebar -->
            <aside class="lg:col-span-4">
                <div class="sticky top-24 space-y-8">
                    <!-- Release card -->
                    <div class="bg-white rounded-xl border border-base-300 shadow-xs p-6">
                        <h3 class="font-serif text-lg font-bold text-base-content mb-4 flex items-center">
                            <span class="iconify text-success mr-2 text-sm" data-icon="carbon:tag" aria-hidden="true"></span> Current release
                        </h3>
                        <div class="space-y-3 text-sm">
                            <div class="flex justify-between gap-4"><span class="text-charcoal-mid">Version</span><span class="font-mono text-base-content">v{{ netsuke_version }}</span></div>
                            <div class="flex justify-between gap-4"><span class="text-charcoal-mid">Release date</span><span class="font-mono text-base-content text-right">{{ netsuke_release_date }}</span></div>
                            <div class="flex justify-between gap-4"><span class="text-charcoal-mid">Licence</span><span class="font-mono text-base-content">ISC</span></div>
                            <div class="flex justify-between gap-4"><span class="text-charcoal-mid">Rust (source builds)</span><span class="font-mono text-base-content text-right">{{ netsuke_rust_nightly }}</span></div>
                            <div class="flex justify-between gap-4"><span class="text-charcoal-mid">Crate</span><span class="font-mono text-base-content">netsuke-build</span></div>
                        </div>
                        <div class="mt-5 pt-4 border-t border-stone-light space-y-2">
                            <a href="https://github.com/leynos/netsuke/releases" class="block w-full py-2 px-4 bg-accent text-white text-center rounded text-sm font-bold hover:bg-vermillion-dim transition-colors">Release notes &amp; installers<br>(from {{ netsuke_release_date }})</a>
                            <a href="/netsuke/install/" class="block w-full py-2 px-4 bg-transparent border border-base-300 text-base-content text-center rounded text-sm font-bold hover:bg-base-100 transition-colors">Install Netsuke</a>
                        </div>
                    </div>

                    <!-- Command vocabulary preview -->
                    <div class="bg-base-content rounded-xl overflow-hidden">
                        <div class="bg-charcoal-mid/20 px-4 py-2 border-b border-white/10 text-xs font-mono text-stone-light">Canonical vocabulary (target state)</div>
                        <div class="p-5 font-mono text-xs text-stone-light space-y-1">
                            <div><span class="text-stone-light">Shipped:</span> <span class="text-success-text">build</span> · <span class="text-success-text">clean</span> · <span class="text-success-text">generate</span> · <span class="text-success-text">graph</span> · <span class="text-success-text">help targets</span></div>
                            <div><span class="text-stone-light">Planned:</span> <span class="text-warning-text">check</span> · <span class="text-warning-text">test</span> · <span class="text-warning-text">bundle fetch</span> · <span class="text-warning-text">context</span> · <span class="text-warning-text">skill-path</span> · <span class="text-warning-text">runs</span> · <span class="text-warning-text">profile</span> · <span class="text-warning-text">feedback</span></div>
                            <div class="pt-2 text-charcoal-light">--json · --no-input · --force · --dry-run</div>
                            <div class="text-charcoal-light">--limit · --cursor · --output · --deliver</div>
                        </div>
                        <div class="px-5 pb-4 text-xs text-charcoal-light">Green commands exist today; amber ones are planned. <code>check</code> arrives with the <a href="{{ fc.href('linter') }}" class="underline hover:text-stone-light">linter</a>, <code>test</code> with the <a href="{{ fc.href('testing-framework') }}" class="underline hover:text-stone-light">testing framework</a>, and <code>bundle fetch</code> with <a href="{{ fc.href('modules', 'external') }}" class="underline hover:text-stone-light">external bundles</a>. The full grammar is defined in the roadmap.</div>
                    </div>

                    <!-- Source links -->
                    <div class="bg-base-100 rounded-xl border border-base-300 p-6">
                        <h3 class="font-serif text-lg font-bold text-base-content mb-4">Follow the work</h3>
                        <ul class="space-y-3 text-sm">
                            <li><a href="https://github.com/leynos/netsuke/blob/main/docs/roadmap.md" class="text-charcoal-mid hover:text-accent transition-colors flex items-center"><span class="iconify mr-2 text-xs" data-icon="carbon:roadmap" aria-hidden="true"></span> Detailed roadmap (task level)</a></li>
                            <li><a href="https://github.com/leynos/netsuke/releases" class="text-charcoal-mid hover:text-accent transition-colors flex items-center"><span class="iconify mr-2 text-xs" data-icon="carbon:tag" aria-hidden="true"></span> Releases on GitHub</a></li>
                            <li><a href="https://github.com/leynos/netsuke/issues" class="text-charcoal-mid hover:text-accent transition-colors flex items-center"><span class="iconify mr-2 text-xs" data-icon="carbon:debug" aria-hidden="true"></span> Issue tracker</a></li>
                            <li><a href="/netsuke/forthcoming/" class="text-charcoal-mid hover:text-accent transition-colors flex items-center"><span class="iconify mr-2 text-xs" data-icon="carbon:idea" aria-hidden="true"></span> Forthcoming capability previews</a></li>
                            <li><a href="/netsuke/guides/contributing/" class="text-charcoal-mid hover:text-accent transition-colors flex items-center"><span class="iconify mr-2 text-xs" data-icon="carbon:collaborate" aria-hidden="true"></span> Contributing guide</a></li>
                        </ul>
                    </div>
                </div>
            </aside>
        </div>
    </main>

{% endblock %}
