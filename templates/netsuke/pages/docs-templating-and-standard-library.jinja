{% extends "doc_page.jinja" %}
{% set active_nav = 'docs' %}
{% block page_title %}Templating &amp; Standard Library - Netsuke Build System{% endblock %}
{% block extra_head %}
    <script src="https://cdn.plot.ly/plotly-3.1.1.min.js"></script>
    <style>

        .code-container {
            counter-reset: line;
        }
        .code-line::before {
            counter-increment: line;
            content: counter(line);
            display: inline-block;
            width: 1.5rem;
            margin-right: 1rem;
            text-align: right;
            color: #5C554D;
            opacity: 0.5;
            user-select: none;
        }

        .recipe-btn { color: #5C554D; }
        .recipe-btn:hover { background: rgba(255, 255, 255, 0.6); }
        .recipe-btn--active {
            color: #2B4162;
            background: rgba(43, 65, 98, 0.05);
            border: 1px solid rgba(43, 65, 98, 0.1);
        }

        .function-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(46, 42, 37, 0.1), 0 4px 6px -2px rgba(46, 42, 37, 0.05);
        }
    </style>
{% endblock %}
{% block content %}
{% raw %}
    <!-- Main Content Area with Sidebar -->
    <div class="site-container pt-16 flex-grow flex">

        <!-- Sidebar Navigation (Desktop) -->
        <aside id="sidebar" class="hidden lg:block w-64 flex-shrink-0 h-[calc(100vh-4rem)] sticky top-16 overflow-y-auto border-r border-stone-light pr-6 py-8">
            <!-- Search -->
            <div
                class="mb-8 relative"
                data-doc-search-root
                data-doc-search-index="/netsuke/assets/search/docs-search.json"
            >
                <span class="iconify absolute left-3 top-2.5 text-stone text-sm" data-icon="carbon:search" aria-hidden="true"></span>
                <input
                    type="text"
                    placeholder="Search docs..."
                    class="search-input w-full pl-9 pr-4 py-2 bg-white border border-stone rounded-md text-sm text-charcoal placeholder-stone focus:border-indigo transition-colors shadow-sm"
                    data-doc-search-input
                    aria-label="Search the documentation"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                >
                <div class="absolute right-3 top-2.5 text-xs text-stone font-mono">⌘K</div>
                <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-doc-search-panel>
                    <div class="overflow-hidden rounded-xl border border-stone bg-white shadow-paper-lg">
                        <ul class="max-h-96 overflow-y-auto divide-y divide-stone-light" data-doc-search-results role="listbox"></ul>
                        <p class="border-t border-stone-light bg-boxwood-pale px-4 py-3 text-xs text-charcoal-light" data-doc-search-meta>
                            Type at least 2 characters to search the docs.
                        </p>
                    </div>
                </div>
            </div>

            <nav class="space-y-8">
                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Introduction</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Documentation Hub</a></li>
                        <li><a href="/netsuke/docs/getting-started/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Getting Started</a></li>
                        <li><a href="/netsuke/install/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Installation</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Core Concepts</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/manifest-reference/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Manifest Reference</a></li>
                        <li><a href="/netsuke/docs/rules-and-targets/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Rules &amp; Targets</a></li>
                        <li><a href="#starlark-intro" class="sidebar-link sidebar-link--sub active block px-2 py-1.5 font-medium rounded-r-md transition-colors">Templating</a></li>
                        <li><a href="#stdlib-reference" class="sidebar-link sidebar-link--sub block px-2 py-1.5 hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Core Standard Library</a></li>
                        <li><a href="#stdlib-extended" class="sidebar-link sidebar-link--sub block px-2 py-1.5 hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Extended Library</a></li>
                        <li><a href="#patterns" class="sidebar-link sidebar-link--sub block px-2 py-1.5 hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Patterns</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Reference</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/cli-security-and-configuration/#cli" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">CLI Commands</a></li>
                        <li><a href="/netsuke/docs/cli-security-and-configuration/#configuration" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Configuration</a></li>
                        <li><a href="/netsuke/docs/cli-security-and-configuration/#security" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Security Model</a></li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main id="main-content" class="hm-docs-content flex-1 min-w-0 py-12 px-4 sm:px-6 lg:px-12">

            <!-- Breadcrumbs -->
            <nav class="flex items-center text-sm text-charcoal-light mb-8 font-mono">
                <a href="/netsuke/docs/" class="hover:text-vermillion transition-colors">Docs</a>
                <span class="mx-2 text-stone">/</span>
                <span class="text-charcoal font-medium">Templating &amp; StdLib</span>
            </nav>

            <!-- Page Header -->
            <div class="mb-12 border-b border-stone-light pb-8">
                <div class="flex items-center justify-between mb-4">
                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-boxwood text-charcoal-mid text-xs font-semibold uppercase tracking-wider border border-stone">
                        Core Concepts
                    </div>
                    <span class="text-charcoal-mid text-xs font-mono bg-white px-2 py-1 rounded border border-stone">Jinja helpers</span>
                </div>
                <h1 class="font-serif text-4xl lg:text-5xl font-bold text-charcoal mb-6">Templating &amp; Standard Library</h1>
                <p class="text-xl text-charcoal-mid font-light leading-relaxed max-w-3xl">
                    Netsuke uses MiniJinja inside YAML values. The structure stays as data; templating fills in strings, expands <code>foreach</code>, and gates entries with <code>when</code>.
                </p>
            </div>

            <!-- Introduction to templating -->
            <section id="starlark-intro" class="mb-16">
                <div class="grid lg:grid-cols-2 gap-12 items-start">
                    <div>
                        <h2 class="font-serif text-2xl font-bold text-charcoal mb-4">Why Jinja inside YAML?</h2>
                        <p class="text-charcoal-mid mb-6 leading-relaxed">
                            Netsuke validates YAML before rendering templates. That keeps the manifest legible, keeps the structure explicit, and still leaves room for loops, macros, and conditional expansion.
                        </p>
                        <ul class="space-y-4 mb-8">
                            <li class="flex items-start">
                                <div class="w-6 h-6 rounded-full bg-matcha/10 flex items-center justify-center mt-1 mr-3 shrink-0">
                                    <span class="iconify text-matcha text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span>
                                </div>
                                <span class="text-sm text-charcoal-mid"><strong class="text-charcoal">YAML first:</strong> Structure is checked before templating is allowed to render commands.</span>
                            </li>
                            <li class="flex items-start">
                                <div class="w-6 h-6 rounded-full bg-matcha/10 flex items-center justify-center mt-1 mr-3 shrink-0">
                                    <span class="iconify text-matcha text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span>
                                </div>
                                <span class="text-sm text-charcoal-mid"><strong class="text-charcoal">Controlled expansion:</strong> <code>foreach</code> and <code>when</code> handle structural repetition without turning the file into a programming language.</span>
                            </li>
                            <li class="flex items-start">
                                <div class="w-6 h-6 rounded-full bg-matcha/10 flex items-center justify-center mt-1 mr-3 shrink-0">
                                    <span class="iconify text-matcha text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span>
                                </div>
                                <span class="text-sm text-charcoal-mid"><strong class="text-charcoal">Reusable helpers:</strong> Macros, filters, and built-in functions cover common path and environment tasks.</span>
                            </li>
                        </ul>
                        <div class="bg-boxwood-pale p-5 rounded-lg border border-stone text-sm text-charcoal-mid">
                            <p class="font-bold text-charcoal mb-2"><span class="iconify mr-2 text-indigo" data-icon="carbon:book" aria-hidden="true"></span> Learn More</p>
                            The goal is not to hide the build graph. The goal is to keep repeated YAML short enough to tolerate.
                        </div>
                    </div>

                    <!-- Code Example Card -->
                    <div class="hm-faux-window bg-charcoal rounded-xl border border-charcoal-mid shadow-lg overflow-hidden">
                        <div class="hm-faux-window__titlebar bg-charcoal-mid/20 px-4 py-3 flex items-center justify-between border-b border-white/10">
                            <div class="flex space-x-2">
                                <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                                <div class="w-3 h-3 rounded-full bg-amber"></div>
                                <div class="w-3 h-3 rounded-full bg-matcha"></div>
                            </div>
                            <span class="text-xs font-mono text-stone-light">Netsukefile</span>
                            <div class="w-12"></div>
                        </div>
                        <div class="hm-faux-window__body p-6 font-mono text-sm overflow-x-auto text-stone-light code-container">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
macros:
  - signature: "obj_name(src)"
    body: |
      {{ src | basename | replace('.c', '.o') }}

targets:
  - foreach: glob('src/*.c')
    name: "build/{{ obj_name(item) }}"
    rule: "compile"
    sources: "{{ item }}"
{% endraw %}{% endhighlight %}{% raw %}
                        </div>
                    </div>
                </div>
            </section>

            <!-- Library Usage Stats Chart -->
            <section id="stats" class="mb-20 pt-8 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6">Standard Library Usage</h2>
                <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                    <div id="stdLibChart" class="h-[350px] w-full"></div>
                    <p class="text-xs text-center text-charcoal-light mt-4 font-mono">Illustrative relative frequency across example manifests in the Netsuke repository</p>
                </div>
            </section>

            <!-- Standard Library Reference -->
            <section id="stdlib-reference" class="mb-16">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="font-serif text-2xl font-bold text-charcoal">Standard Library Reference</h2>
                    <div class="flex space-x-2">
                        <span class="px-2 py-1 bg-white border border-stone rounded text-xs font-mono text-charcoal-mid cursor-pointer hover:border-indigo transition-colors">Core</span>
                        <span class="px-2 py-1 bg-transparent border border-transparent rounded text-xs font-mono text-charcoal-light cursor-pointer hover:text-charcoal transition-colors">Shell</span>
                        <span class="px-2 py-1 bg-transparent border border-transparent rounded text-xs font-mono text-charcoal-light cursor-pointer hover:text-charcoal transition-colors">Paths</span>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Function Card 1 -->
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">fetch()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Network</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Downloads content from a URL. HTTPS is the only allowed scheme by default; the <code>--fetch-*</code> CLI options widen or narrow the policy. Pass <code>cache=true</code> to cache the result in <code>.netsuke/fetch</code>. Marks the template as impure.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            fetch("https://example.com/data", cache=true)
                        </div>
                    </div>

                    <!-- Function Card 2 -->
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">command_available()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Discovery</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Returns <code>true</code> when an executable can be found on <code>PATH</code>, <code>false</code> otherwise. Accepts the same keyword arguments as <code>which</code>. Ideal in <code>when</code> conditions.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            when: command_available('pandoc')
                        </div>
                    </div>

                    <!-- Function Card 3 -->
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">with_suffix</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Path</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Replaces the file extension of a path. Accepts an optional count to replace multiple trailing extensions, and an optional separator (default <code>.</code>).</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ item | basename | with_suffix('.o') }}
                        </div>
                    </div>

                    <!-- Function Card 4 -->
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">env()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Data</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Reads one required environment variable. There is no default-value argument; a missing or non-Unicode value is an error.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            env("CC")
                        </div>
                    </div>

                    <!-- Function Card 5 -->
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">basename / dirname</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Path</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Pure path filters: <code>basename</code> returns the final path component; <code>dirname</code> returns the parent (or <code>.</code> when there is none).</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ 'reports/daily.csv' | basename }}
                        </div>
                    </div>

                    <!-- Function Card 6 -->
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">glob</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">File</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Finds workspace paths matching a pattern. Host-observing: results depend on workspace contents and platform. Use sparingly to maintain explicit dependencies.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            glob('src/*.c')
                        </div>
                    </div>
                </div>
            </section>

            <!-- Extended Standard Library -->
            <section id="stdlib-extended" class="mb-16 pt-8 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-3">Extended Standard Library</h2>
                <p class="text-charcoal-mid mb-8 max-w-3xl">
                    Beyond the core functions, Netsuke provides a rich set of filters and helpers covering time, file inspection, paths, collections, shell execution, and executable discovery.
                </p>

                <!-- Time Helpers -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:time" aria-hidden="true"></span> Time helpers
                </h3>
                <div class="grid md:grid-cols-2 gap-6 mb-10">
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">now()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Time</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Returns the current time as a timezone-aware object (defaults to UTC). Exposes <code>.iso8601</code>, <code>.unix_timestamp</code>, and <code>.offset</code>. Accepts an optional UTC offset string such as <code>'+02:00'</code> or <code>'Z'</code>.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ now().iso8601 }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">timedelta()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Time</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Creates a duration object for age comparisons and arithmetic. Accepts <code>weeks</code>, <code>days</code>, <code>hours</code>, <code>minutes</code>, <code>seconds</code>, <code>milliseconds</code>, <code>microseconds</code>, <code>nanoseconds</code>. Exposes <code>.iso8601</code>, <code>.seconds</code>, <code>.nanoseconds</code>.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            timedelta(days=7)
                        </div>
                    </div>
                </div>

                <!-- File Content Filters -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:document-view" aria-hidden="true"></span> File content filters
                </h3>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">contents</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">File</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Reads a file's content as a string. Accepts an optional encoding argument; <code>'utf-8'</code> (alias <code>'utf8'</code>) is currently the only supported encoding.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ "VERSION" | contents }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">size</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">File</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Returns the file size in bytes. Useful for gating large downloads or asserting build artefact bounds.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ path | size }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">linecount</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">File</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Counts the number of lines in a text file. Does not load the entire file into memory.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ "src/main.c" | linecount }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">hash</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">File</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Returns the full hex digest of a file. Supports <code>sha256</code> (default) and <code>sha512</code>; MD5 and SHA-1 need the <code>legacy-digests</code> build feature.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ path | hash('sha512') }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">digest</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">File</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Returns a truncated hex digest of a file. Accepts a length (default: <code>8</code>) and an algorithm (default: <code>sha256</code>). Useful for short cache-busting hashes in output filenames.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ path | digest(12, 'sha512') }}
                        </div>
                    </div>
                </div>

                <!-- Path Filters -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:folder" aria-hidden="true"></span> Path filters
                </h3>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">relative_to</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Path</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Makes an absolute path relative to a given base. <code>'/a/b/c' | relative_to('/a/b')</code> &rarr; <code>'c'</code>.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ path | relative_to(base_dir) }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">realpath</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Path</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Canonicalises a path, resolving all symlinks and relative components to an absolute path.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ item | realpath }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">expanduser</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Path</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Expands a leading <code>~</code> to the current user's home directory.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ "~/.config/app" | expanduser }}
                        </div>
                    </div>
                </div>

                <!-- Collection Filters -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:list" aria-hidden="true"></span> Collection filters
                </h3>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">uniq</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Collection</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Removes duplicate items from a list, preserving the original order of first occurrences.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            glob('**/*.h') | uniq
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">flatten</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Collection</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Flattens a nested list into a single flat list. <code>[[1], [2, 3]] | flatten</code> &rarr; <code>[1, 2, 3]</code>.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            source_groups | flatten
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">group_by</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Collection</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Groups a list of dicts or objects by the value of a named attribute, returning a dict of lists keyed by the grouped value.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            files | group_by('extension')
                        </div>
                    </div>
                </div>

                <!-- Command Filters (Impure) -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:terminal" aria-hidden="true"></span> Command filters
                    <span class="ml-3 px-2 py-0.5 rounded text-xs font-mono bg-amber/10 text-amber border border-amber/20">Impure</span>
                </h3>
                <p class="text-sm text-charcoal-mid mb-4 max-w-2xl">
                    These filters execute external processes at template evaluation time, making the template <em>impure</em> &mdash; its output depends on the environment, not just the manifest. Use judiciously.
                </p>
                <div class="grid md:grid-cols-2 gap-6 mb-10">
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">shell()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Command</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Pipes the input value as stdin to a shell command string. Capture mode (the default) returns the command's stdout. Pass <code>{'mode': 'tempfile'}</code> (also spelled <code>stream</code> or <code>streaming</code>) to write bounded output to a persisted temporary file; those modes return the file's path, not its contents.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ user_list | shell('grep admin') }}
                        </div>
                    </div>
                    <div class="function-card bg-white p-6 rounded-xl border border-stone transition-all duration-300 group cursor-pointer">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">grep()</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Command</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4">Runs the host <code>grep</code> executable over the input value. The <code>flags</code> argument is a sequence such as <code>['-i']</code>; availability and flag spelling are platform-dependent. Options share the same modes as <code>shell</code>.</p>
                        <div class="text-xs font-mono text-stone-light bg-charcoal p-3 rounded group-hover:bg-charcoal-mid transition-colors">
                            {{ log_lines | grep('ERROR', ['-i']) }}
                        </div>
                    </div>
                </div>

                <!-- Executable Discovery -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:search-locate" aria-hidden="true"></span> Executable discovery
                </h3>
                <div class="bg-white rounded-xl border border-stone shadow-sm overflow-hidden mb-10">
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-3">
                            <code class="text-indigo font-bold font-mono text-sm bg-indigo/5 px-2 py-1 rounded">which</code>
                            <span class="text-xs text-charcoal-light border border-stone px-1.5 rounded">Discovery</span>
                        </div>
                        <p class="text-sm text-charcoal-mid mb-4 max-w-2xl">
                            Resolves executables using the current <code>PATH</code> without marking the template impure.
                            Available as both a filter (<code>{{ 'clang++' | which }}</code>) and a function (<code>{{ which('clang++') }}</code>).
                        </p>
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <h4 class="font-bold text-charcoal text-xs uppercase tracking-wide mb-3">Keyword arguments</h4>
                                <div class="space-y-2 text-xs font-mono">
                                    <div class="flex items-start">
                                        <span class="text-indigo w-24 shrink-0">all</span>
                                        <span class="text-charcoal-mid">Return every match, ordered by <code>PATH</code> (default: <code>false</code>)</span>
                                    </div>
                                    <div class="flex items-start">
                                        <span class="text-indigo w-24 shrink-0">canonical</span>
                                        <span class="text-charcoal-mid">Resolve symlinks and deduplicate by canonical path (default: <code>false</code>)</span>
                                    </div>
                                    <div class="flex items-start">
                                        <span class="text-indigo w-24 shrink-0">fresh</span>
                                        <span class="text-charcoal-mid">Bypass the resolver cache for this lookup (default: <code>false</code>)</span>
                                    </div>
                                    <div class="flex items-start">
                                        <span class="text-indigo w-24 shrink-0">cwd_mode</span>
                                        <span class="text-charcoal-mid"><code>auto</code> | <code>always</code> | <code>never</code> &mdash; control whether empty <code>PATH</code> segments honour the working directory</span>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <h4 class="font-bold text-charcoal text-xs uppercase tracking-wide mb-3">Diagnostic codes</h4>
                                <div class="space-y-2 text-xs font-mono text-charcoal-mid">
                                    <div><code class="text-vermillion">netsuke::jinja::which::not_found</code> &mdash; executable not on PATH; includes a preview of the scanned PATH</div>
                                    <div class="mt-2"><code class="text-vermillion">netsuke::jinja::which::args</code> &mdash; unknown or invalid keyword argument</div>
                                </div>
                                <div class="mt-4 text-xs font-mono text-stone-light bg-charcoal p-3 rounded">
                                    {{ 'clang++' | which(all=true, canonical=true) }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filesystem Tests -->
                <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center">
                    <span class="iconify text-indigo mr-2" data-icon="carbon:checkmark-outline" aria-hidden="true"></span> Filesystem tests
                </h3>
                <p class="text-sm text-charcoal-mid mb-4 max-w-2xl">
                    Use Jinja's <code>is</code> keyword with these tests to gate targets conditionally.
                    Tests are host-observing; a missing path or non-string value yields <code>false</code>, and the symlink test does not follow links.
                </p>
                <div class="grid md:grid-cols-2 gap-4 mb-4">
                    <div class="bg-white p-4 rounded-lg border border-stone text-xs">
                        <div class="font-bold text-charcoal mb-2">Type tests</div>
                        <div class="space-y-1 font-mono text-charcoal-mid">
                            <div><code class="text-indigo">is file</code> &mdash; regular file</div>
                            <div><code class="text-indigo">is dir</code> &mdash; directory</div>
                            <div><code class="text-indigo">is symlink</code> &mdash; symbolic link</div>
                        </div>
                    </div>
                    <div class="bg-white p-4 rounded-lg border border-stone text-xs">
                        <div class="font-bold text-charcoal mb-2">Special-file tests <span class="text-charcoal-light font-normal">(always <code>false</code> off Unix)</span></div>
                        <div class="space-y-1 font-mono text-charcoal-mid">
                            <div><code class="text-indigo">is pipe</code> &mdash; named pipe</div>
                            <div><code class="text-indigo">is block_device</code> / <code class="text-indigo">is char_device</code></div>
                            <div><code class="text-indigo">is device</code> &mdash; either device kind</div>
                        </div>
                    </div>
                </div>
                <div class="bg-charcoal rounded-lg p-4 overflow-x-auto text-xs font-mono text-stone-light">
                    {% endraw %}{% highlight 'netsuke' %}{% raw %}
targets:
  - when: 'src/main.c' is file and command_available('clang')
    name: "build/main.o"
    rule: "compile"
{% endraw %}{% endhighlight %}{% raw %}
                </div>
            </section>

            <!-- Advanced Patterns -->
            <section id="patterns" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6">Common Patterns</h2>

                <div class="bg-boxwood-pale border border-stone rounded-xl overflow-hidden">
                    <div class="grid md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-stone">
                        <!-- Sidebar for patterns -->
                        <div class="md:col-span-4 p-6 bg-white/50">
                            <h3 class="font-bold text-charcoal mb-4 text-sm uppercase tracking-wide">Recipes</h3>
                            <ul class="space-y-2">
                                <li>
                                    <button type="button" class="recipe-btn recipe-btn--active w-full text-left px-3 py-2 text-sm font-medium rounded-md transition-colors" data-recipe-tab="cross-compilation" aria-selected="true">
                                        Cross-Compilation
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="recipe-btn w-full text-left px-3 py-2 text-sm font-medium rounded-md transition-colors" data-recipe-tab="test-suites" aria-selected="false">
                                        Test Suites
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="recipe-btn w-full text-left px-3 py-2 text-sm font-medium rounded-md transition-colors" data-recipe-tab="code-generation" aria-selected="false">
                                        Code Generation
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <!-- Content for patterns -->
                        <div class="md:col-span-8 p-8 bg-white" data-recipe-panel="cross-compilation">
                            <h4 class="font-serif text-xl font-bold text-charcoal mb-2">Platform-specific sources with `when`</h4>
                            <p class="text-sm text-charcoal-mid mb-6">
                                Use <code class="bg-stone-light/30 px-1 rounded text-xs">when</code> on repeated entries to include targets only when the current variables match the platform you want.
                            </p>

                            <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
targets:
  - when: target_os == 'linux'
    name: "sys/linux.o"
    rule: "compile"
    sources: "src/linux_utils.c"

  - when: target_os == 'macos'
    name: "sys/macos.o"
    rule: "compile"
    sources: "src/macos_utils.c"
{% endraw %}{% endhighlight %}{% raw %}
                            </div>

                            <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                                <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                                <p>Keep conditions coarse-grained. Avoid selecting on individual compiler versions unless absolutely necessary.</p>
                            </div>
                        </div>

                        <div class="md:col-span-8 p-8 bg-white hidden" data-recipe-panel="test-suites">
                            <h4 class="font-serif text-xl font-bold text-charcoal mb-2">Test runs with `actions` and `always`</h4>
                            <p class="text-sm text-charcoal-mid mb-6">
                                Put operator-run test suites in <code class="bg-stone-light/30 px-1 rounded text-xs">actions</code> so they stay outside the default graph, and mark report targets <code class="bg-stone-light/30 px-1 rounded text-xs">always</code> when they should rerun on every invocation.
                            </p>

                            <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
targets:
  - name: test-report.txt
    command: "./run-tests > {{ outs }}"
    sources: "app"
    always: true

actions:
  - name: test
    command: "./app --self-test"
{% endraw %}{% endhighlight %}{% raw %}
                            </div>

                            <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                                <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                                <p>Keep the build product and the test run distinct: the report target depends on the binary, so tests always run against the current build.</p>
                            </div>
                        </div>

                        <div class="md:col-span-8 p-8 bg-white hidden" data-recipe-panel="code-generation">
                            <h4 class="font-serif text-xl font-bold text-charcoal mb-2">Generated sources as first-class targets</h4>
                            <p class="text-sm text-charcoal-mid mb-6">
                                Model generated code as its own target and let downstream targets name it in <code class="bg-stone-light/30 px-1 rounded text-xs">sources</code>: the implicit dependency keeps generation ordered before compilation.
                            </p>

                            <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
rules:
  - name: protoc
    command: "protoc --c_out=gen {{ ins }}"

targets:
  - name: gen/messages.c
    rule: protoc
    sources: proto/messages.proto

  - name: messages.o
    rule: compile
    sources: gen/messages.c
{% endraw %}{% endhighlight %}{% raw %}
                            </div>

                            <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                                <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                                <p>List generated inputs explicitly rather than globbing them: templates expand before anything is built, so a glob over generated files sees an empty directory.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Help Footer -->
            <div class="mt-10 pt-10 border-t border-stone-light">
                <div class="flex justify-between items-center">
                    <a href="/netsuke/docs/rules-and-targets/" class="group flex items-center text-charcoal-mid hover:text-charcoal transition-colors">
                        <div class="w-8 h-8 rounded-full border border-stone flex items-center justify-center mr-3 group-hover:border-indigo group-hover:text-indigo transition-colors">
                            <span class="iconify text-xs" data-icon="carbon:arrow-left" aria-hidden="true"></span>
                        </div>
                        <div class="text-left">
                            <div class="text-xs text-charcoal-light uppercase tracking-wide">Previous</div>
                            <div class="font-medium text-sm">Rules &amp; Targets</div>
                        </div>
                    </a>

                    <a href="/netsuke/docs/cli-security-and-configuration/#cli" class="group flex items-center text-charcoal-mid hover:text-charcoal transition-colors">
                        <div class="text-right">
                            <div class="text-xs text-charcoal-light uppercase tracking-wide">Next</div>
                            <div class="font-medium text-sm">CLI Commands</div>
                        </div>
                        <div class="w-8 h-8 rounded-full border border-stone flex items-center justify-center ml-3 group-hover:border-indigo group-hover:text-indigo transition-colors">
                            <span class="iconify text-xs" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </div>
                    </a>
                </div>
            </div>

        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tabs = document.querySelectorAll('[data-recipe-tab]');
            const panels = document.querySelectorAll('[data-recipe-panel]');

            tabs.forEach((tab) => {
                tab.addEventListener('click', () => {
                    const key = tab.getAttribute('data-recipe-tab');
                    tabs.forEach((other) => {
                        const active = other === tab;
                        other.classList.toggle('recipe-btn--active', active);
                        other.setAttribute('aria-selected', String(active));
                    });
                    panels.forEach((panel) => {
                        panel.classList.toggle('hidden', panel.getAttribute('data-recipe-panel') !== key);
                    });
                });
            });
        });
    </script>
    <script defer src="/netsuke/assets/vendor/minisearch.js"></script>
    <script defer src="/netsuke/assets/js/doc-search.js"></script>
    <script>
        window.addEventListener('load', function() {
