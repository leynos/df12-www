{#
  What the system may decide on its own, and what it must hand to a person.
  This matrix is the page's thesis; keep the boundary literal.
#}
{% set decision_boundary = [
  {
    "activity": "Weighting and selecting between conflicting sources",
    "system": "Computes priority scores from quality, freshness, and reliability, and applies the weighting matrix.",
    "human": "Sets the weighting coefficients per series profile, and can inspect every rejected source.",
    "status": "available"
  },
  {
    "activity": "Estimating episode runtime",
    "system": "Produces a deterministic estimate and records the estimator metadata behind it.",
    "human": "Decides whether the estimate is close enough to commission the recording.",
    "status": "available"
  },
  {
    "activity": "Scoring a draft for accuracy",
    "system": "Returns per-claim findings with severity and remediation guidance.",
    "human": "Decides whether a finding is correct and what to do about it. A score is not a verdict.",
    "status": "in-progress"
  },
  {
    "activity": "Spending money on model calls",
    "system": "Reserves budget before a billable call, commits on success, and releases on failure.",
    "human": "Sets the per-episode budget and the tier of model each task may use.",
    "status": "in-progress"
  },
  {
    "activity": "Approving an episode for an audience",
    "system": "Surfaces findings, suspends the graph, and preserves state while the decision is pending.",
    "human": "Approves, requests changes, or redirects the run. This decision has no automated path.",
    "status": "planned"
  }
] %}

{#
  Failure behaviour. Fail-fast is a design commitment, so state what stops.
#}
{% set failure_modes = [
  {
    "trigger": "Malformed structured output from a model",
    "behaviour": "The run stops. Nothing partially parsed reaches the canonical episode.",
    "status": "available"
  },
  {
    "trigger": "Chapter-marker timing that does not match segment transitions",
    "behaviour": "Validation rejects the payload. Starts must be ordered, integer-only, and in PT#H#M#S form.",
    "status": "available"
  },
  {
    "trigger": "Optimistic-locking conflict on a profile or template",
    "behaviour": "The write is refused so a concurrent edit is never silently overwritten.",
    "status": "available"
  },
  {
    "trigger": "Repeated request with a matching idempotency key",
    "behaviour": "The stored response replays. The same key with a different canonical body returns 409 Conflict.",
    "status": "available"
  },
  {
    "trigger": "Per-episode budget exhausted",
    "behaviour": "The reservation is refused before the billable call is made.",
    "status": "in-progress"
  }
] %}
