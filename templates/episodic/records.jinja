{#
  Macros that render the shared record sets.

  Every one of these degrades to a readable ordered or description list with
  no CSS and no JavaScript. The visual treatment is layered on top of markup
  that already carries the meaning - a stage sequence is an `<ol>`, a contract
  is a `<dl>`, and a route table is a `<table>`.
#}
{% import "components.jinja" as ui %}

{#
  The production path. An ordered list, because the order is the content.
#}
{% macro stage_sequence(stages, headless=false) -%}
  <ol class="stage-sequence">
    {% for stage in stages %}
    <li class="stage" id="stage-{{ stage.key }}">
      <div class="stage__head">
        <span class="stage__number" aria-hidden="true">{{ stage.number }}</span>
        {% if headless %}
        <p class="stage__title">{{ stage.label }}</p>
        {% else %}
        <h3 class="stage__title">{{ stage.label }}</h3>
        {% endif %}
        {{ ui.status_badge(stage.status) }}
      </div>
      <p class="stage__summary">{{ ui.rich(stage.summary) }}</p>
      <dl class="stage__contract">
        <div><dt>In</dt><dd>{{ ui.rich(stage.input) }}</dd></div>
        <div><dt>Out</dt><dd>{{ ui.rich(stage.output) }}</dd></div>
        <div><dt>Owned by</dt><dd>{{ stage.actor }}</dd></div>
      </dl>
      {{ ui.evidence(stage.evidence) }}
    </li>
    {% endfor %}
  </ol>
{%- endmacro %}

{#
  The four-stage overview summary. Fewer records, more room per record.

  `variant` takes `stage-summary--path`, which lays the stages out as one
  sequence running left to right rather than as a block of cards. The
  ordering is the content: these are movements in a process, and four boxes
  in a square say nothing about which comes first. The element stays an `ol`
  either way, so the order survives without CSS.
#}
{% macro stage_summary(entries, variant='') -%}
  <ol class="stage-summary {{ variant }}">
    {% for entry in entries %}
    <li>
      <a class="stage-summary__card" href="{{ entry.href }}">
        <span class="stage-summary__number" aria-hidden="true">{{ entry.number }}</span>
        <span class="stage-summary__label">{{ entry.label }}</span>
        <span class="stage-summary__detail">{{ ui.rich(entry.detail) }}</span>
        {{ ui.status_badge(entry.status) }}
      </a>
    </li>
    {% endfor %}
  </ol>
{%- endmacro %}

{#
  Delivery state as a matrix of phases rather than a stack of rows.

  Each cell carries the completed and total task counts as text, because that
  is the claim. The bar beside them is a redundant reading of the same two
  numbers and is hidden from assistive technology: it makes the shape of
  delivery scannable across six phases at once, and says nothing the sentence
  does not already say.
#}
{% macro phase_matrix(phases) -%}
  <ol class="phase-matrix">
    {% for phase in phases %}
    <li class="phase-matrix__cell">
      <p class="phase-matrix__head">
        <span class="phase-matrix__number" aria-hidden="true">{{ "%02d" | format(phase.number | int) }}</span>
        <span class="phase-matrix__title">{{ phase.title }}</span>
      </p>
      {{ ui.status_badge(phase.state) }}
      <p class="phase-matrix__tally">{{ phase.done_count }} of {{ phase.total_count }} tasks</p>
      <span class="phase-matrix__bar" aria-hidden="true"
            style="--done: {{ (100 * phase.done_count / phase.total_count) | round | int if phase.total_count else 0 }}%"></span>
    </li>
    {% endfor %}
  </ol>
{%- endmacro %}

{#
  The evaluator catalogue. Purpose, mechanism, output shape, and evidence -
  the four things a reader needs to judge whether a score means anything.
#}
{% macro evaluator_catalogue(evaluators) -%}
  <div class="catalogue">
    {% for item in evaluators %}
    {% call ui.ledger_row(item.task, item.name, item.status, item.evidence, "evaluator-" ~ item.name | lower) %}
      <p class="catalogue__purpose">{{ ui.rich(item.purpose) }}</p>
      <dl class="catalogue__detail">
        <div><dt>Mechanism</dt><dd>{{ ui.rich(item.mechanism) }}</dd></div>
        <div><dt>Returns</dt><dd>{{ ui.rich(item.output) }}</dd></div>
      </dl>
    {% endcall %}
    {% endfor %}
  </div>
{%- endmacro %}

{#
  The component catalogue, driving both the narrow-screen list and the
  labels on the boundary diagram.
#}
{% macro component_catalogue(components) -%}
  <div class="catalogue">
    {% for item in components %}
    {% call ui.ledger_row("%02d" | format(loop.index), item.name, item.status, item.evidence, "component-" ~ item.key) %}
      <p class="catalogue__purpose">{{ ui.rich(item.responsibility) }}</p>
      <dl class="catalogue__detail">
        <div><dt>Adapter</dt><dd>{{ ui.rich(item.adapter) }}</dd></div>
        <div><dt>State</dt><dd>{{ ui.rich(item.state) }}</dd></div>
      </dl>
    {% endcall %}
    {% endfor %}
  </div>
{%- endmacro %}

{#
  The interface catalogue. `limits` is not optional: an interface page that
  lists only what works is a sales page.
#}
{% macro interface_catalogue(interfaces) -%}
  <div class="catalogue">
    {% for item in interfaces %}
    {% call ui.ledger_row("%02d" | format(loop.index), item.name, item.status, item.evidence, "interface-" ~ item.key) %}
      <dl class="catalogue__detail">
        <div><dt>Supports</dt><dd>{{ ui.rich(item.supports) }}</dd></div>
        <div><dt>Does not</dt><dd>{{ ui.rich(item.limits) }}</dd></div>
      </dl>
      <p><a class="text-link" href="{{ item.href }}">{{ item.name }} in detail</a></p>
    {% endcall %}
    {% endfor %}
  </div>
{%- endmacro %}

{#
  A two-column matrix of what the system decides against what a person
  decides. Rendered as a table because the pairing is the point.
#}
{% macro boundary_matrix(rows, id) -%}
  {{ ui.table_open("What the system decides, and what a person decides", id) }}
  <thead>
    <tr>
      <th scope="col">Activity</th>
      <th scope="col">The system</th>
      <th scope="col">A person</th>
      <th scope="col">Status</th>
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
    <tr>
      <th scope="row">{{ row.activity }}</th>
      <td>{{ ui.rich(row.system) }}</td>
      <td>{{ ui.rich(row.human) }}</td>
      <td>{{ ui.status_badge(row.status) }}</td>
    </tr>
    {% endfor %}
  </tbody>
  {{ ui.table_close() }}
{%- endmacro %}

{#
  Failure behaviour, as a description list. What triggers it, what happens.
#}
{% macro failure_list(rows) -%}
  <dl class="failure-list">
    {% for row in rows %}
    <div class="failure-list__item">
      <dt>
        <span class="failure-list__trigger">{{ row.trigger }}</span>
        {{ ui.status_badge(row.status) }}
      </dt>
      <dd>{{ ui.rich(row.behaviour) }}</dd>
    </div>
    {% endfor %}
  </dl>
{%- endmacro %}

{#
  The endpoint reference. Methods are ground truth read from the application
  route table, so they are rendered verbatim rather than described.
#}
{#
  The caption is the scroll region's accessible name, so it stays - but it
  carries the route count rather than repeating the heading two lines above
  it. One shared column geometry keeps the six tables reading as one
  reference surface instead of six unrelated artefacts.
#}
{% macro endpoint_table(group) -%}
  {{ ui.table_open(group.label ~ " endpoints", "endpoints-" ~ group.key, "visually-hidden") }}
  <colgroup>
    <col class="col-methods" />
    <col class="col-path" />
    <col class="col-purpose" />
  </colgroup>
  <thead>
    <tr>
      <th scope="col">Methods</th>
      <th scope="col">Path</th>
      <th scope="col">Purpose</th>
    </tr>
  </thead>
  <tbody>
    {% for route in group.routes %}
    <tr>
      <td class="record-table__methods">
        {% for method in route.methods %}<span class="method">{{ method }}</span>{% endfor %}
      </td>
      <th scope="row"><code>{{ route.path }}</code></th>
      <td>{{ ui.rich(route.purpose) }}</td>
    </tr>
    {% endfor %}
  </tbody>
  {{ ui.table_close() }}
{%- endmacro %}

{#
  A roadmap phase: its completion count in text, then its steps and tasks.
  Checkbox state is carried by a word and a glyph, never by colour.
#}
{% macro roadmap_task(task) -%}
  <li class="task" data-done="{{ 'yes' if task.done else 'no' }}">
    <span class="task__state">
      <span class="task__mark" aria-hidden="true">{{ '☑' if task.done else '☐' }}</span>
      <span class="visually-hidden">{{ 'Complete' if task.done else 'Not started' }}</span>
    </span>
    <span class="task__id" aria-hidden="true">{{ task.id if task.id else "" }}</span>
    <span class="task__title">{{ ui.rich(task.title) }}</span>
    {% if task.requires %}
    <span class="task__requires">Requires {{ task.requires | join(", ") }}</span>
    {% endif %}
    {% if task.completion_note %}
    <span class="task__note">Completed {{ task.completed_on }}. {{ ui.rich(task.completion_note) }}</span>
    {% endif %}
    {% if task.subtasks %}
    <ul class="task-list task-list--nested">
      {% for subtask in task.subtasks %}
      {{ roadmap_task(subtask) }}
      {% endfor %}
    </ul>
    {% endif %}
  </li>
{%- endmacro %}

{% macro roadmap_phase(phase) -%}
  <section class="phase" id="phase-{{ phase.number }}" aria-labelledby="phase-{{ phase.number }}-heading">
    <header class="phase__head">
      <h3 class="phase__title" id="phase-{{ phase.number }}-heading">
        <span class="phase__number" aria-hidden="true">{{ phase.number }}</span>
        {{ phase.title }}
      </h3>
      <p class="phase__count">
        {{ ui.status_badge(phase.state) }}
        <span class="phase__tally">{{ phase.done_count }} of {{ phase.total_count }} tasks complete</span>
      </p>
    </header>
    {% if phase.summary %}<p class="phase__summary">{{ ui.rich(phase.summary) }}</p>{% endif %}
    {% for step in phase.steps %}
    {# Not an exclusive accordion: closing one step to read another makes
       comparing two steps impossible and hides content from find-in-page. #}
    <details class="step">
      <summary>
        <span class="disclosure-marker" aria-hidden="true"></span>
        <span class="step__id" aria-hidden="true">{{ step.id }}</span>
        <span class="step__title">{{ step.title }}</span>
        <span class="step__tally">{{ step.done_count }}/{{ step.total_count }}</span>
      </summary>
      {% if step.summary %}<p class="step__summary">{{ ui.rich(step.summary) }}</p>{% endif %}
      <ul class="task-list">
        {% for task in step.tasks %}
        {{ roadmap_task(task) }}
        {% endfor %}
      </ul>
    </details>
    {% endfor %}
  </section>
{%- endmacro %}

{#
  The documents in one category, as a list. Extracted so the open and the
  disclosed arrangements render the same markup rather than two copies of it.
#}
{% macro doc_list(documents, source_base) -%}
  <ul class="doc-list">
    {% for document in documents %}
    <li>
      <a href="{{ source_base }}{{ document.path }}">{{ document.title }}</a>
      {% if document.summary %}<span class="doc-list__summary">{{ ui.rich(document.summary) }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
{%- endmacro %}

{#
  A documentation category with its documents.

  A long category is disclosed rather than printed in full. Two of the six
  hold two thirds of the set between them - thirty-six execution plans and
  sixteen decision records - and both are historical: an accepted decision
  record says what was decided, and an execution plan stops being current the
  moment its task lands. Printing them in full pushed the four categories a
  reader is usually looking for off the end of a very long page.

  The threshold is a count rather than a list of keys, so a category that
  grows past it is disclosed without anyone remembering to say so. The heading,
  the type, the audience, the count, and the blurb all stay outside the
  disclosure, so what is inside is knowable without opening it.
#}
{% macro doc_category(category, source_base, disclose_over=10) -%}
  {% set documents = category.documents %}
  {% set document_count = documents | length %}
  {% set document_label = "document" if document_count == 1 else "documents" %}
  <section class="doc-category" id="docs-{{ category.key }}" aria-labelledby="docs-{{ category.key }}-heading">
    <header class="doc-category__head">
      <h3 id="docs-{{ category.key }}-heading">{{ category.label }}</h3>
      <p class="doc-category__meta">
        <span class="doc-category__type">{{ category.type }}</span>
        <span class="doc-category__audience">For: {{ category.audience }}</span>
        <span class="doc-category__count">{{ document_count }} {{ document_label }}</span>
      </p>
      <p class="doc-category__blurb">{{ category.blurb }}</p>
    </header>
    {% if document_count > disclose_over %}
    <details class="doc-disclosure">
      <summary>
        <span class="disclosure-marker" aria-hidden="true"></span>
        <span class="doc-disclosure__label">All {{ document_count }} {{ document_label }}</span>
      </summary>
      {{ doc_list(documents, source_base) }}
    </details>
    {% else %}
    {{ doc_list(documents, source_base) }}
    {% endif %}
  </section>
{%- endmacro %}

{#
  Command groups. Each command is selectable text inside a scrollable block.
#}
{% macro command_groups_list(groups) -%}
  {% for group in groups %}
  <section class="command-group" aria-labelledby="commands-{{ loop.index }}">
    <h3 id="commands-{{ loop.index }}">{{ group.label }} {{ ui.status_badge(group.status) }}</h3>
    <dl class="command-list">
      {% for entry in group.commands %}
      <div class="command-list__item">
        <dt><code>{{ entry.command }}</code></dt>
        <dd>{{ ui.rich(entry.detail) }}</dd>
      </div>
      {% endfor %}
    </dl>
  </section>
  {% endfor %}
{%- endmacro %}

{#
  A three-column contract or ownership table.

  `fields` names the record keys to read, in column order, so one macro serves
  the runtime contract, the ownership split, and the chart value tables
  without reshaping the underlying records.
#}
{% macro contract_table(caption, id, rows, fields, headings) -%}
  {{ ui.table_open(caption, id) }}
  <thead>
    <tr>
      {% for heading in headings %}<th scope="col">{{ heading }}</th>{% endfor %}
    </tr>
  </thead>
  <tbody>
    {% for row in rows %}
    <tr>
      <th scope="row">{{ row[fields[0]] }}</th>
      {% for field in fields[1:] %}
      <td>{% if field == "value" %}<code>{{ row[field] }}</code>{% else %}{{ ui.rich(row[field]) }}{% endif %}</td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
  {{ ui.table_close() }}
{%- endmacro %}
