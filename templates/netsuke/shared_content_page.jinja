{% extends "doc_page.jinja" %}
{% block page_title %}{{ title }} - Netsuke{% endblock %}
{% block content %}
    <main id="main-content" class="grow w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-28 pb-20">
        <nav class="mb-8 text-sm font-mono text-charcoal-light" aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center list-none">
                {% if parent_link %}
                <li><a href="{{ parent_link.href }}" class="hover:text-vermillion">{{ parent_link.label }}</a></li>
                <li class="mx-2" aria-hidden="true">/</li>
                {% endif %}
                <li><a href="/netsuke/" class="hover:text-vermillion">Home</a></li>
                <li class="mx-2" aria-hidden="true">/</li>
                <li aria-current="page">{{ title }}</li>
            </ol>
        </nav>

        <div class="rounded-3xl border border-stone bg-white/80 p-6 sm:p-10 shadow-xs">
            <div class="inline-flex items-center rounded-full border border-stone bg-boxwood-light px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-indigo">{{ eyebrow or 'Legal' }}</div>
            <h1 class="mt-6 font-serif text-4xl font-bold tracking-tight">{{ title }}</h1>
            {% if summary %}
            <p class="mt-4 max-w-3xl text-lg leading-relaxed text-charcoal-mid">{{ summary }}</p>
            {% endif %}

            <article class="hm-prose mt-10 text-charcoal">
                {{ body_html | safe }}
            </article>
        </div>
    </main>
{% endblock %}
