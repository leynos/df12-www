                    {
                      "name": "plan_level",
                      "type": "",
                      "description": "Log level for <code>plan</code> events (intent to execute). Default DEBUG."
                    },
                    {
                      "name": "start_level",
                      "type": "",
                      "description": "Log level for <code>start</code> events (process spawned). Default INFO."
                    },
                    {
                      "name": "output_level",
                      "type": "",
                      "description": "Log level for <code>stdout</code>/<code>stderr</code> events. Default DEBUG."
                    },
                    {
                      "name": "exit_level",
                      "type": "",
                      "description": "Log level for <code>exit</code> events (process completed). Default INFO."
                    },
                    {
                      "name": "fail_fast_level",
                      "type": "",
                      "description": "Log level for <code>pipeline_fail_fast</code> events (a pipeline is being torn down because a non-final stage failed first). Default WARNING: unlike the other phases this reports an abnormal outcome, and it would otherwise fall through to the unhandled-phase default of DEBUG and be invisible in a normal configuration."
                    },
                    {
                      "name": "group_teardown_level",
                      "type": "",
                      "description": "Log level for <code>group_teardown</code> events (a teardown could not establish settlement). Default WARNING for the same reason as <code>fail_fast_level</code>: unlike the other phases this reports an abnormal outcome, and it would otherwise fall through to the unhandled-phase default of DEBUG and be invisible in a normal configuration."
                    },
                    {
                      "name": "stdio_error_level",
                      "type": "",
                      "description": "Log level for <code>stdio_error</code> events (a standard-stream boundary failed). Default WARNING, for the same reason as <code>fail_fast_level</code>: it reports a failure, and a record nobody retains is not a diagnostic."
                    }
                  ]
                }
              ]
            }
