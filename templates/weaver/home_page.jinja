{% extends "doc_page.jinja" %}

{% block page_title %}{{ homepage.title }}{% endblock %}

{% block content %}

            <!-- Hero Section -->
            <section id="hero" class="relative pt-16 pb-12 px-8 lg:px-16 lg:pt-24 lg:pb-20 border-b border-weaver-indigo/20 overflow-hidden">
                <!-- Background Decorative Elements -->
                <div class="absolute top-0 right-0 w-1/3 h-full border-l border-weaver-indigo/10 bg-white/20 pointer-events-none hidden lg:block"></div>
                <div class="absolute bottom-0 right-0 w-64 h-64 opacity-10 pointer-events-none">
                    <i class="fa-solid fa-layer-group text-9xl text-weaver-indigo"></i>
                </div>

                <div class="masthead-frame mx-auto relative z-10">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        <div>
                            <div class="masthead-eyebrow mb-8">
                                <span class="w-2 h-2 bg-weaver-vermilion rounded-full"></span>
                                <span class="font-mono text-xs tracking-widest uppercase text-weaver-indigo">Weaver CLI v0.1.0</span>
                            </div>

                            <h1 class="font-serif text-5xl lg:text-7xl font-bold text-weaver-indigo leading-none mb-6">
                                CLI tooling for <br>
                                <span class="text-weaver-vermilion italic font-light">code-aware</span> agents.
                            </h1>

                            <p class="font-sans text-lg text-weaver-indigo/80 leading-relaxed mb-8 max-w-lg font-light">
                                Weaver connects AI agents to a real codebase through concrete observe, act, and verify operations. The CLI stays thin, the daemon keeps context loaded, and Double-Lock plus Birdcage constrain the risky parts.
                            </p>

                            <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
                                <!-- CLI Install Command Box -->
                                <div class="relative group">
                                    <div class="absolute -inset-0.5 bg-weaver-vermilion rounded-xs blur-sm opacity-20 group-hover:opacity-40 transition duration-200"></div>
                                    <div class="relative flex items-center bg-weaver-dark text-weaver-cream font-mono text-sm px-6 py-4 rounded-xs border border-weaver-indigo shadow-lg">
                                        <span class="text-weaver-vermilion mr-3">$</span>
                                        <span class="mr-8">cargo install weaver</span>
                                        <button class="text-weaver-indigo/60 hover:text-white transition-colors" title="Copy to clipboard">
                                            <i class="fa-regular fa-copy"></i>
                                        </button>
                                    </div>
                                </div>
                                <a href="/weaver/install/" class="px-6 py-4 font-mono text-sm font-bold text-weaver-indigo border border-weaver-indigo hover:bg-weaver-indigo hover:text-weaver-cream transition-all uppercase tracking-wide">
                                    Quick Start <i class="fa-solid fa-arrow-right ml-2"></i>
                                </a>
                            </div>
                        </div>

                        <!-- Hero Graphic: Blueprint / Loom Metaphor -->
                        <div class="relative h-[400px] w-full border-2 border-weaver-indigo bg-weaver-cream p-4 hidden md:block shadow-[8px_8px_0px_0px_rgba(25,60,110,0.1)]">
                            <div class="absolute top-2 left-2 z-10 bg-weaver-cream text-[10px] font-mono text-weaver-indigo border border-weaver-indigo px-1">FIG 1.0: ARCHITECTURE</div>

                            <!-- Central Visualization -->
                            <div class="w-full h-full relative overflow-hidden bg-white/50 border-none">
                                <img
                                    src="/weaver/assets/home/home-hero-loom-architecture.png"
                                    alt="Illustrated loom fused with a software architecture diagram, showing indigo and vermilion threads moving through a daemon-like central hub with blueprint measurements and wave motifs."
                                    class="w-full h-full object-cover"
                                >
                            </div>

                            <!-- Technical Marks -->
                            <div class="absolute -left-3 top-1/2 w-2 h-2 bg-weaver-indigo"></div>
                            <div class="absolute -right-3 top-1/2 w-2 h-2 bg-weaver-indigo"></div>
                            <div class="absolute bottom-2 right-2 font-mono text-[10px] text-weaver-indigo/60">SCALE: 1:1</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Value Props Section -->
            <section id="features" class="py-20 px-8 lg:px-16 border-b border-weaver-indigo/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                        <!-- Prop 1: Composable -->
                        <div class="group relative p-8 border border-weaver-indigo/20 bg-weaver-cream hover:border-weaver-indigo transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                <i class="fa-solid fa-puzzle-piece text-6xl text-weaver-indigo"></i>
                            </div>
                            <div class="w-12 h-12 bg-weaver-indigo text-weaver-cream flex items-center justify-center mb-6 text-xl rounded-xs">
                                <i class="fa-solid fa-cubes-stacked"></i>
                            </div>
                            <h3 class="font-serif text-2xl text-weaver-indigo mb-3 group-hover:text-weaver-vermilion transition-colors">Composable</h3>
                            <p class="font-sans text-weaver-indigo/70 leading-relaxed mb-6">
                                Use one surface for structural queries, patch application, and diagnostics. The daemon streams JSONL to the CLI, which then forwards raw payloads or human-readable output as needed.
                            </p>
                            <a href="/weaver/how-it-works/#fusion" class="inline-flex items-center font-mono text-xs font-bold text-weaver-indigo uppercase tracking-wider group-hover:underline decoration-weaver-vermilion underline-offset-4">
                                Explore Fusion <i class="fa-solid fa-arrow-right ml-2 text-[10px]"></i>
                            </a>
                            <!-- Corner Accent -->
                            <div class="absolute bottom-0 start-0 w-0 h-0 border-b-[20px] border-r-[20px] border-b-weaver-vermilion border-r-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        </div>

                        <!-- Prop 2: Safe -->
                        <div class="group relative p-8 border border-weaver-indigo/20 bg-weaver-cream hover:border-weaver-indigo transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                <i class="fa-solid fa-shield-halved text-6xl text-weaver-indigo"></i>
                            </div>
                            <div class="w-12 h-12 bg-weaver-indigo text-weaver-cream flex items-center justify-center mb-6 text-xl rounded-xs">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                            <h3 class="font-serif text-2xl text-weaver-indigo mb-3 group-hover:text-weaver-vermilion transition-colors">Safe</h3>
                            <p class="font-sans text-weaver-indigo/70 leading-relaxed mb-6">
                                Block bad edits before they land. Double-Lock checks the change; Birdcage isolates untrusted tooling with seccomp-bpf and namespaces.
                            </p>
                            <a href="/weaver/safety/" class="inline-flex items-center font-mono text-xs font-bold text-weaver-indigo uppercase tracking-wider group-hover:underline decoration-weaver-vermilion underline-offset-4">
                                Security Model <i class="fa-solid fa-arrow-right ml-2 text-[10px]"></i>
                            </a>
                             <!-- Corner Accent -->
                             <div class="absolute bottom-0 start-0 w-0 h-0 border-b-[20px] border-r-[20px] border-b-weaver-vermilion border-r-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        </div>

                        <!-- Prop 3: Fast -->
                        <div class="group relative p-8 border border-weaver-indigo/20 bg-weaver-cream hover:border-weaver-indigo transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                <i class="fa-solid fa-bolt text-6xl text-weaver-indigo"></i>
                            </div>
                            <div class="w-12 h-12 bg-weaver-indigo text-weaver-cream flex items-center justify-center mb-6 text-xl rounded-xs">
                                <i class="fa-solid fa-microchip"></i>
                            </div>
                            <h3 class="font-serif text-2xl text-weaver-indigo mb-3 group-hover:text-weaver-vermilion transition-colors">Fast</h3>
                            <p class="font-sans text-weaver-indigo/70 leading-relaxed mb-6">
                                Keep state in a resident daemon instead of re-parsing on every call. Rust binaries stream JSONL over Unix domain sockets for low-friction automation.
                            </p>
                            <a href="/weaver/how-it-works/#daemon" class="inline-flex items-center font-mono text-xs font-bold text-weaver-indigo uppercase tracking-wider group-hover:underline decoration-weaver-vermilion underline-offset-4">
                                Daemon Specs <i class="fa-solid fa-arrow-right ml-2 text-[10px]"></i>
                            </a>
                             <!-- Corner Accent -->
                             <div class="absolute bottom-0 start-0 w-0 h-0 border-b-[20px] border-r-[20px] border-b-weaver-vermilion border-r-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Command Preview Section -->
            <section id="commands-preview" class="py-20 px-8 lg:px-16 border-b border-weaver-indigo/20 relative">
                <!-- Background Pattern -->
                <div class="absolute inset-0 opacity-5" style="background-image: url('/weaver/assets/textures/cubes.png');"></div>

                <div class="max-w-6xl mx-auto">
                    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
                        <div>
                            <span class="font-mono text-xs text-weaver-vermilion font-bold tracking-widest uppercase mb-2 block">Interface</span>
                            <h2 class="font-serif text-4xl text-weaver-indigo">Command Reference</h2>
                        </div>
                        <a href="/weaver/commands/" class="hidden md:inline-block font-mono text-sm text-weaver-indigo hover:text-weaver-vermilion transition-colors border-b border-weaver-indigo/30 pb-1">
                            View all commands ->
                        </a>
                    </div>

                    <div class="bg-weaver-dark rounded-xs shadow-2xl overflow-hidden border border-weaver-indigo">
                        <!-- Terminal Header -->
                        <div class="bg-black/40 px-4 py-2 flex items-center justify-between border-b border-white/10">
                            <div class="flex space-x-2">
                                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                            </div>
                            <div class="text-xs font-mono text-gray-500">weaver-cli — zsh — 80x24</div>
                        </div>

                        <!-- Terminal Body -->
                        <div class="p-6 font-mono text-sm md:text-base overflow-x-auto">
                            <!-- Command 1: observe get-definition -->
                            <div class="mb-6">
                                <div class="flex text-gray-400">
                                    <span class="text-weaver-vermilion mr-2">➜</span>
                                    <span class="mr-2">~</span>
                                    <span class="text-white">weaver observe get-definition --output json --uri file:///src/main.rs --position 10:5</span>
                                </div>
                                <div class="text-blue-300 mt-2 pl-4 border-l-2 border-blue-500/30">
                                    [{"uri":"file:///src/lib.rs","line":42,"column":17}]
                                </div>
                            </div>

                            <!-- Command 2: act apply-patch -->
                            <div class="mb-6">
                                <div class="flex text-gray-400">
                                    <span class="text-weaver-vermilion mr-2">➜</span>
                                    <span class="mr-2">~</span>
                                    <span class="text-white">weaver act apply-patch --output json &lt; fix.diff</span>
                                </div>
                                <div class="text-yellow-300 mt-2 pl-4 border-l-2 border-yellow-500/30">
                                    {"applied":true,"files":["src/lib.rs"]}
                                </div>
                            </div>

                            <!-- Cursor -->
                            <div class="flex text-gray-400">
                                <span class="text-weaver-vermilion mr-2">➜</span>
                                <span class="mr-2">~</span>
                                <span class="text-white">weaver verify diagnostics --output json --uri file:///src/lib.rs<span class="animate-pulse inline-block w-2.5 h-5 bg-gray-400 ml-1 align-middle"></span></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 text-center md:hidden">
                        <a href="/weaver/commands/" class="font-mono text-sm text-weaver-indigo font-bold border-b border-weaver-indigo pb-1">
                            View Full Documentation
                        </a>
                    </div>
                </div>
            </section>

            <!-- Technical Deep Dive / Sempai Section -->
            <section id="sempai" class="py-20 px-8 lg:px-16 border-b border-weaver-indigo/20 bg-white/60">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                        <div class="order-2 lg:order-1 relative">
                             <!-- Blueprint Illustration -->
                             <div class="figure-fullbleed border-2 border-weaver-indigo bg-weaver-cream p-6 relative shadow-[8px_8px_0px_0px_rgba(25,60,110,0.1)]">
                                <div class="figure-fullbleed-label absolute top-0 left-0 z-10 bg-weaver-indigo text-white px-2 py-1 font-mono text-xs">QUERY ENGINE</div>
                                <div class="figure-fullbleed-img h-64 border border-weaver-indigo/20 relative overflow-hidden">
                                    <img
                                        src="/weaver/assets/home/home-sempai-query-pipeline.png"
                                        alt="Illustrated left-to-right Sempai query pipeline showing code entering a circular parsing chamber and flowing as structured output toward an agent target."
                                        class="w-full h-full object-cover"
                                    >
                                </div>
                                <div class="figure-fullbleed-caption mt-4 flex justify-between font-mono text-[10px] text-weaver-indigo/60">
                                    <span>INPUT: RAW SOURCE</span>
                                    <span>OUTPUT: STRUCTURED JSONL</span>
                                </div>
                             </div>
                        </div>

                        <div class="order-1 lg:order-2">
                            <span class="font-mono text-xs text-weaver-vermilion font-bold tracking-widest uppercase mb-2 block">Query layer</span>
                            <h2 class="font-serif text-4xl text-weaver-indigo mb-6">Sempai Query Engine</h2>
                            <p class="font-sans text-lg text-weaver-indigo/80 mb-6 font-light leading-relaxed">
                                Sempai adds Semgrep-compatible structural queries to <code class="text-xs bg-weaver-indigo/10 px-1">observe</code>. It runs on Tree-sitter, exposes a query-focused operator surface, and keeps compatibility boundaries explicit.
                            </p>
                            <ul class="space-y-4 mb-8">
                                <li class="flex items-start">
                                    <i class="fa-solid fa-check text-weaver-vermilion mt-1 mr-3 text-sm"></i>
                                    <span class="text-weaver-indigo/80 text-sm">Semgrep-compatible rules with a Tree-sitter backend</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fa-solid fa-check text-weaver-vermilion mt-1 mr-3 text-sm"></i>
                                    <span class="text-weaver-indigo/80 text-sm">Rust, Python, and TypeScript support today; Go and HCL are planned</span>
                                </li>
                                <li class="flex items-start">
                                    <i class="fa-solid fa-check text-weaver-vermilion mt-1 mr-3 text-sm"></i>
                                    <span class="text-weaver-indigo/80 text-sm">Designed to turn source structure into agent-ready context</span>
                                </li>
                            </ul>
                            <a href="/weaver/sempai/" class="text-weaver-indigo font-bold border-b-2 border-weaver-vermilion hover:text-weaver-vermilion transition-colors pb-1 inline-block">
                                Read the query design
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Links Grid -->
            <section class="py-20 px-8 lg:px-16">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

                        <!-- Link Card: Docs -->
                        <a href="/weaver/docs/" class="block group h-full">
                            <div class="bg-white border border-weaver-indigo/20 p-8 h-full hover:border-weaver-indigo hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-weaver-indigo/5 rounded-full group-hover:bg-weaver-indigo/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-weaver-indigo mb-2">Documentation</h3>
                                <p class="text-sm text-weaver-indigo/60 mb-4">Read the command, install, safety, and configuration references.</p>
                                <span class="text-xs font-mono text-weaver-vermilion font-bold uppercase group-hover:underline">Read Docs &rarr;</span>
                            </div>
                        </a>

                        <!-- Link Card: Roadmap -->
                        <a href="/weaver/roadmap/" class="block group h-full">
                            <div class="bg-white border border-weaver-indigo/20 p-8 h-full hover:border-weaver-indigo hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-weaver-indigo/5 rounded-full group-hover:bg-weaver-indigo/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-weaver-indigo mb-2">Roadmap</h3>
                                <p class="text-sm text-weaver-indigo/60 mb-4">See which phases are shipped, which are planned, and which ideas remain directional.</p>
                                <span class="text-xs font-mono text-weaver-vermilion font-bold uppercase group-hover:underline">View plan &rarr;</span>
                            </div>
                        </a>

                        <!-- Link Card: GitHub -->
                        <a href="https://github.com/leynos/weaver" target="_blank" class="block group h-full">
                            <div class="bg-white border border-weaver-indigo/20 p-8 h-full hover:border-weaver-indigo hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-weaver-indigo/5 rounded-full group-hover:bg-weaver-indigo/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-weaver-indigo mb-2">GitHub</h3>
                                <p class="text-sm text-weaver-indigo/60 mb-4">Read the source, track issues, and follow release work in the open.</p>
                                <span class="text-xs font-mono text-weaver-vermilion font-bold uppercase group-hover:underline">Open repo &rarr;</span>
                            </div>
                        </a>

                        <!-- Link Card: Community -->
                        <a href="https://github.com/leynos/weaver" target="_blank" class="block group h-full">
                            <div class="bg-white border border-weaver-indigo/20 p-8 h-full hover:border-weaver-indigo hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-weaver-indigo/5 rounded-full group-hover:bg-weaver-indigo/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-weaver-indigo mb-2">Community</h3>
                                <p class="text-sm text-weaver-indigo/60 mb-4">Discord is not live yet. Use GitHub issues until the public channel opens.</p>
                                <span class="text-xs font-mono text-weaver-vermilion font-bold uppercase group-hover:underline">Track updates &rarr;</span>
                            </div>
                        </a>

                    </div>
                </div>
            </section>

            <!-- Footer -->
{% endblock %}
