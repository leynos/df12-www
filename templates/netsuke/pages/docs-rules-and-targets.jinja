                    <a href="/netsuke/docs/templating/" class="group flex items-center text-charcoal-mid hover:text-charcoal transition-colors">
                        <div class="text-right">
                            <div class="text-xs text-charcoal-light uppercase tracking-wide">Next</div>
                            <div class="font-medium text-sm">Templating</div>
                        </div>
                        <div class="w-8 h-8 rounded-full border border-stone flex items-center justify-center ml-3 group-hover:border-indigo group-hover:text-indigo transition-colors">
                            <span class="iconify text-xs" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </div>
                    </a>
                </div>
            </div>

        </main>
    </div>

    <script defer src="/netsuke/assets/vendor/minisearch.js"></script>
    <script defer src="/netsuke/assets/js/doc-search.js"></script>
    <script>
        window.addEventListener('load', function() {
            try {
                // Bar Chart for Build Performance
                const trace1 = {
                    x: ['Clean Build', 'Incremental (No Change)', 'Incremental (Small Change)'],
                    y: [45, 0.5, 2.1],
                    name: 'Netsuke (Optimized)',
                    type: 'bar',
                    marker: { color: '#2B4162' } // Indigo
                };

                const trace2 = {
                    x: ['Clean Build', 'Incremental (No Change)', 'Incremental (Small Change)'],
                    y: [120, 15, 45],
                    name: 'Traditional Make',
                    type: 'bar',
                    marker: { color: '#D1C7B8' } // Stone
                };

                const data = [trace1, trace2];

                const layout = {
                    title: { text: 'Build Time Comparison (Seconds)', font: { family: 'Fraunces', size: 16, color: '#2E2A25' } },
                    margin: { t: 50, r: 20, b: 40, l: 50 },
                    plot_bgcolor: '#FFFFFF',
                    paper_bgcolor: '#FFFFFF',
                    font: { family: 'Source Sans 3', color: '#5C554D' },
                    xaxis: { gridcolor: '#F5EDE0' },
                    yaxis: { gridcolor: '#F5EDE0', title: 'Time (s)' },
                    showlegend: true,
                    legend: { orientation: 'h', y: -0.2 }
                };

                Plotly.newPlot('buildPerfChart', data, layout, {responsive: true, displayModeBar: false});

            } catch(e) {
                console.error("Chart generation failed:", e);
            }
        });
    </script>
