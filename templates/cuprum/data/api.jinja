                {
                  "name": "outcome",
                  "type": "",
                  "description": "For <code>handoff</code>, the closed outcome of the writer-resource hand-off. <code>None</code> for every other phase."
                },
                {
                  "name": "duration_s",
                  "type": "",
                  "description": "Monotonic seconds spent waiting for the native worker's cleanup when <code>phase</code> is <code>cleanup_completed</code>. <code>None</code> for every other phase."
