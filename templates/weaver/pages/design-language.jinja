                <!-- Measurement Marks -->
                <div
                  class="absolute bottom-10 left-1/2 transform -translate-x-1/2 w-64 border-b border-base-content flex justify-between items-end pb-1">
                  <div class="h-2 w-px bg-primary"></div><span
                    class="font-mono text-3xs text-base-content mb-1">640px
