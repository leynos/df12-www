{% extends "doc_page.jinja" %}
{% from '_icons.jinja' import icon %}

{% block page_title %}Commands: Change - Weaver AI Codebase Tooling{% endblock %}

{% block extra_head %}
{% endblock %}

{% block nav_subitems_commands %}
                    <!-- Sub-navigation for Commands -->
                    <div class="ml-4 pl-4 border-l border-base-content/20 space-y-1 my-2">
                        <a href="/weaver/commands/observe/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/read</a>
                        <a href="/weaver/commands/act/" class="block py-1 text-xs font-mono font-bold text-accent-ink bg-accent/5 -ml-4 pl-4 border-l-2 border-accent">/change</a>
                        <a href="/weaver/commands/verify/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/verification</a>
                    </div>
{% endblock %}

{% block content %}

            <!-- Header Section -->
            <section id="act-header" class="relative pt-16 pb-12 px-8 lg:px-16 border-b border-base-content/20">
                <div class="masthead-frame mx-auto">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8">
                        <div class="masthead-eyebrow self-start">
                            <a href="/weaver/commands/" class="font-mono text-xs tracking-widest uppercase text-base-content/82 hover:text-accent-ink transition-colors">COMMANDS</a>
                            <span class="text-base-content/75">/</span>
                            <span class="font-mono text-xs tracking-widest uppercase text-base-content font-bold">CHANGE</span>
                        </div>
                    </div>

                    <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-6">
                        Controlled <br>
                        <span class="text-accent-ink italic font-light">Intervention</span>.
                    </h1>

                    <p class="font-sans text-lg text-base-content/80 leading-relaxed max-w-3xl font-light">
                        The change commands &ndash; <span class="font-mono text-sm bg-primary/10 px-1 rounded-sm">patches apply</span>, <span class="font-mono text-sm bg-primary/10 px-1 rounded-sm">symbols rename</span>, and <span class="font-mono text-sm bg-primary/10 px-1 rounded-sm">symbols move</span> &ndash; share one mutation engine. Every edit is staged in memory, formatted, validated by the Double-Lock harness (syntactic + semantic checks), and only then atomically committed to disk. No proposal cycle, no human approval gate &ndash; the locks <em>are</em> the safety gate.
                    </p>
                </div>

                <!-- Decorative Act Illustration -->
                <div class="absolute right-0 top-0 h-full w-1/3 hidden xl:flex opacity-24 pointer-events-none overflow-hidden items-start justify-end pr-8 pt-8">
                    <img
                        src="/weaver/assets/act/act-hero-outline.png"
                        alt="Blueprint-style intervention illustration for the act command."
                        class="block h-[28rem] w-auto"
                    >
                </div>
            </section>

            <!-- Usage & Syntax Section -->
            <section class="py-12 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

                        <!-- Left: Synopsis -->
                        <div class="lg:col-span-1">
                            <h2 class="font-serif text-2xl text-base-content mb-4">Synopsis</h2>
                            <p class="text-sm text-base-content/88 mb-6 leading-relaxed">
                                Every actuator accepts two selector entry points: direct (<code class="font-mono text-xs bg-primary/10 px-1">--uri</code> + <code class="font-mono text-xs bg-primary/10 px-1">--position</code>, or an inline <code class="font-mono text-xs bg-primary/10 px-1">--query</code>) and a typed stream via <code class="font-mono text-xs bg-primary/10 px-1">--selectors &lt;path|-&gt;</code>. The daemon plans the edit in memory, runs both locks, and writes to disk only on success. Failures leave the filesystem untouched.
                            </p>

                            <div class="bg-base-100 border border-base-content p-4 relative mb-6">
                                <div class="absolute -top-3 left-4 bg-base-100 px-2 text-xs font-mono text-accent-ink font-bold">SYNTAX</div>
                                <code class="font-mono text-sm text-base-content block break-all">
                                    weaver &lt;resource&gt; &lt;verb&gt; [--dry-run] [FLAGS]
                                </code>
                            </div>

                            <div class="flex items-center gap-2 text-xs font-mono text-base-content/82">
                                {{ icon('shield-halved') }}
                                <span>All writes pass through the Double-Lock harness</span>
                            </div>
                        </div>

                        <!-- Right: Operations Table -->
                        <div class="lg:col-span-2">
                            <h2 class="font-serif text-2xl text-base-content mb-4">Commands</h2>
                            <div class="overflow-hidden border border-base-content/20 rounded-xs shadow-xs bg-base-100">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-primary text-base-100 font-mono text-xs uppercase tracking-wider">
                                            <th class="p-3 border-r border-base-100/20 w-44">Command</th>
                                            <th class="p-3 border-r border-base-100/20 w-24">Input</th>
                                            <th class="p-3">Description</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-base-content/10">
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent-ink border-r border-base-content/10">patches apply</td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">File / STDIN</td>
                                            <td class="p-3 text-sm text-base-content/80">Apply a Git-style patch via <span class="font-mono text-xs bg-primary/10 px-1">--file</span> or stdin. Supports modify, create, and delete hunks, plus <span class="font-mono text-xs bg-primary/10 px-1">--dry-run</span>.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent-ink border-r border-base-content/10">symbols rename</td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">Selectors</td>
                                            <td class="p-3 text-sm text-base-content/80">Rename by position, inline <span class="font-mono text-xs bg-primary/10 px-1">--query</span>, or piped <span class="font-mono text-xs bg-primary/10 px-1">--selectors -</span>. Capability: <code>symbol.rename</code>.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent-ink border-r border-base-content/10">symbols move</td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">Selectors</td>
                                            <td class="p-3 text-sm text-base-content/80">Move a symbol to another module. Public verb <code>move</code>; internal capability <code>extricate-symbol</code>. Not an alias for <code>extract-method</code>.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent-ink border-r border-base-content/10">declared, unbuilt</td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">&mdash;</td>
                                            <td class="p-3 text-sm text-base-content/80">Sibling capability identifiers <code>extract-method</code>, <code>replace-body</code>, and <code>extract-predicate</code> are declared in the contract but not implemented. They will not pretend otherwise.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Sandboxed Execution Model Diagram -->
            <section class="py-16 px-8 lg:px-16 bg-base-100 border-b border-base-content/20 relative overflow-hidden">
                <!-- Grid background for technical feel -->
                <div class="absolute inset-0 z-0" style="background-image: linear-gradient(color-mix(in oklab, var(--color-primary) 3%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in oklab, var(--color-primary) 3%, transparent) 1px, transparent 1px); background-size: 20px 20px;"></div>

                <div class="max-w-6xl mx-auto relative z-10">
                    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
                        <div>
                            <span class="font-mono text-xs text-accent-ink font-bold tracking-widest uppercase mb-2 block">SAFETY ARCHITECTURE</span>
                            <h2 class="font-serif text-3xl text-base-content">The "Birdcage" Sandbox</h2>
                            <p class="text-base-content/88 mt-2 max-w-xl">
                                Code execution happens in an ephemeral environment using <code class="text-xs bg-primary/10 px-1">seccomp-bpf</code> filters to prevent unauthorized syscalls.
                            </p>
                        </div>
                    </div>

                    <!-- Sandbox Visualizer -->
                    <div class="bg-white border-2 border-base-content p-8 relative shadow-panel figure-fullbleed">
                        <!-- Technical Labels -->
                        <div class="absolute top-2 left-2 z-20 text-3xs font-mono text-base-content border border-base-content px-1 bg-base-100/90 figure-fullbleed-label">FIG 4.2: ISOLATION BOUNDARY</div>

                        <div class="relative py-8 figure-fullbleed-img">
                            <img
                                src="/weaver/assets/act/act-birdcage-sandbox.png"
                                alt="Illustration of the host environment, controlled socket, and isolated Birdcage sandbox boundary."
                                class="block w-full h-auto rounded-[2px] border border-base-content/10 bg-base-100"
                            >
                        </div>

                        <!-- Safety Note Footer -->
                        <div class="mt-8 border-t border-base-content/10 pt-4 flex items-start gap-3 figure-fullbleed-footer">
                            {{ icon('triangle-exclamation', 'text-accent-ink mt-1') }}
                            <p class="text-sm text-base-content/88 font-mono">
                                <strong class="text-base-content">Violation Policy:</strong> Any attempt to access unauthorized paths (e.g., <code class="text-xs">/etc/passwd</code>, <code class="text-xs">~/.ssh</code>) immediately kills the child process and logs a security event.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Lock-Guarded Actuation -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-10">Lock-Guarded Actuation</h2>

                    <div class="space-y-12">

                        <!-- Example 1: patches apply -->
                        <div class="relative group">
                            <div class="absolute -left-4 top-0 bottom-0 w-1 bg-primary opacity-30 group-hover:opacity-100 transition-opacity"></div>
                            <div class="flex items-baseline gap-3 mb-4 pl-4">
                                <span class="font-mono text-xs font-bold text-base-100 bg-primary px-2 py-1 rounded-xs">EXAMPLE</span>
                                <h3 class="font-serif text-xl text-base-content">patches apply</h3>
                            </div>
                            <p class="text-sm text-base-content/88 mb-4 pl-4 max-w-2xl">
                                Point at a Git-style patch. The engine stages it against expected content versions, formats the staged files, runs both locks, and commits atomically &ndash; recording the transaction, digests, and rollback reference.
                            </p>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pl-4">
                                <div class="bg-neutral rounded-xs p-4 border border-base-content/20">
                                    <div class="flex justify-between items-center mb-2 border-b border-white/10 pb-2">
                                        <span class="text-xs font-mono text-base-100/70">TERMINAL</span>
                                    </div>
                                    <div class="font-mono text-sm leading-relaxed">
                                        <span class="text-code-string">$</span> <span class="text-code-string">weaver</span> <span class="text-white">patches apply --file fix.patch --json</span>
                                    </div>
                                </div>

                                <div class="bg-code-surface rounded-xs p-4 border border-base-content/20 font-mono text-xs overflow-x-auto shadow-inner relative">
                                    <div class="absolute top-2 right-2 text-3xs text-white/55 uppercase tracking-widest">JSON RESULT</div>
<pre class="text-code-text">
{<span class="token-key">"transaction"</span>:<span class="token-string">"txn_01j9..."</span>,<span class="token-key">"changed"</span>:[<span class="token-string">"src/lib.rs"</span>],<span class="token-key">"verification"</span>:{<span class="token-key">"syntactic"</span>:<span class="token-string">"ok"</span>,<span class="token-key">"semantic"</span>:<span class="token-string">"ok"</span>},<span class="token-key">"diagnostics"</span>:{<span class="token-key">"introduced"</span>:<span class="token-number">0</span>,<span class="token-key">"resolved"</span>:<span class="token-number">1</span>}}
</pre>
                                </div>
                            </div>
                        </div>

                        <!-- Connecting Arrow -->
                        <div class="flex justify-center -my-4 relative z-10">
                            {{ icon('arrow-down', 'text-base-content/20 text-2xl') }}
                        </div>

                        <!-- Example 2: refactor (rename) -->
                        <div class="relative group">
                            <div class="absolute -left-4 top-0 bottom-0 w-1 bg-accent opacity-30 group-hover:opacity-100 transition-opacity"></div>
                            <div class="flex items-baseline gap-3 mb-4 pl-4">
                                <span class="font-mono text-xs font-bold text-white bg-accent-deep px-2 py-1 rounded-xs">EXAMPLE</span>
                                <h3 class="font-serif text-xl text-base-content">symbols rename (by query)</h3>
                            </div>
                            <p class="text-sm text-base-content/88 mb-4 pl-4 max-w-2xl">
                                An inline query selects the target; the routed actuator plans, the shared engine verifies through the Double-Lock, and disk changes happen only on success. A multi-match query is refused, with candidates listed &ndash; no command guesses whether a multi-match mutation is intended.
                            </p>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pl-4">
                                <div class="bg-neutral rounded-xs p-4 border border-base-content/20">
                                    <div class="flex justify-between items-center mb-2 border-b border-white/10 pb-2">
                                        <span class="text-xs font-mono text-base-100/70">TERMINAL</span>
                                    </div>
                                    <div class="font-mono text-sm leading-relaxed">
                                        <span class="text-code-string">$</span> <span class="text-code-string">weaver</span> <span class="text-white">symbols rename \</span><br>
                                        <span class="text-white pl-4">--query 'fn process_request($...ARGS)' \</span><br>
                                        <span class="text-white pl-4">--new-name run_request --json</span>
                                    </div>
                                </div>

                                <div class="bg-code-surface rounded-xs p-4 border border-base-content/20 font-mono text-xs overflow-x-auto shadow-inner relative">
                                    <div class="absolute top-2 right-2 text-3xs text-white/55 uppercase tracking-widest">JSON RESULT</div>
<pre class="text-code-text">
{<span class="token-key">"transaction"</span>:<span class="token-string">"txn_01ja..."</span>,<span class="token-key">"changed"</span>:[<span class="token-string">"src/main.rs"</span>,<span class="token-string">"src/handler.rs"</span>],<span class="token-key">"verification"</span>:{<span class="token-key">"syntactic"</span>:<span class="token-string">"ok"</span>,<span class="token-key">"semantic"</span>:<span class="token-string">"ok"</span>},<span class="token-key">"diagnostics"</span>:{<span class="token-key">"introduced"</span>:<span class="token-number">0</span>,<span class="token-key">"resolved"</span>:<span class="token-number">0</span>}}
</pre>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

             <!-- Failure Modes -->
             <section class="py-12 px-8 lg:px-16 bg-white/30 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-2xl text-base-content mb-6">Common Failure Modes</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

                        <!-- Error 1: Syntactic Lock -->
                        <div class="bg-base-100 border border-accent/30 p-5 rounded-xs relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1 h-full bg-accent"></div>
                            <div class="flex items-start justify-between mb-3">
                                <span class="font-mono text-xs font-bold text-accent-ink">ERR_SYNTACTIC_LOCK</span>
                                {{ icon('code', 'text-accent-ink/40') }}
                            </div>
                            <p class="text-xs text-base-content/80 leading-relaxed mb-3">
                                The modified file failed Tree-sitter parsing. Structural error (e.g. unbalanced braces, missing semicolons).
                            </p>
                            <code class="block bg-primary/5 p-2 rounded-sm text-3xs font-mono text-base-content">
                                syntactic lock failed: src/main.rs:42:5 syntax error
                            </code>
                        </div>

                        <!-- Error 2: Semantic Lock -->
                        <div class="bg-base-100 border border-accent/30 p-5 rounded-xs relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1 h-full bg-accent"></div>
                            <div class="flex items-start justify-between mb-3">
                                <span class="font-mono text-xs font-bold text-accent-ink">ERR_SEMANTIC_LOCK</span>
                                {{ icon('microscope', 'text-accent-ink/40') }}
                            </div>
                            <p class="text-xs text-base-content/80 leading-relaxed mb-3">
                                New diagnostics detected after the edit. The language server found type errors or unresolved references that were not present before.
                            </p>
                            <code class="block bg-primary/5 p-2 rounded-sm text-3xs font-mono text-base-content">
                                semantic lock failed: 2 new error(s)
                            </code>
                        </div>

                        <!-- Error 3: Stale Source -->
                        <div class="bg-base-100 border border-accent/30 p-5 rounded-xs relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1 h-full bg-accent"></div>
                            <div class="flex items-start justify-between mb-3">
                                <span class="font-mono text-xs font-bold text-accent-ink">ERR_STALE_SOURCE</span>
                                {{ icon('rotate-left', 'text-accent-ink/40') }}
                            </div>
                            <p class="text-xs text-base-content/80 leading-relaxed mb-3">
                                The file changed since the selectors were produced. Checked before planning and again immediately before commit; <code class="text-3xs font-mono">--force</code> cannot erase this precondition.
                            </p>
                            <code class="block bg-primary/5 p-2 rounded-sm text-3xs font-mono text-base-content">
                                stale source: src/lib.rs digest mismatch; re-run the query
                            </code>
                        </div>

                        <!-- Error 4: Sandbox Violation -->
                        <div class="bg-base-100 border border-base-content/20 p-5 rounded-xs relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-1 h-full bg-primary"></div>
                            <div class="flex items-start justify-between mb-3">
                                <span class="font-mono text-xs font-bold text-base-content">ERR_SANDBOX_VIOLATION</span>
                                {{ icon('ban', 'text-base-content/75') }}
                            </div>
                            <p class="text-xs text-base-content/80 leading-relaxed mb-3">
                                A plugin attempted to access a path outside the sandbox allowlist. The child process is killed immediately.
                            </p>
                            <code class="block bg-primary/5 p-2 rounded-sm text-3xs font-mono text-base-content">
                                Access denied: /etc/hosts
                            </code>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Mutation Contract Guarantees -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-4">The Mutation Contract</h2>
                    <p class="text-sm text-base-content/80 max-w-3xl mb-10">
                        One engine plans and commits every change, so every actuator inherits the same guarantees. Human and <code class="text-xs bg-primary/10 px-1">--json</code> renderers read the same result.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Completion before actuation</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                An actuator reads or spools the complete selector stream and validates its completion record before planning anything. It never mutates while input is still arriving, and a producer failure never fakes a successful completion.
                            </p>
                        </div>
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Explicit cardinality</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                Every actuator documents its policy for zero, one, several, and overlapping selectors. The defaults refuse ambiguity: a multi-match mutation requires the caller to say so.
                            </p>
                        </div>
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Idempotent by construction</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                Idempotency keys, transaction identifiers, and retry matching survive a daemon restart. Resubmitting an equivalent request returns the existing transaction &ndash; or the existing refusal.
                            </p>
                        </div>
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Honest no-ops</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                A mutation whose post-format result is byte-identical returns an explicit no-op, and repeated no-ops trip a circuit breaker. Formatting runs on staged files before verification; a formatter failure cannot touch the live workspace.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Symbols Move (PLANNED) -->
            <section id="extricate" class="py-16 px-8 lg:px-16 border-t border-base-content/10">
                <div class="max-w-6xl mx-auto">
                    <div class="border-2 border-dashed border-base-content/40 rounded-xs p-8 lg:p-12 opacity-80">
                        <div class="flex items-center gap-3 mb-8">
                            <h2 class="font-serif text-3xl font-bold text-base-content">symbols move</h2>
                            <span class="status-pill status-pill-planned">Planned</span>
                        </div>

                        <p class="text-sm text-base-content/80 leading-relaxed mb-8 max-w-3xl">
                            Move a selected symbol into a different module while preserving behaviour. The detailed execution model documented here is Rust-specific: it covers <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">impl</code> blocks, <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">use</code> tree rewrites, and refusal cases such as non-preservable <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">pub(in ...)</code>. Python remains a planned capability route, but its Rope-backed limits are not specified to the same depth yet.
                        </p>

                        <!-- Synopsis -->
                        <div class="mb-8">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Synopsis</h3>
                            <div class="paper-panel bg-neutral text-base-100 p-4 rounded-xs">
                                <code class="text-xs font-mono">weaver symbols move --uri &lt;file:///...&gt; --position &lt;line:col&gt; --to &lt;module&gt; [--dry-run]</code>
                            </div>
                        </div>

                        <!-- Capability -->
                        <div class="mb-8">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Capability</h3>
                            <p class="text-sm text-base-content/80">
                                Public verb <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">move</code>; internal capability <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">extricate-symbol</code> &ndash; deliberately not an alias for <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">extract-method</code>. Providers declare the capability in their plugin manifest; the daemon resolves the correct provider for the source file's language and keeps the provider's name out of the primary UX.
                            </p>
                        </div>

                        <!-- Providers -->
                        <div class="mb-8">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Providers</h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm border border-base-content/20">
                                    <thead>
                                        <tr class="bg-primary/5">
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Language</th>
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Plugin</th>
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Backend</th>
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Notes</th>
                                        </tr>
                                    </thead>
                                    <tbody class="text-base-content/80">
                                        <tr class="border-b border-base-content/10">
                                            <td class="p-3 font-mono text-xs">Python</td>
                                            <td class="p-3 font-mono text-xs">rope</td>
                                            <td class="p-3 text-xs">Rope refactoring library</td>
                                            <td class="p-3 text-xs">Planned capability route only. Current site docs do not define a Rope extrication contract beyond provider intent, so do not infer Rust-style module surgery for Python.</td>
                                        </tr>
                                        <tr>
                                            <td class="p-3 font-mono text-xs">Rust</td>
                                            <td class="p-3 font-mono text-xs">rust-analyzer</td>
                                            <td class="p-3 text-xs">RA LSP + overlay transaction engine</td>
                                            <td class="p-3 text-xs">Detailed design exists. Handles definition and reference planning, <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">impl</code> moves, <code class="text-xs font-mono bg-primary/5 px-1 py-0.5 rounded-sm">use</code> rewrites, and Rust-specific refusal cases.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Orchestration -->
                        <div class="mb-8">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Orchestration Sequence</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                <div class="bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="w-6 h-6 bg-primary text-base-100 flex items-center justify-center font-mono text-xs font-bold rounded-xs">1</span>
                                        <span class="font-mono text-xs font-bold text-base-content">Resolve</span>
                                    </div>
                                    <p class="text-xs text-base-content/88">Validate arguments, resolve the selected definition, and collect pre-move references.</p>
                                </div>
                                <div class="bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="w-6 h-6 bg-primary text-base-100 flex items-center justify-center font-mono text-xs font-bold rounded-xs">2</span>
                                        <span class="font-mono text-xs font-bold text-base-content">Overlay</span>
                                    </div>
                                    <p class="text-xs text-base-content/88">Start an in-memory overlay transaction. No filesystem writes until all checks pass.</p>
                                </div>
                                <div class="bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="w-6 h-6 bg-primary text-base-100 flex items-center justify-center font-mono text-xs font-bold rounded-xs">3</span>
                                        <span class="font-mono text-xs font-bold text-base-content">Move</span>
                                    </div>
                                    <p class="text-xs text-base-content/88">Build move-set closure for the symbol and associated <code class="font-mono">impl</code> blocks. Apply edits to overlay.</p>
                                </div>
                                <div class="bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="w-6 h-6 bg-primary text-base-100 flex items-center justify-center font-mono text-xs font-bold rounded-xs">4</span>
                                        <span class="font-mono text-xs font-bold text-base-content">Import Repair</span>
                                    </div>
                                    <p class="text-xs text-base-content/88">Rewrite external references and <code class="font-mono">use</code> trees. Disambiguate imports via definition-equivalence probes.</p>
                                </div>
                                <div class="bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="w-6 h-6 bg-primary text-base-100 flex items-center justify-center font-mono text-xs font-bold rounded-xs">5</span>
                                        <span class="font-mono text-xs font-bold text-base-content">Verify</span>
                                    </div>
                                    <p class="text-xs text-base-content/88">Run semantic invariants: no new diagnostics, all reference probes resolve to the moved definition.</p>
                                </div>
                                <div class="bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="w-6 h-6 bg-primary text-base-100 flex items-center justify-center font-mono text-xs font-bold rounded-xs">6</span>
                                        <span class="font-mono text-xs font-bold text-base-content">Commit / Rollback</span>
                                    </div>
                                    <p class="text-xs text-base-content/88">The provider returns a unified diff to the daemon on success. The daemon then commits the edit to disk and updates <code class="font-mono bg-primary/5 px-1 rounded-sm">files_written</code> only if both locks pass; on any failure it discards the overlay and returns diagnostics unchanged.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Arguments -->
                        <div class="mb-8">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Arguments</h3>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm border border-base-content/20">
                                    <thead>
                                        <tr class="bg-primary/5">
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Argument</th>
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Type</th>
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Required</th>
                                            <th class="text-left p-3 font-mono text-xs font-bold text-base-content border-b border-base-content/20">Description</th>
                                        </tr>
                                    </thead>
                                    <tbody class="text-base-content/80">
                                        <tr class="border-b border-base-content/10">
                                            <td class="p-3 font-mono text-xs">--uri</td>
                                            <td class="p-3 font-mono text-xs">string</td>
                                            <td class="p-3 text-xs">Yes</td>
                                            <td class="p-3 text-xs">Source file URI containing the selected symbol.</td>
                                        </tr>
                                        <tr class="border-b border-base-content/10">
                                            <td class="p-3 font-mono text-xs">--position</td>
                                            <td class="p-3 font-mono text-xs">string</td>
                                            <td class="p-3 text-xs">Yes</td>
                                            <td class="p-3 text-xs">Source position in <code class="font-mono bg-primary/5 px-1 rounded-sm">line:col</code> form (LSP coordinates).</td>
                                        </tr>
                                        <tr class="border-b border-base-content/10">
                                            <td class="p-3 font-mono text-xs">--to</td>
                                            <td class="p-3 font-mono text-xs">string</td>
                                            <td class="p-3 text-xs">Yes</td>
                                            <td class="p-3 text-xs">Destination module path or file URI.</td>
                                        </tr>
                                        <tr class="border-b border-base-content/10">
                                            <td class="p-3 font-mono text-xs">--create-missing-modules / --no-create-missing-modules</td>
                                            <td class="p-3 font-mono text-xs">bool</td>
                                            <td class="p-3 text-xs">No</td>
                                            <td class="p-3 text-xs">Create missing destination modules. Default <code class="font-mono bg-primary/5 px-1 rounded-sm">true</code>; to disable, pass <code class="font-mono bg-primary/5 px-1 rounded-sm">--no-create-missing-modules</code>.</td>
                                        </tr>
                                        <tr class="border-b border-base-content/10">
                                            <td class="p-3 font-mono text-xs">--format</td>
                                            <td class="p-3 font-mono text-xs">string</td>
                                            <td class="p-3 text-xs">No</td>
                                            <td class="p-3 text-xs"><code class="font-mono bg-primary/5 px-1 rounded-sm">auto</code>, <code class="font-mono bg-primary/5 px-1 rounded-sm">on</code>, or <code class="font-mono bg-primary/5 px-1 rounded-sm">off</code>. Default <code class="font-mono bg-primary/5 px-1 rounded-sm">auto</code>.</td>
                                        </tr>
                                        <tr>
                                            <td class="p-3 font-mono text-xs">--explain</td>
                                            <td class="p-3 font-mono text-xs">bool</td>
                                            <td class="p-3 text-xs">No</td>
                                            <td class="p-3 text-xs">Emit execution plan metadata in diagnostics output.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Refusal Cases -->
                        <div>
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Refusal Cases</h3>
                            <p class="text-sm text-base-content/80 leading-relaxed mb-4">
                                The plugin refuses execution for non-deterministic or unsound cases. Each refusal returns precise diagnostics and leaves workspace content unchanged.
                            </p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <div class="flex items-start gap-3 bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    {{ icon('xmark', 'text-accent-ink/60 mt-0.5') }}
                                    <div>
                                        <span class="font-mono text-xs font-bold text-base-content">Macro-generated items</span>
                                        <p class="text-xs text-base-content/82 mt-1">Items lacking stable editable source ranges cannot be moved safely.</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3 bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    {{ icon('xmark', 'text-accent-ink/60 mt-0.5') }}
                                    <div>
                                        <span class="font-mono text-xs font-bold text-base-content">Ambiguous imports</span>
                                        <p class="text-xs text-base-content/82 mt-1">Import repair without a unique semantic match is a hard error.</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3 bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    {{ icon('xmark', 'text-accent-ink/60 mt-0.5') }}
                                    <div>
                                        <span class="font-mono text-xs font-bold text-base-content">Unsupported visibility</span>
                                        <p class="text-xs text-base-content/82 mt-1">Non-preservable <code class="font-mono text-3xs">pub(in ...)</code> constraints that cannot be maintained across modules.</p>
                                    </div>
                                </div>
                                <div class="flex items-start gap-3 bg-base-100 border border-base-content/20 p-4 rounded-xs">
                                    {{ icon('xmark', 'text-accent-ink/60 mt-0.5') }}
                                    <div>
                                        <span class="font-mono text-xs font-bold text-base-content">Incomplete payloads</span>
                                        <p class="text-xs text-base-content/82 mt-1">File payload does not cover all files required for deterministic execution.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Bottom CTA Navigation -->
            <section class="py-16 px-8 lg:px-16">
                <div class="max-w-6xl mx-auto">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-6 p-8 bg-primary/5 border border-base-content/10 rounded-xs">
                        <div>
                            <h3 class="font-serif text-xl text-base-content mb-2">Trust, but Verify.</h3>
                            <p class="text-sm text-base-content/88">Ensure the actions taken produced the desired outcome.</p>
                        </div>
                        <a href="/weaver/commands/verify/" class="group flex items-center gap-3 px-6 py-3 bg-primary text-base-100 font-mono text-xs font-bold uppercase tracking-wider hover:bg-accent transition-colors shadow-md">
                            Next: Verification
                            {{ icon('arrow-right', 'group-hover:translate-x-1 transition-transform') }}
                        </a>
                    </div>
                </div>
            </section>

{% endblock %}
