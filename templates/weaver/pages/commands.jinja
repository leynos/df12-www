{% extends "doc_page.jinja" %}
{% from '_icons.jinja' import icon %}

{% block page_title %}Command Reference - Weaver AI Codebase Tooling{% endblock %}

{% block extra_head %}
{% endblock %}

{% block nav_subitems_commands %}
                    <div class="ml-4 pl-4 border-l border-base-content/20 space-y-1 my-2">
                        <a href="/weaver/commands/observe/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/observe</a>
                        <a href="/weaver/commands/act/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/act</a>
                        <a href="/weaver/commands/verify/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/verify</a>
                    </div>
{% endblock %}

{% block content %}

            <!-- Header Section -->
            <section id="commands-header" class="relative pt-16 pb-12 px-8 lg:px-16 border-b border-base-content/20">
                <div class="masthead-frame mx-auto">
                    <div class="masthead-eyebrow mb-6">
                        <span class="font-mono text-xs tracking-widest uppercase text-base-content">CLI Reference</span>
                    </div>

                    <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-8">
                        The Vocabulary of <br>
                        <span class="text-accent-ink italic font-light">Action</span>.
                    </h1>

                    <p class="font-sans text-lg text-base-content/80 leading-relaxed max-w-2xl font-light">
                        Every command follows the same shape: <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">weaver &lt;domain&gt; &lt;operation&gt; [ARG ...]</code>. Three domains — Observe, Act, and Verify — cover perception, mutation, and validation respectively.
                    </p>
                </div>
            </section>

            <!-- Capabilities Table Section -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-8">Core Capabilities</h2>

                    <div class="overflow-hidden border border-base-content/20 rounded-xs shadow-xs bg-base-100">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-primary text-base-100 font-mono text-xs uppercase tracking-wider">
                                    <th class="p-4 border-r border-base-100/20 w-32">Domain</th>
                                    <th class="p-4 border-r border-base-100/20">Purpose</th>
                                    <th class="p-4 border-r border-base-100/20 w-56">Key Operations</th>
                                    <th class="p-4 w-40">Output</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-base-content/10">
                                <tr class="group hover:bg-primary/5 transition-colors">
                                    <td class="p-4 font-mono text-sm font-bold text-base-content border-r border-base-content/10">
                                        <a href="/weaver/commands/observe/" class="flex items-center gap-2 hover:text-accent-ink">
                                            observe {{ icon('arrow-right', '-rotate-45 text-3xs opacity-0 group-hover:opacity-100 transition-opacity') }}
                                        </a>
                                    </td>
                                    <td class="p-4 text-sm text-base-content/80 border-r border-base-content/10">
                                        Query code structure and relationships via LSP and Tree-sitter.
                                    </td>
                                    <td class="p-4 font-mono text-xs text-base-content/82 border-r border-base-content/10">
                                        get-definition, find-references, call-hierarchy, grep
                                    </td>
                                    <td class="p-4 font-mono text-xs text-base-content/82">
                                        JSONL (<code class="text-3xs">kind</code> envelope)
                                    </td>
                                </tr>
                                <tr class="group hover:bg-primary/5 transition-colors">
                                    <td class="p-4 font-mono text-sm font-bold text-base-content border-r border-base-content/10">
                                        <a href="/weaver/commands/act/" class="flex items-center gap-2 hover:text-accent-ink">
                                            act {{ icon('arrow-right', '-rotate-45 text-3xs opacity-0 group-hover:opacity-100 transition-opacity') }}
                                        </a>
                                    </td>
                                    <td class="p-4 text-sm text-base-content/80 border-r border-base-content/10">
                                        Lock-guarded, transactional code mutation via patches or rewrites.
                                    </td>
                                    <td class="p-4 font-mono text-xs text-base-content/82 border-r border-base-content/10">
                                        apply-patch, apply-rewrite, refactor
                                    </td>
                                    <td class="p-4 font-mono text-xs text-base-content/82">
                                        JSONL (<code class="text-3xs">kind</code> envelope)
                                    </td>
                                </tr>
                                <tr class="group hover:bg-primary/5 transition-colors">
                                    <td class="p-4 font-mono text-sm font-bold text-base-content border-r border-base-content/10">
                                        <a href="/weaver/commands/verify/" class="flex items-center gap-2 hover:text-accent-ink">
                                            verify {{ icon('arrow-right', '-rotate-45 text-3xs opacity-0 group-hover:opacity-100 transition-opacity') }}
                                        </a>
                                    </td>
                                    <td class="p-4 text-sm text-base-content/80 border-r border-base-content/10">
                                        Pull diagnostics from language servers to confirm code health.
                                    </td>
                                    <td class="p-4 font-mono text-xs text-base-content/82 border-r border-base-content/10">
                                        diagnostics
                                    </td>
                                    <td class="p-4 font-mono text-xs text-base-content/82">
                                        JSONL (<code class="text-3xs">kind</code> envelope)
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- Command Breakdown Cards -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">

                    <!-- Observe Card -->
                    <div id="observe-card" class="bg-white border-2 border-base-content p-6 relative group hover:-translate-y-1 transition-transform duration-300 shadow-panel-sm">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            {{ icon('eye', 'text-6xl text-base-content') }}
                        </div>
                        <h3 class="font-serif text-2xl text-base-content mb-2 group-hover:text-accent-ink transition-colors">Observe</h3>
                        <p class="text-sm font-mono text-base-content/78 mb-4">perception</p>
                        <p class="text-base-content/80 mb-6 text-sm leading-relaxed min-h-[80px]">
                            The agent's eyes. Queries code structure via LSP and Tree-sitter — definitions, references, call hierarchies, structural grep.
                        </p>
                        <div class="bg-neutral p-3 rounded-xs mb-4 border border-base-content/20">
                            <code class="font-mono text-xs text-code-string block">$ weaver observe get-definition \<br>&nbsp;&nbsp;--uri file:///src/main.rs --position 10:5</code>
                        </div>
                        <a href="/weaver/commands/observe/" class="inline-flex items-center text-xs font-bold font-mono uppercase tracking-wider text-accent-ink hover:text-base-content transition-colors">
                            Full Documentation {{ icon('arrow-right', 'ml-2') }}
                        </a>
                    </div>

                    <!-- Act Card -->
                    <div id="act-card" class="bg-white border-2 border-base-content p-6 relative group hover:-translate-y-1 transition-transform duration-300 shadow-panel-sm">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            {{ icon('hand-holding-hand', 'text-6xl text-base-content') }}
                        </div>
                        <h3 class="font-serif text-2xl text-base-content mb-2 group-hover:text-accent-ink transition-colors">Act</h3>
                        <p class="text-sm font-mono text-base-content/78 mb-4">mutation</p>
                        <p class="text-base-content/80 mb-6 text-sm leading-relaxed min-h-[80px]">
                            The agent's hands. Applies patches and rewrites through Double-Lock validation — every edit passes syntactic and semantic checks before it touches disk.
                        </p>
                        <div class="bg-neutral p-3 rounded-xs mb-4 border border-base-content/20">
                            <code class="font-mono text-xs text-code-string block">$ weaver act apply-patch &lt; fix.diff</code>
                        </div>
                        <a href="/weaver/commands/act/" class="inline-flex items-center text-xs font-bold font-mono uppercase tracking-wider text-accent-ink hover:text-base-content transition-colors">
                            Full Documentation {{ icon('arrow-right', 'ml-2') }}
                        </a>
                    </div>

                    <!-- Verify Card -->
                    <div id="verify-card" class="bg-white border-2 border-base-content p-6 relative group hover:-translate-y-1 transition-transform duration-300 shadow-panel-sm">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            {{ icon('scale-balanced', 'text-6xl text-base-content') }}
                        </div>
                        <h3 class="font-serif text-2xl text-base-content mb-2 group-hover:text-accent-ink transition-colors">Verify</h3>
                        <p class="text-sm font-mono text-base-content/78 mb-4">validation</p>
                        <p class="text-base-content/80 mb-6 text-sm leading-relaxed min-h-[80px]">
                            The agent's conscience. Currently pulls LSP diagnostics for any file with a supported language server. Policy and test orchestration are planned, not implemented yet.
                        </p>
                        <div class="bg-neutral p-3 rounded-xs mb-4 border border-base-content/20">
                            <code class="font-mono text-xs text-code-string block">$ weaver verify diagnostics \<br>&nbsp;&nbsp;--uri file:///src/lib.rs</code>
                        </div>
                        <a href="/weaver/commands/verify/" class="inline-flex items-center text-xs font-bold font-mono uppercase tracking-wider text-accent-ink hover:text-base-content transition-colors">
                            Full Documentation {{ icon('arrow-right', 'ml-2') }}
                        </a>
                    </div>

                </div>
            </section>

            <!-- Example Pipeline Section (Interactive-like) -->
            <section class="py-20 px-8 lg:px-16 border-b border-base-content/20 bg-base-100 relative">

                <div class="max-w-6xl mx-auto relative z-10">
                    <div class="flex flex-col md:flex-row justify-between md:items-end mb-10">
                        <div>
                            <span class="font-mono text-xs text-accent-ink font-bold tracking-widest uppercase mb-2 block">WORKFLOW</span>
                            <h2 class="font-serif text-3xl text-base-content">End-to-End Pipeline</h2>
                            <p class="text-base-content/88 mt-2 max-w-xl">How an agent typically chains commands to safely refactor code.</p>
                        </div>
                        <div class="hidden md:block">
                             <div class="flex items-center gap-2 text-xs font-mono text-base-content/82">
                                <span class="w-3 h-3 bg-neutral rounded-full"></span> Input
                                <span class="w-3 h-3 bg-accent rounded-full ml-2"></span> Process
                                <span class="w-3 h-3 bg-primary rounded-full ml-2"></span> Output
                             </div>
                        </div>
                    </div>

                    <div class="bg-white border-2 border-base-content p-4 rounded-xs shadow-panel-soft mb-8 figure-fullbleed">
                        <img
                            src="/weaver/assets/commands/commands-end-to-end-pipeline.png"
                            alt="Illustration of the Observe, Act, and Verify command pipeline for an AI-assisted coding workflow."
                            class="block w-full h-auto rounded-[2px] border border-base-content/10 bg-base-100"
                        >
                    </div>

                    <!-- Pipeline Steps -->
                    <div class="space-y-4">

                        <!-- Step 1: Observe -->
                        <div class="bg-white border border-base-content/20 p-6 rounded-xs shadow-xs relative overflow-hidden">
                            <div class="absolute left-0 top-0 bottom-0 w-1 bg-primary"></div>
                            <div class="flex flex-col lg:flex-row gap-6">
                                <div class="lg:w-1/3 flex flex-col justify-center">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="font-mono text-xs font-bold bg-primary text-base-100 px-2 py-0.5 rounded-xs">01</span>
                                        <h3 class="font-serif text-xl text-base-content">Observe Context</h3>
                                    </div>
                                    <p class="text-sm text-base-content/88 mb-4">Agent jumps to the definition of <code class="text-xs bg-primary/10 px-1">process_data</code> to understand it before editing.</p>
                                    <div class="font-mono text-xs text-base-content/78 bg-base-100 p-2 border border-base-content/10 rounded-sm">
                                        <span class="text-accent-ink">$</span> weaver observe get-definition \<br>
                                        &nbsp;&nbsp;--output json \<br>
                                        &nbsp;&nbsp;--uri file:///src/main.rs --position 10:5
                                    </div>
                                </div>
                                <div class="lg:w-2/3 bg-neutral p-4 rounded-xs font-mono text-xs text-code-text overflow-x-auto border border-base-content/10 shadow-inner">
<pre>
<span class="text-code-muted">// CLI JSON output (--output json)</span>
[{"uri":"file:///src/lib.rs","line":42,"column":17}]
</pre>
                                </div>
                            </div>
                        </div>

                        <!-- Connector -->
                        <div class="flex justify-center h-6">
                            <div class="w-px bg-primary/30 border-l border-dashed border-base-content"></div>
                        </div>

                        <!-- Step 2: Act -->
                        <div class="bg-white border border-base-content/20 p-6 rounded-xs shadow-xs relative overflow-hidden">
                            <div class="absolute left-0 top-0 bottom-0 w-1 bg-accent"></div>
                            <div class="flex flex-col lg:flex-row gap-6">
                                <div class="lg:w-1/3 flex flex-col justify-center">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="font-mono text-xs font-bold bg-accent-deep text-white px-2 py-0.5 rounded-xs">02</span>
                                        <h3 class="font-serif text-xl text-base-content">Apply Patch</h3>
                                    </div>
                                    <p class="text-sm text-base-content/88 mb-4">Agent pipes a diff through Double-Lock validation and onto disk.</p>
                                    <div class="font-mono text-xs text-base-content/78 bg-base-100 p-2 border border-base-content/10 rounded-sm">
                                        <span class="text-accent-ink">$</span> weaver act apply-patch --output json &lt; refactor.diff
                                    </div>
                                </div>
                                <div class="lg:w-2/3 bg-neutral p-4 rounded-xs font-mono text-xs text-code-text overflow-x-auto border border-base-content/10 shadow-inner">
<pre>
<span class="text-code-muted">// CLI JSON output (--output json)</span>
{"applied":true,"files":["src/lib.rs"]}
</pre>
                                </div>
                            </div>
                        </div>

                        <!-- Connector -->
                        <div class="flex justify-center h-6">
                            <div class="w-px bg-primary/30 border-l border-dashed border-base-content"></div>
                        </div>

                        <!-- Step 3: Verify -->
                        <div class="bg-white border border-base-content/20 p-6 rounded-xs shadow-xs relative overflow-hidden">
                            <div class="absolute left-0 top-0 bottom-0 w-1 bg-status-ok-strong"></div>
                            <div class="flex flex-col lg:flex-row gap-6">
                                <div class="lg:w-1/3 flex flex-col justify-center">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="font-mono text-xs font-bold bg-status-ok-strong text-white px-2 py-0.5 rounded-xs">03</span>
                                        <h3 class="font-serif text-xl text-base-content">Verify Diagnostics</h3>
                                    </div>
                                    <p class="text-sm text-base-content/88 mb-4">Agent confirms the edited file has no compiler warnings or errors.</p>
                                    <div class="font-mono text-xs text-base-content/78 bg-base-100 p-2 border border-base-content/10 rounded-sm">
                                        <span class="text-accent-ink">$</span> weaver verify diagnostics \<br>
                                        &nbsp;&nbsp;--output json \<br>
                                        &nbsp;&nbsp;--uri file:///src/lib.rs
                                    </div>
                                </div>
                                <div class="lg:w-2/3 bg-neutral p-4 rounded-xs font-mono text-xs text-code-text overflow-x-auto border border-base-content/10 shadow-inner">
<pre>
<span class="text-code-muted">// CLI JSON output (--output json; no diagnostics, clean file)</span>
{"diagnostics":[]}
</pre>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Common Flags & Exit Codes -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12">

                    <!-- Common Flags -->
                    <div>
                        <h3 class="font-serif text-2xl text-base-content mb-6">Global Flags</h3>
                        <div class="reference-callout mb-6">
                            <div class="reference-callout-title">
                                {{ icon('book-open') }}
                                Canonical reference
                            </div>
                            <p class="text-sm text-base-content/80 mb-3">
                                Keep command semantics on this page. Keep config defaults, override precedence, and the JSONL envelope in the docs hub.
                            </p>
                            <div class="flex flex-wrap gap-3 text-xs font-mono">
                                <a href="/weaver/docs/#configuration" class="text-accent-ink hover:underline">Configuration</a>
                                <a href="/weaver/docs/#jsonl-schema" class="text-accent-ink hover:underline">JSONL protocol</a>
                                <a href="/weaver/docs/#capability-overrides" class="text-accent-ink hover:underline">Capability overrides</a>
                            </div>
                        </div>
                        <div class="bg-base-100 border border-base-content/20 rounded-xs overflow-hidden">
                            <table class="w-full text-left">
                                <tbody class="divide-y divide-base-content/10">
                                    <tr>
                                        <td class="p-3 font-mono text-xs text-accent-ink bg-primary/5 w-44">--output</td>
                                        <td class="p-3 text-sm text-base-content/80">Output mode: <code class="text-xs bg-primary/10 px-1">auto</code> (default), <code class="text-xs bg-primary/10 px-1">human</code>, or <code class="text-xs bg-primary/10 px-1">json</code>. <code class="text-xs bg-primary/10 px-1">auto</code> selects <code class="text-xs bg-primary/10 px-1">human</code> on a TTY, <code class="text-xs bg-primary/10 px-1">json</code> when redirected. Must appear <em>before</em> the domain/operation.</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs text-accent-ink bg-primary/5">--config-path</td>
                                        <td class="p-3 text-sm text-base-content/80">Path to an explicit <code class="text-xs bg-primary/10 px-1">weaver.toml</code> configuration file.</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs text-accent-ink bg-primary/5">--daemon-socket</td>
                                        <td class="p-3 text-sm text-base-content/80">Override daemon transport (e.g. <code class="text-xs bg-primary/10 px-1">unix:///run/user/1000/weaver.sock</code>).</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs text-accent-ink bg-primary/5">--log-filter</td>
                                        <td class="p-3 text-sm text-base-content/80">Tracing filter (default <code class="text-xs bg-primary/10 px-1">info</code>).</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs text-accent-ink bg-primary/5">--log-format</td>
                                        <td class="p-3 text-sm text-base-content/80">Log output format: <code class="text-xs bg-primary/10 px-1">json</code> (default) or <code class="text-xs bg-primary/10 px-1">compact</code>.</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs text-accent-ink bg-primary/5">--capability-overrides</td>
                                        <td class="p-3 text-sm text-base-content/80">Capability overrides. See the override syntax in the docs hub before repeating directives on the CLI.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Exit Codes -->
                    <div>
                        <h3 class="font-serif text-2xl text-base-content mb-6">Exit Codes</h3>
                        <div class="bg-base-100 border border-base-content/20 rounded-xs overflow-hidden">
                            <table class="w-full text-left">
                                <tbody class="divide-y divide-base-content/10">
                                    <tr>
                                        <td class="p-3 font-mono text-xs font-bold text-base-content bg-primary/5 w-16 text-center">0</td>
                                        <td class="p-3 text-sm text-base-content/80">Success. Command completed without error.</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs font-bold text-base-content bg-primary/5 text-center">1</td>
                                        <td class="p-3 text-sm text-base-content/80">General error (file not found, permission denied).</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs font-bold text-base-content bg-primary/5 text-center">126</td>
                                        <td class="p-3 text-sm text-base-content/80">Command invoked cannot execute (sandbox restriction).</td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-mono text-xs font-bold text-base-content bg-primary/5 text-center">130</td>
                                        <td class="p-3 text-sm text-base-content/80">Terminated by signal (Ctrl-C).</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </section>

            <!-- Capability Discovery & Output Contract -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-8">Capability Discovery &amp; Output</h2>
                    <div class="reference-callout mb-8">
                        <div class="reference-callout-title">
                            {{ icon('book-open') }}
                            Canonical reference
                        </div>
                        <p class="text-sm text-base-content/80 mb-3">
                            This page keeps the command map. The authoritative defaults, override syntax, and JSONL envelope live in the docs hub so those details only drift in one place.
                        </p>
                        <div class="flex flex-wrap gap-3 text-xs font-mono">
                            <a href="/weaver/docs/#configuration" class="text-accent-ink hover:underline">Configuration</a>
                            <a href="/weaver/docs/#capability-overrides" class="text-accent-ink hover:underline">Capability overrides</a>
                            <a href="/weaver/docs/#jsonl-schema" class="text-accent-ink hover:underline">JSONL protocol</a>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Capability probe</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                Run <code>weaver --capabilities</code> to inspect the negotiated capability surface. The full output shape and override syntax are documented in the docs hub.
                            </p>
                        </div>
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Output modes</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                <code>--output auto</code> stays the default. Use <code>human</code> for operator context and <code>json</code> for piping. The exact JSONL envelope is maintained in the docs hub.
                            </p>
                        </div>
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Failure shape</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                Capability mismatches still return structured failures with actionable hints. Keep the exact wire contract centralized so command docs can focus on operator intent.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CLI Help Discoverability (PLANNED) -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <div class="border-2 border-dashed border-base-content/40 rounded-xs p-8 opacity-80">
                        <div class="flex items-center gap-3 mb-6">
                            <h2 class="font-serif text-3xl text-base-content">CLI Help &amp; Discoverability</h2>
                            <span class="status-pill status-pill-planned">Planned</span>
                        </div>

                        <p class="mb-6 text-sm text-base-content/80">
