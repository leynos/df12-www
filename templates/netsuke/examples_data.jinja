{% macro card(ex) %}
            <article class="hm-card hm-card--interactive overflow-hidden flex flex-col h-full" data-example-card data-category="{{ ex.category }}" data-snippet="{{ ex.snippet | forceescape }}">
                <div class="h-48 bg-charcoal relative overflow-hidden group">
                     <div class="absolute inset-0 bg-[url('{{ ex.image }}')] bg-cover bg-center opacity-95"></div>
                    <div class="absolute top-4 right-4 bg-black/60 backdrop-blur px-2 py-1 rounded text-xs font-mono text-white border border-white/20">
                        <span class="iconify mr-1 {{ ex.cat_colour }} inline" data-icon="{{ ex.cat_icon }}" aria-hidden="true"></span> {{ ex.category }}
                    </div>
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <div class="mb-4">
                        <h3 class="font-serif text-xl font-bold text-charcoal mb-2">{{ ex.title }}</h3>
                        <p class="text-sm text-charcoal-mid line-clamp-3">
                            {{ ex.description }}
                        </p>
                    </div>

                    <div class="flex flex-wrap gap-2 mb-6">
                        {% for chip in ex.chips %}
                        <span class="hm-chip">{{ chip }}</span>
                        {% endfor %}
                    </div>

                    <div class="mt-auto pt-6 border-t border-stone-light flex justify-between items-center">
                        <a href="{{ ex.href }}" class="text-indigo font-bold text-sm hover:text-indigo-light flex items-center">
                            Read Guide <span class="iconify ml-2 text-xs" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </a>
                        <div class="flex space-x-3">
                            <button type="button" class="text-stone hover:text-charcoal transition-colors" title="Copy manifest" aria-label="Copy the {{ ex.title }} manifest to the clipboard" data-copy-snippet><span class="iconify" data-icon="carbon:copy" aria-hidden="true"></span></button>
                            <a href="{{ ex.github }}" class="text-stone hover:text-charcoal transition-colors" title="View on GitHub"><span class="iconify" data-icon="carbon:logo-github" aria-hidden="true"></span></a>
                        </div>
                    </div>
                </div>
            </article>
{% endmacro %}

{% macro filter_buttons() %}
                    <button type="button" class="hm-chip hm-chip--filter hm-chip--active" data-example-filter="all" aria-pressed="true">All</button>
                    {% for ex in examples %}
                    {% if ex.category not in (examples[:loop.index0] | map(attribute='category') | list) %}
                    <button type="button" class="hm-chip hm-chip--filter" data-example-filter="{{ ex.category }}" aria-pressed="false">{{ ex.category }}</button>
                    {% endif %}
                    {% endfor %}
{% endmacro %}

{% macro up_next(current_key) %}
{% set ns = namespace(next=none) %}
{% for ex in examples %}
{% if ex.key == current_key %}
{% set ns.next = examples[loop.index % (examples | length)] %}
{% endif %}
{% endfor %}
{% if ns.next %}
                <div class="bg-indigo rounded-xl p-6 text-white shadow-lg relative overflow-hidden">
                    <div class="absolute top-0 right-0 -mr-10 -mt-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
                    <h3 class="font-serif text-lg font-bold mb-2 relative z-10">Up Next</h3>
                    <p class="text-indigo-100 text-sm mb-4 relative z-10">{{ ns.next.description }}</p>
                    <a href="{{ ns.next.href }}" class="block bg-white/10 backdrop-blur border border-white/20 rounded-lg p-3 hover:bg-white/20 transition-colors relative z-10">
                        <div class="flex justify-between items-center mb-1"><span class="text-xs font-mono text-amber">{{ ns.next.category }}</span><span class="iconify text-xs opacity-70" data-icon="carbon:arrow-right" aria-hidden="true"></span></div>
                        <div class="font-bold text-sm">{{ ns.next.title }}</div>
                    </a>
                </div>
{% endif %}
{% endmacro %}
