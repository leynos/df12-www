{% extends "doc_page.jinja" %}
{% set active_nav = 'docs' %}
{% block page_title %}Documentation Hub - Netsuke Build System{% endblock %}
{% block content %}
{% raw %}
    <!-- Main Content Area with Sidebar -->
    <div class="site-container pt-16 flex-grow flex">

        <!-- Sidebar Navigation (Desktop) -->
        <aside id="sidebar" class="hidden lg:block w-64 flex-shrink-0 h-[calc(100vh-4rem)] sticky top-16 overflow-y-auto border-r border-stone-light pr-6 py-8">
            <!-- Search -->
            <div
                class="mb-8 relative"
                data-doc-search-root
                data-doc-search-index="/netsuke/assets/search/docs-search.json"
            >
                <span class="iconify absolute left-3 top-2.5 text-stone text-sm" data-icon="carbon:search" aria-hidden="true"></span>
                <input
                    type="text"
                    placeholder="Search docs..."
                    class="search-input w-full pl-9 pr-4 py-2 bg-white border border-stone rounded-md text-sm text-charcoal placeholder-stone focus:border-indigo transition-colors shadow-sm"
                    data-doc-search-input
                    aria-label="Search the documentation"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                >
                <div class="absolute right-3 top-2.5 text-xs text-stone font-mono">⌘K</div>
                <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-doc-search-panel>
                    <div class="overflow-hidden rounded-xl border border-stone bg-white shadow-paper-lg">
                        <ul class="max-h-96 overflow-y-auto divide-y divide-stone-light" data-doc-search-results role="listbox"></ul>
                        <p class="border-t border-stone-light bg-boxwood-pale px-4 py-3 text-xs text-charcoal-light" data-doc-search-meta>
                            Type at least 2 characters to search the docs.
                        </p>
                    </div>
                </div>
            </div>

            <nav class="space-y-8">
                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Introduction</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/" class="sidebar-link active block px-2 py-1.5 text-sm font-medium rounded-r-md transition-colors">Documentation Hub</a></li>
                        <li><a href="/netsuke/docs/getting-started/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Getting Started</a></li>
                        <li><a href="/netsuke/docs/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Installation</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Core Concepts</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/manifest-reference/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Manifest Reference</a></li>
                        <li><a href="/netsuke/docs/rules-and-targets/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Rules &amp; Targets</a></li>
                        <li><a href="/netsuke/docs/templating-and-standard-library/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Templating</a></li>
                        <li><a href="/netsuke/docs/templating-and-standard-library/" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Standard Library</a></li>
                    </ul>
                </div>

                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">Reference</h3>
                    <ul class="space-y-1">
                        <li><a href="/netsuke/docs/cli-security-and-configuration/#cli" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">CLI Commands</a></li>
                        <li><a href="/netsuke/docs/cli-security-and-configuration/#configuration" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Configuration</a></li>
                        <li><a href="/netsuke/docs/cli-security-and-configuration/#security" class="sidebar-link block px-2 py-1.5 text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light rounded-r-md transition-colors">Security Model</a></li>
                    </ul>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <main id="main-content" class="hm-docs-content flex-1 min-w-0 py-12 px-4 sm:px-6 lg:px-12">

            <!-- Breadcrumbs -->
            <nav class="flex items-center text-sm text-charcoal-light mb-8 font-mono">
                <a href="/netsuke/" class="hover:text-vermillion transition-colors">Home</a>
                <span class="mx-2 text-stone">/</span>
                <span class="text-charcoal font-medium">Documentation</span>
            </nav>

            <!-- Page Header -->
            <div class="mb-12 border-b border-stone-light pb-8">
                <div class="inline-flex items-center px-3 py-1 rounded-full bg-boxwood-light text-indigo text-xs font-semibold uppercase tracking-wider border border-stone mb-4">
                    Documentation
                </div>
                <h1 class="font-serif text-4xl lg:text-5xl font-bold text-charcoal mb-6">Documentation Hub</h1>
                <p class="text-xl text-charcoal-mid font-light leading-relaxed max-w-3xl">
                    Welcome to the Netsuke documentation. Start with the YAML manifest, learn how Jinja expands it, then follow the path through validation and Ninja execution.
                </p>
            </div>

            <!-- Start Here Section -->
            <section id="start-here" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:flag" aria-hidden="true"></span> Start Here
                </h2>
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Quickstart Card -->
                    <a href="/netsuke/docs/getting-started/" class="group block p-6 bg-white rounded-xl border border-stone shadow-sm hover:shadow-paper hover:border-indigo transition-all">
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-10 h-10 rounded-lg bg-indigo/10 text-indigo flex items-center justify-center text-lg">
                                <span class="iconify" data-icon="carbon:rocket" aria-hidden="true"></span>
                            </div>
                            <span class="text-xs font-mono text-stone-light group-hover:text-indigo transition-colors">5 min read</span>
                        </div>
                        <h3 class="font-bold text-charcoal text-lg mb-2 group-hover:text-indigo transition-colors">Getting Started</h3>
                        <p class="text-charcoal-mid text-sm leading-relaxed mb-4">
                            Install Netsuke, create a small <code>Netsukefile</code>, and build the default targets.
                        </p>
                        <div class="text-indigo text-sm font-medium flex items-center">
                            Start tutorial <span class="iconify ml-2 text-xs transition-transform group-hover:translate-x-1" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </div>
                    </a>

                    <!-- Core Concepts Card -->
                    <a href="/netsuke/docs/" class="group block p-6 bg-white rounded-xl border border-stone shadow-sm hover:shadow-paper hover:border-vermillion transition-all">
                        <div class="flex items-start justify-between mb-4">
                            <div class="w-10 h-10 rounded-lg bg-vermillion/10 text-vermillion flex items-center justify-center text-lg">
                                <span class="iconify" data-icon="carbon:cube-view" aria-hidden="true"></span>
                            </div>
                            <span class="text-xs font-mono text-stone-light group-hover:text-vermillion transition-colors">Conceptual</span>
                        </div>
                        <h3 class="font-bold text-charcoal text-lg mb-2 group-hover:text-vermillion transition-colors">How it Works</h3>
                        <p class="text-charcoal-mid text-sm leading-relaxed mb-4">
                            Understand the six-stage pipeline: YAML first, template expansion second, Ninja last.
                        </p>
                        <div class="text-vermillion text-sm font-medium flex items-center">
                            Learn the basics <span class="iconify ml-2 text-xs transition-transform group-hover:translate-x-1" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </div>
                    </a>
                </div>
            </section>

            <!-- Browse by Topic -->
            <section id="topics" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-8">Browse by Topic</h2>

                <div class="grid md:grid-cols-3 gap-6">
                    <!-- Topic 1: Manifests -->
                    <div class="bg-boxwood-pale rounded-lg p-6 border border-stone">
                        <h3 class="font-serif font-bold text-charcoal mb-3 flex items-center">
                            <span class="iconify text-charcoal-light mr-2 text-sm" data-icon="carbon:code-reference" aria-hidden="true"></span> Manifests
                        </h3>
                        <ul class="space-y-2 text-sm">
                            <li><a href="/netsuke/docs/manifest-reference/" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Netsukefile Syntax</a></li>
                            <li><a href="/netsuke/docs/templating-and-standard-library/" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Jinja Templating</a></li>
                            <li><a href="/netsuke/docs/" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Glob Patterns</a></li>
                        </ul>
                    </div>

                    <!-- Topic 2: Rules -->
                    <div class="bg-boxwood-pale rounded-lg p-6 border border-stone">
                        <h3 class="font-serif font-bold text-charcoal mb-3 flex items-center">
                            <span class="iconify text-charcoal-light mr-2 text-sm" data-icon="carbon:tools" aria-hidden="true"></span> Rules &amp; Targets
                        </h3>
                        <ul class="space-y-2 text-sm">
                            <li><a href="/netsuke/docs/rules-and-targets/" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Defining Rules</a></li>
                            <li><a href="/netsuke/docs/rules-and-targets/" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Actions, Phony, and Defaults</a></li>
                            <li><a href="/netsuke/docs/" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Custom Actions</a></li>
                        </ul>
                    </div>

                    <!-- Topic 3: CLI -->
                    <div class="bg-boxwood-pale rounded-lg p-6 border border-stone">
                        <h3 class="font-serif font-bold text-charcoal mb-3 flex items-center">
                            <span class="iconify text-charcoal-light mr-2 text-sm" data-icon="carbon:terminal" aria-hidden="true"></span> CLI Reference
                        </h3>
                        <ul class="space-y-2 text-sm">
                            <li><a href="/netsuke/docs/cli-security-and-configuration/#cli" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Build Commands</a></li>
                            <li><a href="/netsuke/docs/cli-security-and-configuration/#cli" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Query Graph</a></li>
                            <li><a href="/netsuke/docs/cli-security-and-configuration/#cli" class="text-charcoal-mid hover:text-vermillion transition-colors flex items-center"><span class="w-1.5 h-1.5 bg-stone rounded-full mr-2"></span>Clean &amp; Maintenance</a></li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- Example Code Block -->
            <section id="example-preview" class="mb-16 bg-white border border-stone rounded-xl overflow-hidden shadow-sm">
                <div class="grid lg:grid-cols-5">
                    <div class="p-8 lg:col-span-2 bg-boxwood-pale border-r border-stone flex flex-col justify-center">
                        <h3 class="font-serif text-xl font-bold text-charcoal mb-3">Self-documenting builds</h3>
                        <p class="text-sm text-charcoal-mid mb-6 leading-relaxed">
                            Netsuke configurations are designed to be read by humans. The syntax is minimal, removing the boilerplate found in other build tools.
                        </p>
                        <a href="/netsuke/examples/" class="inline-flex items-center text-sm font-bold text-indigo hover:text-indigo-light">
                            View full examples <span class="iconify ml-2" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </a>
                    </div>
                    <div class="lg:col-span-3 bg-charcoal p-6 overflow-x-auto">
                        <div class="flex items-center justify-between mb-4 text-xs font-mono text-stone-light opacity-50">
                            <span>examples/basic/Netsukefile</span>
                            <span>RO</span>
                        </div>
<pre class="font-mono text-sm leading-relaxed text-stone-light"><code><span class="text-charcoal-light"># Compile a simple C program</span>
<span class="text-indigo-light">netsuke_version</span>: <span class="text-matcha">"1.0.0"</span>

<span class="text-indigo-light">rules</span>:
  - <span class="text-amber">name</span>: <span class="text-matcha">"compile"</span>
    <span class="text-amber">command</span>: <span class="text-matcha">"gcc -c {{ ins }} -o {{ outs }}"</span>

<span class="text-indigo-light">targets</span>:
  - <span class="text-amber">name</span>: <span class="text-matcha">"hello_world"</span>
    <span class="text-amber">command</span>: <span class="text-matcha">"gcc {{ ins }} -o {{ outs }}"</span>
    <span class="text-amber">sources</span>: [<span class="text-matcha">"main.o"</span>, <span class="text-matcha">"print.o"</span>]</code></pre>
                    </div>
                </div>
            </section>

            <!-- Popular Guides -->
            <section id="popular-guides">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="font-serif text-2xl font-bold text-charcoal">Popular Guides</h2>
                    <a href="/netsuke/guides/" class="text-sm font-medium text-charcoal-mid hover:text-vermillion transition-colors hidden sm:block">View all guides</a>
                </div>

                <div class="space-y-4">
                    <!-- Guide Row 1 -->
                    <a href="/netsuke/docs/" class="block group">
                        <div class="flex items-start p-4 rounded-lg hover:bg-white border border-transparent hover:border-stone hover:shadow-sm transition-all">
                            <div class="flex-shrink-0 mt-1 mr-4 text-stone-light group-hover:text-indigo transition-colors">
                                <span class="iconify text-2xl" data-icon="carbon:logo-python" aria-hidden="true"></span>
                            </div>
                            <div>
                                <h4 class="text-charcoal font-bold mb-1 group-hover:text-indigo transition-colors">Building Python Extensions with C++</h4>
                                <p class="text-sm text-charcoal-mid">Learn how to create a mixed-language build graph for high-performance Python modules.</p>
                            </div>
                            <div class="ml-auto pl-4 self-center hidden sm:block">
                                <span class="iconify text-stone-light text-sm group-hover:text-indigo transition-colors" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                            </div>
                        </div>
                    </a>

                    <!-- Guide Row 2 -->
                    <a href="/netsuke/docs/" class="block group">
                        <div class="flex items-start p-4 rounded-lg hover:bg-white border border-transparent hover:border-stone hover:shadow-sm transition-all">
                            <div class="flex-shrink-0 mt-1 mr-4 text-stone-light group-hover:text-matcha transition-colors">
                                <span class="iconify text-2xl" data-icon="carbon:container-software" aria-hidden="true"></span>
                            </div>
                            <div>
                                <h4 class="text-charcoal font-bold mb-1 group-hover:text-matcha transition-colors">Reproducible Builds</h4>
                                <p class="text-sm text-charcoal-mid">Understand how Netsuke keeps structure explicit, renders strings late, and produces reproducible Ninja plans.</p>
                            </div>
                            <div class="ml-auto pl-4 self-center hidden sm:block">
                                <span class="iconify text-stone-light text-sm group-hover:text-matcha transition-colors" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                            </div>
                        </div>
                    </a>

                    <!-- Guide Row 3 -->
                    <a href="/netsuke/docs/" class="block group">
                        <div class="flex items-start p-4 rounded-lg hover:bg-white border border-transparent hover:border-stone hover:shadow-sm transition-all">
                            <div class="flex-shrink-0 mt-1 mr-4 text-stone-light group-hover:text-amber transition-colors">
                                <span class="iconify text-2xl" data-icon="carbon:renew" aria-hidden="true"></span>
                            </div>
                            <div>
                                <h4 class="text-charcoal font-bold mb-1 group-hover:text-amber transition-colors">Migrating from Make</h4>
                                <p class="text-sm text-charcoal-mid">A step-by-step guide to converting legacy Makefiles to declarative Netsuke manifests.</p>
                            </div>
                            <div class="ml-auto pl-4 self-center hidden sm:block">
                                <span class="iconify text-stone-light text-sm group-hover:text-amber transition-colors" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                            </div>
                        </div>
                    </a>
                </div>
            </section>

            <!-- Help Footer -->
            <div class="mt-20 pt-10 border-t border-stone-light">
                <div class="bg-indigo/5 rounded-xl p-8 text-center border border-indigo/10">
                    <h3 class="font-serif text-xl font-bold text-charcoal mb-3">Still have questions?</h3>
                    <p class="text-charcoal-mid mb-6 max-w-lg mx-auto">
                        Can't find what you're looking for in the docs? Open an issue on GitHub.
                    </p>
                    <div class="flex justify-center space-x-4">
                        <a href="https://github.com/leynos/netsuke/issues" class="hm-button hm-button--ghost inline-flex items-center px-5 py-2 text-sm">
                            <span class="iconify mr-2" data-icon="carbon:logo-github" aria-hidden="true"></span> GitHub Issues
                        </a>
                    </div>
                </div>
            </div>

        </main>
    </div>
    <script defer src="/netsuke/assets/vendor/minisearch.js"></script>
    <script defer src="/netsuke/assets/js/doc-search.js"></script>
{% endraw %}
{% endblock %}
