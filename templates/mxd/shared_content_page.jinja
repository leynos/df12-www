<!DOCTYPE html><html lang="en"><head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} — mxd</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@100;200;300;400;500;600;700;800;900&amp;family=DM+Serif+Display:ital,wght@0,400;1,400&amp;family=Source+Serif+4:ital,wght@200;300;400;600;700;900&amp;family=Inter:wght@100;200;300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        "primary": ["JetBrains Mono", "monospace"],
                        "secondary": ["DM Serif Display", "serif"],
                        "tertiary": ["Source Serif 4", "serif"]
                    }
                }
            }
        };
    </script>
    <link rel="icon" href="../assets/logo-mark.svg" type="image/svg+xml">
    <link rel="stylesheet" href="../{{ stylesheet or 'assets/site.css' }}">
</head>
<body class="bg-[#fdf8f0]">
<a class="mxd-skip-link" href="#main-content">Skip to content</a>
<header class="mxd-site-header">
  <div class="mxd-site-header__inner">
    <a class="mxd-brand" href="../">
      <img src="../assets/logo-mark.svg" alt="">
      <span>
        <span class="mxd-brand__eyebrow">df12 Productions</span>
        <span class="mxd-brand__title">Marrakesh Express Daemon</span>
      </span>
    </a>
    <nav class="mxd-site-nav" aria-label="Primary">
      {% for link in nav_links %}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
<main id="main-content" tabindex="-1">

<section id="hero-section" class="relative bg-[#12121f] overflow-hidden">
    <div class="mxd-pattern mxd-pattern--hero absolute inset-0 opacity-60" aria-hidden="true"></div>

    <div class="absolute top-0 left-0 right-0 h-1 mxd-express-line bg-gradient-to-r from-[#c54b2a] via-[#e8a838] to-[#2d3a8c]"></div>

    <div class="relative max-w-[900px] mx-auto px-4 sm:px-8 pt-20 pb-12">
        <div class="inline-flex px-3 py-1 rounded-sm border border-[#c89430] mb-6">
            <div class="text-[#e8a838] text-[11.10px] font-bold font-primary uppercase tracking-[0.15em]">Legal · {{ title }}</div>
        </div>

        <h1 class="mb-6">
            <span class="text-[#f5e6d0] text-4xl sm:text-5xl md:text-[68.80px] font-normal font-secondary leading-tight sm:leading-[72.24px]">{{ title }}</span>
        </h1>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[#c54b2a] via-[#e8a838] to-[#2d3a8c]"></div>
</section>

<div class="border-t border-[#e8d5b8] py-16 sm:py-20">
    <div class="max-w-[900px] mx-auto px-4 sm:px-8">
        <article class="mxd-prose space-y-8 text-[#12121f] text-base font-normal font-tertiary leading-[27.20px]">
            {{ body_html }}
        </article>
    </div>
</div>

</main>

<footer id="footer" class="bg-[#12121f] relative">
    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#c54b2a] via-[#e8a838] to-[#2d3a8c]"></div>
    <div class="max-w-[900px] mx-auto px-4 sm:px-8 py-12 text-center">
        <div class="mb-6 opacity-40">
            <span class="text-[#e8d5b8] text-[23px] font-normal font-primary">◆</span>
        </div>
        <p class="text-[#3a3a55] text-[11.10px] font-normal font-secondary leading-[18.88px] mb-2">
            Protocol Souk — Design System for <span class="text-[#e8a838]">mxd</span>
        </p>
        <p class="text-[#3a3a55] text-[11.10px] font-normal font-secondary leading-[18.88px]">
            A <span class="text-[#e8a838]">df12 Productions</span> artefact · Edinburgh · 2026
        </p>
    </div>
    <div class="border-t border-[#2a2a42] py-6">
        <div class="max-w-[900px] mx-auto px-4 sm:px-8 flex flex-col sm:flex-row justify-between items-center text-[11.10px] font-primary">
            <p class="text-[#9a9ab0] mb-3 sm:mb-0">&copy; 2026 df12 Productions</p>
            <nav class="mxd-legal-nav flex space-x-6" aria-label="Legal">
                <a href="../privacy-policy/" class="text-[#9a9ab0] hover:text-[#e8d5b8] transition-colors">Privacy Policy</a>
                <a href="../terms-of-use/" class="text-[#9a9ab0] hover:text-[#e8d5b8] transition-colors">Terms of Use</a>
                <a href="../code-of-conduct/" class="text-[#9a9ab0] hover:text-[#e8d5b8] transition-colors">Code of Conduct</a>
            </nav>
        </div>
    </div>
</footer>

</body></html>
