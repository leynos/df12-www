                        <!-- TOML example -->
                        <div class="bg-weaver-dark p-6 rounded-sm shadow-lg overflow-x-auto border border-weaver-indigo/20 mb-8 paper-panel">
                            <div class="flex justify-between items-center mb-4 border-b border-white/10 pb-2">
                                <span class="text-xs font-mono text-weaver-cream/60">weaver.toml</span>
                                <button class="text-xs text-weaver-cream/40 hover:text-white"><i class="fa-regular fa-copy"></i></button>
                            </div>
<pre class="font-mono text-sm text-gray-300 leading-relaxed">
<span class="text-gray-500"># Top-level keys (no [section] headers)</span>

<span class="text-gray-500"># Daemon transport (Unix socket or TCP)</span>
daemon_socket = { transport = <span class="text-green-400">"tcp"</span>, host = <span class="text-green-400">"127.0.0.1"</span>, port = <span class="text-yellow-400">9779</span> }

<span class="text-gray-500"># Logging</span>
log_filter = <span class="text-green-400">"info"</span>
log_format = <span class="text-green-400">"compact"</span>  <span class="text-gray-500"># Example override: default is "json"</span>

<span class="text-gray-500"># Capability overrides (repeatable)</span>
<span class="text-weaver-faded">[[capability_overrides]]</span>
language = <span class="text-green-400">"python"</span>
capability = <span class="text-green-400">"observe.call-hierarchy"</span>
directive = <span class="text-green-400">"force"</span>
</pre>
                        </div>

                        <!-- XDG discovery -->
                        <h3 id="xdg-discovery" class="font-serif text-xl text-weaver-indigo mb-3 scroll-mt-20">File Discovery</h3>
                        <p class="mb-4 text-sm text-weaver-indigo/80">
                            When <code class="font-mono text-xs bg-weaver-indigo/10 px-1">--config-path</code> is not supplied, the loader searches the standard XDG locations for <code class="font-mono text-xs bg-weaver-indigo/10 px-1">weaver.toml</code> or <code class="font-mono text-xs bg-weaver-indigo/10 px-1">.weaver.toml</code>. Discovery honours <code class="font-mono text-xs bg-weaver-indigo/10 px-1">XDG_CONFIG_HOME</code> (typically <code class="font-mono text-xs bg-weaver-indigo/10 px-1">~/.config/weaver/</code>) and falls back to the project root. If no files exist, the built-in defaults apply.
                        </p>

                        <!-- Fail-fast behaviour -->
                        <h3 id="fail-fast" class="font-serif text-xl text-weaver-indigo mb-3 scroll-mt-20">Fail-Fast Validation</h3>
                        <p class="mb-4 text-sm text-weaver-indigo/80">
                            <code class="font-mono text-xs bg-weaver-indigo/10 px-1">ortho-config</code> v0.6.0 treats invalid configuration files as fatal. Both the CLI and daemon abort with a <code class="font-mono text-xs bg-weaver-indigo/10 px-1">LoadConfiguration</code> error that lists every offending path. No silent fallback — fix or remove the reported files.
                        </p>
                        <div class="bg-weaver-dark p-4 rounded-sm border border-weaver-indigo/20 overflow-x-auto mb-8 paper-panel">
                            <div class="text-[10px] font-mono text-white/30 uppercase tracking-widest mb-2">EXAMPLE ERROR OUTPUT</div>
<pre class="font-mono text-xs text-gray-300 leading-relaxed">
failed to load configuration: multiple configuration errors:
1: Configuration file error in '/etc/weaver/weaver.toml': expected `}`
2: Configuration file error in '/home/alex/.weaver.toml': invalid type:
string "yes", expected a boolean
</pre>
                        </div>

                        <!-- Environment variables -->
                        <h3 id="environment-variables" class="font-serif text-xl text-weaver-indigo mb-3 scroll-mt-20">Environment Variables</h3>
                        <div class="border border-weaver-indigo/20 rounded-sm bg-white overflow-hidden mb-8">
