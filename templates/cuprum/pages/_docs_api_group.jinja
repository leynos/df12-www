{#
  One API reference page. A child sets `api_slug` to a group slug from
  data/api.jinja; the page lists that group's entries in order.
#}
{% extends "pages/_docs.jinja" %}
{% import "_api.jinja" as api %}
{% import "components.jinja" as ui %}
{% from "data/api.jinja" import api_groups, api_source %}
{% set docs_group = api_groups | selectattr('slug', 'equalto', api_slug) | first %}
{% set docs_current = '/cuprum/docs/api/' ~ api_slug ~ '/' %}
{% set slugs = api_groups | map(attribute='slug') | list %}
{% set position = slugs.index(api_slug) %}
{% block title %}{{ docs_group.title }} · API reference · Cuprum{% endblock %}
{% block description %}{{ docs_group.lede }}{% endblock %}
{% block docs_body %}
          <header class="cu-docs__head">
            <p class="cu-kicker">API reference · {{ '%02d' % (position + 1) }} of {{ slugs | length }}</p>
            <h1 class="cu-docs__title">{{ docs_group.title }}</h1>
            <p class="cu-docs__lede">{{ docs_group.lede }}</p>
            <p class="cu-docs__meta">Read from Cuprum {{ api_source.version }} at <a href="{{ repository_url }}/tree/{{ api_source.commit }}">{{ api_source.commit[:8] }}</a></p>
          </header>
          <div class="cu-api">
            {% for e in docs_group.entries %}
            {{ api.entry(e) }}
            {% endfor %}
          </div>
          {% set prev = api_groups[position - 1] if position > 0 else none %}
          {% set next = api_groups[position + 1] if position + 1 < api_groups | length else none %}
          {{ ui.pager(
            {'href': '/cuprum/docs/api/' ~ prev.slug ~ '/', 'title': prev.title} if prev else {'href': '/cuprum/docs/api/', 'title': 'API reference'},
            {'href': '/cuprum/docs/api/' ~ next.slug ~ '/', 'title': next.title} if next else {'href': '/cuprum/docs/', 'title': 'Documentation'}
          ) }}
{% endblock %}
