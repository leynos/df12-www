{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!node_modules",
      "!dist",
      "!.bin",
      "!.pnpm-store",
      "!.cache",
      "!.artifacts",
      "!.act-stubs",
      "!public/assets",
      "!public/netsuke/assets/vendor",
      "!src/static/**/vendor"
    ],
    "ignoreUnknown": true
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      },
      "style": {
        "useForOf": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": ["**/*.html"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": { "enabled": false }
    },
    {
      // The Pygments blocks in these two stylesheets are written by
      // scripts/generate_*_pygments_css.py, which emits one rule per line.
      // Formatting them here would put the formatter and the generator in a
      // loop, each undoing the other on the next run.
      "includes": [
        "src/static/stilyagi/assets/styles/syntax.css",
        "src/static/netsuke/assets/css/himotoshi.css"
      ],
      "formatter": { "enabled": false }
    },
    {
      // Standalone .svg assets are referenced from CSS as images. The a11y
      // rules that fire on them (noSvgWithoutTitle) are written for inline
      // JSX, where the <svg> is part of a document's accessibility tree.
      "includes": ["**/*.svg"],
      "linter": { "enabled": false }
    },
    {
      // The sub-site scripts are classic scripts, loaded with a plain
      // <script src>, not modules: each wraps itself in an IIFE and the
      // "use strict" directive inside it does real work.
      "includes": ["src/static/**/assets/js/**"],
      "linter": {
        "rules": {
          "suspicious": { "noRedundantUseStrict": "off" }
        }
      }
    }
  ]
}
