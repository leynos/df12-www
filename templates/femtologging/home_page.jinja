{% extends '_layout.jinja' %}
{% import 'components.jinja' as ui with context %}
{% import '_code.jinja' as samples with context %}
{% from 'data/plates.jinja' import plates, magnification, specimens %}
{% set capabilities = [
  ('branch', 'Familiar loggers', 'Dotted names, levels, and propagation, through get_logger or getLogger.', 'docs/guides/loggers', 'Route loggers'),
  ('record', 'Structured records', 'Validated extra fields, exc_info, and stack_info travel with each record.', 'docs/guides/structured-records', 'Add context'),
  ('queue', 'Bounded queues', 'Every handler owns a finite queue and a stated overflow policy.', 'docs/guides/operations', 'Plan for pressure'),
  ('worker', 'Rust workers', 'File and network I/O run on handler threads, off the producer path.', 'architecture', 'See the runtime'),
  ('compatibility', 'Stdlib adapter', 'Reuse an existing logging.Handler through StdlibHandlerAdapter.', 'compatibility', 'Check the surface'),
  ('lattice-defect', 'Rust bridges', 'Optional log and tracing bridges route Rust events to the same handlers.', 'docs/api/rust-bridges', 'Read the bridges'),
] %}
{% block content %}
<section class="fl-cover fl-dark fl-grain" aria-labelledby="cover-title">
  <div class="fl-cover__copy">
    <p class="fl-label">The femtofauna survey · A Python logging runtime</p>
    <h1 id="cover-title">Logging,<br>under the<br><em>microscope.</em></h1>
    <p class="fl-cover__line">Python above. Rust below.</p>
    <p class="fl-cover__copy-text">A logging runtime for Python that delegates record dispatch and output to Rust worker threads, with bounded queues, structured records, and an explicit compatibility surface.</p>
    <div class="fl-actions">{{ ui.button('Get started', '/femtologging/getting-started/') }}{{ ui.button('Read the docs', '/femtologging/docs/', true) }}</div>
    <dl class="fl-facts">
      <div><dt>{{ femto_version }}</dt><dd>Next release, forthcoming</dd></div>
      <div><dt>Python {{ python_floor }}+</dt><dd>Source build today</dd></div>
      <div><dt>Rust workers</dt><dd>One per handler</dd></div>
    </dl>
  </div>
  {{ ui.plate('cover', 'cover', eager=true, sizes='(width < 1024px) 100vw, 70vw') }}
</section>

<section class="fl-section" aria-labelledby="why">
  <div class="fl-shell">
    {{ ui.section_head('why', '01 / Field summary', 'Why femtologging?', 'Serious logging.<br>Unexpected company.' | safe) }}
    <ul class="fl-capabilities">{% for icon, title, text, slug, link in capabilities %}<li><span class="fl-capabilities__icon">{{ ui.icon(icon) }}</span><h3>{{ title }}</h3><p>{{ text }}</p><a href="/femtologging/{{ slug }}/">{{ link }}<span class="fl-visually-hidden">: {{ title | lower }}</span> {{ ui.icon('arrow-right') }}</a></li>{% endfor %}</ul>
  </div>
</section>

<section class="fl-section fl-dark fl-grain fl-lattice" aria-labelledby="smaller">
  <div class="fl-shell">
    {{ ui.section_head('smaller', '02 / Magnification series', 'Explore a smaller world.', 'From your application<br>to the femtoscale.' | safe) }}
    <figure class="fl-series">
      <ol>{% for step in magnification %}{% set p = plates[step.plate] %}<li><img src="/femtologging/assets/images/{{ p.file }}-half.webp" alt="{{ p.alt }}" width="{{ p.width // 2 }}" height="{{ p.height // 2 }}" loading="lazy" decoding="async"><span class="fl-series__power">{{ step.power }}</span><span class="fl-series__title">{{ step.title }}</span></li>{% endfor %}</ol>
      <figcaption><span class="fl-label">Plates 05–09 · Fictional scientific illustration</span> Five fields of view, from the application to a single transport unit. Powers of ten are illustrative; calibration remains disputed.</figcaption>
    </figure>
  </div>
</section>

<section class="fl-section" aria-labelledby="observe">
  <div class="fl-shell fl-two">
    <div>
      <p class="fl-label">03 / First observation</p>
      <h2 id="observe">A record enters<br>the system.</h2>
      <p class="fl-intro">Configure output, emit a message, then drain the named logger and its root output before exit. The application owns the lifecycle.</p>
      <p>The 0.2.0 surface adds validated <code>extra</code> fields to named loggers. Context travels with the record; the message remains a string.</p>
      <p><a href="/femtologging/getting-started/">Build from source and run the example {{ ui.icon('arrow-right') }}</a></p>
      <p class="fl-version">Source revision {{ femto_revision[:7] }}<br>Release target {{ femto_version }}</p>
    </div>
    <div>{{ samples.code('first-record.py') }}{% call samples.output() %}survey.transport [INFO] record received{% endcall %}</div>
  </div>
</section>

<section class="fl-section fl-dark fl-grain" aria-labelledby="pipeline">
  <div class="fl-shell">
    {{ ui.section_head('pipeline', '04 / Runtime cross-section', 'The path is small.<br>The boundaries matter.' | safe, 'Python creates the record.<br>Rust routes it to handlers.' | safe) }}
    <ol class="fl-path" aria-label="Record path">{% for name, icon, detail in [('Python', 'record', 'Message, extra, exception'), ('Logger', 'branch', 'Levels and propagation'), ('Queue', 'queue', 'Finite capacity'), ('Handler', 'handler', 'Worker-backed output'), ('Output', 'output', 'Stream, file, or network')] %}<li><span class="fl-path__step">{{ '%02d' | format(loop.index) }}</span>{{ ui.icon(icon) }}<strong>{{ name }}</strong><span>{{ detail }}</span></li>{% endfor %}</ol>
    {{ ui.plate('panorama', 'wide', sizes='(width < 1360px) 100vw, 1280px') }}
    <div class="fl-boundaries">
      <div><h3>Capacity is a choice.</h3><p>Full queues can reject records. Handler policies and drop counters need an operational plan.</p><a href="/femtologging/docs/guides/operations/">Handle pressure and shutdown {{ ui.icon('arrow-right') }}</a></div>
      <div><h3>Output has an owner.</h3><p>Stream, file, rotating file, socket, and HTTP handlers have different failure and shutdown contracts.</p><a href="/femtologging/docs/guides/handlers/">Choose an output {{ ui.icon('arrow-right') }}</a></div>
      <div><h3>Familiar has limits.</h3><p>Named loggers and handler adapters support adoption. Full stdlib parity remains a goal.</p><a href="/femtologging/compatibility/">Check compatibility {{ ui.icon('arrow-right') }}</a></div>
    </div>
  </div>
</section>

<section class="fl-section" aria-labelledby="specimens">
  <div class="fl-shell">
    {{ ui.section_head('specimens', '05 / Specimen notes', 'Machinery. With residents.', 'Field notes<br>from the pipeline.' | safe, 'The survey is fiction. The queue policy is configuration.') }}
    <div class="fl-specimens">{% for s in specimens %}{{ ui.specimen_card(s, loop.index) }}{% endfor %}</div>
  </div>
</section>

<section class="fl-dark fl-grain fl-closing-band" aria-labelledby="closing">
  <div class="fl-shell fl-closing">
    <div><p class="fl-label">Continue the investigation</p><h2 id="closing">Start with one record.</h2><p class="fl-intro">One named logger, one handler, one flush. Then look closer.</p></div>
    <div class="fl-actions">{{ ui.button('Get started', '/femtologging/getting-started/') }}{{ ui.button('Explore the roadmap', '/femtologging/roadmap/', true) }}</div>
  </div>
</section>
{% endblock %}
