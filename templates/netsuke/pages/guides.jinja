{% extends "doc_page.jinja" %}
{% set active_nav = 'guides' %}
{% block page_title %}Guides Hub - Netsuke Build System{% endblock %}
{% block content %}
{% raw %}
<main id="main-content" class="flex-grow pt-24 pb-20 site-container w-full">

        <!-- Hero Section -->
        <header id="guides-hero" class="mb-16 text-center max-w-3xl mx-auto">
            <div class="inline-flex items-center px-3 py-1 rounded-full bg-boxwood text-charcoal-mid text-xs font-semibold uppercase tracking-wider border border-stone mb-6">
                Concepts & Contribution
            </div>
            <h1 class="font-serif text-5xl lg:text-6xl font-bold text-charcoal mb-6">Guides & Deep Dives</h1>
            <p class="text-xl text-charcoal-mid font-light leading-relaxed">
                Understand the compiler model behind Netsuke, learn where the sharp edges are, and use the same language the manifests use.
            </p>
        </header>

        <!-- Featured Guide (How it works) -->
        <section id="featured-guide" class="mb-20">
            <div class="hm-card hm-card--interactive overflow-hidden group">
                <div class="grid lg:grid-cols-2">
                    <div class="p-8 lg:p-12 flex flex-col justify-center">
                        <div class="flex items-center space-x-2 text-indigo font-mono text-sm mb-4">
                            <span  class="iconify" data-icon="carbon:layers" aria-hidden="true"></span>
                            <span>Architecture</span>
                        </div>
                        <h2 class="font-serif text-3xl font-bold text-charcoal mb-4 group-hover:text-indigo transition-colors">How Netsuke Works</h2>
                        <p class="text-charcoal-mid mb-8 leading-relaxed">
                            Explore the six-stage pipeline that turns a YAML manifest into a static Ninja plan. The dynamic work happens up front, so execution stays fast and legible.
                        </p>

                        <div class="space-y-4 mb-8">
                            <div class="flex items-start">
                                <div class="w-6 h-6 rounded-full bg-boxwood flex items-center justify-center text-charcoal text-xs font-bold mt-0.5 mr-3">1</div>
                                <div>
                                    <h4 class="font-bold text-charcoal text-sm">Manifest Parsing</h4>
                                    <p class="text-xs text-charcoal-light">YAML validation and raw manifest loading</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="w-6 h-6 rounded-full bg-boxwood flex items-center justify-center text-charcoal text-xs font-bold mt-0.5 mr-3">2</div>
                                <div>
                                    <h4 class="font-bold text-charcoal text-sm">Graph Analysis</h4>
                                    <p class="text-xs text-charcoal-light">Dependency resolution and cycle detection</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <div class="w-6 h-6 rounded-full bg-boxwood flex items-center justify-center text-charcoal text-xs font-bold mt-0.5 mr-3">3</div>
                                <div>
                                    <h4 class="font-bold text-charcoal text-sm">Action Execution</h4>
                                    <p class="text-xs text-charcoal-light">Generated Ninja execution with clear diagnostics</p>
                                </div>
                            </div>
                        </div>

                        <a href="/netsuke/docs/" class="inline-flex items-center text-indigo font-bold hover:text-vermillion transition-colors">
                            Browse the docs hub <span  class="iconify ml-2" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </a>
                    </div>
                    <div class="bg-boxwood-pale p-8 lg:p-12 border-t lg:border-t-0 lg:border-l border-stone flex items-center justify-center relative overflow-hidden">
                        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#8A8279 1px, transparent 1px); background-size: 24px 24px;"></div>

                        <!-- Abstract Diagram Visualization -->
                        <div class="relative z-10 w-full max-w-md aspect-square bg-white rounded-xl shadow-sm border border-stone p-6 flex flex-col justify-between">
                            <div class="flex justify-between items-center border-b border-stone pb-4 mb-4">
                                <span class="font-mono text-xs text-charcoal-light">pipeline_state.rs</span>
                                <div class="flex space-x-1">
                                    <div class="w-2 h-2 rounded-full bg-vermillion"></div>
                                    <div class="w-2 h-2 rounded-full bg-amber"></div>
                                    <div class="w-2 h-2 rounded-full bg-matcha"></div>
                                </div>
                            </div>
                            <div class="space-y-3 font-mono text-xs">
                                <div class="bg-boxwood-pale p-2 rounded border border-stone/50 text-charcoal-mid">
                                    <span class="text-indigo">fn</span> <span class="text-vermillion">construct_graph</span>(manifest) -> Graph {
                                </div>
                                <div class="pl-4 text-stone-light">... internal logic ...</div>
                                <div class="bg-indigo/5 p-2 rounded border border-indigo/10 text-indigo flex justify-between items-center">
                                    <span>Analysis Phase</span>
                                    <span  class="iconify text-matcha" data-icon="carbon:checkmark" aria-hidden="true"></span>
                                </div>
                                <div class="bg-boxwood p-2 rounded border border-stone text-charcoal shadow-sm flex justify-between items-center">
                                    <span>Execution Phase</span>
                                    <span  class="iconify text-charcoal-mid animate-spin" data-icon="carbon:rotate-360" aria-hidden="true"></span>
                                </div>
                                <div class="text-charcoal-mid">}</div>
                            </div>
                            <div class="mt-4 pt-4 border-t border-stone flex justify-between text-xs text-charcoal-light">
                                <span>Input: 14kb</span>
                                <span>Output: Binary</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Grid -->
        <div class="grid lg:grid-cols-12 gap-12">

            <!-- Left Column: Guide Categories -->
            <div class="lg:col-span-8 space-y-16">

                <!-- Section: Philosophy -->
                <section id="philosophy">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-indigo/10 text-indigo flex items-center justify-center mr-4">
                            <span  class="iconify" data-icon="carbon:idea" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-charcoal">Philosophy & Context</h2>
                    </div>

                    <div class="grid md:grid-cols-2 gap-6">
                        <!-- Card 1 -->
                        <a href="/netsuke/docs/" class="hm-guide-card hm-card p-6 block h-full">
                            <h3 class="font-serif text-lg font-bold text-charcoal mb-3">Documentation Hub</h3>
                            <p class="text-sm text-charcoal-mid mb-4 line-clamp-3">
                                Start in the docs hub for the core ideas behind Netsuke, then branch into manifests, templating, and execution details.
                            </p>
                            <span class="text-xs font-mono text-indigo font-medium">Open Docs Hub &rarr;</span>
                        </a>

                        <!-- Card 2 -->
                        <a href="/netsuke/roadmap/" class="hm-guide-card hm-card p-6 block h-full">
                            <h3 class="font-serif text-lg font-bold text-charcoal mb-3">Roadmap &amp; Release Status</h3>
                            <p class="text-sm text-charcoal-mid mb-4 line-clamp-3">
                                See what shipped in v0.1.0, the known limitations, and the phased plan for the work ahead.
                            </p>
                            <span class="text-xs font-mono text-indigo font-medium">Open Roadmap &rarr;</span>
                        </a>
                    </div>
                </section>

                <!-- Section: Contributing -->
                <section id="contributing">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-matcha/10 text-matcha flex items-center justify-center mr-4">
                            <span  class="iconify" data-icon="carbon:branch" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-charcoal">Contributing</h2>
                    </div>

                    <div class="hm-card overflow-hidden">
                        <div class="divide-y divide-stone-light">
                            <a href="/netsuke/guides/contributing/" class="block p-6 hover:bg-boxwood-pale transition-colors group">
                                <div class="flex items-start">
                                    <div class="flex-shrink-0 mt-1">
                                        <span  class="iconify text-stone group-hover:text-indigo transition-colors" data-icon="carbon:notebook" aria-hidden="true"></span>
                                    </div>
                                    <div class="ml-4">
                                        <h3 class="text-base font-bold text-charcoal group-hover:text-indigo transition-colors">Contribution Guidelines</h3>
                                        <p class="text-sm text-charcoal-mid mt-1">Start here. Code of conduct, setting up your dev environment, and pull request etiquette.</p>
                                    </div>
                                    <div class="ml-auto pl-4">
                                        <span  class="iconify text-stone text-xs" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                                    </div>
                                </div>
                            </a>
                            <a href="/netsuke/guides/translating/" class="block p-6 hover:bg-boxwood-pale transition-colors group">
                                <div class="flex items-start">
                                    <div class="flex-shrink-0 mt-1">
                                        <span  class="iconify text-stone group-hover:text-indigo transition-colors" data-icon="carbon:language" aria-hidden="true"></span>
                                    </div>
                                    <div class="ml-4">
                                        <h3 class="text-base font-bold text-charcoal group-hover:text-indigo transition-colors">Translating Netsuke</h3>
                                        <p class="text-sm text-charcoal-mid mt-1">Full localization guide: Fluent files, message keys, plurals, and adding a new locale.</p>
                                    </div>
                                    <div class="ml-auto pl-4">
                                        <span  class="iconify text-stone text-xs" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                                    </div>
                                </div>
                            </a>
                            <a href="/netsuke/guides/writing-examples/" class="block p-6 hover:bg-boxwood-pale transition-colors group">
                                <div class="flex items-start">
                                    <div class="flex-shrink-0 mt-1">
                                        <span  class="iconify text-stone group-hover:text-indigo transition-colors" data-icon="carbon:cube" aria-hidden="true"></span>
                                    </div>
                                    <div class="ml-4">
                                        <h3 class="text-base font-bold text-charcoal group-hover:text-indigo transition-colors">Writing Examples &amp; Showcases</h3>
                                        <p class="text-sm text-charcoal-mid mt-1">Full guide to contributing example manifests and turning them into showcase pages.</p>
                                    </div>
                                    <div class="ml-auto pl-4">
                                        <span  class="iconify text-stone text-xs" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Section: Community -->
                <section id="community">
                    <div class="flex items-center mb-8">
                        <div class="w-10 h-10 rounded-full bg-vermillion/10 text-vermillion flex items-center justify-center mr-4">
                            <span  class="iconify" data-icon="carbon:group" aria-hidden="true"></span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-charcoal">Community Resources</h2>
                    </div>

                    <div class="grid md:grid-cols-3 gap-6">
                        <div class="hm-card hm-card--accent p-6 text-center">
                            <!-- Git logo, modelled on the official Git icon -->
                            <svg class="block mx-auto h-8 w-8 mb-4" viewBox="0 0 24 24" fill="#f05133" aria-hidden="true"><path d="M23.546 10.93 13.067.452c-.604-.603-1.582-.603-2.188 0L8.708 2.627l2.76 2.76c.645-.215 1.379-.07 1.889.441.516.515.658 1.258.438 1.9l2.658 2.66c.645-.223 1.387-.078 1.9.435.721.72.721 1.884 0 2.604-.719.719-1.881.719-2.6 0-.539-.541-.674-1.337-.404-1.996L12.86 8.955v6.525c.176.086.342.203.488.348.713.721.713 1.883 0 2.6-.719.721-1.889.721-2.609 0-.719-.719-.719-1.879 0-2.598.182-.18.387-.316.605-.406V8.835c-.217-.091-.424-.222-.6-.401-.545-.545-.676-1.342-.396-2.009L7.636 3.7.45 10.881c-.6.605-.6 1.584 0 2.189l10.48 10.477c.604.604 1.582.604 2.186 0l10.43-10.43c.605-.603.605-1.582 0-2.187"/></svg>
                            <h3 class="font-bold text-charcoal mb-2">Project Repository</h3>
                            <p class="text-xs text-charcoal-mid mb-4">Browse the prototype source, assets, and roadmap in one place.</p>
                            <a href="https://github.com/leynos/netsuke" class="text-indigo text-sm font-bold hover:underline">Open Repository</a>
                        </div>
                        <div class="hm-card hm-card--accent p-6 text-center">
                            <span  class="iconify block mx-auto text-3xl text-charcoal mb-4" data-icon="carbon:logo-github" aria-hidden="true"></span>
                            <h3 class="font-bold text-charcoal mb-2">Issue Tracker</h3>
                            <p class="text-xs text-charcoal-mid mb-4">Report bugs, request improvements, and track the prototype backlog.</p>
                            <a href="https://github.com/leynos/netsuke/issues" class="text-indigo text-sm font-bold hover:underline">Open Issues</a>
                        </div>
                        <div class="hm-card hm-card--accent p-6 text-center">
                            <span  class="iconify block mx-auto text-3xl text-vermillion mb-4" data-icon="carbon:calendar" aria-hidden="true"></span>
                            <h3 class="font-bold text-charcoal mb-2">Roadmap</h3>
                            <p class="text-xs text-charcoal-mid mb-4">Follow what shipped, what is still rough, and the phased plan ahead.</p>
                            <a href="/netsuke/roadmap/" class="text-indigo text-sm font-bold hover:underline">View the Roadmap</a>
                        </div>
                    </div>
                </section>
            </div>

            <!-- Right Column: Sidebar -->
            <aside class="lg:col-span-4 space-y-8">

                <!-- Recommended Path -->
                <div class="hm-sidebar-card p-6">
                    <h3 class="font-serif text-lg font-bold text-charcoal mb-4">Recommended Path</h3>
                    <p class="text-sm text-charcoal-mid mb-6">New to build systems? Here is a suggested reading order to get up to speed.</p>

                    <div class="relative pl-4 border-l-2 border-stone-light space-y-6">
                        <div class="relative">
                            <div class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-indigo border-2 border-white"></div>
                            <h4 class="text-sm font-bold text-indigo">1. Why Netsuke?</h4>
                            <p class="text-xs text-charcoal-mid mt-1">Understanding the problem space.</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-stone border-2 border-white"></div>
                            <h4 class="text-sm font-bold text-charcoal">2. Getting Started</h4>
                            <p class="text-xs text-charcoal-mid mt-1">Installation and first build.</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-stone border-2 border-white"></div>
                            <h4 class="text-sm font-bold text-charcoal">3. How it Works</h4>
                            <p class="text-xs text-charcoal-mid mt-1">Deep dive into the graph.</p>
                        </div>
                        <div class="relative">
                            <div class="absolute -left-[23px] top-1 w-3 h-3 rounded-full bg-stone border-2 border-white"></div>
                            <h4 class="text-sm font-bold text-charcoal">4. Writing Examples</h4>
                            <p class="text-xs text-charcoal-mid mt-1">Contributing your own manifests.</p>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="bg-boxwood-pale rounded-lg border border-stone p-6">
                    <h3 class="font-serif text-lg font-bold text-charcoal mb-4">Top Articles</h3>
                    <ul class="space-y-3">
                        <li>
                            <a href="/netsuke/docs/rules-and-targets/" class="flex items-start group">
                                <span class="text-stone mr-3 text-xs mt-1">01</span>
                                <span class="text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Rules &amp; Targets</span>
                            </a>
                        </li>
                        <li>
                            <a href="/netsuke/roadmap/" class="flex items-start group">
                                <span class="text-stone mr-3 text-xs mt-1">02</span>
                                <span class="text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Roadmap</span>
                            </a>
                        </li>
                        <li>
                            <a href="/netsuke/docs/cli/" class="flex items-start group">
                                <span class="text-stone mr-3 text-xs mt-1">03</span>
                                <span class="text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Command Line &amp; Configuration</span>
                            </a>
                        </li>
                    </ul>
                </div>

            </aside>
        </div>

    </main>
{% endraw %}
{% endblock %}
