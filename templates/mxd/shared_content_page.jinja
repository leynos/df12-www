{% extends "doc_page.jinja" %}
{% block page_title %}{{ title }}{% endblock %}
{% block hero %}
<section id="hero-section" class="relative bg-[#12121f] overflow-hidden">
    <div class="mxd-pattern mxd-pattern--hero absolute inset-0 opacity-60" aria-hidden="true"></div>

    <div class="absolute top-0 left-0 right-0 h-1 mxd-express-line bg-gradient-to-r from-[#c54b2a] via-[#e8a838] to-[#2d3a8c]"></div>

    <div class="relative max-w-[900px] mx-auto px-4 sm:px-8 pt-20 pb-12">
        <div class="inline-flex px-3 py-1 rounded-sm border border-[#c89430] mb-6">
            <div class="text-[#e8a838] text-[11.10px] font-bold font-primary uppercase tracking-[0.15em]">Legal · {{ title }}</div>
        </div>

        <h1 class="mb-6">
            <span class="text-[#f5e6d0] text-4xl sm:text-5xl md:text-[68.80px] font-normal font-secondary leading-tight sm:leading-[72.24px]">{{ title }}</span>
        </h1>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-[#c54b2a] via-[#e8a838] to-[#2d3a8c]"></div>
</section>
{% endblock %}
{% block content %}
<div class="border-t border-[#e8d5b8] py-16 sm:py-20">
    <div class="max-w-[900px] mx-auto px-4 sm:px-8">
        <article class="mxd-prose space-y-8 text-[#12121f] text-base font-normal font-tertiary leading-[27.20px]">
            {{ body_html | safe }}
        </article>
    </div>
</div>
{% endblock %}
