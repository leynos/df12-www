{% extends "_layout.jinja" %}
{% block title %}Stilyagi · Docs — rules catalogue, configuration, colophon{% endblock %}
{% block description %}Stilyagi reference: the rules catalogue, configuration schema, suppression semantics, the testing sandbox for rule authors, and the growing manual for the tool itself.{% endblock %}
{% block page_stylesheet %}
    <link rel="stylesheet" href="/stilyagi/assets/styles/pages/docs.css" />
{% endblock %}
{% block content %}
      <section class="page-intro">
        <div class="wrap">
          <div>
            <div class="folio">§ Documentation · operating surface</div>
            <h1>The <span class="red">rules</span>, the config, the seal.</h1>
          </div>
          <div>
            <p class="lede editorial">
              Every Stilyagi rule has an ID, a namespace, a severity, and a fix class — knowable at a
              glance. Configuration is a single TOML file. Suppressions live in the source. This page lays
              the whole operating surface out in one place.
            </p>
            <div style="margin-top: 18px"><span class="stamp small">v0.4</span></div>
          </div>
        </div>
      </section>
      <div class="docs-layout">
        <aside class="side-toc">
          <a href="#catalogue" class="active">§ I. Rules</a><a href="#config" class="">§ II. Config</a
          ><a href="#suppress" class="">§ III. Suppressions</a
          ><a href="#testing" class="">§ IV. Sandbox</a><a href="#colophon" class="">§ V. Colophon</a>
        </aside>
        <div>
          <section id="catalogue" style="scroll-margin-top: 90px">
