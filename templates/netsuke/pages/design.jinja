{% extends "doc_page.jinja" %}
{% import "components.jinja" as ui %}
{% set active_nav = '' %}
{% block page_title %}Himotoshi Design Language (Netsuke) - Design System{% endblock %}
{% block extra_head %}<script src="https://cdn.plot.ly/plotly-3.1.1.min.js" integrity="sha384-eyWfwv4NWkH7sLjk6s+Al2SBmZhX8gcLellpr+PLrfiNaHoTlAQTG9zDi4Z0liz8" crossorigin="anonymous"></script>
<style>
.code-block
      {
        background-color: #2E2A25;
        color: #E8D5B5;
        font-family: 'JetBrains Mono', monospace;
      }
</style>{% endblock %}
{% block content %}
{% raw %}
    <!-- Hero Section -->
    <header id="intro"
      class="pt-32 pb-20 lg:pt-48 lg:pb-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative overflow-hidden">
      <div
        class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 bg-boxwood/30 rounded-full blur-3xl -z-10">
      </div>
      <div
        class="absolute bottom-0 left-0 -ml-20 -mb-20 w-72 h-72 bg-base-300/30 rounded-full blur-3xl -z-10">
      </div>
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          {% endraw %}{{ ui.kicker('v1.0.0 Release') }}{% raw %}
          <h1
            class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-[1.1] lg:leading-none tracking-tight">
            Warmth,<br>
            Precision,<br><span class="text-accent italic">Structure.</span>
          </h1>
          <p
            class="text-xl text-charcoal-mid max-w-lg leading-relaxed font-light">
            The Himotoshi Design Language for Netsuke, the build system
            compiler. Named for the
            cord that threads through a carved netsuke, connecting it to the obi
            sash —
            Himotoshi connects every surface of Netsuke's identity into a
            coherent whole.

          </p>
          <div class="flex flex-wrap gap-4 pt-4"><a href="#components"
              class="hm-button hm-button--primary inline-flex items-center px-6 py-3">
              Explore Components
            </a><a href="#tokens"
              class="hm-button hm-button--ghost inline-flex items-center px-6 py-3">
              View Tokens
            </a></div>
        </div>
        <div class="relative">
          <div
            class="relative rounded-xl overflow-hidden shadow-2xl border border-base-300 bg-base-100 p-1">
            <div class="absolute top-4 right-4 z-20">
              <div
                class="bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-mono text-base-content shadow-xs border border-base-300/50">
                Netsuke UI
              </div>
            </div><img
              src="/netsuke/assets/himotoshi-dashboard.png"
              alt="minimalist japanese aesthetic UI design dashboard, warm beige background, indigo and vermillion accents, clean typography, wooden texture details, soft lighting, detailed interface elements"
              class="w-full h-auto object-cover rounded-lg aspect-[4/3]">
          </div><!-- Floating Element -->
          <div
            class="absolute -bottom-10 -left-10 bg-white p-6 rounded-lg shadow-xl border border-base-300 max-w-xs z-20 hidden md:block">
            <div class="flex items-center space-x-3 mb-3">
              <div class="w-3 h-3 rounded-full bg-accent"></div>
              <div class="w-3 h-3 rounded-full bg-warning"></div>
              <div class="w-3 h-3 rounded-full bg-success"></div>
            </div>
            <div class="font-mono text-xs text-charcoal-mid space-y-1">
              <div class="flex justify-between"><span
                  class="text-primary">--bg-primary:</span> <span>#FAF6F0</span>
              </div>
              <div class="flex justify-between"><span
                  class="text-primary">--text-main:</span> <span>#2E2A25</span>
              </div>
              <div class="flex justify-between"><span
                  class="text-primary">--accent:</span> <span>#C23B22</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header><!-- Color System Section -->
    <section id="colors" class="py-20 bg-white border-y border-stone-light">
      <div class="site-container">
        <div class="mb-16"><span
            class="text-accent font-mono text-sm font-semibold tracking-wider uppercase mb-2 block">01
            — Visual Design</span>
          <h2 class="font-serif text-4xl font-bold text-base-content mb-6">Color
            Palette</h2>
          <p class="text-lg text-charcoal-mid max-w-2xl">
            Our palette is grounded in natural materials—charcoal, indigo dye,
            vermillion lacquer, and boxwood. These colors provide high contrast
            while maintaining a warm, organic feel accessible under WCAG 2.1 AA
            standards.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Charcoal -->
          <div class="space-y-4">
            <div
              class="h-32 rounded-lg bg-base-content shadow-md flex items-end p-4 group relative overflow-hidden">
              <span class="text-white font-mono text-sm relative z-10">Charcoal
                #2E2A25</span></div>
            <div class="grid grid-cols-2 gap-4">
              <div
                class="h-20 rounded-lg bg-charcoal-mid flex items-end p-3 text-white font-mono text-xs">
                Mid</div>
              <div
                class="h-20 rounded-lg bg-charcoal-light flex items-end p-3 text-white font-mono text-xs">
                Light</div>
            </div>
          </div><!-- Indigo -->
          <div class="space-y-4">
            <div class="h-32 rounded-lg bg-primary shadow-md flex items-end p-4">
              <span class="text-white font-mono text-sm">Indigo #2B4162</span>
            </div>
            <div class="grid grid-cols-1 gap-4">
              <div
                class="h-20 rounded-lg bg-secondary flex items-end p-3 text-white font-mono text-xs">
                Light #3A5A7C</div>
            </div>
          </div><!-- Vermillion -->
          <div class="space-y-4">
            <div
              class="h-32 rounded-lg bg-accent shadow-md flex items-end p-4">
              <span class="text-white font-mono text-sm">Vermillion
                #C23B22</span></div>
            <div class="grid grid-cols-1 gap-4">
              <div
                class="h-20 rounded-lg bg-vermillion-dim flex items-end p-3 text-white font-mono text-xs">
                Dim #9E3020</div>
            </div>
          </div><!-- Boxwood & Stone -->
          <div class="space-y-4">
            <div
              class="h-32 rounded-lg bg-boxwood shadow-md flex items-end p-4 border border-base-300">
              <span class="text-base-content font-mono text-sm">Boxwood
                #E8D5B5</span></div>
            <div class="grid grid-cols-2 gap-4">
              <div
                class="h-20 rounded-lg bg-base-100 border border-base-300 flex items-end p-3 text-base-content font-mono text-xs">
                Pale</div>
              <div
                class="h-20 rounded-lg bg-base-300 flex items-end p-3 text-base-content font-mono text-xs">
                Stone</div>
            </div>
          </div>
        </div><!-- Semantic Colors -->
        <div class="mt-16 pt-16 border-t border-stone-light">
          <h3 class="font-serif text-2xl font-bold text-base-content mb-8">Semantic
            Application</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div
              class="p-6 rounded-lg bg-base-100 border border-base-300 flex items-start space-x-4">
              <div
                class="w-10 h-10 rounded-full bg-success flex items-center justify-center text-white shrink-0">
                <span  class="iconify" data-icon="carbon:checkmark" aria-hidden="true"></span></div>
              <div>
                <h4 class="font-bold text-base-content mb-1">Success</h4>
                <p class="text-sm text-charcoal-mid">Use Matcha (#4A7C59) for
                  success states, completions, and safe actions.</p>
              </div>
            </div>
            <div
              class="p-6 rounded-lg bg-base-100 border border-base-300 flex items-start space-x-4">
              <div
                class="w-10 h-10 rounded-full bg-warning flex items-center justify-center text-white shrink-0">
                <span  class="iconify" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span></div>
              <div>
                <h4 class="font-bold text-base-content mb-1">Warning</h4>
                <p class="text-sm text-charcoal-mid">Use Amber (#C48B2C) for
                  non-blocking alerts and attention grabbers.</p>
              </div>
            </div>
            <div
              class="p-6 rounded-lg bg-base-100 border border-base-300 flex items-start space-x-4">
              <div
                class="w-10 h-10 rounded-full bg-accent flex items-center justify-center text-white shrink-0">
                <span  class="iconify" data-icon="carbon:close" aria-hidden="true"></span></div>
              <div>
                <h4 class="font-bold text-base-content mb-1">Error</h4>
                <p class="text-sm text-charcoal-mid">Use Vermillion (#C23B22)
                  for destructive actions, errors, and failures.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><!-- Typography Section -->
    <section id="typography" class="py-20 relative overflow-hidden">
      <div class="site-container relative z-10">
        <div class="grid lg:grid-cols-12 gap-12">
          <div class="lg:col-span-4"><span
              class="text-accent font-mono text-sm font-semibold tracking-wider uppercase mb-2 block">02
              — Typography</span>
            <h2 class="font-serif text-4xl font-bold text-base-content mb-6">Type
              &amp; Scale</h2>
            <p class="text-charcoal-mid mb-8">
              The typographic system uses a 1.25 major third scale starting from
              a 16px baseline. We pair the humanistic Fraunces serif with the
              clean utility of Source Sans 3 and JetBrains Mono.
            </p>
            <div class="p-6 bg-white border border-base-300 rounded-lg shadow-xs">
              <h4 class="font-serif font-bold text-lg mb-4 text-primary">Font
                Stack</h4>
              <div class="space-y-4">
                <div><span
                    class="text-xs font-mono text-charcoal-light uppercase tracking-wide">Display</span>
                  <p class="font-serif text-2xl text-base-content">Fraunces</p>
                </div>
                <div><span
                    class="text-xs font-mono text-charcoal-light uppercase tracking-wide">Body</span>
                  <p class="font-sans text-2xl text-base-content">Source Sans 3</p>
                </div>
                <div><span
                    class="text-xs font-mono text-charcoal-light uppercase tracking-wide">Code</span>
                  <p class="font-mono text-xl text-base-content">JetBrains Mono</p>
                </div>
              </div>
            </div>
          </div>
          <div class="lg:col-span-8 space-y-8">
            <!-- Type Scale Preview -->
            <div class="space-y-6 border-l-2 border-boxwood pl-8">
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  5xl</span>
                <h1 class="font-serif text-6xl text-base-content">The quick brown
                  fox</h1>
              </div>
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  4xl</span>
                <h2 class="font-serif text-5xl text-base-content">Jumps over the
                  lazy dog</h2>
              </div>
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  3xl</span>
                <h3 class="font-serif text-4xl text-base-content">Tactile interfaces
                </h3>
              </div>
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  2xl</span>
                <h4 class="font-serif text-3xl text-base-content">Precision and
                  warmth</h4>
              </div>
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  xl</span>
                <h5 class="font-serif text-2xl text-base-content">Visible structure
                </h5>
              </div>
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  Base</span>
                <p class="font-sans text-base text-base-content max-w-xl">
                  Design philosophy emphasizes warmth over sterility, precision
                  in small spaces, visible structure, and hands-on tactile
                  interfaces. Dark contexts provide an inverted but warm
                  variant.
                </p>
              </div>
              <div class="flex items-baseline"><span
                  class="w-24 text-xs font-mono text-charcoal-light">Text
                  sm</span>
                <p class="font-sans text-sm text-charcoal-mid">
                  Branding notes focus on a warm, precise, and tactile
                  personality; interfaces should feel natural and
                  hand-influenced.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><!-- Components Section -->
    <section id="components"
      class="py-20 bg-base-100 border-y border-base-300">
      <div class="site-container">
        <div class="text-center mb-16"><span
            class="text-accent font-mono text-sm font-semibold tracking-wider uppercase mb-2 block">03
            — Components</span>
          <h2 class="font-serif text-4xl font-bold text-base-content">UI Elements
            &amp; Patterns</h2>
        </div>
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Buttons Card -->
          <div class="bg-white p-8 rounded-xl border border-base-300 shadow-xs">
            <h3
              class="font-serif text-xl font-bold text-base-content mb-6 flex items-center">
              <span  class="iconify text-primary mr-3 text-sm" data-icon="carbon:cursor-1" aria-hidden="true"></span>
              Buttons
            </h3>
            <div class="space-y-8">
              <div>
                <p class="text-sm text-charcoal-mid mb-4 font-mono">Default Size
                </p>
                <div class="flex flex-wrap gap-4 items-center"><button
                    class="px-6 py-2.5 bg-primary text-white rounded-md font-medium shadow-xs hover:bg-secondary transition-colors focus:ring-2 focus:ring-primary focus:ring-offset-2">
                    Primary Action
                  </button><button
                    class="px-6 py-2.5 bg-accent text-white rounded-md font-medium shadow-xs hover:bg-vermillion-dim transition-colors focus:ring-2 focus:ring-accent focus:ring-offset-2">
                    Accent CTA
                  </button><button
                    class="px-6 py-2.5 bg-transparent border border-base-content/20 text-base-content rounded-md font-medium hover:bg-stone-light transition-colors">
                    Ghost Action
                  </button></div>
              </div>
              <div>
                <p class="text-sm text-charcoal-mid mb-4 font-mono">Small Size
                  (--sm)</p>
                <div class="flex flex-wrap gap-4 items-center"><button
                    class="px-3 py-1.5 text-sm bg-primary text-white rounded-md font-medium shadow-xs hover:bg-secondary transition-colors">
                    Primary
                  </button><button
                    class="px-3 py-1.5 text-sm bg-accent text-white rounded-md font-medium shadow-xs hover:bg-vermillion-dim transition-colors">
                    Accent
                  </button><button
                    class="px-3 py-1.5 text-sm bg-transparent border border-base-content/20 text-base-content rounded-md font-medium hover:bg-stone-light transition-colors">
                    Ghost
                  </button></div>
              </div>
            </div>
          </div><!-- Tags & Badges -->
          <div class="bg-white p-8 rounded-xl border border-base-300 shadow-xs">
            <h3
              class="font-serif text-xl font-bold text-base-content mb-6 flex items-center">
              <span  class="iconify text-primary mr-3 text-sm" data-icon="carbon:tag" aria-hidden="true"></span> Tags
              &amp; Badges
            </h3>
            <div class="space-y-6">
              <div>
                <p class="text-sm text-charcoal-mid mb-4">Pill-shaped, monospace
                  metadata labels.</p>
                <div class="flex flex-wrap gap-3"><span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-boxwood text-base-content font-mono border border-base-300">
                    v2.0.1
                  </span><span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary/10 text-primary font-mono border border-primary/20">
                    docs
                  </span><span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-success/10 text-success font-mono border border-success/20">
                    stable
                  </span><span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-warning/10 text-warning font-mono border border-warning/20">
                    beta
                  </span><span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-accent/10 text-accent font-mono border border-accent/20">
                    deprecated
                  </span></div>
              </div><!-- Callouts -->
              <div class="pt-6 border-t border-stone-light">
                <p class="text-sm text-charcoal-mid mb-4 font-mono">Admonitions
                </p>
                <div
                  class="border-l-4 border-primary bg-primary/5 p-4 rounded-r-md">
                  <div class="flex">
                    <div class="shrink-0"><span
                         class="iconify text-primary" data-icon="carbon:information-filled" aria-hidden="true"></span></div>
                    <div class="ml-3">
                      <h3 class="text-sm font-medium text-primary">Information
                      </h3>
                      <div class="mt-1 text-sm text-secondary">
                        <p>This is an informational callout used for
                          non-critical guidance.</p>
                      </div>
                    </div>
                  </div>
                </div>
                <div
                  class="mt-4 border-l-4 border-accent bg-accent/5 p-4 rounded-r-md">
                  <div class="flex">
                    <div class="shrink-0"><span
                         class="iconify text-accent" data-icon="carbon:error-filled" aria-hidden="true"></span>
                    </div>
                    <div class="ml-3">
                      <h3 class="text-sm font-medium text-accent">Critical
                        Error</h3>
                      <div class="mt-1 text-sm text-vermillion-dim">
                        <p>Something went wrong with the compilation process.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div><!-- Terminal & Code -->
          <div
            class="lg:col-span-2 bg-base-content rounded-xl border border-charcoal-mid shadow-lg overflow-hidden">
            <div
              class="bg-charcoal-mid/30 px-4 py-2 flex items-center justify-between border-b border-white/10">
              <div class="flex space-x-2">
                <div class="w-3 h-3 rounded-full bg-accent"></div>
                <div class="w-3 h-3 rounded-full bg-warning"></div>
                <div class="w-3 h-3 rounded-full bg-success"></div>
              </div>
              <div class="text-xs font-mono text-charcoal-light">Terminal
                Preview</div>
              <div class="w-12"></div>
            </div>
            <div class="p-6 font-mono text-sm overflow-x-auto">
              <div class="text-base-100"><span
                  class="text-success">➜</span><span
                  class="text-secondary">~/project</span> <span
                  class="text-boxwood">netsuke build</span></div>
              <div class="text-stone-light mt-2"><span
                  class="text-charcoal-light">00:01:23</span> <span
                  class="text-primary font-bold">INFO</span> Compiling assets...
              </div>
              <div class="text-stone-light"><span
                  class="text-charcoal-light">00:01:24</span> <span
                  class="text-success font-bold">SUCCESS</span> Built 42 modules
                in 1.2s
              </div>
              <div class="text-stone-light mt-4"><span
                  class="text-charcoal-light">00:01:25</span> <span
                  class="text-accent font-bold">ERROR</span> Failed to
                resolve dependency
              </div><!-- Miette Style Error -->
              <div
                class="mt-4 p-4 bg-black/30 rounded border-l-2 border-accent">
                <div class="text-accent font-bold mb-2">× Config Error:
                  Invalid Token</div>
                <div class="pl-4 border-l border-charcoal-mid/50 ml-1">
                  <div class="flex"><span
                      class="text-charcoal-mid w-8 select-none">12</span><span
                      class="text-base-300"> color: </span><span
                      class="text-warning">"invalid-hex"</span></div>
                  <div class="flex"><span
                      class="text-charcoal-mid w-8 select-none">13</span><span
                      class="text-base-300"> font: </span><span
                      class="text-success">"Fraunces"</span></div>
                  <div class="flex text-accent mt-1"><span
                      class="w-8 select-none"></span><span> ^ expected hex color
                      format like #RRGGBB</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section><!-- Tokens Table Section -->
    <section id="tokens" class="py-20 bg-white">
      <div class="site-container">
        <div class="grid lg:grid-cols-3 gap-12">
          <div class="lg:col-span-1"><span
              class="text-accent font-mono text-sm font-semibold tracking-wider uppercase mb-2 block">04
              — Implementation</span>
            <h2 class="font-serif text-3xl font-bold text-base-content mb-4">Design
              Tokens</h2>
            <p class="text-charcoal-mid mb-6">
              Core design decisions are stored as CSS custom properties. These
              tokens ensure consistency across the platform and enable easy
              theming.
            </p>
            <div class="bg-base-100 p-6 rounded-lg border border-base-300">
              <h4 class="font-bold text-base-content mb-2">Usage Note</h4>
              <p class="text-sm text-charcoal-mid mb-4">
                All tokens are prefixed with
                <code class="bg-white px-1 py-0.5 rounded border border-base-300 text-accent">--netsuke-</code>
                to avoid conflicts.
              </p><button
                class="text-primary text-sm font-medium hover:text-secondary flex items-center">
                Download JSON <span  class="iconify ml-2" data-icon="carbon:download" aria-hidden="true"></span></button>
            </div>
          </div>
          <div class="lg:col-span-2">
            <div
              class="overflow-hidden shadow ring-1 ring-black/5 rounded-lg">
              <table class="min-w-full hm-rows">
                <thead class="bg-base-100">
                  <tr>
                    <th scope="col"
                      class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-base-content sm:pl-6">
                      Token Name</th>
                    <th scope="col"
                      class="px-3 py-3.5 text-left text-sm font-semibold text-base-content">
                      Value</th>
                    <th scope="col"
                      class="px-3 py-3.5 text-left text-sm font-semibold text-base-content">
                      Example</th>
                    <th scope="col"
                      class="px-3 py-3.5 text-left text-sm font-semibold text-base-content">
                      Use Case</th>
                  </tr>
                </thead>
                <tbody class="hm-rows bg-white">
                  <tr>
                    <td
                      class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono text-primary sm:pl-6">
                      --color-primary</td>
                    <td
                      class="whitespace-nowrap px-3 py-4 text-sm text-charcoal-mid font-mono">
                      #2B4162</td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                      <div
                        class="w-6 h-6 rounded bg-primary border border-stone-light">
                      </div>
                    </td>
                    <td
                      class="whitespace-nowrap px-3 py-4 text-sm text-charcoal-mid">
                      Primary actions, links</td>
                  </tr>
                  <tr>
                    <td
                      class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono text-primary sm:pl-6">
                      --color-surface</td>
                    <td
                      class="whitespace-nowrap px-3 py-4 text-sm text-charcoal-mid font-mono">
                      #FAF6F0</td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm">
                      <div
                        class="w-6 h-6 rounded bg-base-100 border border-stone-light">
                      </div>
                    </td>
                    <td
                      class="whitespace-nowrap px-3 py-4 text-sm text-charcoal-mid">
                      Page background</td>
                  </tr>
                  <tr>
                    <td
                      class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono text-primary sm:pl-6">
                      --font-display</td>
