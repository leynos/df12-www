{#
  Cross-cutting request behaviour. Only what the source actually defines: the
  site must not invent pagination, rate limits, or scopes the code does not
  implement.
#}
{% set request_contracts = [
  {
    "name": "Authorization",
    "status": "in-progress",
    "detail": "Authorization middleware runs ahead of every resource and supplies the authenticated principal. Role-based access control and tenancy isolation are roadmap phase 5."
  },
  {
    "name": "Idempotency",
    "status": "available",
    "detail": "Side-effecting POST requests to the intake surface require an Idempotency-Key. The key is scoped to the authenticated principal. A repeat with the same canonical body replays the stored response; the same key with a different body returns 409 Conflict."
  },
  {
    "name": "Optimistic locking",
    "status": "available",
    "detail": "Profile and template updates carry expected_revision. A stale revision is refused rather than overwriting a concurrent edit."
  },
  {
    "name": "Errors",
    "status": "available",
    "detail": "A single error serializer produces a consistent error body across every resource."
  },
  {
    "name": "Pagination and rate limits",
    "status": "planned",
    "detail": "Pagination, filtering, and role enforcement are roadmap task 4.1.2. No rate-limit contract is defined; do not assume one."
  }
] %}

