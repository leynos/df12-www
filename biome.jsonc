{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!node_modules",
      "!dist",
      "!.bin",
      "!.pnpm-store",
      "!.cache",
      "!.artifacts",
      "!.act-stubs",
      "!public/assets",
      "!public/netsuke/assets/vendor",
      "!src/static/**/vendor",
      // Betamax writes these HTTP recordings; re-recording a cassette would
      // fail the format gate on output no human authored.
      "!tests/cassettes",
      // Snapshots kept for reference, neither built nor shipped. Holding
      // them to the house style would only churn files whose value is that
      // they still read the way they did when they were written.
      "!reference"
    ],
    "ignoreUnknown": true
  },
  "css": {
    // The Tailwind v4 entrypoints in src/styles/ use @source, @plugin, and
    // @theme, which the CSS parser rejects as unknown at-rules otherwise.
    "parser": { "tailwindDirectives": true }
  },
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "off"
      },
      "style": {
        "useForOf": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.d.ts"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    },
    {
      "includes": ["**/*.html"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": { "enabled": false }
    },
    {
      // The Pygments blocks in these stylesheets are written by
      // scripts/generate_*_pygments_css.py, which emits one rule per line.
      // Formatting them here would put the formatter and the generator in a
      // loop, each undoing the other on the next run.
      "includes": [
        "src/static/stilyagi/assets/styles/syntax.css",
        "src/static/netsuke/assets/css/himotoshi.css",
        "src/static/episodic/assets/styles/syntax.css"
      ],
      "formatter": { "enabled": false }
    },
    {
      // Episodic's MiniSearch builder owns this committed index. Formatting
      // its JSON would make the checked-in projection differ from the source
      // generator even when the indexed content has not changed.
      "includes": ["src/static/episodic/assets/search/episodic-search.json"],
      "formatter": { "enabled": false }
    },
    {
      // Standalone .svg assets are referenced from CSS as images. The a11y
      // rules that fire on them (noSvgWithoutTitle) are written for inline
      // JSX, where the <svg> is part of a document's accessibility tree.
      "includes": ["**/*.svg"],
      "linter": { "enabled": false }
    },
    {
      // The sub-site scripts are classic scripts, loaded with a plain
      // <script src>, not modules: each wraps itself in an IIFE and the
      // "use strict" directive inside it does real work.
      "includes": ["src/static/**/assets/js/**"],
      "linter": {
        "rules": {
          "suspicious": { "noRedundantUseStrict": "off" }
        }
      }
    }
  ]
}
