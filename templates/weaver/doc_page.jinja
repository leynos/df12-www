<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block page_title %}{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'weaver-cream': '#F3EFD9',
                        'weaver-indigo': '#193C6E',
                        'weaver-vermilion': '#E8502B',
                        'weaver-dark': '#0F2440',
                        'weaver-faded': '#4A6FA5',
                    },
                    fontFamily: {
                        'serif': ['"Playfair Display"', 'serif'],
                        'sans': ['"IBM Plex Sans"', 'sans-serif'],
                        'mono': ['"IBM Plex Mono"', 'monospace'],
                    },
                    backgroundImage: {
                        'grid-pattern': "linear-gradient(to right, rgba(25, 60, 110, 0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(25, 60, 110, 0.05) 1px, transparent 1px)",
                    }
                }
            }
        }
    </script>
    <script>
        window.FontAwesomeConfig = { autoReplaceSvg: 'nest' };
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Playfair+Display:wght@400;600;700;900&display=swap" rel="stylesheet">
    {% block extra_head %}{% endblock %}
    <link rel="stylesheet" href="/weaver/assets/styles/weaver-site.css">
</head>
<body class="bg-weaver-cream relative overflow-x-hidden selection:bg-weaver-vermilion selection:text-white">

    <!-- Texture Overlay -->
    <div class="texture-overlay"></div>

    <div class="flex flex-col lg:flex-row min-h-screen relative z-20">

        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="w-full lg:w-64 bg-weaver-cream border-r-2 border-weaver-indigo/20 flex-shrink-0 lg:fixed h-auto lg:h-full z-40 flex flex-col justify-between">
            <div>
                <div class="p-8 border-b-2 border-weaver-indigo/20" data-mobile-nav-header>
                    <h1 class="font-serif text-3xl font-bold tracking-tight text-weaver-indigo">WEAVER</h1>
                    <p class="font-mono text-xs mt-2 text-weaver-indigo/70">AI CODEBASE TOOLING</p>
                </div>
                <nav class="p-6 space-y-2 overflow-y-auto max-h-[calc(100vh-200px)]">
                    {%- set ns = namespace(home_active=false, why_active=false, how_active=false, cmd_active=false, safety_active=false, sempai_active=false, jacquard_active=false, install_active=false, docs_active=false, roadmap_active=false) -%}
                    {%- for link in nav_links -%}
                        {%- if link.current -%}
                            {%- if link.href == '/weaver/' -%}{%- set ns.home_active = true -%}
                            {%- elif link.href == '/weaver/why-weaver/' -%}{%- set ns.why_active = true -%}
                            {%- elif link.href == '/weaver/how-it-works/' -%}{%- set ns.how_active = true -%}
                            {%- elif link.href == '/weaver/commands/' -%}{%- set ns.cmd_active = true -%}
                            {%- elif link.href == '/weaver/safety/' -%}{%- set ns.safety_active = true -%}
                            {%- elif link.href == '/weaver/sempai/' -%}{%- set ns.sempai_active = true -%}
                            {%- elif link.href == '/weaver/jacquard/' -%}{%- set ns.jacquard_active = true -%}
                            {%- elif link.href == '/weaver/install/' -%}{%- set ns.install_active = true -%}
                            {%- elif link.href == '/weaver/docs/' -%}{%- set ns.docs_active = true -%}
                            {%- elif link.href == '/weaver/roadmap/' -%}{%- set ns.roadmap_active = true -%}
                            {%- endif -%}
                        {%- endif -%}
                    {%- endfor -%}
                    <a href="/weaver/" class="block px-4 py-2 text-sm {% if ns.home_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.home_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.home_active %}opacity-60{% endif %}">00</span> Home
                    </a>
                    <a href="/weaver/why-weaver/" class="block px-4 py-2 text-sm {% if ns.why_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.why_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.why_active %}opacity-60{% endif %}">01</span> Philosophy
                    </a>
                    <a href="/weaver/how-it-works/" class="block px-4 py-2 text-sm {% if ns.how_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.how_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.how_active %}opacity-60{% endif %}">02</span> Architecture
                    </a>
                    {% block nav_subitems_how %}{% endblock %}
                    <a href="/weaver/commands/" class="block px-4 py-2 text-sm {% if ns.cmd_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.cmd_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.cmd_active %}opacity-60{% endif %}">03</span> Commands
                    </a>
                    {% block nav_subitems_commands %}{% endblock %}
                    <a href="/weaver/safety/" class="block px-4 py-2 text-sm {% if ns.safety_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.safety_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.safety_active %}opacity-60{% endif %}">04</span> Safety
                    </a>
                    <a href="/weaver/sempai/" class="block px-4 py-2 text-sm {% if ns.sempai_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.sempai_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.sempai_active %}opacity-60{% endif %}">05</span> Sempai Engine
                    </a>
                    {% block nav_subitems_sempai %}{% endblock %}
                    <a href="/weaver/jacquard/" class="block px-4 py-2 text-sm {% if ns.jacquard_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.jacquard_active %} aria-current="page"{% endif %}>
                        <span class="mr-2 font-mono text-xs {% if not ns.jacquard_active %}opacity-60{% endif %}">06</span> Jacquard
                    </a>
                    {% block nav_subitems_jacquard %}{% endblock %}
                    <div class="pt-4 mt-4 border-t border-weaver-indigo/10">
                        <a href="/weaver/install/" class="block px-4 py-2 text-sm {% if ns.install_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-vermilion hover:bg-weaver-vermilion/5 transition-colors border border-transparent font-mono{% endif %}"{% if ns.install_active %} aria-current="page"{% endif %}>
                            {% if not ns.install_active %}&gt; {% endif %}Install
                        </a>
                        <a href="/weaver/docs/" class="block px-4 py-2 text-sm {% if ns.docs_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.docs_active %} aria-current="page"{% endif %}>
                            Docs
                        </a>
                        <a href="/weaver/roadmap/" class="block px-4 py-2 text-sm {% if ns.roadmap_active %}font-semibold bg-weaver-indigo text-weaver-cream rounded-sm border border-weaver-indigo shadow-[2px_2px_0px_0px_rgba(25,60,110,1)]{% else %}font-medium text-weaver-indigo hover:bg-weaver-indigo/5 transition-colors border border-transparent{% endif %}"{% if ns.roadmap_active %} aria-current="page"{% endif %}>
                            Roadmap
                        </a>
                    </div>
                </nav>
            </div>

            <!-- Version/Status Footer in Sidebar -->
            <div class="p-6 border-t border-weaver-indigo/10 hidden lg:block">
                <a href="/" class="font-mono text-xs text-weaver-vermilion hover:text-weaver-indigo transition-colors block mb-3">&larr; Back to df12 Productions</a>
                <div class="flex items-center gap-2 mb-2">
                    <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                    <span class="font-mono text-xs text-weaver-indigo/60">System Operational</span>
                </div>
                <p class="font-mono text-[10px] text-weaver-indigo/40">v0.1.0</p>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="flex-1 lg:ml-64 grid-bg min-h-screen relative{% block main_extra_class %}{% endblock %}">

{% block content %}{% endblock %}

        </main>
    </div>

    <!-- Footer -->
    <footer class="bg-weaver-cream border-t border-weaver-indigo/20 p-8 lg:p-16 relative lg:ml-64">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center">
            <div class="mb-6 md:mb-0">
                <div class="flex items-center gap-3 mb-2">
                        <div class="w-8 h-8 bg-weaver-indigo flex items-center justify-center text-weaver-cream">
                        <span class="font-serif font-bold text-lg">W</span>
                        </div>
                        <h2 class="font-serif text-2xl font-bold text-weaver-indigo">WEAVER</h2>
                </div>
                <p class="font-mono text-xs text-weaver-indigo/60 mt-1">© 2026 df12 Productions</p>
                <p class="font-mono text-xs text-weaver-indigo/60 mt-1">Serious tools, <span class="text-weaver-vermilion">playful worlds.</span></p>
            </div>

            <div class="grid grid-cols-2 gap-6 text-center md:flex md:flex-row md:gap-x-8 md:text-right">
                <div class="flex flex-col space-y-2">
                    <span class="font-mono text-xs font-bold text-weaver-indigo uppercase mb-1">Project</span>
                    <a href="/weaver/why-weaver/" class="text-sm text-weaver-indigo/80 hover:text-weaver-vermilion transition-colors">Philosophy</a>
                    <a href="/weaver/roadmap/" class="text-sm text-weaver-indigo/80 hover:text-weaver-vermilion transition-colors">Roadmap</a>
                </div>
                <div class="flex flex-col space-y-2">
                    <span class="font-mono text-xs font-bold text-weaver-indigo uppercase mb-1">Resources</span>
                    <a href="/weaver/docs/" class="text-sm text-weaver-indigo/80 hover:text-weaver-vermilion transition-colors">Documentation</a>
                    <a href="/weaver/install/" class="text-sm text-weaver-indigo/80 hover:text-weaver-vermilion transition-colors">Installation</a>
                </div>
            </div>
        </div>

        <!-- Hanko Stamp (Decorative) -->
        <div class="absolute bottom-8 right-8 hidden lg:block opacity-20 hover:opacity-100 transition-opacity duration-500">
            <div class="w-24 h-24 border-4 border-weaver-vermilion rounded-sm flex items-center justify-center stamp-rotate mix-blend-multiply bg-weaver-vermilion/5">
                <div class="text-center leading-tight">
                    <span class="text-weaver-vermilion font-serif font-bold text-xl block">CODE</span>
                    <span class="text-weaver-vermilion font-serif font-bold text-xl block">SAFE</span>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const selector = this.getAttribute('href');
                if (!selector || selector === '#') return;

                let target;
                try {
                    target = document.querySelector(selector);
                } catch {
                    return;
                }
                if (!target) return;

                e.preventDefault();
                const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                target.scrollIntoView({
                    behavior: reduceMotion ? 'auto' : 'smooth',
                    block: 'start'
                });
                history.pushState(null, '', selector);
            });
        });
    </script>
    <script src="/weaver/assets/js/mobile-nav.js"></script>
</body>
</html>
