{#
  Shared docs navigation data and chrome.

  `docs_pages` is the single ordered source of truth for the docs
  reading order. The desktop sidebar, the mobile sub-menu dropdown, and
  the footer previous/next links all render from it, so adding or
  reordering a docs page means editing this one list. `group` names the
  sidebar heading a page sits under; `docs_groups` fixes the heading
  order.
#}
{% set docs_pages = [
    {'slug': '', 'label': 'Documentation Hub', 'group': 'Introduction'},
    {'slug': 'getting-started', 'label': 'Getting Started', 'group': 'Introduction'},
    {'slug': 'manifest-reference', 'label': 'Manifest Reference', 'group': 'Core Concepts'},
    {'slug': 'rules-and-targets', 'label': 'Rules & Targets', 'group': 'Core Concepts'},
    {'slug': 'templating', 'label': 'Templating', 'group': 'Core Concepts'},
    {'slug': 'standard-library', 'label': 'Standard Library', 'group': 'Core Concepts'},
    {'slug': 'cli', 'label': 'CLI Commands', 'group': 'Reference'},
    {'slug': 'configuration', 'label': 'Configuration', 'group': 'Reference'},
    {'slug': 'security', 'label': 'Security Model', 'group': 'Reference'},
] %}
{% set docs_groups = ['Introduction', 'Core Concepts', 'Reference'] %}

{#
  One entry in the desktop sidebar.

  active  the current page
  sub     an in-page anchor, indented under its page
#}
{% macro sidebar_link(href, label, active=false, sub=false) -%}
<li><a href="{{ href }}" class="sidebar-link{% if active %} active{% endif %}{% if sub %} sidebar-link--sub{% endif %} block {% if sub %}pr-2{% else %}px-2{% endif %} py-1.5{% if active %} text-sm font-medium{% elif sub %} hover:text-vermillion hover:bg-boxwood-light{% else %} text-sm text-charcoal-mid hover:text-vermillion hover:bg-boxwood-light{% endif %} rounded-r-md transition-colors">{{ label }}</a></li>
{%- endmacro %}

{#
  The desktop sidebar: the search widget and the grouped link list.
  Rendered only from the `lg` breakpoint; `mobile_docs_bar` covers the
  narrower widths.

  active     the current docs page's slug; the sidebar then renders every
             docs page under its group, marking that one
  sub_links  in-page anchors listed beneath the active page, each a
             mapping with `href` and `label`
  sections   bespoke groups in place of the docs pages, each a mapping
             with a `title`, its `links`, and optionally `sub: true` to
             indent every link as an in-page anchor; a link may carry its
             own `sub` or `active`, which the forthcoming pages use to nest
             anchors under the current preview. The guides pass an "On
             this page" list and a "Helpful links" list
  search     whether to draw the docs search widget
  nav_label  an `aria-label` for the sidebar's `nav`, where the section
             list is not the documentation
#}
{% macro sidebar(active=none, sub_links=[], sections=none, search=true, nav_label='') %}
        <aside id="sidebar" class="hidden lg:block w-64 shrink-0 h-[calc(100vh-4rem)] sticky top-16 overflow-y-auto border-r border-stone-light pr-6 py-8">
            {%- if search %}
            <!-- Search -->
            <div
                class="mb-8 relative"
                data-doc-search-root
                data-doc-search-index="/netsuke/assets/search/docs-search.json"
            >
                <span class="iconify absolute left-3 top-2.5 text-stone text-sm" data-icon="carbon:search" aria-hidden="true"></span>
                <input
                    type="text"
                    placeholder="Search docs..."
                    class="search-input w-full pl-9 pr-4 py-2 bg-white border border-stone rounded-md text-sm text-charcoal placeholder-stone focus:border-indigo transition-colors shadow-xs"
                    data-doc-search-input
                    aria-label="Search the documentation"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                >
                <div class="absolute right-3 top-2.5 text-xs text-stone font-mono">⌘K</div>
                <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-doc-search-panel>
                    <div class="overflow-hidden rounded-xl border border-stone bg-white shadow-paper-lg">
                        <ul class="max-h-96 overflow-y-auto hm-rows" data-doc-search-results role="listbox"></ul>
                        <p class="border-t border-stone-light bg-boxwood-pale px-4 py-3 text-xs text-charcoal-light" data-doc-search-meta>
                            Type at least 2 characters to search the docs.
                        </p>
                    </div>
                </div>
            </div>
            {%- endif %}

            <nav class="space-y-8"{% if nav_label %} aria-label="{{ nav_label }}"{% endif %}>
                {%- if sections is none %}
                {%- for group in docs_groups %}
                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">{{ group }}</h3>
                    <ul class="space-y-1">
                        {%- for page in docs_pages if page.group == group %}
                        {{ sidebar_link('/netsuke/docs/' ~ (page.slug ~ '/' if page.slug else ''), page.label, active=(page.slug == active)) }}
                        {%- if page.slug == active %}
                        {%- for link in sub_links %}
                        {{ sidebar_link(link.href, link.label, sub=true) }}
                        {%- endfor %}
                        {%- endif %}
                        {%- endfor %}
                    </ul>
                </div>
                {%- endfor %}
                {%- else %}
                {%- for section in sections %}
                <div>
                    <h3 class="font-serif font-bold text-charcoal text-sm mb-3 px-2">{{ section.title }}</h3>
                    <ul class="space-y-1">
                        {%- for link in section.links %}
                        {{ sidebar_link(link.href, link.label, active=link.active | default(false), sub=link.sub | default(section.sub | default(false))) }}
                        {%- endfor %}
                    </ul>
                </div>
                {%- endfor %}
                {%- endif %}
            </nav>
        </aside>
{% endmacro %}

{#
  Floating docs sub-menu bar for mobile devices.

  A clone of the examples-hub filter/search bar, repurposed as docs
  navigation. Rendered only below the `lg` breakpoint; desktop keeps the
  left-hand sidebar (`hidden lg:block`), so the two are exactly
  complementary. The pages are offered as a single dropdown (a native
  select, so mobile browsers present their own picker); navigation on
  change is wired up by assets/js/docs-nav.js. The search box reuses the
  shared doc-search widget via its `data-doc-search-*` hooks, which
  support multiple roots per page.
#}
{% macro mobile_docs_bar(active='') %}
        <section class="hm-filter-shell lg:hidden sticky top-20 z-40 mb-8 py-3 -mx-4 px-4 sm:mx-0 sm:px-0 [contain:inline-size]" aria-label="Documentation menu">
            <div class="hm-filter-shell__row flex flex-col sm:flex-row justify-between items-center gap-3">
                <div class="relative w-full sm:w-auto sm:flex-1 sm:max-w-[16rem]">
                    <label for="docs-nav-select" class="visually-hidden">Documentation pages</label>
                    <span class="iconify absolute left-3 top-2.5 text-stone text-sm pointer-events-none" data-icon="carbon:book" aria-hidden="true"></span>
                    <select
                        id="docs-nav-select"
                        data-docs-nav-select
                        class="search-input w-full appearance-none pl-9 pr-8 py-1.5 bg-white border border-stone rounded-md text-sm text-charcoal focus:border-indigo focus:ring-1 focus:ring-indigo transition-colors"
                    >
                        {% for page in docs_pages %}
                        <option value="/netsuke/docs/{% if page.slug %}{{ page.slug }}/{% endif %}"{% if active == page.slug %} selected{% endif %}>{{ page.label }}</option>
                        {% endfor %}
                    </select>
                    <span class="iconify absolute right-3 top-2.5 text-stone text-sm pointer-events-none" data-icon="carbon:chevron-down" aria-hidden="true"></span>
                </div>

                <div
                    class="relative w-full sm:w-64 sm:shrink-0"
                    data-doc-search-root
                    data-doc-search-index="/netsuke/assets/search/docs-search.json"
                >
                    <span class="iconify absolute left-3 top-2.5 text-stone text-sm" data-icon="carbon:search" aria-hidden="true"></span>
                    <input
                        type="text"
                        placeholder="Search docs..."
                        class="search-input w-full pl-9 pr-4 py-1.5 bg-white border border-stone rounded-md text-sm text-charcoal placeholder-stone focus:border-indigo focus:ring-1 focus:ring-indigo transition-colors"
                        data-doc-search-input
                        aria-label="Search the documentation"
                        role="combobox"
                        aria-autocomplete="list"
                        aria-expanded="false"
                    >
                    <div class="absolute left-0 right-0 top-full z-30 mt-2 hidden" data-doc-search-panel>
                        <div class="overflow-hidden rounded-xl border border-stone bg-white shadow-paper-lg">
                            <ul class="max-h-96 overflow-y-auto hm-rows" data-doc-search-results role="listbox"></ul>
                            <p class="border-t border-stone-light bg-boxwood-pale px-4 py-3 text-xs text-charcoal-light" data-doc-search-meta>
                                Type at least 2 characters to search the docs.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <script defer src="/netsuke/assets/js/docs-nav.js"></script>
{% endmacro %}

{#
  Footer previous/next navigation.

  `footer_nav` renders the docs-style pair of circular-arrow links from
  explicit entries — each a mapping with `href`, `label`, and an
  optional `kicker` (the small uppercase word above the title). Guides
  pages call it directly with their bespoke destinations.

  `docs_footer` derives the entries from `docs_pages` for the linear
  docs reading order; the final page continues onward to the examples
  hub.
#}
{% macro footer_nav(prev=none, next=none) %}
            <div class="mt-10 pt-10 border-t border-stone-light">
                <div class="flex justify-between items-center">
                    {% if prev %}
                    <a href="{{ prev.href }}" class="group flex items-center text-charcoal-mid hover:text-charcoal transition-colors">
                        <div class="w-8 h-8 rounded-full border border-stone flex items-center justify-center mr-3 group-hover:border-indigo group-hover:text-indigo transition-colors">
                            <span class="iconify text-xs" data-icon="carbon:arrow-left" aria-hidden="true"></span>
                        </div>
                        <div class="text-left">
                            <div class="text-xs text-charcoal-light uppercase tracking-wide">{{ prev.kicker | default('Previous') }}</div>
                            <div class="font-medium text-sm">{{ prev.label }}</div>
                        </div>
                    </a>
                    {% else %}
                    <span></span>
                    {% endif %}

                    {% if next %}
                    <a href="{{ next.href }}" class="group flex items-center text-charcoal-mid hover:text-charcoal transition-colors">
                        <div class="text-right">
                            <div class="text-xs text-charcoal-light uppercase tracking-wide">{{ next.kicker | default('Next') }}</div>
                            <div class="font-medium text-sm">{{ next.label }}</div>
                        </div>
                        <div class="w-8 h-8 rounded-full border border-stone flex items-center justify-center ml-3 group-hover:border-indigo group-hover:text-indigo transition-colors">
                            <span class="iconify text-xs" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </div>
                    </a>
                    {% endif %}
                </div>
            </div>
{% endmacro %}

{% macro docs_footer(active) %}
{%- set ns = namespace(prev=none, next=none) -%}
{%- for page in docs_pages -%}
    {%- if page.slug == active -%}
        {%- if not loop.first -%}{%- set ns.prev = docs_pages[loop.index0 - 1] -%}{%- endif -%}
        {%- if not loop.last -%}{%- set ns.next = docs_pages[loop.index0 + 1] -%}{%- endif -%}
    {%- endif -%}
{%- endfor -%}
{%- set prev_entry = {'href': '/netsuke/docs/' ~ (ns.prev.slug ~ '/' if ns.prev.slug else ''), 'label': ns.prev.label} if ns.prev else none -%}
{%- set next_entry = {'href': '/netsuke/docs/' ~ (ns.next.slug ~ '/' if ns.next.slug else ''), 'label': ns.next.label} if ns.next
    else {'href': '/netsuke/examples/', 'label': 'Examples Hub'} -%}
{{ footer_nav(prev_entry, next_entry) }}
{% endmacro %}
