            <div class="flex-1 min-w-0">
                <div class="p-8 lg:p-16 max-w-6xl mx-auto">

                    <header id="thesis" class="masthead-frame mb-16 border-b border-base-content/20 pb-10 relative">
                        <div class="absolute top-0 right-0 hidden md:block opacity-10 pointer-events-none">
