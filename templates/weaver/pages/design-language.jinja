                        <path
                          d="M0,60 C80,60 120,90 200,90 C280,90 320,30 400,30" stroke-width="2" fill="none" class="stroke-primary"></path>
                      </svg></div>
                  </div>
                </div><!-- Technical Overlay UI -->
                <div
                  class="absolute top-4 left-4 border border-base-content px-2 py-1 bg-white">
