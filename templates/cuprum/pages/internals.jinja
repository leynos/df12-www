        {{ ui.card('ADR-007 · Execution module boundaries', 'How single-command execution is divided between modules.', number='Decision', href=src ~ 'docs/adr-007-subprocess-execution-module-boundaries.md') }}
        {{ ui.card('ADR-013 · GitHub Actions sink', 'Why presentation is an opt-in sink rather than a change to echo.', number='Decision', href=src ~ 'docs/adr-013-opt-in-github-actions-presentation-sink.md') }}
      </div>
      {% endcall %}
