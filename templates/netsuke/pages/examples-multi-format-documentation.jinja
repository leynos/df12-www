{% extends "doc_page.jinja" %}
{% set active_nav = 'examples' %}
{% block page_title %}Multi-Format Documentation - Netsuke Examples{% endblock %}
{% block extra_head %}
    <style>
        .file-tree-item {
            position: relative;
            padding-left: 1.5rem;
        }
        .file-tree-item::before {
            content: '';
            position: absolute;
            left: 6px;
            top: 0;
            bottom: 0;
            width: 1px;
            background-color: #D1C7B8;
        }
        .file-tree-item:last-child::before { height: 14px; }
        .file-tree-item::after {
            content: '';
            position: absolute;
            left: 6px;
            top: 14px;
            width: 12px;
            height: 1px;
            background-color: #D1C7B8;
        }
    </style>
{% endblock %}
{% block content %}
{% raw %}
<main id="main-content" class="flex-grow pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
        <nav class="flex mb-8 text-sm text-charcoal-mid" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center"><a href="../" class="inline-flex items-center hover:text-indigo">Examples</a></li>
                <li><div class="flex items-center"><span class="iconify text-stone text-xs mx-2" data-icon="carbon:chevron-right" aria-hidden="true"></span><span class="ml-1 font-medium hover:text-indigo">Documentation Workflows</span></div></li>
                <li aria-current="page"><div class="flex items-center"><span class="iconify text-stone text-xs mx-2" data-icon="carbon:chevron-right" aria-hidden="true"></span><span class="ml-1 font-medium text-charcoal">Multi-Format Documentation</span></div></li>
            </ol>
        </nav>

        <header id="example-header" class="mb-12 border-b border-stone pb-12">
            <div class="flex flex-col lg:flex-row justify-between items-start gap-8">
                <div class="max-w-3xl">
                    <div class="flex items-center space-x-3 mb-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-boxwood text-charcoal font-mono border border-stone">Docs</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-boxwood text-charcoal font-mono border border-stone">Intermediate</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-matcha/10 text-matcha font-mono border border-matcha/20"><span class="iconify mr-1.5" data-icon="carbon:checkmark" aria-hidden="true"></span> Reviewed syntax</span>
                    </div>
                    <h1 class="font-serif text-4xl lg:text-5xl font-bold text-charcoal mb-6">Multi-Format Documentation</h1>
                    <p class="text-xl text-charcoal-mid font-light leading-relaxed">
                        Convert chapter Markdown into TeX, assemble a PDF with `latexmk`, and keep the build directory itself under explicit control. This example is about document pipelines, not marketing-site fluff.
                    </p>
                </div>
                <div class="flex flex-col gap-3 w-full lg:w-auto shrink-0">
                    <a href="../" class="inline-flex items-center justify-center px-6 py-3 bg-indigo text-white rounded-md font-medium shadow-sm hover:bg-indigo-light transition-all w-full lg:w-auto"><span class="iconify mr-2" data-icon="carbon:arrow-left" aria-hidden="true"></span> Back to Examples</a>
                    <a href="../../docs/rules-and-targets/" class="inline-flex items-center justify-center px-6 py-3 bg-white border border-charcoal/20 text-charcoal rounded-md font-medium hover:bg-stone-light transition-colors w-full lg:w-auto"><span class="iconify mr-2" data-icon="carbon:book" aria-hidden="true"></span> Rules &amp; Targets</a>
                </div>
            </div>
        </header>

        <div class="grid lg:grid-cols-12 gap-12">
            <div class="lg:col-span-8 space-y-12 min-w-0">
                <section id="structure" class="bg-white rounded-xl border border-stone shadow-sm p-6 lg:p-8">
                    <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center"><span class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:folder-open" aria-hidden="true"></span> Directory Structure</h2>
                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="font-mono text-sm text-charcoal-mid bg-boxwood-pale p-6 rounded-lg border border-stone">
                            <div class="flex items-center mb-2"><span class="iconify text-indigo mr-2" data-icon="carbon:folder" aria-hidden="true"></span><span class="font-bold">book-project/</span></div>
                            <div class="file-tree-item"><span class="iconify text-indigo mr-2" data-icon="carbon:folder" aria-hidden="true"></span><span>chapters/</span></div>
                            <div class="file-tree-item"><span class="iconify text-stone mr-2" data-icon="carbon:document" aria-hidden="true"></span><span>01-intro.md</span></div>
                            <div class="file-tree-item"><span class="iconify text-stone mr-2" data-icon="carbon:document" aria-hidden="true"></span><span>02-build-graph.md</span></div>
                            <div class="file-tree-item"><span class="iconify text-indigo mr-2" data-icon="carbon:folder" aria-hidden="true"></span><span>build/</span></div>
                            <div class="file-tree-item"><span class="iconify text-vermillion mr-2" data-icon="carbon:cube" aria-hidden="true"></span><span class="font-bold text-charcoal">Netsukefile</span></div>
                        </div>
                        <div class="flex flex-col justify-center space-y-4">
                            <p class="text-charcoal-mid">This manifest walks chapter files, writes `.tex` output into `build/`, then drives `latexmk` to produce a final `build/book.pdf`.</p>
                            <div class="text-sm border-l-2 border-indigo pl-4 py-1">
                                <p class="text-indigo font-medium mb-1">Why it matters</p>
                                <p class="text-charcoal-light">Directory targets, explicit dependencies, and generated intermediates are part of the language. You do not need a second orchestration layer for document builds.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="manifest">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-serif text-2xl font-bold text-charcoal flex items-center"><span class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:code" aria-hidden="true"></span> Annotated Manifest</h2>
                        <span class="text-xs font-mono text-stone bg-charcoal px-2 py-1 rounded">docs/examples/writing.yml</span>
                    </div>
                    <div class="hm-example-code-block p-6 text-sm shadow-lg overflow-x-auto">
<pre><code class="language-yaml">netsuke_version: "1.0.0"

vars:
  chapters_dir: chapters
  build_dir: build
  pandoc_flags: "-N --pdf-engine=xelatex"

rules:
  - name: tex
    command: "pandoc {{ pandoc_flags }} {{ ins }} -o {{ outs }}"

  - name: combine
    command: "latexmk -pdf -outdir={{ build_dir }} {{ ins }}"

  - name: mkdir
    command: "mkdir -p {{ outs }}"

targets:
  - foreach: glob(chapters_dir ~ '/*.md')
    name: "{{ build_dir }}/{{ item | basename | replace('.md', '.tex') }}"
    rule: tex
    sources: "{{ item }}"
    deps:
      - "{{ build_dir }}"

  - name: "{{ build_dir }}/book.pdf"
    rule: combine
    sources: "{{ glob(build_dir ~ '/*.tex') | sorted }}"

  - name: "{{ build_dir }}"
    rule: mkdir

defaults:
  - "{{ build_dir }}/book.pdf"</code></pre>
                    </div>
                    <div class="grid gap-4 mt-6">
                        <div class="flex items-start p-4 rounded-lg bg-boxwood-pale border border-stone"><div class="shrink-0 w-6 h-6 rounded-full bg-vermillion text-white text-sm font-bold flex items-center justify-center mt-0.5">1</div><div class="ml-4"><h4 class="font-bold text-charcoal text-sm mb-1">Intermediates are explicit</h4><p class="text-sm text-charcoal-mid">Each Markdown chapter becomes a TeX file in `build/`. Those files are not hand-waved away; they are graph nodes.</p></div></div>
                        <div class="flex items-start p-4 rounded-lg bg-boxwood-pale border border-stone"><div class="shrink-0 w-6 h-6 rounded-full bg-vermillion text-white text-sm font-bold flex items-center justify-center mt-0.5">2</div><div class="ml-4"><h4 class="font-bold text-charcoal text-sm mb-1">Directory creation is modelled too</h4><p class="text-sm text-charcoal-mid">The build directory has its own target and the chapter outputs depend on it.</p></div></div>
                        <div class="flex items-start p-4 rounded-lg bg-boxwood-pale border border-stone"><div class="shrink-0 w-6 h-6 rounded-full bg-vermillion text-white text-sm font-bold flex items-center justify-center mt-0.5">3</div><div class="ml-4"><h4 class="font-bold text-charcoal text-sm mb-1">Ordering is deliberate</h4><p class="text-sm text-charcoal-mid">The final PDF consumes a sorted list of TeX inputs so chapter order stays stable.</p></div></div>
                    </div>
                </section>

                <section id="terminal-preview">
                    <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center"><span class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:terminal" aria-hidden="true"></span> Running the Build</h2>
                    <div class="hm-example-terminal bg-charcoal rounded-xl border border-charcoal-mid shadow-lg overflow-hidden">
                        <div class="hm-example-terminal__titlebar bg-charcoal-mid/30 px-4 py-2 flex items-center justify-between border-b border-white/10"><div class="flex space-x-2"><div class="w-3 h-3 rounded-full bg-vermillion"></div><div class="w-3 h-3 rounded-full bg-amber"></div><div class="w-3 h-3 rounded-full bg-matcha"></div></div><div class="text-xs font-mono text-charcoal-light">Terminal</div><div class="w-12"></div></div>
                        <div class="hm-example-terminal__body p-6 font-mono text-sm overflow-x-auto">
                            <div class="text-boxwood-pale mb-2"><span class="text-matcha">➜</span> <span class="text-indigo-light">~/book-project</span> <span class="text-boxwood">netsuke build build/book.pdf</span></div>
                            <div class="text-stone-light/80 mb-1"><span class="text-charcoal-light">0.0s</span> <span class="text-indigo font-bold">INFO</span> Created build directory target `build`.</div>
                            <div class="text-stone-light/80 mb-1"><span class="text-charcoal-light">0.1s</span> <span class="text-indigo font-bold">INFO</span> [1/5] Rendering `01-intro.md` to `build/01-intro.tex`</div>
                            <div class="text-stone-light/80 mb-1"><span class="text-charcoal-light">0.2s</span> <span class="text-indigo font-bold">INFO</span> [4/5] Rendering `04-appendix.md` to `build/04-appendix.tex`</div>
                            <div class="text-stone-light/80 mb-3"><span class="text-charcoal-light">0.9s</span> <span class="text-indigo font-bold">INFO</span> [5/5] Running `latexmk` for `build/book.pdf`</div>
                            <div class="text-matcha">Build complete: build/book.pdf</div>
                        </div>
                    </div>
                </section>

                <section id="build-flow" class="bg-white rounded-xl border border-stone shadow-sm p-6 lg:p-8">
                    <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center"><span class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:flow-stream" aria-hidden="true"></span> Build Flow</h2>
                    <div class="grid md:grid-cols-4 gap-4 text-sm">
                        <div class="rounded-lg border border-stone bg-boxwood-pale p-4"><p class="font-bold text-charcoal mb-1">1. Prepare</p><p class="text-charcoal-mid">Create `build/` as a first-class target.</p></div>
                        <div class="rounded-lg border border-stone bg-white p-4"><p class="font-bold text-charcoal mb-1">2. Convert</p><p class="text-charcoal-mid">Render each chapter Markdown file to TeX.</p></div>
                        <div class="rounded-lg border border-stone bg-white p-4"><p class="font-bold text-charcoal mb-1">3. Order</p><p class="text-charcoal-mid">Sort the generated TeX files for stable assembly.</p></div>
                        <div class="rounded-lg border border-stone bg-boxwood-pale p-4"><p class="font-bold text-charcoal mb-1">4. Assemble</p><p class="text-charcoal-mid">Run `latexmk` to emit the PDF deliverable.</p></div>
                    </div>
                </section>
            </div>

            <aside class="lg:col-span-4 space-y-8">
                <div class="bg-white rounded-lg shadow-sm border border-stone p-6 sticky top-24">
                    <h3 class="font-serif text-lg font-bold text-charcoal mb-4">On this page</h3>
                    <ul class="space-y-3 text-sm border-l border-stone-light ml-1">
                        <li><a href="#structure" class="block pl-4 text-charcoal-mid hover:text-indigo border-l-2 border-transparent hover:border-indigo -ml-[1px] transition-colors">Directory Structure</a></li>
                        <li><a href="#manifest" class="block pl-4 text-charcoal font-medium border-l-2 border-vermillion -ml-[1px]">Annotated Manifest</a></li>
                        <li><a href="#terminal-preview" class="block pl-4 text-charcoal-mid hover:text-indigo border-l-2 border-transparent hover:border-indigo -ml-[1px] transition-colors">Running the Build</a></li>
                        <li><a href="#build-flow" class="block pl-4 text-charcoal-mid hover:text-indigo border-l-2 border-transparent hover:border-indigo -ml-[1px] transition-colors">Build Flow</a></li>
                    </ul>
                    <div class="mt-8 pt-6 border-t border-stone-light">
                        <h3 class="font-serif text-lg font-bold text-charcoal mb-4">Related Documentation</h3>
                        <ul class="space-y-3">
                            <li><a href="../../docs/rules-and-targets/" class="flex items-start group"><span class="iconify text-stone mt-1 mr-2 group-hover:text-indigo transition-colors" data-icon="carbon:book" aria-hidden="true"></span><div><span class="block text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Rules &amp; Targets</span><span class="text-xs text-charcoal-light">Dependencies, defaults, and ordered sources</span></div></a></li>
                            <li><a href="../../docs/templating-and-standard-library/" class="flex items-start group"><span class="iconify text-stone mt-1 mr-2 group-hover:text-indigo transition-colors" data-icon="carbon:template" aria-hidden="true"></span><div><span class="block text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Templating</span><span class="text-xs text-charcoal-light">Filters such as `sort` and path rewriting</span></div></a></li>
                            <li><a href="../../docs/manifest-reference/" class="flex items-start group"><span class="iconify text-stone mt-1 mr-2 group-hover:text-indigo transition-colors" data-icon="carbon:data-structured" aria-hidden="true"></span><div><span class="block text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Manifest Reference</span><span class="text-xs text-charcoal-light">`deps`, actions, and build directory targets</span></div></a></li>
                        </ul>
                    </div>
                </div>

                <div class="bg-indigo rounded-xl p-6 text-white shadow-lg relative overflow-hidden">
                    <div class="absolute top-0 right-0 -mr-10 -mt-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
                    <h3 class="font-serif text-lg font-bold mb-2 relative z-10">Up Next</h3>
                    <p class="text-indigo-100 text-sm mb-4 relative z-10">After a multi-step pipeline, go back to the smallest possible manifest and see the language with almost all abstraction stripped away.</p>
                    <a href="../hello-world/" class="block bg-white/10 backdrop-blur border border-white/20 rounded-lg p-3 hover:bg-white/20 transition-colors relative z-10">
                        <div class="flex justify-between items-center mb-1"><span class="text-xs font-mono text-amber">Basics</span><span class="iconify text-xs opacity-70" data-icon="carbon:arrow-right" aria-hidden="true"></span></div>
                        <div class="font-bold text-sm">Hello World</div>
                    </a>
                </div>
            </aside>
        </div>
    </main>
{% endraw %}
{% endblock %}
