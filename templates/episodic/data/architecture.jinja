{#
  The deployable contract with the Nile Valley hosting platform.

  Values are taken from charts/episodic and the local k3d preview design. Keep
  Helm value names exactly as the chart spells them.
#}
{% set runtime_contract = [
  {
    "item": "Entrypoint",
    "value": "granian episodic.api.runtime:create_app_from_env --interface asgi --factory",
    "note": "The production HTTP process. Granian is the ASGI server; Falcon is the application."
  },
  {
    "item": "Port",
    "value": "8080",
    "note": "Exposed by the image and named `http` in the chart."
  },
  {
    "item": "Required configuration",
    "value": "DATABASE_URL",
    "note": "The runtime refuses to start without it."
  },
  {
    "item": "Liveness probe",
    "value": "GET /health/live",
    "note": "Reports that the process has booted."
  },
  {
    "item": "Readiness probe",
    "value": "GET /health/ready",
    "note": "Checks database connectivity and returns 503 on failure, so the platform withholds traffic."
  },
  {
    "item": "Process user",
    "value": "Non-root, uid and gid 10001",
    "note": "With a read-only root filesystem and all capabilities dropped."
  }
] %}

