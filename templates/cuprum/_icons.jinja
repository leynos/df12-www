  'github': '<circle cx="6" cy="3" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="21" r="2"/><path d="M6 5v14m12-11a6 6 0 0 1-6 6H6"/>',
  'check': '<circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/>',
  'progress': '<circle cx="12" cy="12" r="9" stroke-dasharray="3 3"/><path d="M12 7v5l3 2"/>',
