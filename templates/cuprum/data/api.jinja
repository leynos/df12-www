        "doc": {
          "summary": "Execution parameters for SafeCmd runtime control.",
          "sections": [
            {
              "title": "Attributes",
              "fields": [
                {
                  "name": "env",
                  "type": "",
                  "description": "Environment variable overlay applied to the subprocess."
                },
                {
                  "name": "cwd",
                  "type": "",
                  "description": "Working directory for the subprocess."
