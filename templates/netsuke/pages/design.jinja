    <script>
      // Chart Generation
      window.addEventListener('load', function()
      {
        try
        {
          // Bar Chart
          const barData = [
          {
            x: ['Q1', 'Q2', 'Q3', 'Q4'],
            y: [120, 180, 240, 310],
            type: 'bar',
            marker:
            {
              color: '#2B4162'
            } // Indigo
          }];
          const barLayout = {
            title:
            {
              text: '',
              font:
              {
                family: 'Fraunces'
              }
            },
            margin:
            {
              t: 20,
              r: 20,
              b: 40,
              l: 40
            },
            plot_bgcolor: '#FFFFFF',
            paper_bgcolor: '#FFFFFF',
            font:
            {
              family: 'Source Sans 3',
              color: '#5C554D'
            },
            xaxis:
            {
              gridcolor: '#F5EDE0'
            },
            yaxis:
            {
              gridcolor: '#F5EDE0'
            }
          };
          Plotly.newPlot('barChartContainer', barData, barLayout,
          {
            responsive: true,
            displayModeBar: false
          });

          // Pie Chart
          const pieData = [
          {
            values: [45, 25, 20, 10],
            labels: ['Buttons', 'Forms', 'Cards', 'Other'],
            type: 'pie',
            marker:
            {
              colors: ['#2B4162', '#C23B22', '#E8D5B5',
                '#D1C7B8'
              ] // Indigo, Vermillion, Boxwood, Stone
            },
            textinfo: 'none'
          }];
          const pieLayout = {
            margin:
            {
              t: 20,
              r: 20,
              b: 20,
              l: 20
            },
            paper_bgcolor: '#FFFFFF',
            font:
            {
              family: 'Source Sans 3',
              color: '#5C554D'
            },
            showlegend: true
          };
          Plotly.newPlot('pieChartContainer', pieData, pieLayout,
          {
            responsive: true,
            displayModeBar: false
          });

        }
        catch (e)
        {
          console.error("Chart generation failed:", e);
        }
      });
    </script>
