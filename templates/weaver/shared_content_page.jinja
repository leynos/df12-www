{#
  The generated legal pages: privacy policy, terms of use, code of conduct.

  This used to be a fourth standalone copy of the page chrome, and the copy
  had drifted. Its sidebar was missing `id="sidebar"` and the
  `data-mobile-nav-header` hook, so `mobile-nav.js` returned early and the
  legal pages had no navigation at all below 1024px. Its nav listed the same
  ten links in a different style, and its brand linked with a relative `../`
  where every other page uses a root-relative href.

  Extending the shared layout fixes all four at once. What stays different is
  deliberate: these pages carry no paper texture and no grid background, and
  their footer is the short legal one rather than the full site footer.
#}
{% extends "doc_page.jinja" %}

{% block page_title %}{{ title }} — Weaver{% endblock %}

{% block texture_overlay %}{% endblock %}

{% block main_class %}flex-1 lg:ml-64 min-h-screen relative{% endblock %}

{% block sidebar_footer %}
            {% if parent_link %}
            <div class="p-6 border-t border-base-content/10 hidden lg:block">
                <a href="{{ parent_link.href }}" class="font-mono text-xs text-base-content/60 hover:text-accent transition-colors">{{ parent_link.label }}</a>
            </div>
            {% endif %}
{% endblock %}

{% block content %}
            <section class="py-20 px-8 lg:px-16">
                <div class="max-w-3xl mx-auto">
                    <span class="font-mono text-xs text-accent font-bold tracking-widest uppercase mb-2 block">Legal</span>
                    <h1 class="font-serif text-4xl text-base-content mb-10">{{ title }}</h1>

                    <article class="prose prose-indigo max-w-none font-sans text-base-content/80 leading-relaxed space-y-6">
                        {{ body_html | safe }}
                    </article>
                </div>
            </section>
{% endblock %}

{% block page_footer %}
    <footer class="bg-base-100 border-t border-base-content/20 p-8 lg:p-16 relative lg:ml-64">
        <div class="max-w-3xl mx-auto flex flex-col md:flex-row justify-between items-center">
            <div>
                <p class="font-mono text-xs text-base-content/60">&copy; 2026 df12 Productions</p>
                <p class="font-mono text-xs text-base-content/60 mt-1">Serious tools, <span class="text-accent">playful worlds.</span></p>
            </div>
            <nav class="flex space-x-6 mt-4 md:mt-0" aria-label="Legal">
                <a href="/weaver/privacy-policy/" class="font-mono text-xs text-base-content/60 hover:text-accent transition-colors">Privacy Policy</a>
                <a href="/weaver/terms-of-use/" class="font-mono text-xs text-base-content/60 hover:text-accent transition-colors">Terms of Use</a>
                <a href="/weaver/code-of-conduct/" class="font-mono text-xs text-base-content/60 hover:text-accent transition-colors">Code of Conduct</a>
            </nav>
        </div>
    </footer>
{% endblock %}
