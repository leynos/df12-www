{% extends "_layout.jinja" %}
{% block title %}Stilyagi · Design — open the hood{% endblock %}
{% block description %}The Stilyagi architecture in full: the boundary between extraction and rule execution, the IR schema, and the packaging split between the Rust core and the Python rule API.{% endblock %}
{% block page_stylesheet %}
    <link rel="stylesheet" href="/stilyagi/assets/styles/pages/design.css" />
{% endblock %}
{% block content %}
