{% extends "pages/_docs.jinja" %}
{% from "data/docs.jinja" import docs_api, docs_source as api_source %}
{% set docs_current = '/cuprum/docs/api/' %}
{% block title %}API reference · Cuprum{% endblock %}
{% block description %}Every name Cuprum exports, grouped by task, with signatures, parameters, return values, and exceptions read from the source.{% endblock %}
{% block docs_body %}
          <header class="cu-docs__head">
            <p class="cu-kicker">Documentation · API reference</p>
            <h1 class="cu-docs__title">API reference</h1>
            <p class="cu-docs__lede">
              Every name <code>cuprum</code> exports, in seven groups. The
              entries are read from the source of Cuprum
              {{ api_source.version }}; anything not listed here is internal
              and can change without notice.
            </p>
            <p class="cu-docs__meta">Generated from <a href="{{ repository_url }}/tree/{{ api_source.commit }}">{{ api_source.commit[:8] }}</a></p>
          </header>
          {% for page in docs_api %}
          <section class="cu-docs__part" aria-labelledby="{{ page.slug }}-title">
            <h2 id="{{ page.slug }}-title" class="cu-docs__part-title"><a href="{{ page.href }}">{{ page.title }}</a></h2>
            <p class="cu-docs__part-lede">{{ page.lede }}</p>
            <ul class="cu-docs__names" role="list">
              {% for name in page.names %}<li><a href="{{ page.href }}#{{ name }}"><code>{{ name }}</code></a></li>{% endfor %}
            </ul>
          </section>
          {% endfor %}
{% endblock %}
