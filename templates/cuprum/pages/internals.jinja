{% set lifecycle = {
  'id': 'fig-lifecycle', 'num': 'Fig. 02', 'horizontal': false,
  'title': 'What happens between a builder call and a result?',
  'steps': [
    {'kind': 'builder', 'kind_label': '1 · Construction', 'name': 'sh.make(PROGRAM)(*args, **flags)', 'detail': 'UnknownProgramError if the program is not catalogued. Positional arguments are stringified; keywords become --flag=value; None is rejected.', 'edge': 'SafeCmd'},
    {'kind': 'policy', 'kind_label': '2 · Authorization', 'name': 'scope check', 'detail': 'ForbiddenProgramError if the allowlist in force excludes the program. Nothing has been spawned and no hook has run.', 'edge': 'authorized'},
    {'kind': 'observer', 'kind_label': '3 · Plan', 'name': 'plan event, then before hooks', 'detail': 'Observers see the resolved argv, cwd, and environment; before hooks then run in registration order. Overlays apply over the live os.environ, and an explicit timeout beats ExecutionContext, which beats the scope default.', 'edge': 'argv, env, cwd'},
    {'kind': 'process', 'kind_label': '4 · Spawn', 'name': 'exec, no shell', 'detail': 'The argv tuple goes straight to the operating system. On Linux and macOS Cuprum owns the child’s reap so it can report its CPU time and peak memory.', 'edge': 'start event, pid'},
    {'kind': 'process', 'kind_label': '5 · Streams', 'name': 'capture, echo, line events', 'detail': 'stdout and stderr are drained by independent tasks. Echo mirrors bytes to sinks; capture keeps everything; line events are decoded once.', 'edge': 'stdout / stderr events'},
    {'kind': 'result', 'kind_label': '6 · Completion', 'name': 'exit event, after hooks, result', 'detail': 'After hooks run in reverse registration order, so the innermost cleans up first.'},
  ],
  'branches': [
    {'when': 'Task cancelled', 'then': 'SIGTERM, a grace period (cancel_grace, 0.5 s by default), then SIGKILL and reap. Repeated cancellation does not interrupt teardown; the first cancellation is re-raised afterwards.'},
    {'when': 'Timeout expires', 'then': 'The same teardown, then TimeoutExpired carrying whatever output was captured, a timeout event, and a WARNING on the cuprum.timeout logger.'},
    {'when': 'An observe hook raises', 'then': 'The run fails with the hook’s own exception type. A hook that must never affect a run catches its own errors.'},
  ],
  'takeaway': 'A command that was never authorized is never spawned, and a spawned command is always reaped, however the run ends.',
  'source': 'Source: cuprum/sh.py, cuprum/_command_internals.py, and docs/users-guide.md#execution-runtime at main@' ~ cuprum_ref,
} %}
{% set pipeline = {
  'id': 'fig-pipeline', 'num': 'Fig. 03', 'horizontal': true,
  'title': 'Which bytes go where in a three-stage pipeline?',
  'steps': [
    {'kind': 'process', 'kind_label': 'Stage 0', 'name': 'producer', 'detail': 'stdout → OS pipe. stderr → caller (echo, capture).', 'edge': 'bytes, with backpressure'},
    {'kind': 'process', 'kind_label': 'Stage 1', 'name': 'filter', 'detail': 'Reads stage 0, writes stage 2. Its stdout result is None.', 'edge': 'bytes, with backpressure'},
    {'kind': 'process', 'kind_label': 'Stage 2 (final)', 'name': 'consumer', 'detail': 'Its stdout is the pipeline’s output.', 'edge': 'final stdout'},
    {'kind': 'result', 'name': 'PipelineResult', 'detail': 'stdout, stages[], failure, failure_index.'},
  ],
  'branches': [
    {'when': 'First non-final stage exits non-zero', 'then': 'Every other still-running stage is terminated, upstream and downstream. The failing stage owns its own exit and is reported as failure_index.'},
    {'when': 'A downstream stage stops reading', 'then': 'The pump drains the upstream reader to EOF or a short timeout, so the producer is not left blocked on a full pipe.'},
    {'when': 'Deadline reached', 'then': 'One deadline covers the whole pipeline; each stage still gets its own timeout event and log record.'},
  ],
  'takeaway': 'Only the final stage’s stdout reaches the caller; every stage’s stderr does. Blame goes to the first stage to fail, not the last.',
  'source': 'Source: cuprum/_pipeline_internals.py, cuprum/_pipeline_wait.py, and docs/users-guide.md#pipeline-execution at main@' ~ cuprum_ref,
} %}
