{#
  Shared macros for the rstest-bdd sub-site. Import as `ui`:

    {% import "components.jinja" as ui %}

  Each macro pairs with a component block in src/styles/rstest-bdd/; the
  macro says what a thing is at the call site and the stylesheet says how it
  is sewn. See docs/developers-guide.md, section 5.9.
#}
{% import "_icons.jinja" as icons %}

{#- A felt button. `variant` is 'primary' (lantern), 'outline', or 'night'. -#}
{% macro button(label, href, variant='primary', icon=none, compact=false) -%}
<a class="rb-btn{% if variant != 'primary' %} rb-btn--{{ variant }}{% endif %}{% if compact %} rb-btn--compact{% endif %}" href="{{ href }}">{{ label }}{% if icon %}{{ icons.icon(icon) }}{% endif %}</a>
{%- endmacro %}

{#- A round felt button with a stitched rim; `label` is a numeral or empty,
    in which case it is drawn as a sewn-on button with four holes. The bead
    is decorative when `label` repeats a number the text already states. -#}
{% macro bead(label='', tone='pumpkin', hidden=true) -%}
<span class="rb-bead{% if not label %} rb-bead--button{% endif %}{% if tone != 'pumpkin' %} rb-bead--{{ tone }}{% endif %}"{% if hidden %} aria-hidden="true"{% endif %}>{{ label }}</span>
{%- endmacro %}

{#- An illustration sewn into a wool patch. `image` carries `name` (the file
    stem under assets/images/), `alt`, `label`, `caption`, and optionally
    `sizes` and `eager`. Every plate is published at 768 and 1536 wide, at
    3:2. -#}
{% macro figure(image, class='') -%}
<figure class="rb-figure rb-stitched{% if class %} {{ class }}{% endif %}">
  <img
    src="/rstest-bdd/assets/images/{{ image.name }}-1536.webp"
    srcset="/rstest-bdd/assets/images/{{ image.name }}-768.webp 768w, /rstest-bdd/assets/images/{{ image.name }}-1536.webp 1536w"
    sizes="{{ image.sizes or '(min-width: 64rem) 45vw, 100vw' }}"
    width="1536"
    height="1024"
    alt="{{ image.alt }}"
    {% if image.eager %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
    decoding="async"
  />
  <figcaption class="rb-figure__caption">
    <span class="rb-figure__label">{{ image.label }}</span>
    <span>{{ image.caption }}</span>
  </figcaption>
</figure>
{%- endmacro %}

{#- The first viewport of an inner page. A call block supplies the page's
    actions. -#}
{% macro page_head(kicker, title, thesis, meta=none, image=none) -%}
<header class="rb-page-head{% if image %} rb-page-head--art{% endif %}">
  <div class="rb-shell rb-page-head__grid">
    <div>
      <p class="rb-kicker">{{ kicker }}</p>
      <h1 class="rb-page-head__title">{{ title }}</h1>
      <p class="rb-page-head__thesis">{{ thesis }}</p>
      {% if meta %}
      <p class="rb-page-head__meta">{{ meta }}</p>
      {% endif %}
      {% if caller is defined %}
      <div class="rb-page-head__actions">
        {{ caller() }}
      </div>
      {% endif %}
    </div>
    {% if image %}
    {{ figure(image) }}
    {% endif %}
  </div>
</header>
{%- endmacro %}

{#- The head of a numbered section: a bead with the number, the kicker, the
    heading, and an optional lede. `id` names the heading so the section can
    be labelled by it. -#}
{% macro section_head(number, kicker, title, id, lede=none, tone='pumpkin') -%}
<div class="rb-section-head">
  {{ bead(number, tone) }}
  <p class="rb-kicker">{{ kicker }}</p>
  <h2 id="{{ id }}" class="rb-section-head__title">{{ title }}</h2>
  {% if lede %}
  <p class="rb-section-head__lede">{{ lede }}</p>
  {% endif %}
</div>
{%- endmacro %}

{#- The lexer for a sample file, from its extension. -#}
{% macro _lexer(path) -%}
{%- if path.endswith('.rs') %}rust{% elif path.endswith('.feature') %}gherkin{% elif path.endswith('.toml') %}toml{% else %}text{% endif -%}
{%- endmacro %}

{#- A code panel. The caller supplies the highlighted block; the macro
    supplies the bar with the file tab, the keyboard-reachable scroll region,
    and the footer. `sample` names the file under samples/ the code is taken
    from, which tests/test_rstest_bdd_build.py holds the panel to.
    `data-rb-copy` marks the panel for the copy-button enhancement in
    assets/js/copy-code.ts: `copy='console'` strips `$ ` prompts from what is
    copied, and `copy=false` leaves the panel without a button. -#}
{% macro code_panel(title, sample=none, foot=none, copy='text') -%}
<div class="rb-code rb-stitched"{% if sample %} data-rb-sample="{{ sample }}"{% endif %}{% if copy %} data-rb-copy="{{ copy }}" data-rb-copy-label="{{ title }}"{% endif %}>
  <div class="rb-code__bar">
    <span class="rb-code__file rb-stitched rb-stitched--fine">{{ title }}</span>
    <span class="rb-code__slot" data-rb-copy-slot></span>
  </div>
  <div class="rb-code-scroll" tabindex="0" role="region" aria-label="{{ title }}">
    {{ caller() }}
  </div>
  {% if foot is none and sample %}
  <p class="rb-code__foot">Compiled and run against rstest-bdd {{ rstest_bdd_version }}.</p>
  {% elif foot %}
  <p class="rb-code__foot">{{ foot }}</p>
  {% endif %}
</div>
{%- endmacro %}

{#- A whole sample file, highlighted, in a code panel titled by its path. -#}
{% macro sample(path, title=none) -%}
{% call code_panel(title or path, sample=path) %}
{% highlight _lexer(path), 'lantern-syntax' %}{% include 'samples/' ~ path %}{% endhighlight %}
{% endcall %}
{%- endmacro %}

{#- Output from a real run, on a linen slip. The caller supplies the text. -#}
{% macro output(title, label='') -%}
<div class="rb-output">
  <div class="rb-output__bar"><span>{{ title }}</span>{% if label %}<span>{{ label }}</span>{% endif %}</div>
  <div class="rb-output__body">
    <pre>{{ caller() | trim }}</pre>
  </div>
</div>
{%- endmacro %}

{#- A note sewn to the page. `kind` is none, 'caveat', or 'new'. -#}
{% macro note(label, kind=none, class='') -%}
<aside class="rb-note rb-stitched{% if kind %} rb-note--{{ kind }}{% endif %}{% if class %} {{ class }}{% endif %}" aria-label="{{ label }}">
  <span class="rb-note__label">{{ label }}</span>
  {{ caller() }}
</aside>
{%- endmacro %}

{#- A short list of facts: (term, value) pairs. -#}
{% macro facts(items, label='Facts') -%}
<dl class="rb-facts" aria-label="{{ label }}">
  {% for term, value in items %}
  <div class="rb-stitched rb-stitched--fine">
    <dt>{{ term }}</dt>
    <dd>{{ value }}</dd>
  </div>
  {% endfor %}
</dl>
{%- endmacro %}

{#- A guide card for the pattern book: one entry from data/guides.jinja. -#}
{% macro guide_card(guide, number, total) -%}
<a class="rb-card rb-patch rb-patch--{{ guide.patch }} rb-stitched" href="/rstest-bdd/guides/{{ guide.slug }}/">
  <img class="rb-card__badge" src="/rstest-bdd/assets/images/badges/{{ guide.slug }}.webp" width="256" height="256" alt="" loading="lazy" decoding="async" />
  <span class="rb-kicker">Guide {{ number }} of {{ total }}</span>
  <h3 class="rb-card__title">{{ guide.title }}</h3>
  <p class="rb-card__body">{{ guide.summary | safe }}</p>
  <span class="rb-card__meta">Covers {{ guide.covers }}</span>
</a>
{%- endmacro %}

{#- A comparison table that becomes one patch per row below 48rem. `head`
    is the list of column headings, the first naming the row headers; each
    row's first cell is its header. Cells are trusted template data and may
    carry inline markup. -#}
{% macro matrix(caption, head, rows) -%}
<table class="rb-matrix" role="table">
  <caption class="sr-only">{{ caption }}</caption>
  <thead role="rowgroup">
    <tr role="row">
      {% for h in head %}<th scope="col" role="columnheader">{{ h }}</th>{% endfor %}
    </tr>
  </thead>
  <tbody role="rowgroup">
    {% for row in rows %}
    <tr role="row">
      <th scope="row" role="rowheader">{{ row[0] | safe }}</th>
      {% for cell in row[1:] %}
      <td role="cell"><span class="rb-matrix__label" aria-hidden="true">{{ head[loop.index] }}</span>{{ cell | safe }}</td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
</table>
{%- endmacro %}

{#- Previous and next links. Each is a mapping of `href` and `title`, or
    none. -#}
{% macro pager(prev=none, next=none) -%}
<nav class="rb-pager" aria-label="Previous and next">
  {% if prev %}
  <a class="rb-stitched" href="{{ prev.href }}" rel="prev"><span class="rb-pager__dir">Previous</span><span class="rb-pager__title">{{ prev.title }}</span></a>
  {% endif %}
  {% if next %}
  <a class="rb-pager__next rb-stitched" href="{{ next.href }}" rel="next"><span class="rb-pager__dir">Next</span><span class="rb-pager__title">{{ next.title }}</span></a>
  {% endif %}
</nav>
{%- endmacro %}
