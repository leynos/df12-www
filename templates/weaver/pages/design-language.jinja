                  <div class="text-center leading-none"><span
                      class="text-accent-ink font-serif font-bold text-xs block">APPROVED</span><span
                      class="text-accent-ink font-mono text-4xs block mt-1">2024</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section><!-- Resources / Downloads -->
        <section id="components"
          class="p-8 lg:p-16 border-t border-base-content/20 bg-primary text-base-100">
          <div class="max-w-5xl mx-auto">
            <div
              class="flex flex-col md:flex-row justify-between items-start md:items-center mb-12">
              <div>
                <h2 class="font-serif text-3xl mb-2">Assets &amp; Resources</h2>
                <p class="text-base-100/70 font-mono text-sm">Download the
                  official kit for your projects.</p>
              </div><button
                class="mt-4 md:mt-0 px-6 py-3 bg-accent-deep text-white font-mono text-xs font-bold uppercase tracking-wider hover:bg-white hover:text-accent-ink transition-colors border border-accent">
                Download All Assets {{ icon('download', 'ml-2') }}</button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"><a
                href="#" class="block group">
