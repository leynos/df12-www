{% extends "doc_page.jinja" %}
{% from '_icons.jinja' import icon %}

{% block page_title %}Command: Observe - Weaver AI Codebase Tooling{% endblock %}

{% block extra_head %}
{% endblock %}

{% block nav_subitems_commands %}
                    <!-- Sub-navigation for Commands -->
                    <div class="ml-4 pl-4 border-l border-base-content/20 space-y-1 my-2">
                        <a href="/weaver/commands/observe/" class="block py-1 text-xs font-mono font-bold text-accent bg-accent/5 -ml-4 pl-4 border-l-2 border-accent">/observe</a>
                        <a href="/weaver/commands/act/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent transition-colors">/act</a>
                        <a href="/weaver/commands/verify/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent transition-colors">/verify</a>
                    </div>
{% endblock %}

{% block content %}

            <!-- Header Section -->
            <section id="observe-header" class="relative pt-16 pb-12 px-8 lg:px-16 border-b border-base-content/20">
                <div class="masthead-frame mx-auto">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8">
                        <div class="masthead-eyebrow self-start">
                            <a href="/weaver/commands/" class="font-mono text-xs tracking-widest uppercase text-base-content/60 hover:text-accent transition-colors">COMMANDS</a>
                            <span class="text-base-content/40">/</span>
                            <span class="font-mono text-xs tracking-widest uppercase text-base-content font-bold">OBSERVE</span>
                        </div>
                    </div>

                    <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-6">
                        Perception & <br>
                        <span class="text-accent italic font-light">Structure</span>.
                    </h1>

                    <p class="font-sans text-lg text-base-content/80 leading-relaxed max-w-3xl font-light">
                        The <span class="font-mono text-sm bg-primary/10 px-1 rounded-sm">observe</span> command is the sensory organ of the Weaver agent. It fuses raw file content with semantic metadata from Tree-sitter and LSP servers to produce a high-fidelity, structured representation of the codebase.
                    </p>
                </div>

                <!-- Decorative Observe Illustration -->
                <div class="absolute right-0 top-0 h-full w-1/3 hidden xl:flex opacity-22 pointer-events-none overflow-hidden items-start justify-end pr-8 pt-8">
                    <img
                        src="/weaver/assets/observe/observe-hero-outline.png"
                        alt="Blueprint-style observation illustration for the observe command."
                        class="block h-[26rem] w-auto"
                    >
                </div>
            </section>

            <!-- Usage & Syntax Section -->
            <section class="py-12 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

                        <!-- Left: Synopsis -->
                        <div class="lg:col-span-1">
                            <h2 class="font-serif text-2xl text-base-content mb-4">Synopsis</h2>
                            <p class="text-sm text-base-content/70 mb-6 leading-relaxed">
                                Each <code class="font-mono text-xs bg-primary/10 px-1">observe</code> operation queries code structure and relationships via the daemon. The daemon speaks JSONL internally; the CLI either forwards the inner payload in JSON mode or renders recognised responses for humans when stdout is a TTY.
                            </p>

                            <div class="bg-base-100 border border-base-content p-4 relative mb-6">
                                <div class="absolute -top-3 left-4 bg-base-100 px-2 text-xs font-mono text-accent font-bold">SYNTAX</div>
                                <code class="font-mono text-sm text-base-content block break-all">
                                    weaver observe &lt;OPERATION&gt; [ARG ...]
                                </code>
                            </div>

                            <div class="flex items-center gap-2 text-xs font-mono text-base-content/60">
                                {{ icon('info-circle') }}
                                <span>Language inferred from file extension</span>
                            </div>
                        </div>

                        <!-- Right: Operations Table -->
                        <div class="lg:col-span-2">
                            <h2 class="font-serif text-2xl text-base-content mb-4">Operations</h2>
                            <div class="overflow-hidden border border-base-content/20 rounded-xs shadow-xs bg-base-100">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-primary text-base-100 font-mono text-xs uppercase tracking-wider">
                                            <th class="p-3 border-r border-base-100/20 w-40">Operation</th>
                                            <th class="p-3 border-r border-base-100/20 w-24">Source</th>
                                            <th class="p-3 border-r border-base-100/20 w-28">Status</th>
                                            <th class="p-3">Description</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-base-content/10">
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">get-definition</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">LSP</td>
                                            <td class="p-3 font-mono text-xs text-base-content border-r border-base-content/10">Current</td>
                                            <td class="p-3 text-sm text-base-content/80">Jump to definition. Requires <span class="font-mono text-xs bg-primary/10 px-1">--uri</span> and <span class="font-mono text-xs bg-primary/10 px-1">--position</span>.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">find-references</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">LSP</td>
                                            <td class="p-3 font-mono text-xs text-base-content border-r border-base-content/10">Current</td>
                                            <td class="p-3 text-sm text-base-content/80">Find all usages of a symbol. Same flags as <code>get-definition</code>.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">call-hierarchy</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">LSP</td>
                                            <td class="p-3 font-mono text-xs text-base-content border-r border-base-content/10">Current</td>
                                            <td class="p-3 text-sm text-base-content/80">Incoming/outgoing call graph. Returns nodes and edges.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">query</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">Tree-sitter</td>
                                            <td class="p-3 font-mono text-xs text-base-content border-r border-base-content/10">Current</td>
                                            <td class="p-3 text-sm text-base-content/80">AST-aware structural query via <span class="font-mono text-xs bg-primary/10 px-1">--pattern</span> and <span class="font-mono text-xs bg-primary/10 px-1">--path</span>.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">grep</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">Tree-sitter</td>
                                            <td class="p-3 font-mono text-xs text-base-content border-r border-base-content/10">Current</td>
                                            <td class="p-3 text-sm text-base-content/80">Shipped alias of <code>query</code>. Same <span class="font-mono text-xs bg-primary/10 px-1">--pattern</span> and <span class="font-mono text-xs bg-primary/10 px-1">--path</span> contract.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">get-card</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">Jacquard</td>
                                            <td class="p-3 font-mono text-xs border-r border-base-content/10"><span class="status-pill status-pill-planned">Planned</span></td>
                                            <td class="p-3 text-sm text-base-content/80">Structured symbol card (signature, docstring, locals). Progressive detail levels.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent border-r border-base-content/10">graph-slice</td>
                                            <td class="p-3 font-mono text-xs text-base-content/60 border-r border-base-content/10">Jacquard</td>
                                            <td class="p-3 font-mono text-xs border-r border-base-content/10"><span class="status-pill status-pill-planned">Planned</span></td>
                                            <td class="p-3 text-sm text-base-content/80">Budgeted subgraph rooted at a symbol, with typed edges.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Example Scenarios -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-10">Integration Examples</h2>

                    <div class="space-y-12">

                        <!-- Scenario 1: get-definition -->
                        <div class="relative group">
                            <div class="absolute -left-4 top-0 bottom-0 w-1 bg-primary opacity-30 group-hover:opacity-100 transition-opacity"></div>
                            <h3 class="font-serif text-xl text-base-content mb-4 pl-4">1. Jump to Definition</h3>
                            <p class="text-sm text-base-content/70 mb-4 pl-4 max-w-2xl">
                                Point at any symbol with a URI and cursor position. Weaver starts the appropriate language server, resolves the definition, and returns the location as structured JSON.
                            </p>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pl-4">
                                <!-- Command Input -->
                                <div class="bg-neutral rounded-xs p-4 border border-base-content/20">
                                    <div class="flex justify-between items-center mb-2 border-b border-white/10 pb-2">
                                        <span class="text-xs font-mono text-base-100/50">TERMINAL</span>
                                        <div class="flex gap-1">
                                            <div class="w-2 h-2 rounded-full bg-status-error"></div>
                                            <div class="w-2 h-2 rounded-full bg-status-warn"></div>
                                            <div class="w-2 h-2 rounded-full bg-status-ok"></div>
                                        </div>
                                    </div>
                                    <code class="font-mono text-sm text-code-string">
                                        $ weaver observe get-definition \<br>
                                        &nbsp;&nbsp;--output json \<br>
                                        &nbsp;&nbsp;--uri file:///src/main.rs \<br>
                                        &nbsp;&nbsp;--position 10:5
                                    </code>
                                </div>

                                <!-- JSON Output -->
                                <div class="bg-code-surface rounded-xs p-4 border border-base-content/20 font-mono text-xs overflow-x-auto shadow-inner relative">
                                    <div class="absolute top-2 right-2 text-3xs text-white/30 uppercase tracking-widest">CLI JSON Output</div>
<pre class="text-code-text">
<span class="token-comment">// raw payload forwarded by the CLI</span>
[<span class="token-string">{"uri":"file:///src/auth.rs","line":42,"column":17}</span>]
</pre>
                                </div>
                            </div>
                        </div>

                        <!-- Scenario 2: find-references -->
                        <div class="relative group">
                            <div class="absolute -left-4 top-0 bottom-0 w-1 bg-accent opacity-30 group-hover:opacity-100 transition-opacity"></div>
                            <h3 class="font-serif text-xl text-base-content mb-4 pl-4">2. Find All References</h3>
                            <p class="text-sm text-base-content/70 mb-4 pl-4 max-w-2xl">
                                Same shape, different operation. Finds every call-site, import, and usage of the symbol at the given position — useful for impact analysis before a refactor.
                            </p>

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pl-4">
                                <!-- Command Input -->
                                <div class="bg-neutral rounded-xs p-4 border border-base-content/20">
                                    <div class="flex justify-between items-center mb-2 border-b border-white/10 pb-2">
                                        <span class="text-xs font-mono text-base-100/50">TERMINAL</span>
                                        <div class="flex gap-1">
                                            <div class="w-2 h-2 rounded-full bg-status-error"></div>
                                            <div class="w-2 h-2 rounded-full bg-status-warn"></div>
                                            <div class="w-2 h-2 rounded-full bg-status-ok"></div>
                                        </div>
                                    </div>
                                    <code class="font-mono text-sm text-code-string">
                                        $ weaver observe find-references \<br>
                                        &nbsp;&nbsp;--output json \<br>
                                        &nbsp;&nbsp;--uri file:///src/auth.rs \<br>
                                        &nbsp;&nbsp;--position 42:17
                                    </code>
                                </div>

                                <!-- JSON Output -->
                                <div class="bg-code-surface rounded-xs p-4 border border-base-content/20 font-mono text-xs overflow-x-auto shadow-inner relative">
                                    <div class="absolute top-2 right-2 text-3xs text-white/30 uppercase tracking-widest">CLI JSON Output</div>
<pre class="text-code-text">
<span class="token-comment">// raw payload forwarded by the CLI</span>
{<span class="token-key">"references"</span>:[{<span class="token-key">"uri"</span>:<span class="token-string">"file:///src/main.rs"</span>,<span class="token-key">"line"</span>:<span class="token-number">10</span>,<span class="token-key">"column"</span>:<span class="token-number">5</span>},{<span class="token-key">"uri"</span>:<span class="token-string">"file:///tests/auth_test.rs"</span>,<span class="token-key">"line"</span>:<span class="token-number">7</span>,<span class="token-key">"column"</span>:<span class="token-number">12</span>}]}
</pre>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Provenance & Architecture Diagram -->
            <section class="py-16 px-8 lg:px-16 bg-base-100 border-b border-base-content/20 relative overflow-hidden">
                <!-- Seigaiha Pattern Background -->
                <div class="absolute right-0 bottom-0 w-1/2 h-full opacity-5 pointer-events-none"
                     style=" mask-image: linear-gradient(to right, transparent, black);">
                </div>

                <div class="max-w-6xl mx-auto relative z-10">
                    <div class="flex flex-col md:flex-row justify-between md:items-end mb-12">
                        <div>
                            <span class="font-mono text-xs text-accent font-bold tracking-widest uppercase mb-2 block">ARCHITECTURE</span>
                            <h2 class="font-serif text-3xl text-base-content">Semantic Fusion Engine</h2>
                            <p class="text-base-content/70 mt-2 max-w-xl">How Weaver constructs the "truth" about your code.</p>
                        </div>
                    </div>

                    <!-- Diagram Container -->
                    <div class="bg-white border-2 border-base-content p-8 relative shadow-panel figure-fullbleed">
                        <!-- Technical Labels -->
                        <div class="absolute top-2 left-2 z-20 text-3xs font-mono text-base-content border border-base-content px-1 bg-base-100/90 figure-fullbleed-label">FIG 3.1: DATA FUSION</div>

                        <div class="relative figure-fullbleed-img">
                            <img
                                src="/weaver/assets/observe/observe-data-fusion.png"
                                alt="Illustration of raw source text, syntax trees, and language server metadata fusing into a structured semantic stream."
                                class="block w-full h-auto rounded-[2px] border border-base-content/10 bg-base-100"
                            >
                        </div>
                    </div>
                </div>
            </section>

            <!-- Bottom CTA Navigation -->
            <section class="py-16 px-8 lg:px-16">
                <div class="max-w-6xl mx-auto">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-6 p-8 bg-primary/5 border border-base-content/10 rounded-xs">
                        <div>
                            <h3 class="font-serif text-xl text-base-content mb-2">Ready to take action?</h3>
                            <p class="text-sm text-base-content/70">Now that the agent can see, learn how it manipulates the world.</p>
                        </div>
                        <a href="/weaver/commands/act/" class="group flex items-center gap-3 px-6 py-3 bg-primary text-base-100 font-mono text-xs font-bold uppercase tracking-wider hover:bg-accent transition-colors shadow-md">
                            Next: Act Command
                            {{ icon('arrow-right', 'group-hover:translate-x-1 transition-transform') }}
                        </a>
                    </div>
                </div>
            </section>

{% endblock %}
