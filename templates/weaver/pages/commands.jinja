{% block content %}

            <!-- Header Section -->
            <section id="commands-header" class="relative pt-16 pb-12 px-8 lg:px-16 border-b border-base-content/20">
                <div class="masthead-frame mx-auto">
                    <div class="masthead-eyebrow mb-6">
                        <span class="font-mono text-xs tracking-widest uppercase text-base-content">CLI Reference &mdash; 0.1.0 target</span>
                    </div>

                    <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-8">
                        The Vocabulary of <br>
                        <span class="text-accent-ink italic font-light">Action</span>.
                    </h1>

                    <p class="font-sans text-lg text-base-content/80 leading-relaxed max-w-2xl font-light mb-6">
                        Every command follows the same shape: <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">weaver &lt;resource&gt; &lt;verb&gt; [FLAGS]</code>. Resources are nouns &ndash; <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">symbols</code>, <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">patches</code>, <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">diagnostics</code> &ndash; and the verbs come from one canonical set: <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">get</code>, <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">list</code>, <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">apply</code>, <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">rename</code>, <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">move</code>, and friends. One readable renderer, one stable <code class="font-mono text-sm bg-primary/10 px-1 rounded-sm">--json</code> contract.
                    </p>

                    <p class="font-mono text-xs text-base-content/75 leading-relaxed max-w-2xl">
                        This surface is the v0.1.0 target (ADR 007). The prototype <code class="bg-primary/10 px-1">observe</code> / <code class="bg-primary/10 px-1">act</code> / <code class="bg-primary/10 px-1">verify</code> grammar, root <code class="bg-primary/10 px-1">--output</code>, per-operation <code class="bg-primary/10 px-1">--format</code>, and root <code class="bg-primary/10 px-1">--capabilities</code> are superseded and will not ship.
                    </p>
                </div>
            </section>

            <!-- Command Families Table Section -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
