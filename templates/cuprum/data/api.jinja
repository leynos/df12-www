        "line": 413,
        "display": "class RunOutputOptions(\n    capture: bool = True,\n    echo: bool = False,\n    echo_stdout: bool | None = None,\n    echo_stderr: bool | None = None,\n    max_echo_line_bytes: int | None = DEFAULT_ECHO_MAX_LINE_BYTES,\n    on_line: LineHook | None = None,\n    idle_after: float | None = None,\n    on_idle: cabc.Callable[[float, float], None] | None = None,\n    sink: sinks.OutputSink | None = None,\n)",
        "doc": {
          "summary": "Configure captured and mirrored command output.",
          "sections": [
            {
              "title": "Parameters",
              "fields": [
                {
                  "name": "capture",
                  "type": "bool, default=True",
                  "description": "Store stdout and stderr on the returned result. Capture is independent of echoing, so a captured stream can remain silent and an echoed stream can be left uncaptured."
                },
                {
                  "name": "echo",
                  "type": "bool, default=False",
                  "description": "Shorthand for enabling both <code>echo_stdout</code> and <code>echo_stderr</code> unless either stream has an explicit override."
                },
                {
                  "name": "echo_stdout",
                  "type": "bool | None, default=None",
                  "description": "Whether stdout is mirrored to the execution context's stdout sink. <code>None</code> inherits <code>echo</code>."
                },
                {
                  "name": "echo_stderr",
                  "type": "bool | None, default=None",
                  "description": "Whether stderr is mirrored to the execution context's stderr sink. <code>None</code> inherits <code>echo</code>."
                },
                {
                  "name": "max_echo_line_bytes",
                  "type": "int | None, default=64 * 1024",
                  "description": "Inclusive byte bound for every echoed line, including its retained bytes, truncation marker, and terminator. <code>None</code> restores unbounded, chunk-for-chunk mirroring; captured output always remains complete."
                },
                {
                  "name": "on_line",
                  "type": "LineHook | None, default=None",
                  "description": "Optional synchronous callback invoked once per decoded output line with a <code>LineEvent</code> carrying the stream name, the monotonic seconds since the command started, and the line text. Independent of <code>capture</code> and <code>echo</code>; lines are delivered in arrival order per stream. Lines are observed on the Python pathway, so the Rust fast-path dispatcher stays out of the way whenever this is set."
                },
                {
                  "name": "idle_after",
                  "type": "float | None, default=None",
                  "description": "Seconds of silence, measured across both streams, before the run reports that it is still running. <code>None</code> disables idle reporting and costs nothing: no watchdog, no timer, no extra pipe. The interval must be finite and strictly positive. Reporting describes the absence of observed output — never a deadlock diagnosis — and can neither terminate the child nor extend its timeout."
                },
                {
                  "name": "on_idle",
                  "type": "cabc.Callable[[float, float], None] | None, default=None",
                  "description": "Synchronous <code>(elapsed_total, elapsed_idle)</code> callback, in seconds, invoked once per idle interval in place of the built-in stderr keepalive. It must not block for long: it runs on the run's own event loop. Requires <code>idle_after</code>."
                },
                {
                  "name": "sink",
                  "type": "sinks.OutputSink | None, default=None",
                  "description": "Optional presentation adapter (<code>sinks</code> protocol). When given, it may reframe the parent-facing output of this run (for example, a GitHub Actions group); the default <code>None</code> keeps the plain two-stream behaviour. An adapter is inactive for a run when it declines activation, in which case output is unchanged."
                }
              ]
            }
          ],
          "examples": ">>> options = RunOutputOptions(capture=True, echo=True)\n>>> options.resolved_echo\n(True, True)\n>>> RunOutputOptions(capture=True, echo=True, echo_stdout=False).resolved_echo\n(False, True)\n>>> RunOutputOptions(capture=False, idle_after=30.0).capture\nFalse"
        },
