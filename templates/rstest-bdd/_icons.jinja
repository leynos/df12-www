{#
  Inline stroke icons for the rstest-bdd sub-site.

  Every icon is decorative: it sits beside a word that already says the same
  thing, so each carries aria-hidden and no title. The paths are drawn on a
  24-unit grid at a 1.9 stroke with round ends, like a stitch, and take the
  colour of the text around them. The one exception is `chevron-solid`, a
  filled triangle that marks a drop-down. Import as `icons` and call
  `icons.icon('arrow-right')`.
#}
{% set _paths = {
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M20 12H5m6-6-6 6 6 6"/>',
  'arrow-down': '<path d="M12 3v17m-7-7 7 7 7-7"/>',
  'github': '<circle cx="6" cy="3" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="21" r="2"/><path d="M6 5v14m12-11a6 6 0 0 1-6 6H6"/>',
  'menu': '<path d="M3 6h18M3 12h18M3 18h18"/>',
  'chevron-solid': '<path d="M3 8h18l-9 10Z" fill="currentColor" stroke="none"/>',
} %}

{% macro icon(name, class='') -%}
<svg{% if class %} class="{{ class }}"{% endif %} aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">{{ _paths[name] | safe }}</svg>
{%- endmacro %}
