{% macro icon(name, class='') -%}
<svg{% if class %} class="{{ class }}"{% endif %} aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{{ _paths[name] | safe }}</svg>
{%- endmacro %}
