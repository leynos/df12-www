{#
  Shared legal copy (terms, privacy, code of conduct) rendered through the
  wireframe chrome, in the layout of the Netsuke legal pages: a breadcrumb,
  then one reading panel holding the eyebrow, title, summary, and body. The
  body arrives as sanitized HTML from config/shared/, wrapped by the generator
  in content-toc, content-section, and content-card structure; .wf-legal
  styles those by element and structure. No cast and no plates appear here:
  a legal notice is not part of the scope.
#}
{% extends '_layout.jinja' %}
{% block title %}{{ title }} · wireframe{% endblock %}
{% block description %}{{ summary or title ~ ' for the wireframe site.' }}{% endblock %}
{% block content %}
<div class="wf-legal-page">
  <nav class="wf-crumbs" aria-label="Breadcrumb">
    <ol>
      {% if parent_link %}<li><a href="{{ parent_link.href }}">{{ parent_link.label }}</a></li>{% endif %}
      <li><a href="/wireframe/">wireframe</a></li>
      <li aria-current="page">{{ title }}</li>
    </ol>
  </nav>
  <div class="wf-legal-page__panel">
    <p class="wf-legal-page__eyebrow">{{ eyebrow or 'Legal' }}</p>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="wf-legal-page__summary">{{ summary }}</p>{% endif %}
    <article class="wf-legal">{{ body_html | safe }}</article>
  </div>
</div>
{% endblock %}
