{% extends "doc_page.jinja" %}
{% set active_nav = 'examples' %}
{% block page_title %}Basic C Application - Netsuke Examples{% endblock %}
{% block extra_head %}
    <style>
        .annotation-marker {
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .annotation-marker:hover {
            transform: scale(1.1);
        }

        .file-tree-item {
            position: relative;
            padding-left: 1.5rem;
        }
        .file-tree-item::before {
            content: '';
            position: absolute;
            left: 6px;
            top: 0;
            bottom: 0;
            width: 1px;
            background-color: #D1C7B8;
        }
        .file-tree-item:last-child::before {
            height: 14px;
        }
        .file-tree-item::after {
            content: '';
            position: absolute;
            left: 6px;
            top: 14px;
            width: 12px;
            height: 1px;
            background-color: #D1C7B8;
        }
    </style>
{% endblock %}
{% block content %}
{% raw %}
<main id="main-content" class="flex-grow pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">

        <!-- Breadcrumbs -->
        <nav class="flex mb-8 text-sm text-charcoal-mid" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/netsuke/examples/" class="inline-flex items-center hover:text-indigo">
                        Examples
                    </a>
                </li>
                <li>
                    <div class="flex items-center">
                        <span  class="iconify text-stone text-xs mx-2" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                        <span class="ml-1 font-medium text-charcoal-mid">System Programming</span>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <span  class="iconify text-stone text-xs mx-2" data-icon="carbon:chevron-right" aria-hidden="true"></span>
                        <span class="ml-1 font-medium text-charcoal">Basic C Application</span>
                    </div>
                </li>
            </ol>
        </nav>

        <!-- Example Header -->
        <header id="example-header" class="mb-12 border-b border-stone pb-12">
            <div class="flex flex-col lg:flex-row justify-between items-start gap-8">
                <div class="max-w-3xl">
                    <div class="flex items-center space-x-3 mb-4">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo/10 text-indigo font-mono border border-indigo/20">
                            C / C++
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-boxwood text-charcoal font-mono border border-stone">
                            Beginner
                        </span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-matcha/10 text-matcha font-mono border border-matcha/20">
                            <span  class="iconify mr-1.5" data-icon="carbon:checkmark" aria-hidden="true"></span> Reviewed syntax
                        </span>
                    </div>
                    <h1 class="font-serif text-4xl lg:text-5xl font-bold text-charcoal mb-6">Basic C Application</h1>
                    <p class="text-xl text-charcoal-mid font-light leading-relaxed">
                        A foundational example demonstrating how to compile two C sources and link them into one executable. The point is the manifest language, not a rule loader.
                    </p>
                </div>
                <div class="flex flex-col gap-3 w-full lg:w-auto shrink-0">
                    <a href="https://github.com/leynos/netsuke/archive/refs/heads/main.zip" class="hm-button hm-button--primary inline-flex items-center justify-center px-6 py-3 w-full lg:w-auto">
                        <span  class="iconify mr-2" data-icon="carbon:download" aria-hidden="true"></span> Download Repository Source
                    </a>
                    <a href="https://github.com/leynos/netsuke/tree/main/docs/examples/basic-c-application" class="hm-button hm-button--ghost inline-flex items-center justify-center px-6 py-3 w-full lg:w-auto">
                        <span  class="iconify mr-2" data-icon="carbon:logo-github" aria-hidden="true"></span> View on GitHub
                    </a>
                </div>
            </div>
        </header>

        <div class="grid lg:grid-cols-12 gap-12">

            <!-- Left Column: Content & Explanation -->
            <div class="lg:col-span-8 space-y-12 min-w-0">

                <!-- Section: Project Structure -->
                <section id="structure" class="bg-white rounded-xl border border-stone shadow-sm p-6 lg:p-8">
                    <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                        <span  class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:folder-open" aria-hidden="true"></span> Directory Structure
                    </h2>
                    <div class="grid md:grid-cols-2 gap-8">
                        <div class="font-mono text-sm text-charcoal-mid bg-boxwood-pale p-6 rounded-lg border border-stone">
                            <div class="flex items-center mb-2">
                                <span  class="iconify text-indigo mr-2" data-icon="carbon:folder" aria-hidden="true"></span>
                                <span class="font-bold">basic-c/</span>
                            </div>
                            <div class="file-tree-item">
                                <span  class="iconify text-stone mr-2" data-icon="carbon:code-reference" aria-hidden="true"></span>
                                <span>main.c</span>
                            </div>
                            <div class="file-tree-item">
                                <span  class="iconify text-stone mr-2" data-icon="carbon:code-reference" aria-hidden="true"></span>
                                <span>utils.c</span>
                            </div>
                            <div class="file-tree-item">
                                <span  class="iconify text-stone mr-2" data-icon="carbon:code-reference" aria-hidden="true"></span>
                                <span>utils.h</span>
                            </div>
                            <div class="file-tree-item">
                                <span  class="iconify text-vermillion mr-2" data-icon="carbon:cube" aria-hidden="true"></span>
                                <span class="font-bold text-charcoal">Netsukefile</span>
                            </div>
                        </div>
                        <div class="flex flex-col justify-center space-y-4">
                            <p class="text-charcoal-mid">
                                This project consists of a single executable <code class="bg-boxwood-pale px-1.5 py-0.5 rounded border border-stone text-xs">main.c</code> that depends on a utility library defined by <code class="bg-boxwood-pale px-1.5 py-0.5 rounded border border-stone text-xs">utils.c</code> and <code class="bg-boxwood-pale px-1.5 py-0.5 rounded border border-stone text-xs">utils.h</code>.
                            </p>
                            <div class="text-sm border-l-2 border-indigo pl-4 py-1">
                                <p class="text-indigo font-medium mb-1">Key Concept</p>
                                <p class="text-charcoal-light">Netsuke files are typically placed at the root of the package they define.</p>
                                <p class="text-charcoal-light">Keep the graph obvious: sources are file paths, build steps are rules or inline commands, and defaults name the artefacts to build.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section: Manifest -->
                <section id="manifest">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="font-serif text-2xl font-bold text-charcoal flex items-center">
                            <span  class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:code" aria-hidden="true"></span> Annotated Manifest
                        </h2>
                        <span class="text-xs font-mono text-stone bg-charcoal px-2 py-1 rounded">Netsukefile</span>
                    </div>

                    <div class="relative group">
                        <!-- Code Block -->
                        <div class="hm-example-code-block p-6 text-sm relative shadow-paper-lg">
                            <div class="absolute top-4 right-4 flex space-x-2">
                                <button class="text-stone-light hover:text-white transition-colors" title="Copy"><span  class="iconify" data-icon="carbon:copy" aria-hidden="true"></span></button>
                            </div>
                            <pre><code class="language-yaml"><span class="text-stone-light/50 italic"># Global manifest version</span>
<span class="text-indigo">netsuke_version</span>: <span class="text-matcha">"1.0.0"</span> <span class="relative inline-block ml-2"><span class="annotation-marker w-5 h-5 rounded-full bg-vermillion text-white text-xs font-bold flex items-center justify-center absolute -top-1 -left-1 shadow-sm">1</span></span>

<span class="text-stone-light/50 italic mt-4 block"># Reusable compile step</span>
<span class="text-indigo">rules</span>:
  - <span class="text-amber">name</span>: <span class="text-matcha">"compile"</span> <span class="relative inline-block ml-2"><span class="annotation-marker w-5 h-5 rounded-full bg-vermillion text-white text-xs font-bold flex items-center justify-center absolute -top-1 -left-1 shadow-sm">2</span></span>
    <span class="text-amber">command</span>: <span class="text-matcha">"gcc -c {{ ins }} -o {{ outs }}"</span>

<span class="text-stone-light/50 italic mt-4 block"># Targets either reuse a rule or define an inline command</span>
<span class="text-indigo">targets</span>:
  - <span class="text-amber">name</span>: <span class="text-matcha">"main.o"</span>
    <span class="text-amber">rule</span>: <span class="text-matcha">"compile"</span>
    <span class="text-amber">sources</span>: <span class="text-matcha">"main.c"</span>

  - <span class="text-amber">name</span>: <span class="text-matcha">"app"</span>
    <span class="text-amber">command</span>: <span class="text-matcha">"gcc {{ ins }} -o {{ outs }}"</span>
    <span class="text-amber">sources</span>: [<span class="text-matcha">"main.o"</span>, <span class="text-matcha">"utils.o"</span>] <span class="relative inline-block ml-2"><span class="annotation-marker w-5 h-5 rounded-full bg-vermillion text-white text-xs font-bold flex items-center justify-center absolute -top-1 -left-1 shadow-sm">3</span></span>

<span class="text-indigo">defaults</span>: [<span class="text-matcha">"app"</span>]</code></pre>
                        </div>
                    </div>

                    <!-- Annotations -->
                    <div class="grid gap-4 mt-6">
                        <div class="flex items-start p-4 rounded-lg bg-boxwood-pale border border-stone">
                            <div class="shrink-0 w-6 h-6 rounded-full bg-vermillion text-white text-sm font-bold flex items-center justify-center mt-0.5">1</div>
                            <div class="ml-4">
                                <h4 class="font-bold text-charcoal text-sm mb-1">Schema version</h4>
                                <p class="text-sm text-charcoal-mid">Every manifest starts with <code class="font-mono text-xs">netsuke_version</code>. The reviewed docs treat it as the contract for the file format.</p>
                            </div>
                        </div>
                        <div class="flex items-start p-4 rounded-lg bg-boxwood-pale border border-stone">
                            <div class="shrink-0 w-6 h-6 rounded-full bg-vermillion text-white text-sm font-bold flex items-center justify-center mt-0.5">2</div>
                            <div class="ml-4">
                                <h4 class="font-bold text-charcoal text-sm mb-1">Reusable rules</h4>
                                <p class="text-sm text-charcoal-mid">A rule holds the shared command template. Targets point at that rule instead of duplicating the command line.</p>
                            </div>
                        </div>
                        <div class="flex items-start p-4 rounded-lg bg-boxwood-pale border border-stone">
                            <div class="shrink-0 w-6 h-6 rounded-full bg-vermillion text-white text-sm font-bold flex items-center justify-center mt-0.5">3</div>
                            <div class="ml-4">
                                <h4 class="font-bold text-charcoal text-sm mb-1">Explicit graph edges</h4>
                                <p class="text-sm text-charcoal-mid">The executable target lists the object files it needs in <code class="font-mono text-xs">sources</code>. Netsuke turns that static graph into Ninja build statements.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Section: Running the Build -->
                <section id="terminal-preview">
                    <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                        <span  class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:terminal" aria-hidden="true"></span> Running the Build
                    </h2>

                    <div class="hm-example-terminal bg-charcoal rounded-xl border border-charcoal-mid shadow-lg overflow-hidden">
                        <div class="hm-example-terminal__titlebar bg-charcoal-mid/30 px-4 py-2 flex items-center justify-between border-b border-white/10">
                            <div class="flex space-x-2">
                                <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                                <div class="w-3 h-3 rounded-full bg-amber"></div>
                                <div class="w-3 h-3 rounded-full bg-matcha"></div>
                            </div>
                            <div class="text-xs font-mono text-charcoal-light">Terminal</div>
                            <div class="w-12"></div>
                        </div>
                        <div class="hm-example-terminal__body p-6 font-mono text-sm overflow-x-auto">
                            <div class="text-boxwood-pale mb-2">
                                <span class="text-matcha">➜</span> <span class="text-indigo-light">~/basic-c</span> <span class="text-boxwood">netsuke build app</span>
                            </div>
                            <div class="text-stone-light/80 mb-1">
                                <span class="text-charcoal-light">0.0s</span> <span class="text-indigo font-bold">INFO</span>  Parsed Netsukefile and expanded target graph.
                            </div>
                            <div class="text-stone-light/80 mb-1">
                                <span class="text-charcoal-light">0.1s</span> <span class="text-indigo font-bold">INFO</span>  [1/3] Compiling utils.c
                            </div>
                            <div class="text-stone-light/80 mb-1">
                                <span class="text-charcoal-light">0.2s</span> <span class="text-indigo font-bold">INFO</span>  [2/3] Compiling main.c
                            </div>
                            <div class="text-stone-light/80 mb-4">
                                <span class="text-charcoal-light">0.3s</span> <span class="text-indigo font-bold">INFO</span>  [3/3] Linking app
                            </div>
                            <div class="text-stone-light font-bold mb-6">
                                <span class="text-matcha font-bold">SUCCESS</span> Built target app in 0.35s
                            </div>

                            <div class="text-boxwood-pale mb-2">
                                <span class="text-matcha">➜</span> <span class="text-indigo-light">~/basic-c</span> <span class="text-boxwood">./app</span>
                            </div>
                            <div class="text-stone-light">
                                Hello from Netsuke C Example!
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 flex flex-col md:flex-row gap-4">
                        <div class="flex-1 p-4 bg-white border border-stone rounded-lg shadow-sm">
                            <h4 class="font-bold text-charcoal mb-2 text-sm">Build Artifacts</h4>
                            <p class="text-sm text-charcoal-mid">
                                This example writes the executable to <code class="bg-boxwood-pale px-1 rounded border border-stone text-xs">./app</code>. The important part is that the output path is explicit in the manifest.
                            </p>
                        </div>
                        <div class="flex-1 p-4 bg-white border border-stone rounded-lg shadow-sm">
                            <h4 class="font-bold text-charcoal mb-2 text-sm">Caching</h4>
                            <p class="text-sm text-charcoal-mid">
                                Try running the command again. It will complete instantly as Netsuke detects no input changes.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Section: Visual Graph -->
                <section id="dependency-graph">
                    <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                        <span  class="iconify text-vermillion mr-3 text-lg" data-icon="carbon:chart-relationship" aria-hidden="true"></span> Dependency Graph
                    </h2>
                    <div class="bg-boxwood-pale rounded-xl border border-stone p-8 flex justify-center items-center h-64 relative overflow-hidden">
                        <!-- Simple CSS Nodes Graph -->
                        <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#8A8279 1px, transparent 1px); background-size: 20px 20px;"></div>

                        <div class="relative z-10 flex flex-col items-center gap-8">
                            <!-- Main App Node -->
                            <div class="flex flex-col items-center">
                                <div class="w-32 h-12 bg-indigo text-white rounded-md shadow-lg flex items-center justify-center font-mono text-sm border-2 border-white">
                                    app
                                </div>
                                <div class="h-8 w-0.5 bg-stone-light"></div>
                                <div class="w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[8px] border-t-stone-light"></div>
                            </div>

                            <!-- Utils Node -->
                            <div class="w-32 h-12 bg-white text-charcoal rounded-md shadow-sm border border-stone flex items-center justify-center font-mono text-sm">
                                utils.o
                            </div>
                        </div>

                        <!-- Legend -->
                        <div class="absolute bottom-4 right-4 bg-white/80 backdrop-blur p-3 rounded border border-stone text-xs shadow-sm">
                            <div class="flex items-center mb-1">
                                <div class="w-3 h-3 bg-indigo rounded mr-2"></div> Binary
                            </div>
                            <div class="flex items-center">
                                <div class="w-3 h-3 bg-white border border-stone rounded mr-2"></div> Library
                            </div>
                        </div>
                    </div>
                </section>

            </div>

            <!-- Right Column: Sidebar -->
            <aside class="lg:col-span-4 space-y-8">

                <!-- Quick Navigation -->
                <div class="bg-white rounded-lg shadow-sm border border-stone p-6 sticky top-24">
                    <h3 class="font-serif text-lg font-bold text-charcoal mb-4">On this page</h3>
                    <ul class="space-y-3 text-sm border-l border-stone-light ml-1">
                        <li><a href="#structure" class="block pl-4 text-charcoal-mid hover:text-indigo border-l-2 border-transparent hover:border-indigo -ml-[1px] transition-colors">Directory Structure</a></li>
                        <li><a href="#manifest" class="block pl-4 text-charcoal font-medium border-l-2 border-vermillion -ml-[1px]">Annotated Manifest</a></li>
                        <li><a href="#terminal-preview" class="block pl-4 text-charcoal-mid hover:text-indigo border-l-2 border-transparent hover:border-indigo -ml-[1px] transition-colors">Running the Build</a></li>
                        <li><a href="#dependency-graph" class="block pl-4 text-charcoal-mid hover:text-indigo border-l-2 border-transparent hover:border-indigo -ml-[1px] transition-colors">Dependency Graph</a></li>
                    </ul>

                    <div class="mt-8 pt-6 border-t border-stone-light">
                        <h3 class="font-serif text-lg font-bold text-charcoal mb-4">Related Documentation</h3>
                        <ul class="space-y-3">
                            <li>
                                <a href="/netsuke/docs/rules-and-targets/" class="flex items-start group">
                                    <span  class="iconify text-stone mt-1 mr-2 group-hover:text-indigo transition-colors" data-icon="carbon:book" aria-hidden="true"></span>
                                    <div>
                                        <span class="block text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Rules & Targets</span>
                                        <span class="text-xs text-charcoal-light">Reference for rule and target fields</span>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <a href="/netsuke/docs/manifest-reference/" class="flex items-start group">
                                    <span  class="iconify text-stone mt-1 mr-2 group-hover:text-indigo transition-colors" data-icon="carbon:book" aria-hidden="true"></span>
                                    <div>
                                        <span class="block text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">Manifest Reference</span>
                                        <span class="text-xs text-charcoal-light">Top-level keys and field types</span>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <a href="/netsuke/docs/cli-security-and-configuration/#cli" class="flex items-start group">
                                    <span  class="iconify text-stone mt-1 mr-2 group-hover:text-indigo transition-colors" data-icon="carbon:terminal" aria-hidden="true"></span>
                                    <div>
                                        <span class="block text-sm font-medium text-charcoal group-hover:text-indigo transition-colors">CLI Reference</span>
                                        <span class="text-xs text-charcoal-light">netsuke build options</span>
                                    </div>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Next Example Card -->
                <div class="bg-indigo rounded-xl p-6 text-white shadow-lg relative overflow-hidden">
                    <div class="absolute top-0 right-0 -mr-10 -mt-10 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
                    <h3 class="font-serif text-lg font-bold mb-2 relative z-10">Up Next</h3>
                    <p class="text-indigo-100 text-sm mb-4 relative z-10">
                        Ready for something more complex? Try building a static website pipeline.
                    </p>
                    <a href="/netsuke/examples/static-site-pipeline/" class="block bg-white/10 backdrop-blur border border-white/20 rounded-lg p-3 hover:bg-white/20 transition-colors relative z-10">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-xs font-mono text-amber">Web</span>
                            <span  class="iconify text-xs opacity-70" data-icon="carbon:arrow-right" aria-hidden="true"></span>
                        </div>
                        <div class="font-bold text-sm">Static Site Pipeline</div>
                    </a>
                </div>

            </aside>
        </div>

    </main>
{% endraw %}
{% endblock %}
