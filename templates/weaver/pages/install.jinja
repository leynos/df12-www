{% extends "doc_page.jinja" %}
{% from '_icons.jinja' import icon %}

{% block page_title %}Installation & Quick Start - Weaver AI Codebase Tooling{% endblock %}

{% block extra_head %}
{% endblock %}

{% block content %}

            <!-- Hero Section -->
            <section id="install-header" class="relative pt-16 pb-12 px-8 lg:px-16 border-b border-base-content/20">
                <div class="masthead-frame mx-auto relative z-10">
                    <div class="masthead-eyebrow mb-6">
                        <span class="font-mono text-xs tracking-widest uppercase text-base-content">Setup Guide</span>
                    </div>

                    <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-6">
                        Initialize the <br><span class="text-accent-ink italic font-light">Loom</span>
                    </h1>

                    <p class="font-sans text-lg text-base-content/80 leading-relaxed max-w-2xl font-light">
                        Weaver is distributed as a single binary via Cargo. Domain commands use a local daemon for state and sandboxing, while capability probing runs entirely in the CLI process. Follow this guide to weave your first project.
                    </p>
                </div>

                <!-- Abstract Loom Illustration -->
                <div class="absolute right-0 top-0 h-full w-1/3 hidden xl:block opacity-20 pointer-events-none overflow-hidden">
                    <svg viewBox="0 0 400 400" class="h-full w-full">
                        <!-- Threads -->
                        <line x1="0" y1="50" x2="400" y2="50" stroke-width="1" class="stroke-primary" />
                        <line x1="0" y1="100" x2="400" y2="100" stroke-width="1" class="stroke-primary" />
                        <line x1="0" y1="150" x2="400" y2="150" stroke-width="1" class="stroke-primary" />
                        <line x1="0" y1="200" x2="400" y2="200" stroke-width="1" class="stroke-primary" />
                        <line x1="0" y1="250" x2="400" y2="250" stroke-width="1" class="stroke-primary" />

                        <!-- Shuttle -->
                        <path d="M50 0 C 100 0, 100 400, 150 400" stroke-width="4" fill="none" class="stroke-accent" />
                        <path d="M150 0 C 200 0, 200 400, 250 400" stroke-width="4" fill="none" class="stroke-accent" />

                        <!-- Grid Overlay -->
                        <rect x="300" y="50" width="80" height="300" fill="none" stroke-width="2" stroke-dasharray="4 4" class="stroke-primary" />
                    </svg>
                </div>
            </section>

            <!-- Prerequisites Checklist -->
            <section id="prerequisites" class="py-12 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-5xl mx-auto">
                    <h2 class="font-serif text-2xl text-base-content mb-6">Prerequisites</h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="flex items-start gap-4 p-4 border border-base-content/10 bg-base-100/50">
                            <div class="w-6 h-6 rounded-full bg-primary text-base-100 flex items-center justify-center shrink-0 mt-1">
                                {{ icon('rust', 'text-xs') }}
                            </div>
                            <div>
                                <h3 class="font-serif font-bold text-base-content text-sm">Rust Toolchain</h3>
                                <p class="text-xs text-base-content/88 mt-1">1.75.0 or newer required for installation.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4 p-4 border border-base-content/10 bg-base-100/50">
                            <div class="w-6 h-6 rounded-full bg-primary text-base-100 flex items-center justify-center shrink-0 mt-1">
                                {{ icon('linux', 'text-xs') }}
                            </div>
                            <div>
                                <h3 class="font-serif font-bold text-base-content text-sm">Linux Environment</h3>
                                <p class="text-xs text-base-content/88 mt-1">Kernel 5.10+ for full seccomp-bpf sandbox support.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4 p-4 border border-base-content/10 bg-base-100/50">
                            <div class="w-6 h-6 rounded-full bg-primary text-base-100 flex items-center justify-center shrink-0 mt-1">
                                {{ icon('terminal', 'text-xs') }}
                            </div>
                            <div>
                                <h3 class="font-serif font-bold text-base-content text-sm">Shell Access</h3>
                                <p class="text-xs text-base-content/88 mt-1">Bash, Zsh, or Fish. Root privileges not required.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Installation Steps -->
            <section id="installation" class="py-16 px-8 lg:px-16">
                <div class="max-w-5xl mx-auto">
                    <div class="flex items-center mb-12">
                        <span class="h-px w-12 bg-primary mr-4"></span>
                        <h2 class="font-serif text-3xl text-base-content">Installation</h2>
                    </div>

                    <!-- Step 1 -->
                    <div class="relative pl-12 pb-12">
                        <div class="step-line"></div>
                        <div class="absolute left-0 top-0 w-8 h-8 bg-accent-deep text-white font-mono font-bold flex items-center justify-center rounded-xs shadow-xs z-10">01</div>

                        <h3 class="font-serif text-xl font-bold text-base-content mb-2">Install from Crates.io</h3>
                        <p class="text-base-content/88 mb-4 max-w-2xl">Download and compile the weaver binary. This includes both the client CLI and the daemon.</p>

                        <div class="bg-neutral rounded-xs p-4 shadow-lg border border-base-content/20 max-w-2xl code-container group">
                            <div class="flex justify-between items-start">
                                <code class="font-mono text-sm text-code-string">cargo install weaver</code>
                                <button class="copy-btn text-xs text-code-dim hover:text-white bg-white/10 px-2 py-1 rounded-sm" onclick="df12WeaverCopy('cargo install weaver')">
                                    {{ icon('copy', 'mr-1') }} Copy
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative pl-12 pb-12">
                        <div class="step-line"></div>
                        <div class="absolute left-0 top-0 w-8 h-8 bg-primary text-white font-mono font-bold flex items-center justify-center rounded-xs shadow-xs z-10">02</div>

                        <h3 class="font-serif text-xl font-bold text-base-content mb-2">Verify Installation</h3>
                        <p class="text-base-content/88 mb-4 max-w-2xl">No init ceremony required &ndash; Weaver discovers configuration through XDG paths, environment variables, saved profiles, and CLI flags, all with sensible defaults. Run the capability probe to confirm the binary is installed:</p>

                        <div class="bg-neutral rounded-xs p-4 shadow-lg border border-base-content/20 max-w-2xl code-container group">
                            <div class="flex justify-between items-start">
                                <code class="font-mono text-sm text-code-string">weaver capabilities list --json</code>
                                <button class="copy-btn text-xs text-code-dim hover:text-white bg-white/10 px-2 py-1 rounded-sm" onclick="df12WeaverCopy('weaver capabilities list --json')">
                                    {{ icon('copy', 'mr-1') }} Copy
                                </button>
                            </div>
                            <div class="mt-2 text-xs text-code-muted font-mono border-t border-white/10 pt-2">
                                Reports runtime capability availability with the provider-selection rationale.<br>
                                For the whole command contract as data, run <code>weaver context --json</code>.
                            </div>
                        </div>

                        <div class="reference-callout mt-4 max-w-2xl">
                            <div class="reference-callout-title">
                                {{ icon('book-open') }}
                                Canonical reference
                            </div>
                            <p class="text-sm text-base-content/80 mb-3">
                                Need the real defaults, XDG discovery rules, or the daemon JSONL envelope? Use the docs hub instead of this quick-start page.
                            </p>
                            <div class="flex flex-wrap gap-3 text-xs font-mono">
                                <a href="/weaver/docs/#configuration" class="text-accent-ink hover:underline">Configuration</a>
                                <a href="/weaver/docs/#jsonl-schema" class="text-accent-ink hover:underline">JSONL protocol</a>
                                <a href="/weaver/docs/#daemon-lifecycle" class="text-accent-ink hover:underline">Daemon lifecycle</a>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative pl-12 last-step">
                        <div class="absolute left-0 top-0 w-8 h-8 bg-primary text-white font-mono font-bold flex items-center justify-center rounded-xs shadow-xs z-10">03</div>

                        <h3 class="font-serif text-xl font-bold text-base-content mb-2">Try a Command</h3>
                        <p class="text-base-content/88 mb-4 max-w-2xl">The daemon auto-starts on the first routed command &ndash; no manual launch needed. Just run:</p>

                        <div class="bg-neutral rounded-xs p-4 shadow-lg border border-base-content/20 max-w-2xl code-container group">
                            <div class="flex justify-between items-start">
                                <code class="font-mono text-sm text-code-text">
                                    <span class="text-code-string">weaver</span> definitions get --uri file:///path/to/project/src/main.rs --position 1:1
                                </code>
                                <button class="copy-btn text-xs text-code-dim hover:text-white bg-white/10 px-2 py-1 rounded-sm" onclick="df12WeaverCopy('weaver definitions get --uri file:///path/to/project/src/main.rs --position 1:1')">
                                    {{ icon('copy', 'mr-1') }} Copy
                                </button>
                            </div>
                        </div>

                        <div class="mt-4 p-4 bg-primary/5 border-l-4 border-base-content max-w-2xl">
                            <h4 class="font-bold text-sm text-base-content mb-1">{{ icon('circle-info', 'mr-2') }}Manual Daemon Control</h4>
                            <p class="text-xs text-base-content/80 font-mono">Use <code>weaver daemon start</code>, <code>weaver daemon stop</code>, or <code>weaver daemon status</code> if you need to manage the daemon explicitly.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Quick Start Pipeline -->
            <section id="quick-start" class="py-16 px-8 lg:px-16 bg-primary text-base-100 border-t border-b border-base-content/20 relative overflow-hidden">
                <!-- Background Pattern -->
                <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(white 1px, transparent 1px); background-size: 30px 30px;"></div>

                <div class="max-w-6xl mx-auto relative z-10">
                    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
                        <div>
                            <div class="inline-block border border-base-100/30 px-2 py-1 mb-4 text-3xs font-mono uppercase tracking-widest text-base-100/80">Workflow</div>
                            <h2 class="font-serif text-4xl text-white">Your First Weave</h2>
                            <p class="text-base-100/70 mt-2 max-w-xl">Execute the standard definitions, patches, and diagnostics workflow on a sample project.</p>
                        </div>
                        <div class="hidden md:block">
                            {{ icon('arrow-right-long', 'text-4xl text-accent-ink opacity-50') }}
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <!-- Definitions Card -->
                        <div class="bg-white/5 border border-white/10 p-6 rounded-xs hover:bg-white/10 transition-colors">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-8 h-8 rounded-full bg-accent-deep flex items-center justify-center text-white font-bold text-xs">1</div>
                                <h3 class="font-mono font-bold text-white">DEFINITIONS GET</h3>
                            </div>
                            <p class="text-xs text-base-100/70 mb-4 h-10">Jump to a symbol definition to understand the code before editing.</p>
                            <div class="bg-black/30 p-3 rounded-sm font-mono text-xs text-code-string border border-white/5">
                                $ weaver definitions get \<br>
                                &nbsp;&nbsp;--uri file:///path/to/project/src/main.rs \<br>
                                &nbsp;&nbsp;--position 10:5
                            </div>
                        </div>

                        <!-- Patches Card -->
                        <div class="bg-white/5 border border-white/10 p-6 rounded-xs hover:bg-white/10 transition-colors">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-8 h-8 rounded-full bg-accent-deep flex items-center justify-center text-white font-bold text-xs">2</div>
                                <h3 class="font-mono font-bold text-white">PATCHES APPLY</h3>
                            </div>
                            <p class="text-xs text-base-100/70 mb-4 h-10">Apply a patch through Double-Lock validation.</p>
                            <div class="bg-black/30 p-3 rounded-sm font-mono text-xs text-code-string border border-white/5">
                                $ weaver patches apply &lt; fix.diff
                            </div>
                        </div>

                        <!-- Diagnostics Card -->
                        <div class="bg-white/5 border border-white/10 p-6 rounded-xs hover:bg-white/10 transition-colors">
                            <div class="flex items-center gap-3 mb-4">
                                <div class="w-8 h-8 rounded-full bg-accent-deep flex items-center justify-center text-white font-bold text-xs">3</div>
                                <h3 class="font-mono font-bold text-white">DIAGNOSTICS LIST</h3>
                            </div>
                            <p class="text-xs text-base-100/70 mb-4 h-10">List diagnostics to confirm no regressions.</p>
                            <div class="bg-black/30 p-3 rounded-sm font-mono text-xs text-code-string border border-white/5">
                                $ weaver diagnostics list \<br>
                                &nbsp;&nbsp;--uri file:///path/to/project/src/main.rs
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Troubleshooting -->
            <section id="troubleshooting" class="py-16 px-8 lg:px-16">
                <div class="max-w-5xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-8">Troubleshooting</h2>

                    <div class="space-y-6">
                        <!-- Issue 1 -->
                        <div class="border border-base-content/20 bg-white p-6 rounded-xs">
                            <h3 class="font-serif text-xl text-base-content flex items-center gap-2">
                                {{ icon('triangle-exclamation', 'text-accent-ink') }}
                                Unix Socket Permission Denied
                            </h3>
                            <p class="text-sm text-base-content/88 mt-2 mb-4">
                                If you see <code>Error: connect(2) failed</code>, the daemon socket may have incorrect ownership. The default socket lives at <code>$XDG_RUNTIME_DIR/weaver/weaverd.sock</code> (fallback: <code>/tmp/weaver/uid-$UID/weaverd.sock</code>). The usual fix is to ensure the daemon runs as the correct user rather than chowning the socket directly:
                            </p>
                            <div class="bg-base-100 p-3 font-mono text-xs text-base-content border-l-2 border-base-content">
                                <span class="text-base-content/82"># Stop any stale daemon, then restart as your user</span><br>
                                weaver daemon stop &amp;&amp; weaver daemon start
                            </div>
                        </div>

                        <!-- Issue 2 -->
                        <div class="border border-base-content/20 bg-white p-6 rounded-xs">
                            <h3 class="font-serif text-xl text-base-content flex items-center gap-2">
                                {{ icon('server', 'text-ink-muted') }}
                                Non-Unix / Windows Mode
                            </h3>
                            <p class="text-sm text-base-content/88 mt-2 mb-4">
                                Unix domain sockets are not supported on Windows. Switch to TCP mode in <code>weaver.toml</code>.
                            </p>
                            <div class="bg-neutral p-4 rounded-xs text-xs font-mono text-code-text">
                                <span class="text-code-muted"># weaver.toml — switch to TCP transport</span><br>
                                daemon_socket = { transport = <span class="text-code-string">"tcp"</span>, host = <span class="text-code-string">"127.0.0.1"</span>, port = <span class="text-code-warn">9779</span> }
                            </div>
                        </div>
                    </div>
                </div>
            </section>

{% endblock %}
