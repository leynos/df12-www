                  "name": "",
                  "type": "-------",
                  "description": ""
                },
                {
                  "name": "",
                  "type": "&gt;&gt;&gt; import os",
                  "description": ""
                },
                {
                  "name": "",
                  "type": "&gt;&gt;&gt; os.environ[&quot;GIT_AUTHOR_NAME&quot;] = &quot;Cuprum&quot;",
                  "description": ""
                },
                {
                  "name": "",
                  "type": "...     # Subprocesses spawned here see PATH=/usr/bin overlaid on the",
                  "description": ""
                },
                {
                  "name": "",
                  "type": "...     # *live* os.environ, including GIT_AUTHOR_NAME.",
