  'name': 'drafting-room', 'widths': [768, 1536], 'width': 1536, 'height': 1024,
  'alt': '', 'plate': 'Plate 04',
  'caption': 'In the drafting room, Copper checks a tee on the plan. The figures below are the plan; the drawing is only a drawing.',
  'eager': true,
} %}
{% set architecture = {
  'id': 'fig-architecture', 'num': 'Fig. 01', 'horizontal': true,
  'title': 'Who constructs, who authorizes, who runs, and who reports?',
  'steps': [
    {'kind': 'builder', 'kind_label': 'Catalogue', 'name': 'ProgramCatalogue', 'detail': 'Which programs exist, grouped by project, with noise rules and documentation links.', 'edge': 'Program'},
    {'kind': 'builder', 'name': 'sh.make → SafeCmd', 'detail': 'An immutable command: program, argv tuple, project metadata. The catalogue is the one named, else the scope’s, else the default.', 'edge': 'SafeCmd'},
    {'kind': 'policy', 'name': 'CuprumContext scope', 'detail': 'The allowlist in force for this thread or task, plus hooks, environment policy, executable bindings, and defaults.', 'edge': 'authorized SafeCmd'},
    {'kind': 'process', 'kind_label': 'Runtime', 'name': 'run() / run_sync()', 'detail': 'Spawns without a shell, pumps streams, enforces timeouts, tears down.', 'edge': 'status, bytes'},
    {'kind': 'result', 'name': 'CommandResult', 'detail': 'ok, exit code, captured output, pid, timing, resource use, and the path that ran if a binding chose it.'},
  ],
  'branches': [
    {'when': 'Observers, throughout', 'then': 'Before and after hooks, sh.observe event hooks, control and echo observers, telemetry adapters, and presentation sinks receive events from the runtime. They report; they do not route.'},
  ],
  'takeaway': 'Construction and authorization are separate: the catalogue decides what can be built, and the scope in force decides what may run here.',
  'source': 'Source: docs/cuprum-design.md §§4–6 at ' ~ cuprum_tag,
} %}
{% set lifecycle = {
  'id': 'fig-lifecycle', 'num': 'Fig. 02', 'horizontal': false,
  'title': 'What happens between a builder call and a result?',
  'steps': [
    {'kind': 'builder', 'kind_label': '1 · Construction', 'name': 'sh.make(PROGRAM)(*args, **flags)', 'detail': 'UnknownProgramError if the resolved catalogue does not list the program. Arguments must be ArgValue: str, int, float, bool, or a path; keywords become --flag=value; None, bytes, and a keyword naming an execution option are rejected.', 'edge': 'SafeCmd'},
    {'kind': 'policy', 'kind_label': '2 · Authorization', 'name': 'scope check', 'detail': 'ForbiddenProgramError if the allowlist in force excludes the program. Nothing has been spawned and no hook has run.', 'edge': 'authorized'},
    {'kind': 'observer', 'kind_label': '3 · Plan', 'name': 'plan event, then before hooks', 'detail': 'Observers see the resolved argv, cwd, environment, and environment mode; before hooks then run in registration order. Overlays apply over the live os.environ unless the mode is REPLACE, and an explicit timeout beats ExecutionContext, which beats the scope default.', 'edge': 'argv, env, cwd'},
    {'kind': 'process', 'kind_label': '4 · Spawn', 'name': 'exec, no shell', 'detail': 'The argv tuple goes straight to the operating system, with the executable an active binding resolved for the program, if any. On Linux and macOS Cuprum owns the child’s reap so it can report its CPU time and peak memory; under OWN_GROUP the child leads its own session and process group.', 'edge': 'start event, pid'},
    {'kind': 'process', 'kind_label': '5 · Streams', 'name': 'capture, echo, line events', 'detail': 'stdout and stderr are drained by independent tasks. Echo mirrors bytes to sinks; capture keeps everything; line events are decoded once.', 'edge': 'stdout / stderr events'},
    {'kind': 'result', 'kind_label': '6 · Completion', 'name': 'exit event, after hooks, settled, result', 'detail': 'After hooks run in reverse registration order, so the innermost cleans up first. One settled event then closes the execution with its terminal outcome, whatever happened.'},
  ],
  'branches': [
    {'when': 'start() instead of run()', 'then': 'The caller holds a RunningCommand after step 4 and decides when to wait, signal, terminate, or kill. The handle settles once, and leaving its async with block tears a live child down the same way.'},
    {'when': 'Task cancelled', 'then': 'SIGTERM, a grace period (cancel_grace, 0.5 s by default), then SIGKILL and reap. Repeated cancellation does not interrupt teardown; the first cancellation is re-raised afterwards.'},
    {'when': 'Timeout expires', 'then': 'The same teardown, then TimeoutExpired carrying whatever output was captured, a timeout event, and a WARNING on the cuprum.timeout logger. With process-group ownership the group is signalled, so a descendant holding a pipe open is reclaimed too.'},
    {'when': 'An observe hook raises', 'then': 'The run fails with the hook’s own exception type. A hook that must never affect a run catches its own errors.'},
  ],
  'takeaway': 'A command that was never authorized is never spawned, and a spawned command is always reaped, however the run ends.',
  'source': 'Source: cuprum/sh.py, cuprum/_command_internals.py, and docs/users-guide.md at ' ~ cuprum_tag,
} %}
{% set pipeline = {
  'id': 'fig-pipeline', 'num': 'Fig. 03', 'horizontal': true,
  'title': 'Which bytes go where in a three-stage pipeline?',
  'steps': [
    {'kind': 'process', 'kind_label': 'Stage 0', 'name': 'producer', 'detail': 'stdout → OS pipe. stderr → caller (echo, capture).', 'edge': 'bytes, with backpressure'},
    {'kind': 'process', 'kind_label': 'Stage 1', 'name': 'filter', 'detail': 'Reads stage 0, writes stage 2. Its stdout result is None.', 'edge': 'bytes, with backpressure'},
    {'kind': 'process', 'kind_label': 'Stage 2 (final)', 'name': 'consumer', 'detail': 'Its stdout is the pipeline’s output.', 'edge': 'final stdout'},
    {'kind': 'result', 'name': 'PipelineResult', 'detail': 'stdout, stages[], failure, failure_index.'},
  ],
  'branches': [
    {'when': 'First non-final stage exits non-zero', 'then': 'Every other still-running stage is terminated, upstream and downstream. The failing stage owns its own exit and is reported as failure_index.'},
    {'when': 'A downstream stage stops reading', 'then': 'The pump drains the upstream reader to EOF or a short timeout, so the producer is not left blocked on a full pipe.'},
    {'when': 'Deadline reached', 'then': 'One deadline covers the whole pipeline; each stage still gets its own timeout event and log record.'},
  ],
  'takeaway': 'Only the final stage’s stdout reaches the caller; every stage’s stderr does. Blame goes to the first stage to fail, not the last.',
  'source': 'Source: cuprum/_pipeline_internals.py, cuprum/_pipeline_wait.py, and docs/users-guide.md at ' ~ cuprum_tag,
} %}
      {% call ui.page_head('Engineering plans · Internals', 'Internals',
