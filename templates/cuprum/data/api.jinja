        "display": "class ExecEvent(\n    phase: ExecPhase,\n    program: Program,\n    argv: tuple[str, ...],\n    cwd: Path | None,\n    env: cabc.Mapping[str, str] | None,\n    pid: int | None,\n    timestamp: float,\n    line: str | None,\n    exit_code: int | None,\n    duration_s: float | None,\n    tags: cabc.Mapping[str, object],\n    note: str | None = None,\n    byte_count: int | None = None,\n    operation: str | None = None,\n    error_type: str | None = None,\n    exec_id: ExecId | None = None,\n    project: str | None = None,\n    timeout_s: float | None = None,\n    timeout_mode: TimeoutMode | None = None,\n    stage_index: int | None = None,\n    stage_count: int | None = None,\n    eof_grace_s: float | None = None,\n    pending_readers: int | None = None,\n    max_rss_bytes: int | None = None,\n    user_cpu_seconds: float | None = None,\n    system_cpu_seconds: float | None = None,\n    resource_usage_mode: ResourceUsageMode | None = None,\n)",
        "doc": {
          "summary": "A structured execution event emitted by Cuprum.",
          "sections": [
            {
              "title": "Attributes",
              "fields": [
                {
                  "name": "phase",
                  "type": "",
                  "description": "Event phase. See <code>ExecPhase</code>. Both <code>timeout</code> and <code>teardown_error</code> are ancillary diagnostics that never displace a lifecycle phase. <code>pipeline_fail_fast</code> reports the pipeline coordinator's decision before the failing stage's own <code>exit</code> event. <code>timeout</code> marks a run that exceeded its deadline, and is emitted before the existing <code>exit</code> event and the public <code>TimeoutExpired</code>, both of which are preserved. <code>teardown_error</code> marks a stream consumer that drained with an unexpected error during cleanup. <code>capture_eof_grace_expired</code> marks a capturing drain whose bounded EOF grace elapsed while one or two readers remained pending. Neither ancillary diagnostic carries an ordering guarantee. Cleanup also runs on external cancellation and on an unexpected stdin-writer failure, and on those paths the original exception propagates unchanged: no <code>exit</code> event follows and no <code>TimeoutExpired</code> is raised, so an ancillary diagnostic may be the last event a consumer sees for that execution."
                },
                {
                  "name": "program",
                  "type": "",
                  "description": "The allowlisted program that is executing."
                },
                {
                  "name": "argv",
                  "type": "",
                  "description": "Full argv including program name as the first element. Empty for the sanitized <code>pipeline_fail_fast</code> decision event."
                },
                {
                  "name": "cwd",
                  "type": "",
                  "description": "Working directory for the subprocess, when set. Absent from the sanitized <code>pipeline_fail_fast</code> decision event."
                },
                {
                  "name": "env",
                  "type": "",
                  "description": "Environment overlay provided for this execution, when set. Absent from the sanitized <code>pipeline_fail_fast</code> decision event."
                },
                {
                  "name": "pid",
                  "type": "",
                  "description": "Process identifier for the running subprocess (populated for every phase except <code>plan</code>, which fires before the subprocess is spawned)."
                },
                {
                  "name": "timestamp",
                  "type": "",
                  "description": "Wall-clock timestamp (seconds since epoch) when the phase occurred."
                },
                {
                  "name": "line",
                  "type": "",
                  "description": "Output line for <code>stdout</code> / <code>stderr</code> phases. Line terminators are omitted."
                },
                {
                  "name": "exit_code",
                  "type": "",
                  "description": "Exit code for the <code>exit</code> phase, and the failing stage's exit code for the <code>pipeline_fail_fast</code> phase."
                },
                {
                  "name": "duration_s",
                  "type": "",
                  "description": "Elapsed duration in seconds from <code>start</code> to subprocess exit (not including output drain after process termination). For <code>pipeline_fail_fast</code> this is how long the failing stage ran before its completion was observed."
