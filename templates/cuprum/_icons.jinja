  'flow': '<rect x="2" y="2" width="8" height="8" rx="1"/><rect x="14" y="14" width="8" height="8" rx="1"/><path d="M6 10v4a4 4 0 0 0 4 4h4m0-12h3a3 3 0 0 1 3 3v5"/>',
