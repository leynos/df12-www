                    }
                  ]
                }
              ],
              "examples": "::\n\n    metrics = InMemoryMetrics()\n\n    with observe_echo(EchoMetricsHook(metrics)):\n        command.run_sync(output=RunOutputOptions(echo=True))\n\n    assert metrics.counters[\"cuprum_echo_encoding_failures_total\"] == 1.0"
            }
          },
