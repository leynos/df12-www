{% extends "doc_page.jinja" %}
{% from '_icons.jinja' import icon %}

{% block page_title %}{{ homepage.title }}{% endblock %}

{% block content %}

            <!-- Hero Section -->
            <section id="hero" class="relative border-b border-base-content/20 overflow-hidden">
                <!-- Desktop backdrop: the loom fills the hero; text sits in its clear left field -->
                <div class="absolute inset-0 hidden lg:block pointer-events-none" aria-hidden="true">
                    <img
                        src="/weaver/assets/home/home-hero-loom-architecture.png"
                        alt=""
                        class="w-full h-full object-cover object-[30%_40%]"
                    >
                    <div class="absolute inset-0 bg-gradient-to-r from-base-100/95 from-15% via-base-100/70 via-50% to-transparent to-85%"></div>
                </div>

                <div class="relative z-10 pt-16 pb-12 px-8 lg:px-16 lg:pt-24 lg:pb-24">
                    <div class="masthead-frame mx-auto">
                        <div class="max-w-3xl lg:max-w-xl lg:p-5 lg:bg-white/60 lg:rounded-xs">
                            <div class="masthead-eyebrow mb-8">
                                <span class="w-2 h-2 bg-accent rounded-full"></span>
                                <span class="font-mono text-xs tracking-widest uppercase text-base-content">Weaver CLI &mdash; 0.1.0 target</span>
                            </div>

                            <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-6">
                                CLI tooling for <br>
                                <span class="text-accent-ink italic font-light">code-aware</span> agents.
                            </h1>

                            <p class="font-sans text-lg text-base-content/80 leading-relaxed mb-8 max-w-lg font-light">
                                Weaver turns semantic code operations into shell primitives. Query symbols structurally, pipe the matches through <code class="text-sm bg-primary/10 px-1">jq</code>, and hand them to a rename &ndash; every command has one readable renderer and one stable <code class="text-sm bg-primary/10 px-1">--json</code> contract, with Double-Lock and Birdcage constraining the risky parts.
                            </p>

                            <p class="font-mono text-xs text-base-content/75 leading-relaxed mb-8 max-w-lg">
                                Weaver is in active early development. These pages document the v0.1.0 target surface; the prototype grammar it replaces is not preserved.
                            </p>

                            <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-center">
                                <!-- CLI Install Command Box -->
                                <div class="relative group">
                                    <div class="absolute -inset-0.5 bg-accent rounded-xs blur-sm opacity-20 group-hover:opacity-40 transition duration-200"></div>
                                    <div class="relative flex items-center bg-neutral text-base-100 font-mono text-sm px-6 py-4 rounded-xs border border-base-content shadow-lg">
                                        <span class="text-accent-ink mr-3">$</span>
                                        <span class="mr-8">cargo install weaver</span>
                                        <button class="text-base-content/82 hover:text-white transition-colors" title="Copy to clipboard">
                                            {{ icon('copy') }}
                                        </button>
                                    </div>
                                </div>
                                <a href="/weaver/install/" class="px-6 py-4 font-mono text-sm font-bold text-base-content border border-base-content hover:bg-primary hover:text-base-100 transition-all uppercase tracking-wide">
                                    Quick Start {{ icon('arrow-right', 'ml-2') }}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Desktop figure furniture -->
                <div class="absolute top-3 right-8 lg:right-16 z-10 bg-base-100 text-3xs font-mono text-base-content border border-base-content px-1 hidden lg:block">FIG 1.0: ARCHITECTURE</div>
                <div class="absolute bottom-3 right-8 lg:right-16 z-10 font-mono text-3xs text-base-content/82 bg-base-100/80 px-1 hidden lg:block">SCALE: 1:1</div>

                <!-- Below lg: the loom as a banner strip under the text -->
                <div class="relative border-t-2 border-base-content lg:hidden">
                    <div class="absolute top-3 left-8 z-10 bg-base-100 text-3xs font-mono text-base-content border border-base-content px-1">FIG 1.0: ARCHITECTURE</div>
                    <img
                        src="/weaver/assets/home/home-hero-loom-architecture.png"
                        alt="Illustrated loom fused with a software architecture diagram, showing indigo and vermilion threads moving through a daemon-like central hub with blueprint measurements and wave motifs."
                        class="w-full h-48 sm:h-64 object-cover"
                    >
                    <div class="absolute bottom-3 right-8 font-mono text-3xs text-base-content/82 bg-base-100/80 px-1">SCALE: 1:1</div>
                </div>
            </section>

            <!-- Value Props Section -->
            <section id="features" class="py-20 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

                        <!-- Prop 1: Composable -->
                        <div class="group relative p-8 border border-base-content/20 bg-base-100 hover:border-base-content transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                {{ icon('puzzle-piece', 'text-6xl text-base-content') }}
                            </div>
                            <div class="w-12 h-12 bg-primary text-base-100 flex items-center justify-center mb-6 text-xl rounded-xs">
                                {{ icon('cubes-stacked') }}
                            </div>
                            <h3 class="font-serif text-2xl text-base-content mb-3 group-hover:text-accent-ink transition-colors">Composable</h3>
                            <p class="font-sans text-base-content/88 leading-relaxed mb-6">
                                One noun-verb grammar covers reading, querying, and changing code. Queries emit versioned selector streams that pipe through <code class="text-xs bg-primary/10 px-1">jq</code> or straight into a mutation &ndash; the shell is the integration layer.
                            </p>
                            <a href="/weaver/how-it-works/#fusion" class="inline-flex items-center font-mono text-xs font-bold text-base-content uppercase tracking-wider group-hover:underline decoration-accent underline-offset-4">
                                Explore Fusion {{ icon('arrow-right', 'ml-2 text-3xs') }}
                            </a>
                            <!-- Corner Accent -->
                            <div class="absolute bottom-0 start-0 w-0 h-0 border-b-[20px] border-r-[20px] border-b-accent border-r-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        </div>

                        <!-- Prop 2: Safe -->
                        <div class="group relative p-8 border border-base-content/20 bg-base-100 hover:border-base-content transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                {{ icon('shield-halved', 'text-6xl text-base-content') }}
                            </div>
                            <div class="w-12 h-12 bg-primary text-base-100 flex items-center justify-center mb-6 text-xl rounded-xs">
                                {{ icon('lock') }}
                            </div>
                            <h3 class="font-serif text-2xl text-base-content mb-3 group-hover:text-accent-ink transition-colors">Safe</h3>
                            <p class="font-sans text-base-content/88 leading-relaxed mb-6">
                                Block bad edits before they land. Double-Lock checks the change; Birdcage isolates untrusted tooling with seccomp-bpf and namespaces.
                            </p>
                            <a href="/weaver/safety/" class="inline-flex items-center font-mono text-xs font-bold text-base-content uppercase tracking-wider group-hover:underline decoration-accent underline-offset-4">
                                Security Model {{ icon('arrow-right', 'ml-2 text-3xs') }}
                            </a>
                             <!-- Corner Accent -->
                             <div class="absolute bottom-0 start-0 w-0 h-0 border-b-[20px] border-r-[20px] border-b-accent border-r-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        </div>

                        <!-- Prop 3: Fast -->
                        <div class="group relative p-8 border border-base-content/20 bg-base-100 hover:border-base-content transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">
                            <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                                {{ icon('bolt', 'text-6xl text-base-content') }}
                            </div>
                            <div class="w-12 h-12 bg-primary text-base-100 flex items-center justify-center mb-6 text-xl rounded-xs">
                                {{ icon('microchip') }}
                            </div>
                            <h3 class="font-serif text-2xl text-base-content mb-3 group-hover:text-accent-ink transition-colors">Fast</h3>
                            <p class="font-sans text-base-content/88 leading-relaxed mb-6">
                                Keep state in a resident daemon instead of re-parsing on every call. Rust binaries stream JSONL over Unix domain sockets for low-friction automation.
                            </p>
                            <a href="/weaver/how-it-works/#daemon" class="inline-flex items-center font-mono text-xs font-bold text-base-content uppercase tracking-wider group-hover:underline decoration-accent underline-offset-4">
                                Daemon Specs {{ icon('arrow-right', 'ml-2 text-3xs') }}
                            </a>
                             <!-- Corner Accent -->
                             <div class="absolute bottom-0 start-0 w-0 h-0 border-b-[20px] border-r-[20px] border-b-accent border-r-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Command Preview Section -->
            <section id="commands-preview" class="py-20 px-8 lg:px-16 border-b border-base-content/20 relative">
                <!-- Background Pattern -->
                <div class="absolute inset-0 opacity-5" style="background-image: url('/weaver/assets/textures/cubes.png');"></div>

                <div class="max-w-6xl mx-auto">
                    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
                        <div>
                            <span class="font-mono text-xs text-accent-ink font-bold tracking-widest uppercase mb-2 block">Interface</span>
                            <h2 class="font-serif text-4xl text-base-content">Command Reference</h2>
                        </div>
                        <a href="/weaver/commands/" class="hidden md:inline-block font-mono text-sm text-base-content hover:text-accent-ink transition-colors border-b border-base-content/30 pb-1">
                            View all commands ->
                        </a>
                    </div>

                    <div class="bg-neutral rounded-xs shadow-2xl overflow-hidden border border-base-content">
                        <!-- Terminal Header -->
                        <div class="bg-black/40 px-4 py-2 flex items-center justify-between border-b border-white/10">
                            <div class="flex space-x-2">
                                <div class="w-3 h-3 rounded-full bg-status-error/80"></div>
                                <div class="w-3 h-3 rounded-full bg-status-warn/80"></div>
                                <div class="w-3 h-3 rounded-full bg-status-ok/80"></div>
                            </div>
                            <div class="text-xs font-mono text-code-muted">weaver-cli — zsh — 80x24</div>
                        </div>

                        <!-- Terminal Body -->
                        <div class="p-6 font-mono text-sm md:text-base overflow-x-auto">
                            <!-- The query-to-selector pipeline -->
                            <div class="mb-6">
                                <div class="flex text-code-dim">
                                    <span class="text-accent-ink mr-2">➜</span>
                                    <span class="mr-2">~</span>
                                    <span class="text-white">weaver symbols list --lang rust --query 'fn $NAME($...ARGS)' --json \</span>
                                </div>
                                <div class="text-white pl-10">| jq -c 'select(.captures.NAME.text | startswith("old_"))' \</div>
                                <div class="text-white pl-10">| weaver symbols rename --selectors - --new-name run --dry-run</div>
                                <div class="text-note-info mt-2 pl-4 border-l-2 border-note-info-line/30">
                                    {"schema":"weaver.selector.v1","uri":"file:///src/lib.rs","captures":{"NAME":{"text":"old_run"}}}
                                </div>
                                <div class="text-note-warn pl-4 border-l-2 border-status-warn/30">
                                    dry run: 1 rename planned, 3 files would change, verification clean
                                </div>
                            </div>

                            <!-- Cursor -->
                            <div class="flex text-code-dim">
                                <span class="text-accent-ink mr-2">➜</span>
                                <span class="mr-2">~</span>
                                <span class="text-white">weaver diagnostics list --workspace . --json<span class="animate-pulse inline-block w-2.5 h-5 bg-code-dim ml-1 align-middle"></span></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 text-center md:hidden">
                        <a href="/weaver/commands/" class="font-mono text-sm text-base-content font-bold border-b border-base-content pb-1">
                            View Full Documentation
                        </a>
                    </div>
                </div>
            </section>

            <!-- Technical Deep Dive / Sempai Section -->
            <section id="sempai" class="py-20 px-8 lg:px-16 border-b border-base-content/20 bg-white/60">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                        <div class="order-2 lg:order-1 relative">
                             <!-- Blueprint Illustration -->
                             <div class="figure-fullbleed border-2 border-base-content bg-base-100 p-6 relative shadow-panel">
                                <div class="figure-fullbleed-label absolute top-0 left-0 z-10 bg-primary text-white px-2 py-1 font-mono text-xs">QUERY ENGINE</div>
                                <div class="figure-fullbleed-img h-64 border border-base-content/20 relative overflow-hidden">
                                    <img
                                        src="/weaver/assets/home/home-sempai-query-pipeline.png"
                                        alt="Illustrated left-to-right Sempai query pipeline showing code entering a circular parsing chamber and flowing as structured output toward an agent target."
                                        class="w-full h-full object-cover"
                                    >
                                </div>
                                <div class="figure-fullbleed-caption mt-4 flex justify-between font-mono text-3xs text-base-content/82">
                                    <span>INPUT: RAW SOURCE</span>
                                    <span>OUTPUT: STRUCTURED JSONL</span>
                                </div>
                             </div>
                        </div>

                        <div class="order-1 lg:order-2">
                            <span class="font-mono text-xs text-accent-ink font-bold tracking-widest uppercase mb-2 block">Query layer</span>
                            <h2 class="font-serif text-4xl text-base-content mb-6">Sempai Query Engine</h2>
                            <p class="font-sans text-lg text-base-content/80 mb-6 font-light leading-relaxed">
                                Sempai powers <code class="text-xs bg-primary/10 px-1">weaver symbols list</code>: Semgrep-shaped queries on a Tree-sitter spine, with explicit compatibility boundaries. Matches leave as versioned selector records that any consumer can trust.
                            </p>
                            <ul class="space-y-4 mb-8">
                                <li class="flex items-start">
                                    {{ icon('check', 'text-accent-ink mt-1 mr-3 text-sm') }}
                                    <span class="text-base-content/80 text-sm">Bare structural patterns, an expression DSL, or Semgrep-style YAML rules &ndash; three explicit front doors, no guessing</span>
                                </li>
                                <li class="flex items-start">
                                    {{ icon('check', 'text-accent-ink mt-1 mr-3 text-sm') }}
                                    <span class="text-base-content/80 text-sm">Rust, Python, TypeScript, and Go core; HCL optional. The first executable slice covers Rust, Python, and TypeScript</span>
                                </li>
                                <li class="flex items-start">
                                    {{ icon('check', 'text-accent-ink mt-1 mr-3 text-sm') }}
                                    <span class="text-base-content/80 text-sm">Deterministic selector streams with spans, captures, and source digests &ndash; matches that survive the pipe</span>
                                </li>
                            </ul>
                            <a href="/weaver/sempai/" class="text-base-content font-bold border-b-2 border-accent hover:text-accent-ink transition-colors pb-1 inline-block">
                                Read the query design
                            </a>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Links Grid -->
            <section class="py-20 px-8 lg:px-16">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

                        <!-- Link Card: Docs -->
                        <a href="/weaver/docs/" class="block group h-full">
                            <div class="bg-white border border-base-content/20 p-8 h-full hover:border-base-content hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-primary/5 rounded-full group-hover:bg-primary/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-base-content mb-2">Documentation</h3>
                                <p class="text-sm text-base-content/82 mb-4">Read the command, install, safety, and configuration references.</p>
                                <span class="text-xs font-mono text-accent-ink font-bold uppercase group-hover:underline">Read Docs &rarr;</span>
                            </div>
                        </a>

                        <!-- Link Card: Roadmap -->
                        <a href="/weaver/roadmap/" class="block group h-full">
                            <div class="bg-white border border-base-content/20 p-8 h-full hover:border-base-content hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-primary/5 rounded-full group-hover:bg-primary/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-base-content mb-2">Roadmap</h3>
                                <p class="text-sm text-base-content/82 mb-4">See which phases are shipped, which are planned, and which ideas remain directional.</p>
                                <span class="text-xs font-mono text-accent-ink font-bold uppercase group-hover:underline">View plan &rarr;</span>
                            </div>
                        </a>

                        <!-- Link Card: GitHub -->
                        <a href="https://github.com/leynos/weaver" target="_blank" class="block group h-full">
                            <div class="bg-white border border-base-content/20 p-8 h-full hover:border-base-content hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-primary/5 rounded-full group-hover:bg-primary/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-base-content mb-2">GitHub</h3>
                                <p class="text-sm text-base-content/82 mb-4">Read the source, track issues, and follow release work in the open.</p>
                                <span class="text-xs font-mono text-accent-ink font-bold uppercase group-hover:underline">Open repo &rarr;</span>
                            </div>
                        </a>

                        <!-- Link Card: Community -->
                        <a href="https://github.com/leynos/weaver" target="_blank" class="block group h-full">
                            <div class="bg-white border border-base-content/20 p-8 h-full hover:border-base-content hover:shadow-md transition-all relative overflow-hidden">
                                <div class="absolute -right-4 -top-4 w-16 h-16 bg-primary/5 rounded-full group-hover:bg-primary/10 transition-colors"></div>
                                <h3 class="font-serif text-xl text-base-content mb-2">Community</h3>
                                <p class="text-sm text-base-content/82 mb-4">Discord is not live yet. Use GitHub issues until the public channel opens.</p>
                                <span class="text-xs font-mono text-accent-ink font-bold uppercase group-hover:underline">Track updates &rarr;</span>
                            </div>
                        </a>

                    </div>
                </div>
            </section>

            <!-- Footer -->
{% endblock %}
