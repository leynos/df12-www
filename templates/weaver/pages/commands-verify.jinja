{% extends "doc_page.jinja" %}
{% from '_icons.jinja' import icon %}

{% block page_title %}Commands: Verification - Weaver AI Codebase Tooling{% endblock %}

{% block extra_head %}
{% endblock %}

{% block nav_subitems_commands %}
                    <!-- Sub-navigation for Commands -->
                    <div class="ml-4 pl-4 border-l border-base-content/20 space-y-1 my-2">
                        <a href="/weaver/commands/observe/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/read</a>
                        <a href="/weaver/commands/act/" class="block py-1 text-xs font-mono text-base-content/80 hover:text-accent-ink transition-colors">/change</a>
                        <a href="/weaver/commands/verify/" class="block py-1 text-xs font-mono font-bold text-accent-ink bg-accent/5 -ml-4 pl-4 border-l-2 border-accent">/verification</a>
                    </div>
{% endblock %}

{% block content %}

            <!-- Header Section -->
            <section id="verify-header" class="relative pt-16 pb-12 px-8 lg:px-16 border-b border-base-content/20">
                <div class="masthead-frame mx-auto">
                    <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8">
                        <div class="masthead-eyebrow self-start">
                            <a href="/weaver/commands/" class="font-mono text-xs tracking-widest uppercase text-base-content/82 hover:text-accent-ink transition-colors">COMMANDS</a>
                            <span class="text-base-content/75">/</span>
                            <span class="font-mono text-xs tracking-widest uppercase text-base-content font-bold">VERIFICATION</span>
                        </div>
                    </div>

                    <h1 class="font-serif text-5xl lg:text-7xl font-bold text-base-content leading-none mb-6">
                        Trust through <br>
                        <span class="text-accent-ink italic font-light">Proof</span>.
                    </h1>

                    <p class="font-sans text-lg text-base-content/80 leading-relaxed max-w-3xl font-light">
                        Verification is not a separate command an agent may forget to run &ndash; the Double-Lock executes inside every mutation. <code class="text-xs bg-primary/10 px-1 rounded-sm">diagnostics list</code> is the standalone read on workspace health. Broader layers (policy checks, test orchestration) are planned, not implemented yet.
                    </p>
                </div>

                <!-- Decorative Verify Illustration -->
                <div class="absolute right-0 top-0 h-full w-1/3 hidden xl:flex opacity-24 pointer-events-none overflow-hidden items-start justify-end pr-8 pt-8">
                    <img
                        src="/weaver/assets/verify/verify-hero-outline.png"
                        alt="Blueprint-style verification illustration for the verify command."
                        class="block h-[28rem] w-auto"
                    >
                </div>
            </section>

            <!-- Usage & Syntax Section -->
            <section class="py-12 px-8 lg:px-16 border-b border-base-content/20 bg-white/40">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

                        <!-- Left: Synopsis -->
                        <div class="lg:col-span-1">
                            <h2 class="font-serif text-2xl text-base-content mb-4">Synopsis</h2>
                            <p class="text-sm text-base-content/88 mb-6 leading-relaxed">
                                Two verification surfaces exist: the Double-Lock, which runs inside every mutation, and <code class="text-xs bg-primary/10 px-1">diagnostics list</code>, the standalone read for a file or a workspace. One caveat travels with both: an LSP-clean result does not claim behavioural correctness.
                            </p>

                            <div class="bg-base-100 border border-base-content p-4 relative mb-6">
                                <div class="absolute -top-3 left-4 bg-base-100 px-2 text-xs font-mono text-accent-ink font-bold">SYNTAX</div>
                                <code class="font-mono text-sm text-base-content block break-all">
                                    weaver diagnostics list [--uri | --workspace] [FLAGS]
                                </code>
                            </div>

                            <div class="flex items-center gap-2 text-xs font-mono text-base-content/82">
                                {{ icon('circle-info') }}
                                <span>Language inferred from file extension</span>
                            </div>
                        </div>

                        <!-- Right: Operations Table -->
                        <div class="lg:col-span-2">
                            <h2 class="font-serif text-2xl text-base-content mb-4">Surfaces</h2>
                            <div class="overflow-hidden border border-base-content/20 rounded-xs shadow-xs bg-base-100">
                                <table class="w-full text-left border-collapse">
                                    <thead>
                                        <tr class="bg-primary text-base-100 font-mono text-xs uppercase tracking-wider">
                                            <th class="p-3 border-r border-base-100/20 w-48">Surface</th>
                                            <th class="p-3 border-r border-base-100/20 w-24">Source</th>
                                            <th class="p-3">Description</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-base-content/10">
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent-ink border-r border-base-content/10">diagnostics list</td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">LSP</td>
                                            <td class="p-3 text-sm text-base-content/80">Compiler warnings and language-server errors for a file (<code class="text-xs bg-primary/10 px-1">--uri</code>) or the whole workspace (<code class="text-xs bg-primary/10 px-1">--workspace</code>).</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors">
                                            <td class="p-3 font-mono text-xs font-bold text-accent-ink border-r border-base-content/10">the Double-Lock</td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">Engine</td>
                                            <td class="p-3 text-sm text-base-content/80">Runs inside every mutation: Tree-sitter validates the staged result, LSP observes the complete proposed delta. Not optional, not skippable.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors opacity-60">
                                            <td class="p-3 font-mono text-xs font-bold text-base-content/82 border-r border-base-content/10">policy <span class="status-pill status-pill-planned ml-1">Planned</span></td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">Sempai</td>
                                            <td class="p-3 text-sm text-base-content/82">Enforce architectural constraints and forbidden patterns via Sempai queries.</td>
                                        </tr>
                                        <tr class="hover:bg-primary/5 transition-colors opacity-60">
                                            <td class="p-3 font-mono text-xs font-bold text-base-content/82 border-r border-base-content/10">tests <span class="status-pill status-pill-planned ml-1">Planned</span></td>
                                            <td class="p-3 font-mono text-xs text-base-content/82 border-r border-base-content/10">Runner</td>
                                            <td class="p-3 text-sm text-base-content/82">Orchestrate test suites and report results as structured output.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Verification Layers Diagram -->
            <section class="py-16 px-8 lg:px-16 bg-base-100 border-b border-base-content/20 relative overflow-hidden">
                <div class="absolute inset-0 z-0 grid-bg-fine"></div>

                <div class="max-w-6xl mx-auto relative z-10">
                    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
                        <div>
                            <span class="font-mono text-xs text-accent-ink font-bold tracking-widest uppercase mb-2 block">ARCHITECTURE</span>
                            <h2 class="font-serif text-3xl text-base-content">The Verification Stack</h2>
                            <p class="text-base-content/88 mt-2 max-w-xl">
                                The Double-Lock and <code class="text-xs bg-primary/10 px-1">diagnostics list</code> form the base layer. Policy enforcement and test orchestration are planned follow-on layers.
                            </p>
                        </div>
                    </div>

                    <div class="bg-white border-2 border-base-content p-4 rounded-xs shadow-panel-soft mb-8 figure-fullbleed">
                        <img
                            src="/weaver/assets/verify/verify-verification-stack.png"
                            alt="Illustration of Weaver's staged verification stack, with diagnostics active today and policy plus test layers planned for later phases."
                            class="block w-full h-auto rounded-[2px] border border-base-content/10 bg-base-100"
                        >
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Current: Diagnostics -->
                        <div class="bg-white border-2 border-base-content p-6 shadow-panel-sm group hover:-translate-y-1 transition-transform">
                            <div class="flex items-center justify-between mb-4 pb-4 border-b border-base-content/10">
                                <span class="font-mono text-xs font-bold text-white bg-primary px-2 py-1">BASE LAYER</span>
                                {{ icon('stethoscope', 'text-accent-ink text-xl') }}
                            </div>
                            <h3 class="font-serif text-xl text-base-content mb-2">Diagnostics</h3>
                            <p class="text-xs text-base-content/88 mb-4 h-10">Compiler warnings and LSP errors for any file or workspace with a supported language server.</p>
                            <div class="bg-neutral p-3 rounded-xs font-mono text-3xs text-code-text">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-code-warn">!</span> unused variable `x`
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-code-fail">✗</span> mismatched types
                                </div>
                            </div>
                        </div>

                        <!-- Planned: Policy -->
                        <div class="bg-white/60 border-2 border-dashed border-base-content/40 p-6 group hover:-translate-y-1 transition-transform relative">
                            <div class="flex items-center justify-between mb-4 pb-4 border-b border-base-content/10">
                                <span class="font-mono text-xs font-bold text-base-content/78 bg-primary/10 px-2 py-1">PLANNED</span>
                                {{ icon('scale-balanced', 'text-base-content/75 text-xl') }}
                            </div>
                            <h3 class="font-serif text-xl text-base-content/82 mb-2">Policy Enforcement</h3>
                            <p class="text-xs text-base-content/78 mb-4 h-10">Architectural constraints and forbidden-pattern detection via Sempai queries.</p>
                            <div class="bg-neutral/90 p-3 rounded-xs font-mono text-3xs text-code-text">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-code-pass">✓</span> no_unsafe_blocks
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-code-warn">!</span> cyclomatic_complexity
                                </div>
                            </div>
                        </div>

                        <!-- Planned: Test Orchestration -->
                        <div class="bg-white/60 border-2 border-dashed border-base-content/40 p-6 group hover:-translate-y-1 transition-transform relative">
                            <div class="flex items-center justify-between mb-4 pb-4 border-b border-base-content/10">
                                <span class="font-mono text-xs font-bold text-base-content/78 bg-primary/10 px-2 py-1">PLANNED</span>
                                {{ icon('flask-vial', 'text-base-content/75 text-xl') }}
                            </div>
                            <h3 class="font-serif text-xl text-base-content/82 mb-2">Test Orchestration</h3>
                            <p class="text-xs text-base-content/78 mb-4 h-10">Run test suites and report results as structured JSONL for CI gating.</p>
                            <div class="bg-neutral/90 p-3 rounded-xs font-mono text-3xs text-code-text">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-code-pass">✓</span> cargo test
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-code-pass">✓</span> pytest tests/
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Double-Lock in the Mutation Contract -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-4">The Double-Lock, In Detail</h2>
                    <p class="text-sm text-base-content/80 max-w-3xl mb-10">
                        Every proposed change is staged into one workspace view and verified twice before commit. No path silently weakens this contract.
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Syntactic lock</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                Tree-sitter parses the final staged content of every touched file. Structural breakage &ndash; unbalanced braces, truncated blocks &ndash; is refused before any semantic work runs.
                            </p>
                        </div>
                        <div class="bg-white border border-base-content/15 p-6 rounded-xs">
                            <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">Semantic lock</h3>
                            <p class="text-sm text-base-content/75 leading-relaxed">
                                The language server observes the complete proposed delta and flushes diagnostics once per language. A missing semantic backend yields an explicit <code class="text-xs bg-primary/10 px-1">unavailable</code> or <code class="text-xs bg-primary/10 px-1">inconclusive</code> status under declared policy &ndash; never a silent pass.
                            </p>
                        </div>
                    </div>
                    <div class="bg-white border border-base-content/15 p-6 rounded-xs mb-8">
                        <h3 class="font-mono text-xs font-bold text-base-content uppercase tracking-wider mb-3">The diagnostics delta</h3>
                        <p class="text-sm text-base-content/75 leading-relaxed mb-4">
                            Post-mutation diagnostics are classified rather than dumped: <span class="font-mono text-xs">introduced</span>, <span class="font-mono text-xs">severity-worsened</span>, <span class="font-mono text-xs">resolved</span>, <span class="font-mono text-xs">unchanged</span>, or <span class="font-mono text-xs">relocated</span>. Concise deltas render inline; the complete set sits behind a bounded spool reference.
                        </p>
                        <div class="bg-neutral p-3 rounded-xs font-mono text-3xs text-code-text overflow-x-auto">
                            {"diagnostics":{"introduced":0,"severity_worsened":0,"resolved":1,"unchanged":12,"relocated":2},"spool":"weaver jobs get txn_01j9... --json"}
                        </div>
                    </div>
                    <div class="p-4 bg-primary/5 border-l-2 border-base-content">
                        <p class="text-xs font-mono text-base-content italic">
                            An LSP-clean result does not claim behavioural correctness. The locks prove the change parses and type-checks; the test suite still owns behaviour.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Policy Configuration Example -->
            <section class="py-16 px-8 lg:px-16 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

                        <!-- Explanation -->
                        <div>
                            <h2 class="font-serif text-3xl text-base-content mb-2">Planned: Policy Rules</h2>
                            <span class="status-pill status-pill-planned">Planned</span>
                            <p class="text-base-content/80 mb-6 mt-4 leading-relaxed">
                                A future policy surface will combine standard linters with custom <a href="/weaver/sempai/" class="text-accent-ink underline decoration-1 underline-offset-2">Sempai</a> queries to enforce architectural constraints. The schema below is illustrative.
                            </p>

                            <ul class="space-y-4 mb-8">
                                <li class="flex items-start gap-3">
                                    {{ icon('check', 'text-base-content/75 mt-1 text-sm') }}
                                    <span class="text-sm text-base-content/82">Block dangerous functions or imports</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    {{ icon('check', 'text-base-content/75 mt-1 text-sm') }}
                                    <span class="text-sm text-base-content/82">Enforce type hints and documentation standards</span>
                                </li>
                                <li class="flex items-start gap-3">
                                    {{ icon('check', 'text-base-content/75 mt-1 text-sm') }}
                                    <span class="text-sm text-base-content/82">Require specific test coverage thresholds</span>
                                </li>
                            </ul>

                            <div class="p-4 bg-primary/5 border-l-2 border-base-content">
                                <p class="text-xs font-mono text-base-content italic">
                                    "Verification is not just about catching bugs; it is about ensuring the AI acts within the boundaries of the system's design philosophy."
                                </p>
                            </div>
                        </div>

                        <!-- Code Block -->
                        <div class="bg-neutral rounded-xs p-1 shadow-lg border border-dashed border-base-content/30 opacity-80">
                            <div tabindex="0" class="bg-code-surface p-4 rounded-xs overflow-x-auto">
                                <div class="flex justify-between items-center mb-4 border-b border-white/10 pb-2">
                                    <span class="text-xs font-mono text-base-100/70">weaver.policy.yaml (illustrative)</span>
                                    <div class="flex gap-1">
                                        <div class="w-2 h-2 rounded-full bg-status-error"></div>
                                        <div class="w-2 h-2 rounded-full bg-status-warn"></div>
                                        <div class="w-2 h-2 rounded-full bg-status-ok"></div>
                                    </div>
                                </div>
<pre class="text-xs font-mono leading-relaxed text-code-text">
<span class="token-key">version:</span> <span class="token-string">"1.0"</span>
<span class="token-key">rules:</span>
  <span class="token-comment"># Enforce security patterns</span>
  <span class="token-key">- name:</span> <span class="token-string">"no-raw-sql"</span>
    <span class="token-key">severity:</span> <span class="token-string">"error"</span>
    <span class="token-key">query:</span> <span class="token-string">"sempai: pattern: sql_query($X) where $X is string_literal"</span>

  <span class="token-comment"># Ensure testing standards</span>
  <span class="token-key">- name:</span> <span class="token-string">"test-coverage"</span>
    <span class="token-key">severity:</span> <span class="token-string">"warning"</span>
    <span class="token-key">check:</span> <span class="token-string">"coverage > 85%"</span>
</pre>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- Output Format / CI Integration -->
            <section class="py-16 px-8 lg:px-16 bg-white/30 border-b border-base-content/20">
                <div class="max-w-6xl mx-auto">
                    <h2 class="font-serif text-3xl text-base-content mb-10">Output &amp; Integration</h2>

                    <div class="relative">
                        <!-- Connecting Line -->
                        <div class="absolute left-8 top-10 bottom-10 w-0.5 bg-primary/20 hidden md:block"></div>

                        <!-- Step 1: Running -->
                        <div class="flex flex-col md:flex-row gap-6 mb-12 relative z-10">
                            <div class="w-16 h-16 bg-primary text-base-100 flex items-center justify-center rounded-xs font-bold font-mono text-xl shrink-0 border-4 border-base-100 shadow-xs z-10">
                                01
                            </div>
                            <div class="flex-1">
                                <h3 class="font-serif text-xl text-base-content mb-2">CLI Output Modes</h3>
                                <p class="text-sm text-base-content/88 mb-4">
                                    Results go to stdout; progress and warnings go to stderr. With <code class="text-xs bg-primary/10 px-1">--json</code>, the stable machine contract streams verbatim; without it, the human renderer applies, with <code class="text-xs bg-primary/10 px-1">--limit</code> and truncation markers keeping large workspaces bounded.
                                </p>
                                <div tabindex="0" class="bg-neutral p-4 rounded-xs border border-base-content/20 font-mono text-xs overflow-x-auto">
<pre class="text-code-text">
<span class="token-cmd">$</span> <span class="token-arg">weaver diagnostics list --json --uri file:///src/lib.rs</span>

<span class="token-comment">// stable machine contract (--json)</span>
{<span class="token-key">"diagnostics"</span>:[{<span class="token-key">"line"</span>:<span class="token-number">12</span>,<span class="token-key">"column"</span>:<span class="token-number">5</span>,<span class="token-key">"message"</span>:<span class="token-string">"unused variable `x`"</span>}]}
</pre>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: Example invocation -->
                        <div class="flex flex-col md:flex-row gap-6 relative z-10">
                            <div class="w-16 h-16 bg-accent-deep text-white flex items-center justify-center rounded-xs font-bold font-mono text-xl shrink-0 border-4 border-base-100 shadow-xs z-10">
                                02
                            </div>
                            <div class="flex-1">
                                <h3 class="font-serif text-xl text-base-content mb-2">Human Mode</h3>
                                <p class="text-sm text-base-content/88 mb-4">
                                    Point at a file URI to pull every diagnostic the language server reports. Human-readable output is the default when stdout is a TTY, so recognised diagnostics render with source context instead of raw JSON.
                                </p>
                                <div tabindex="0" class="bg-neutral p-4 rounded-xs border border-base-content/20 font-mono text-xs overflow-x-auto">
<pre class="text-code-text">
<span class="token-cmd">$</span> <span class="token-arg">weaver diagnostics list --uri file:///src/lib.rs</span>

<span class="token-comment">src/lib.rs</span>
  <span class="token-comment">--></span> <span class="token-number">12</span>:<span class="token-number">5</span>
   |
<span class="token-number">12</span> | <span class="token-arg">let x = 42;</span>
       <span class="token-fail">^ unused variable `x`</span>
</pre>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Bottom CTA Navigation -->
            <section class="py-16 px-8 lg:px-16">
                <div class="max-w-6xl mx-auto">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-6 p-8 bg-primary/5 border border-base-content/10 rounded-xs">
                        <div>
                            <h3 class="font-serif text-xl text-base-content mb-2">Ready to secure your agents?</h3>
                            <p class="text-sm text-base-content/88">Learn how the sandbox keeps execution safe.</p>
                        </div>
                        <a href="/weaver/safety/" class="group flex items-center gap-3 px-6 py-3 bg-primary text-base-100 font-mono text-xs font-bold uppercase tracking-wider hover:bg-accent transition-colors shadow-md">
                            Next: Safety Model
                            {{ icon('arrow-right', 'group-hover:translate-x-1 transition-transform') }}
                        </a>
                    </div>
                </div>
            </section>

{% endblock %}
