{% endraw %}{{ docsnav.mobile_docs_bar('templating') }}{% raw %}

            <!-- Breadcrumbs -->
            <nav class="flex items-center text-sm text-charcoal-light mb-8 font-mono">
                <a href="/netsuke/docs/" class="hover:text-vermillion transition-colors">Docs</a>
                <span class="mx-2 text-stone">/</span>
                <span class="text-charcoal font-medium">Templating</span>
            </nav>

            <!-- Page Header -->
            <div class="mb-12 border-b border-stone-light pb-8">
                <div class="flex items-center mb-4">
                    <div class="inline-flex items-center px-3 py-1 rounded-full bg-boxwood text-charcoal-mid text-xs font-semibold uppercase tracking-wider border border-stone">
                        Core Concepts
                    </div>
                </div>
                <h1 class="font-serif text-4xl lg:text-5xl font-bold text-charcoal mb-6">Templating</h1>
                <p class="text-xl text-charcoal-mid font-light leading-relaxed max-w-3xl">
                    Netsuke renders MiniJinja inside YAML values. The structure stays as data; templating fills in strings,
                    expands entries with <code>foreach</code>, and gates them with <code>when</code> &mdash; all before the build graph exists.
                </p>
            </div>

            <!-- Why -->
            <section id="why" class="mb-20">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-indigo mr-3 text-lg" data-icon="carbon:idea" aria-hidden="true"></span> Why Jinja inside YAML
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    Netsuke validates YAML before rendering templates. That keeps the manifest legible, keeps the structure
                    explicit, and still leaves room for repetition, conditions, and reusable helpers. The goal is not to hide
                    the build graph &mdash; it is to keep repeated YAML short enough to tolerate.
                </p>
                <div class="grid md:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                        <div class="w-10 h-10 rounded-full bg-matcha/10 flex items-center justify-center text-matcha mb-4">
                            <span class="iconify" data-icon="carbon:document" aria-hidden="true"></span>
                        </div>
                        <h3 class="font-bold text-charcoal mb-2">YAML first</h3>
                        <p class="text-sm text-charcoal-mid">Structure is checked before templating renders commands. Structural mistakes fail early, with YAML line numbers.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                        <div class="w-10 h-10 rounded-full bg-indigo/10 flex items-center justify-center text-indigo mb-4">
                            <span class="iconify" data-icon="carbon:flow" aria-hidden="true"></span>
                        </div>
                        <h3 class="font-bold text-charcoal mb-2">Entries, not branches</h3>
                        <p class="text-sm text-charcoal-mid"><code>foreach</code> and <code>when</code> select manifest entries at plan time. Build-time branching belongs in recipe commands, not the manifest.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                        <div class="w-10 h-10 rounded-full bg-amber/10 flex items-center justify-center text-amber mb-4">
                            <span class="iconify" data-icon="carbon:function" aria-hidden="true"></span>
                        </div>
                        <h3 class="font-bold text-charcoal mb-2">Reusable helpers</h3>
                        <p class="text-sm text-charcoal-mid">Declared macros, filters, and the <a href="/netsuke/docs/standard-library/" class="text-indigo hover:underline">standard library</a> cover common path, file, and environment tasks.</p>
                    </div>
                </div>
            </section>

            <!-- YAML foundations -->
            <section id="yaml" class="mb-20 pt-10 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-indigo mr-3 text-lg" data-icon="carbon:list-boxes" aria-hidden="true"></span> YAML foundations
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    A <code>Netsukefile</code> is a YAML mapping. Netsuke rejects duplicate keys, unknown fields, and missing
                    required fields; <code>netsuke_version</code> and <code>targets</code> are required. Quote version numbers
                    and any value that begins with <code>{{</code> &mdash; an unquoted <code>{</code> has meaning in YAML.
                    Use <code>|</code> for a multi-line string that preserves line breaks, or <code>&gt;-</code> to fold lines
                    into one string.
                </p>
                <div class="hm-faux-window bg-charcoal rounded-xl border border-charcoal-mid shadow-lg overflow-hidden">
                    <div class="hm-faux-window__titlebar bg-charcoal-mid/20 px-4 py-3 flex items-center justify-between border-b border-white/10">
                        <div class="flex space-x-2">
                            <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                            <div class="w-3 h-3 rounded-full bg-amber"></div>
                            <div class="w-3 h-3 rounded-full bg-matcha"></div>
                        </div>
                        <span class="text-xs font-mono text-stone-light">Netsukefile</span>
                        <div class="w-12"></div>
                    </div>
                    <div class="hm-faux-window__body p-6 font-mono text-sm overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
netsuke_version: "1.0.0"

vars:
  greeting: Hello
  recipients:
    - Netsuke
    - Ninja

targets:
  - name: greeting.txt
    command: >-
      printf '%s\n'
      "{{ greeting }}, {{ recipients | first }}!"
      > {{ outs }}

defaults:
  - greeting.txt
{% endraw %}{% endhighlight %}{% raw %}
                    </div>
                </div>
            </section>

            <!-- Rendering -->
            <section id="rendering" class="mb-20 pt-10 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-indigo mr-3 text-lg" data-icon="carbon:magic-wand" aria-hidden="true"></span> How rendering works
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    MiniJinja renders <em>string fields</em>. Put an expression inside <code>{{ ... }}</code>, read values
                    declared under <code>vars</code> by name, pass a value through a filter with <code>|</code>, call a
                    function with parentheses, and apply a test with <code>is</code>.
                </p>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                        <h3 class="font-bold text-charcoal mb-3 text-sm">Rules that keep manifests honest</h3>
                        <ul class="space-y-2 text-sm text-charcoal-mid">
                            <li class="flex items-start"><span class="iconify text-matcha mt-1 mr-2 text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span> <span>Undefined values are errors, not silent empty strings.</span></li>
                            <li class="flex items-start"><span class="iconify text-matcha mt-1 mr-2 text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span> <span>Only <code>{{ ins }}</code> and <code>{{ outs }}</code> are automatically quoted for the host shell; other rendered values are not.</span></li>
                            <li class="flex items-start"><span class="iconify text-matcha mt-1 mr-2 text-xs" data-icon="carbon:checkmark" aria-hidden="true"></span> <span>Structural statements such as <code>{% for %}</code> cannot reshape the YAML document. Use <code>foreach</code>, <code>when</code>, and declared macros instead.</span></li>
                        </ul>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-stone shadow-sm">
                        <h3 class="font-bold text-charcoal mb-3 text-sm">Order of operations</h3>
                        <ol class="space-y-2 text-sm text-charcoal-mid list-decimal list-inside marker:text-indigo marker:font-bold">
                            <li>Parse and validate the YAML document.</li>
                            <li>Evaluate <code>foreach</code> and <code>when</code> to select and clone entries.</li>
                            <li>Deserialize the typed manifest and render every string field.</li>
                            <li>Build the graph and hand a static plan to Ninja.</li>
                        </ol>
                        <p class="text-xs text-charcoal-light mt-3">The control keys run before typed deserialization, so they shape which entries exist &mdash; nothing about them survives into the build.</p>
                    </div>
                </div>
            </section>

            <!-- foreach -->
            <section id="foreach" class="mb-20 pt-10 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-indigo mr-3 text-lg" data-icon="carbon:repeat" aria-hidden="true"></span> Repeating with <code class="ml-2">foreach</code>
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    <code>foreach</code> takes a direct Jinja expression &mdash; no <code>{{ ... }}</code> braces &mdash; that
                    evaluates to a sequence: a list declared under <code>vars</code>, or a discovery call such as
                    <code>glob('src/*.c')</code>. Netsuke clones the entry once per element, exposing <code>item</code> (the
                    element) and <code>index</code> (its position) to every string field and to <code>when</code>.
                    It works on <code>targets</code> and on top-level <code>actions</code> alike.
                </p>
                <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
vars:
  designs:
    - hero
    - logo

targets:
  - foreach: designs
    name: "build/{{ item }}.png"
    rule: rasterise
    sources: "design/svg/{{ item }}.svg"

  - foreach: glob('pages/*.md')
    name: "site/{{ item | basename | with_suffix('.html') }}"
    rule: page
    sources: "{{ item }}"
{% endraw %}{% endhighlight %}{% raw %}
                </div>
                <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                    <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                    <p>Glob over <em>source</em> files only. Templates expand before anything is built, so a glob over generated outputs sees an empty directory on a clean checkout.</p>
                </div>
            </section>

            <!-- when -->
            <section id="when" class="mb-20 pt-10 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-indigo mr-3 text-lg" data-icon="carbon:filter" aria-hidden="true"></span> Selecting with <code class="ml-2">when</code>
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    <code>when</code> also takes a direct expression. If it evaluates false, the entry simply does not exist in
                    the plan. On a <code>foreach</code> entry it runs once per clone with <code>item</code> and
                    <code>index</code> in scope, so a single template can both expand and filter.
                    Complementary branches pair naturally with
                    <a href="/netsuke/docs/standard-library/" class="text-indigo hover:underline"><code>command_available(...)</code></a>.
                </p>
                <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
targets:
  - when: command_available('magick')
    name: "build/hero.png"
    rule: magick_convert
    sources: "design/hero.svg"

  - when: not command_available('magick')
    name: "build/hero.png"
    rule: inkscape_convert
    sources: "design/hero.svg"
{% endraw %}{% endhighlight %}{% raw %}
                </div>
                <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                    <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                    <p><code>when</code> selects manifest entries at plan time; it is not build-time branching. A condition that must be re-evaluated during the build belongs in the recipe command or script.</p>
                </div>
            </section>

            <!-- Macros -->
            <section id="macros" class="mb-20 pt-10 border-t border-stone-light">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6 flex items-center">
                    <span class="iconify text-indigo mr-3 text-lg" data-icon="carbon:function" aria-hidden="true"></span> Macros
                </h2>
                <p class="text-charcoal-mid mb-6 max-w-3xl">
                    Declared macros are the manifest's unit of reuse: a <code>signature</code> naming the macro and its
                    parameters, and a <code>body</code> template rendered wherever the macro is called. Because they are
                    declared as data rather than written as <code>{% macro %}</code> statements, the YAML document stays a
                    document.
                </p>
                <div class="hm-faux-window bg-charcoal rounded-xl border border-charcoal-mid shadow-lg overflow-hidden">
                    <div class="hm-faux-window__titlebar bg-charcoal-mid/20 px-4 py-3 flex items-center justify-between border-b border-white/10">
                        <div class="flex space-x-2">
                            <div class="w-3 h-3 rounded-full bg-vermillion"></div>
                            <div class="w-3 h-3 rounded-full bg-amber"></div>
                            <div class="w-3 h-3 rounded-full bg-matcha"></div>
                        </div>
                        <span class="text-xs font-mono text-stone-light">Netsukefile</span>
                        <div class="w-12"></div>
                    </div>
                    <div class="hm-faux-window__body p-6 font-mono text-sm overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
macros:
  - signature: "obj_name(src)"
    body: |
      {{ src | basename | with_suffix('.o') }}

targets:
  - foreach: glob('src/*.c')
    name: "build/{{ obj_name(item) }}"
    rule: "compile"
    sources: "{{ item }}"
{% endraw %}{% endhighlight %}{% raw %}
                    </div>
                </div>
            </section>

            <!-- Advanced Patterns -->
            <section id="patterns" class="mb-16">
                <h2 class="font-serif text-2xl font-bold text-charcoal mb-6">Common Patterns</h2>

                <div class="bg-boxwood-pale border border-stone rounded-xl overflow-hidden">
                    <div class="grid md:grid-cols-12 divide-y md:divide-y-0 md:divide-x divide-stone">
                        <!-- Sidebar for patterns -->
                        <div class="md:col-span-4 p-6 bg-white/50">
                            <h3 class="font-bold text-charcoal mb-4 text-sm uppercase tracking-wide">Recipes</h3>
                            <ul class="space-y-2" role="tablist" aria-label="Recipes" aria-orientation="vertical">
                                <li role="presentation">
                                    <button type="button" id="recipe-tab-cross-compilation" class="recipe-btn recipe-btn--active w-full text-left px-3 py-2 text-sm font-medium rounded-md transition-colors" data-recipe-tab="cross-compilation" role="tab" aria-selected="true" aria-controls="recipe-panel-cross-compilation" tabindex="0">
                                        Cross-Compilation
                                    </button>
                                </li>
                                <li role="presentation">
                                    <button type="button" id="recipe-tab-test-suites" class="recipe-btn w-full text-left px-3 py-2 text-sm font-medium rounded-md transition-colors" data-recipe-tab="test-suites" role="tab" aria-selected="false" aria-controls="recipe-panel-test-suites" tabindex="-1">
                                        Test Suites
                                    </button>
                                </li>
                                <li role="presentation">
                                    <button type="button" id="recipe-tab-code-generation" class="recipe-btn w-full text-left px-3 py-2 text-sm font-medium rounded-md transition-colors" data-recipe-tab="code-generation" role="tab" aria-selected="false" aria-controls="recipe-panel-code-generation" tabindex="-1">
                                        Code Generation
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <!-- Content for patterns -->
                        <div class="md:col-span-8 p-8 bg-white" id="recipe-panel-cross-compilation" data-recipe-panel="cross-compilation" role="tabpanel" aria-labelledby="recipe-tab-cross-compilation">
                            <h4 class="font-serif text-xl font-bold text-charcoal mb-2">Platform-specific sources with `when`</h4>
                            <p class="text-sm text-charcoal-mid mb-6">
                                Use <code class="bg-stone-light/30 px-1 rounded text-xs">when</code> on repeated entries to include targets only when the current variables match the platform you want.
                            </p>

                            <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
targets:
  - when: target_os == 'linux'
    name: "sys/linux.o"
    rule: "compile"
    sources: "src/linux_utils.c"

  - when: target_os == 'macos'
    name: "sys/macos.o"
    rule: "compile"
    sources: "src/macos_utils.c"
{% endraw %}{% endhighlight %}{% raw %}
                            </div>

                            <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                                <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                                <p>Keep conditions coarse-grained. Avoid selecting on individual compiler versions unless absolutely necessary.</p>
                            </div>
                        </div>

                        <div class="md:col-span-8 p-8 bg-white hidden" id="recipe-panel-test-suites" data-recipe-panel="test-suites" role="tabpanel" aria-labelledby="recipe-tab-test-suites">
                            <h4 class="font-serif text-xl font-bold text-charcoal mb-2">Test runs with `actions` and `always`</h4>
                            <p class="text-sm text-charcoal-mid mb-6">
                                Put operator-run test suites in <code class="bg-stone-light/30 px-1 rounded text-xs">actions</code> so they stay outside the default graph, and mark report targets <code class="bg-stone-light/30 px-1 rounded text-xs">always</code> when they should rerun on every invocation.
                            </p>

                            <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
targets:
  - name: test-report.txt
    command: "./run-tests > {{ outs }}"
    sources: "app"
    always: true

actions:
  - name: test
    command: "./app --self-test"
{% endraw %}{% endhighlight %}{% raw %}
                            </div>

                            <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                                <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                                <p>Keep the build product and the test run distinct: the report target depends on the binary, so tests always run against the current build.</p>
                            </div>
                        </div>

                        <div class="md:col-span-8 p-8 bg-white hidden" id="recipe-panel-code-generation" data-recipe-panel="code-generation" role="tabpanel" aria-labelledby="recipe-tab-code-generation">
                            <h4 class="font-serif text-xl font-bold text-charcoal mb-2">Generated sources as first-class targets</h4>
                            <p class="text-sm text-charcoal-mid mb-6">
                                Model generated code as its own target and let downstream targets name it in <code class="bg-stone-light/30 px-1 rounded text-xs">sources</code>: the implicit dependency keeps generation ordered before compilation.
                            </p>

                            <div class="bg-charcoal p-4 rounded-lg font-mono text-xs text-stone-light overflow-x-auto">
{% endraw %}{% highlight 'netsuke' %}{% raw %}
rules:
  - name: protoc
    command: "protoc --c_out=gen {{ ins }}"

targets:
  - name: gen/messages.c
    rule: protoc
    sources: proto/messages.proto

  - name: messages.o
    rule: compile
    sources: gen/messages.c
{% endraw %}{% endhighlight %}{% raw %}
                            </div>

                            <div class="mt-6 flex items-start space-x-3 text-sm text-charcoal-mid bg-stone-light/20 p-4 rounded border border-stone-light">
                                <span class="iconify text-amber mt-0.5" data-icon="carbon:warning-alt-filled" aria-hidden="true"></span>
                                <p>List generated inputs explicitly rather than globbing them: templates expand before anything is built, so a glob over generated files sees an empty directory.</p>
                            </div>
